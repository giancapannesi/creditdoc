---
import type { Lender } from '../utils/data';
import RatingStars from './RatingStars.astro';
import { formatPrice, getBbbClass, normalizedBbbRating } from '../utils/data';
import { softenYmylCopy } from '../utils/safe-copy';
import { buildLenderFallbackHref, buildReviewHref } from '../utils/outbound';

interface Props {
  lenders: Lender[];
}

const { lenders } = Astro.props;
// Use the order passed in (already sorted by caller)
const sorted = lenders;

function softenProviderSignal(text: string): string {
  return softenYmylCopy(text);
}
---

<div class="overflow-x-auto -mx-4 sm:mx-0 rounded-xl border border-border">
  <table class="w-full min-w-[700px] text-sm">
    <thead>
      <tr class="bg-bg-alt border-b-2 border-border">
        <th class="text-left py-3.5 px-4 font-semibold text-text w-10">#</th>
        <th class="text-left py-3.5 px-4 font-semibold text-text">Provider</th>
        <th class="text-left py-3.5 px-4 font-semibold text-text">Price</th>
        <th class="text-center py-3.5 px-4 font-semibold text-text">BBB</th>
        <th class="text-center py-3.5 px-4 font-semibold text-text">Refund Term</th>
        <th class="text-left py-3.5 px-4 font-semibold text-text">Profile Signals</th>
        <th class="text-center py-3.5 px-4 font-semibold text-text">Action</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-border">
      {sorted.map((lender, i) => {
        const bbbRating = normalizedBbbRating(lender.company_info.bbb_rating);
        const bbbClass = getBbbClass(bbbRating);
        const isVerified = lender.verified_provider === true;
        const showGoogleRating = Boolean(lender.google_rating && lender.google_rating > 0 && !(lender.google_rating > 5) && lender.google_reviews_count && lender.google_reviews_count >= 1);
        const reviewHref = buildReviewHref(lender);
        const detailsHref = reviewHref ?? buildLenderFallbackHref(lender);
        const detailsLabel = reviewHref ? 'View Details' : 'Compare Category';
        return (
          <tr class={`hover:bg-bg-alt/50 transition-colors ${isVerified ? 'bg-amber-50/40 border-l-2 border-l-amber-400' : 'bg-white'}`}>
            <!-- Rank -->
            <td class="py-4 px-4">
              <span class={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${isVerified ? 'bg-amber-100 text-amber-700' : 'bg-primary-light text-primary'}`}>
                {i + 1}
              </span>
            </td>

            <!-- Provider (logo + name + description) -->
            <td class="py-4 px-4">
              <div class="flex items-center gap-3">
                <div class={`shrink-0 w-10 h-10 rounded-lg border flex items-center justify-center overflow-hidden ${isVerified ? 'bg-amber-50 border-amber-200' : 'bg-bg-alt border-border'}`}>
                  {lender.logo_url && !lender.logo_url.includes('googleusercontent.com') ? (
                    <img src={lender.logo_url} alt={lender.name} class="w-7 h-7 object-contain" loading="lazy" onerror={`this.onerror=null;this.parentElement.innerHTML='<span class="text-xs font-bold ${isVerified ? 'text-amber-700' : 'text-primary'}">${lender.name.charAt(0)}</span>'`} />
                  ) : (
                    <span class={`text-xs font-bold ${isVerified ? 'text-amber-700' : 'text-primary'}`}>{lender.name.charAt(0)}</span>
                  )}
                </div>
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    {reviewHref ? (
                      <a href={reviewHref} class="font-semibold text-text hover:text-primary transition-colors truncate">
                        {lender.name}
                      </a>
                    ) : (
                      <span class="font-semibold text-text truncate">{lender.name}</span>
                    )}
                    {isVerified && (
                      <span class="inline-flex items-center gap-1 rounded-full bg-amber-100 border border-amber-300 px-1.5 py-0.5 text-[10px] font-bold text-amber-800 uppercase tracking-wider flex-shrink-0">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.403 12.652a3 3 0 000-5.304 3 3 0 00-3.75-3.751 3 3 0 00-5.305 0 3 3 0 00-3.751 3.75 3 3 0 000 5.305 3 3 0 003.75 3.751 3 3 0 005.305 0 3 3 0 003.751-3.75zm-2.546-4.46a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                        </svg>
                        Profiled
                      </span>
                    )}
                  </div>
                  {showGoogleRating && (
                    <div class="mt-0.5">
                      <RatingStars rating={lender.google_rating} size="sm" />
                      <p class="mt-0.5 text-[11px] text-muted">Google rating from {lender.google_reviews_count.toLocaleString()} reviews</p>
                    </div>
                  )}
                </div>
              </div>
            </td>

            <!-- Price -->
            <td class="py-4 px-4">
              <span class="font-semibold text-text">
                {formatPrice(lender.pricing.monthly_price)}
              </span>
              {lender.pricing.monthly_price > 0 && (
                <span class="text-muted text-xs">/mo</span>
              )}
              {lender.pricing.setup_fee > 0 && (
                <p class="text-xs text-muted mt-0.5">
                  + {formatPrice(lender.pricing.setup_fee)} setup
                </p>
              )}
            </td>

            <!-- BBB -->
            <td class="py-4 px-4 text-center">
              <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ${bbbClass}`}>
                {bbbRating}
              </span>
            </td>

            <!-- Refund term -->
            <td class="py-4 px-4 text-center">
              {lender.pricing.money_back_guarantee ? (
                <span class="inline-flex items-center gap-1 text-positive">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd"/>
                  </svg>
                  <span class="text-xs font-medium">Yes</span>
                </span>
              ) : (
                <span class="text-xs text-muted">No</span>
              )}
            </td>

            <!-- Profile signals -->
            <td class="py-4 px-4">
              <span class="text-xs text-muted line-clamp-2 max-w-[180px]">
                {lender.best_for.slice(0, 2).map(softenProviderSignal).join(', ')}
              </span>
            </td>

            <!-- Action -->
            <td class="py-4 px-4 text-center">
              <a
                href={detailsHref}
                class="inline-flex items-center gap-1 rounded-lg bg-primary px-4 py-2.5 text-xs font-semibold text-white hover:bg-primary-hover transition-colors min-h-[44px] whitespace-nowrap"
              >
                {detailsLabel}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                </svg>
              </a>
            </td>
          </tr>
        );
      })}
    </tbody>
  </table>
</div>
