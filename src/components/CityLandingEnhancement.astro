---
interface ToolLink {
  label: string;
  href: string;
  description: string;
}

interface TextLink {
  label: string;
  href: string;
}

interface LocalFaq {
  q: string;
  a: string;
}

interface Enhancement {
  batch: number;
  priority: number;
  gscImpressions: number;
  gscAvgPosition: number;
  primaryIntent: string;
  heroAngle: string;
  proofPoint: string;
  localActionPlan: string[];
  toolLinks: ToolLink[];
  priorityLinks: TextLink[];
  localFaqs: LocalFaq[];
}

interface Props {
  city: string;
  stateAbbr: string;
  enhancement: Enhancement;
}

const { city, stateAbbr, enhancement } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8" data-city-enhancement-batch={enhancement.batch}>
  <div class="rounded-xl border border-primary/20 bg-white p-5 shadow-sm md:p-6">
    <div class="grid gap-6 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">
          Batch {enhancement.batch} priority #{enhancement.priority} local landing page
        </p>
        <h2 class="mt-2 text-2xl font-bold text-text">
          {city} credit, debt, and local finance action plan
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">{enhancement.heroAngle}</p>
        <p class="mt-3 text-sm leading-relaxed text-muted">{enhancement.proofPoint}</p>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg border border-border bg-bg-alt p-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Primary intent</p>
            <p class="mt-1 text-sm font-semibold text-text">{enhancement.primaryIntent}</p>
          </div>
          <div class="rounded-lg border border-border bg-bg-alt p-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">Current GSC signal</p>
            <p class="mt-1 text-sm font-semibold text-text">
              {enhancement.gscImpressions} impressions, avg position {enhancement.gscAvgPosition}
            </p>
          </div>
        </div>
      </div>

      <div class="rounded-lg border border-border bg-bg-alt p-4">
        <h3 class="text-base font-bold text-text">What to do next in {city}</h3>
        <ol class="mt-3 space-y-2 text-sm leading-relaxed text-muted">
          {enhancement.localActionPlan.map((item) => (
            <li class="flex gap-2">
              <span class="mt-0.5 inline-flex h-5 w-5 flex-none items-center justify-center rounded-full bg-primary text-xs font-bold text-white">
                {enhancement.localActionPlan.indexOf(item) + 1}
              </span>
              <span>{item}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="mt-6">
      <h3 class="text-lg font-bold text-text">Choose a {city} tool</h3>
      <div class="mt-3 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
        {enhancement.toolLinks.map((tool) => (
          <a href={tool.href} class="rounded-lg border border-border bg-white p-4 transition-colors hover:border-primary/40 hover:bg-primary-light/20">
            <span class="block text-sm font-semibold text-primary">{tool.label}</span>
            <span class="mt-1 block text-xs leading-relaxed text-muted">{tool.description}</span>
          </a>
        ))}
      </div>
    </div>

    <div class="mt-6 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <h3 class="text-lg font-bold text-text">Priority {city} links</h3>
        <div class="mt-3 grid gap-2">
          {enhancement.priorityLinks.map((link) => (
            <a href={link.href} class="rounded-lg border border-border bg-white px-4 py-3 text-sm font-semibold text-primary transition-colors hover:border-primary/40 hover:bg-primary-light/20">
              {link.label} &rarr;
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-lg font-bold text-text">Frequently asked questions in {city}</h3>
        <div class="mt-3 space-y-3">
          {enhancement.localFaqs.map((faq) => (
            <details class="rounded-lg border border-border bg-white p-4">
              <summary class="cursor-pointer text-sm font-semibold text-text">{faq.q}</summary>
              <p class="mt-2 text-sm leading-relaxed text-muted">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>

    <p class="mt-5 text-xs leading-relaxed text-muted">
      CreditDoc tools are educational. They do not run credit, submit applications, guarantee approvals, or replace professional advice. Use them with the {city}, {stateAbbr} provider profiles and state-rule resources on this page.
    </p>
  </div>
</section>
