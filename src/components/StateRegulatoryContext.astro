---
import type { StateInfoRuntime } from '../utils/data-runtime';

interface Props {
  data: StateInfoRuntime;
  lenderName: string;
  lenderCategory: string;
  categoryLabel: string;
  cityName?: string;
  stateAbbr?: string;
}

const {
  data,
  lenderName,
  lenderCategory,
  categoryLabel,
  cityName = '',
  stateAbbr = data.abbr,
} = Astro.props;

type LinkItem = {
  name?: string;
  url?: string;
  type?: string;
  description?: string;
};

type CreditRepairLaws = {
  state_statute?: string;
  statute_code?: string;
  key_provisions?: string[];
  registration_required?: boolean;
  registration_agency?: string;
  bond_required?: boolean;
  bond_amount?: string | null;
  cancellation_period_days?: number;
  upfront_fees_prohibited?: boolean;
};

type LendingType = {
  legal?: boolean;
  rate_cap?: string;
  max_amount?: number | null;
  max_term_days?: number | null;
  notes?: string;
};

const complaintResources = Array.isArray(data.complaint_resources)
  ? (data.complaint_resources as LinkItem[]).filter((item) => item?.name || item?.url).slice(0, 3)
  : [];

const statuteLinks = Array.isArray(data.statute_links)
  ? (data.statute_links as LinkItem[]).filter((item) => item?.name || item?.url)
  : [];

const keyRegulations = Array.isArray(data.key_regulations)
  ? (data.key_regulations as string[]).filter(Boolean).slice(0, 3)
  : [];

const lendingTypes = ((data.lending_types ?? {}) as Record<string, LendingType>);
const creditRepairLaws = (data.credit_repair_laws ?? null) as CreditRepairLaws | null;

const categoryLoanTypeMap: Record<string, string[]> = {
  'personal-loans': ['personal_loans', 'installment_loans'],
  'business-loans': ['personal_loans', 'installment_loans'],
  'emergency-cash': ['payday_loans', 'installment_loans'],
  'payday-alternatives': ['payday_loans', 'installment_loans'],
  'mortgages': ['mortgage'],
  'title-loans': ['title_loans'],
  'auto-title-loans': ['title_loans'],
};

const loanTypeLabels: Record<string, string> = {
  personal_loans: 'Personal loan rules',
  installment_loans: 'Installment loan rules',
  payday_loans: 'Payday loan rules',
  title_loans: 'Title loan rules',
  mortgage: 'Mortgage rules',
};

const relevantLoanTypes = (categoryLoanTypeMap[lenderCategory] ?? [])
  .map((key) => ({ key, label: loanTypeLabels[key] || key.replace(/_/g, ' '), value: lendingTypes[key] }))
  .filter((item) => item.value);

const isCreditHelpCategory = ['credit-repair', 'credit-counseling', 'debt-relief', 'bankruptcy'].includes(lenderCategory);
const isMoneyServicesCategory = ['check-cashing', 'pawn-shops', 'pawn-lenders'].includes(lenderCategory);

const locationPhrase = [cityName, stateAbbr].filter(Boolean).join(', ');
const stateName = data.name || stateAbbr || 'this state';

const keywordMap: Record<string, string[]> = {
  'credit-repair': ['credit', 'repair', 'consumer'],
  'credit-counseling': ['credit', 'debt', 'consumer'],
  'debt-relief': ['debt', 'consumer'],
  'bankruptcy': ['debt', 'consumer'],
  'check-cashing': ['check', 'money', 'payday', 'consumer'],
  'pawn-shops': ['pawn', 'title', 'consumer'],
  'pawn-lenders': ['pawn', 'title', 'consumer'],
  'personal-loans': ['loan', 'credit', 'consumer'],
  'business-loans': ['loan', 'credit'],
  'emergency-cash': ['payday', 'loan', 'consumer'],
  'payday-alternatives': ['payday', 'loan', 'consumer'],
  'mortgages': ['mortgage', 'housing'],
};
const statuteKeywords = keywordMap[lenderCategory] ?? ['consumer', 'credit', 'loan'];
const matchingStatutes = statuteLinks
  .filter((item) => {
    const haystack = `${item.name || ''} ${item.description || ''}`.toLowerCase();
    return statuteKeywords.some((word) => haystack.includes(word));
  })
  .slice(0, 3);
const visibleStatutes = (matchingStatutes.length > 0 ? matchingStatutes : statuteLinks).slice(0, 3);
---

<div class="glass-card p-6 border-l-4 border-primary">
  <div class="flex items-start gap-3 mb-4">
    <div class="shrink-0 w-10 h-10 rounded-xl bg-primary-light flex items-center justify-center">
      <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3l7.5 4.5v6.75c0 3.75-2.55 7.24-7.5 8.25-4.95-1.01-7.5-4.5-7.5-8.25V7.5L12 3z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l2 2 4-5" />
      </svg>
    </div>
    <div>
      <h2 class="text-xl font-bold text-text">State Consumer Finance Context</h2>
      <p class="mt-1 text-sm text-muted">
        This is state-level context for {categoryLabel} consumers{locationPhrase ? ` in ${locationPhrase}` : ` in ${stateName}`}. It does not confirm that {lenderName} or this specific location is licensed.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
    {data.licensing_board && (
      <div class="rounded-lg bg-bg-alt border border-border p-3">
        <p class="text-xs text-muted uppercase">State regulator</p>
        <p class="text-sm font-semibold text-text mt-1">{data.licensing_board as string}</p>
      </div>
    )}
    {data.consumer_protection_agency && (
      <div class="rounded-lg bg-bg-alt border border-border p-3">
        <p class="text-xs text-muted uppercase">Consumer protection</p>
        <p class="text-sm font-semibold text-text mt-1">
          {data.consumer_protection_url
            ? <a href={data.consumer_protection_url as string} target="_blank" rel="noopener" class="text-primary hover:underline">{data.consumer_protection_agency as string}</a>
            : data.consumer_protection_agency as string}
        </p>
      </div>
    )}
  </div>

  {isCreditHelpCategory && creditRepairLaws && (
    <div class="mb-4 rounded-lg border border-border bg-bg-alt p-4">
      <h3 class="text-sm font-semibold text-text mb-2">Credit and debt help rules in {stateName}</h3>
      <div class="space-y-2 text-sm text-muted">
        {creditRepairLaws.state_statute && <p><strong class="text-text">Relevant law:</strong> {creditRepairLaws.state_statute}{creditRepairLaws.statute_code ? ` (${creditRepairLaws.statute_code})` : ''}</p>}
        {creditRepairLaws.registration_required !== undefined && (
          <p><strong class="text-text">Registration:</strong> {creditRepairLaws.registration_required ? `Required${creditRepairLaws.registration_agency ? ` with ${creditRepairLaws.registration_agency}` : ''}` : 'Not listed as required in the current CreditDoc state summary'}</p>
        )}
        {creditRepairLaws.upfront_fees_prohibited !== undefined && (
          <p><strong class="text-text">Upfront fees:</strong> {creditRepairLaws.upfront_fees_prohibited ? 'Listed as prohibited in the current CreditDoc state summary' : 'Check the state regulator before paying upfront fees'}</p>
        )}
      </div>
      {Array.isArray(creditRepairLaws.key_provisions) && creditRepairLaws.key_provisions.length > 0 && (
        <ul class="mt-3 ml-4 list-disc space-y-1 text-sm text-muted">
          {creditRepairLaws.key_provisions.slice(0, 3).map((provision) => <li>{provision}</li>)}
        </ul>
      )}
    </div>
  )}

  {relevantLoanTypes.length > 0 && (
    <div class="mb-4 space-y-3">
      {relevantLoanTypes.map(({ label, value }) => (
        <div class="rounded-lg border border-border bg-bg-alt p-4">
          <h3 class="text-sm font-semibold text-text mb-2">{label} in {stateName}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            {value.legal !== undefined && (
              <p><span class="text-muted">Status:</span> <strong class="text-text">{value.legal ? 'Permitted' : 'Not permitted'}</strong></p>
            )}
            {value.rate_cap && (
              <p><span class="text-muted">Rate context:</span> <strong class="text-text">{value.rate_cap}</strong></p>
            )}
            {value.max_amount && (
              <p><span class="text-muted">Amount context:</span> <strong class="text-text">${value.max_amount.toLocaleString('en-US')}</strong></p>
            )}
            {value.max_term_days && (
              <p><span class="text-muted">Term context:</span> <strong class="text-text">{value.max_term_days} days</strong></p>
            )}
          </div>
          {value.notes && <p class="text-sm text-muted mt-3 pt-3 border-t border-border/50">{value.notes}</p>}
        </div>
      ))}
    </div>
  )}

  {isMoneyServicesCategory && (
    <div class="mb-4 rounded-lg border border-border bg-bg-alt p-4">
      <h3 class="text-sm font-semibold text-text mb-2">Money services context in {stateName}</h3>
      <div class="space-y-2 text-sm text-muted">
        {data.payday_loan_status && <p><strong class="text-text">Short-term lending status:</strong> {data.payday_loan_status as string}</p>}
        {data.usury_cap && <p><strong class="text-text">General rate context:</strong> {data.usury_cap as string}</p>}
        {data.consumer_rights_summary && <p>{data.consumer_rights_summary as string}</p>}
      </div>
    </div>
  )}

  {keyRegulations.length > 0 && (
    <div class="mb-4">
      <h3 class="text-sm font-semibold text-text mb-2">Key state rules to check</h3>
      <ul class="ml-4 list-disc space-y-1 text-sm text-muted">
        {keyRegulations.map((rule) => <li>{rule}</li>)}
      </ul>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {complaintResources.length > 0 && (
      <div>
        <h3 class="text-sm font-semibold text-text mb-2">Complaint resources</h3>
        <ul class="space-y-2">
          {complaintResources.map((item) => (
            <li class="text-sm text-muted">
              {item.url
                ? <a href={item.url} target="_blank" rel="noopener" class="font-medium text-primary hover:underline">{item.name || item.url}</a>
                : <span class="font-medium text-text">{item.name}</span>}
              {item.type && <span class="text-xs text-muted"> - {item.type}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {visibleStatutes.length > 0 && (
      <div>
        <h3 class="text-sm font-semibold text-text mb-2">State references</h3>
        <ul class="space-y-2">
          {visibleStatutes.map((item) => (
            <li class="text-sm text-muted">
              {item.url
                ? <a href={item.url} target="_blank" rel="noopener" class="font-medium text-primary hover:underline">{item.name || item.url}</a>
                : <span class="font-medium text-text">{item.name}</span>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <p class="text-xs text-muted mt-5 pt-3 border-t border-border">
    Source: CreditDoc state-law summary and listed public regulator resources. Verify licensing directly with the listed state regulator before relying on a provider.
  </p>
</div>
