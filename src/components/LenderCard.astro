---
import type { Lender } from '../utils/data';
import { getBbbClass } from '../utils/data';
import RatingStars from './RatingStars.astro';
import TrustBadge from './TrustBadge.astro';

interface Props {
  lender: Lender;
  showRatings?: boolean;
}

const { lender, showRatings = true } = Astro.props;

const bbbClass = getBbbClass(lender.company_info.bbb_rating);
const showGoogleRating = showRatings && lender.google_rating && lender.google_rating > 0 && !(lender.google_rating > 5) && lender.google_reviews_count && lender.google_reviews_count >= 1;
---

<article class="glass-card p-5 sm:p-6 flex flex-col h-full">
  <!-- Top: Logo + Name -->
  <div class="flex items-start gap-4">
    <div class="shrink-0 w-14 h-14 rounded-xl bg-bg-alt border border-border flex items-center justify-center overflow-hidden">
      {lender.logo_url && !lender.logo_url.includes('googleusercontent.com') ? (
        <img
          src={lender.logo_url}
          alt={`${lender.name} logo`}
          class="w-10 h-10 object-contain"
          loading="lazy"
          onerror={`this.onerror=null;this.parentElement.innerHTML='<span class="text-lg font-bold text-primary">${lender.name.charAt(0)}</span>'`}
        />
      ) : lender.website_url ? (
        <img
          src={`https://icons.duckduckgo.com/ip3/${new URL(lender.website_url).hostname}.ico`}
          alt={`${lender.name} logo`}
          class="w-10 h-10 object-contain"
          loading="lazy"
          onerror={`this.onerror=function(){this.onerror=null;this.parentElement.innerHTML='<span class="text-lg font-bold text-primary">${lender.name.charAt(0)}</span>'};this.src='https://icon.horse/icon/${new URL(lender.website_url).hostname}?size=large'`}
        />
      ) : (
        <span class="text-lg font-bold text-primary">
          {lender.name.charAt(0)}
        </span>
      )}
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-lg font-semibold text-text truncate">{lender.name}</h3>
      <p class="text-sm text-muted mt-0.5 line-clamp-2">
        {showRatings
          ? lender.description_short
          : 'View this provider profile and compare verified details before choosing a service.'}
      </p>
    </div>
  </div>

  <!-- Rating -->
  {showGoogleRating && (
    <div class="mt-4">
      <RatingStars rating={lender.google_rating} size="sm" />
      <p class="mt-1 text-xs text-muted">
        Google rating from {lender.google_reviews_count.toLocaleString()} review{lender.google_reviews_count === 1 ? '' : 's'}
      </p>
    </div>
  )}

  <!-- Badges Row -->
  {showRatings && (
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <!-- BBB Rating pill -->
      <span class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${bbbClass}`}>
        BBB: {lender.company_info.bbb_rating}
      </span>
    </div>
  )}

  <!-- Best For -->
  {lender.best_for.length > 0 && (
    <div class="mt-3">
      <p class="text-xs text-muted">
        <span class="font-medium">Best for:</span> {lender.best_for.slice(0, 2).join(', ')}
      </p>
    </div>
  )}

  <!-- Spacer -->
  <div class="flex-1"></div>

  <!-- CTA -->
  <div class="mt-5">
    <a
      href={`/review/${lender.slug}/`}
      class="flex items-center justify-center w-full rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white hover:bg-primary-hover transition-colors min-h-[44px]"
    >
      View Details
      <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
      </svg>
    </a>
  </div>
</article>
