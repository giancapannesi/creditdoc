---
/**
 * RegulatoryRecord — renders CFPB complaint stats, enforcement actions,
 * and SBA rankings from federal regulator data.
 *
 * Data sourced from regulator.db → Supabase sync. Feature-flagged via
 * ENABLE_REGULATOR_BLOCKS Worker env var.
 */
import type { RegulatorData } from '../lib/db';

interface Props {
  data: RegulatorData;
  lenderName: string;
}

const { data, lenderName } = Astro.props;
const { stats, enforcement, sba } = data;

if (!stats) return;

const fmt = (n: number) => n.toLocaleString('en-US');
const pct = (n: number | null) => n != null ? `${(n * 100).toFixed(1)}%` : '—';
const dollar = (n: number) => {
  if (n >= 1_000_000_000) return `$${(n / 1_000_000_000).toFixed(1)}B`;
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n.toFixed(0)}`;
};

const topIssues = [
  stats.top_issue_1 ? { name: stats.top_issue_1, pct: stats.top_issue_1_pct } : null,
  stats.top_issue_2 ? { name: stats.top_issue_2, pct: stats.top_issue_2_pct } : null,
  stats.top_issue_3 ? { name: stats.top_issue_3, pct: stats.top_issue_3_pct } : null,
].filter(Boolean) as { name: string; pct: number | null }[];

const trendLabel: Record<string, string> = {
  growing: 'Increasing',
  stable: 'Stable',
  declining: 'Declining',
};
const trendColor: Record<string, string> = {
  growing: 'text-red-400',
  stable: 'text-muted',
  declining: 'text-positive',
};

const bestSbaState = sba.find(s => s.rank_state && s.rank_state <= 10 && s.state);
const bestSbaNational = sba.find(s => s.rank_national && s.rank_national <= 25);
---

<div class="glass-card p-6">
  <!-- Complaint Transparency -->
  <h2 class="text-xl font-bold text-text mb-4">Consumer Complaint Record</h2>
  <p class="text-sm text-muted mb-4">
    {stats.company_name} received <span class="font-semibold text-text">{fmt(stats.total_complaints_12mo)} consumer complaints</span> in the past 12 months.
    {stats.timely_response_rate != null && stats.timely_response_rate >= 0.95
      ? ' All complaints received a timely response from the company.'
      : stats.timely_response_rate != null
        ? ` ${pct(stats.timely_response_rate)} received a timely response.`
        : ''}
  </p>

  <!-- Resolution stats -->
  {stats.resolved_with_relief_rate != null && (
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4">
      <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
        <p class="text-2xl font-bold text-text">{fmt(stats.total_complaints_12mo)}</p>
        <p class="text-xs text-muted mt-1">Complaints (12 months)</p>
      </div>
      <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
        <p class="text-2xl font-bold text-primary">{pct(stats.resolved_with_relief_rate)}</p>
        <p class="text-xs text-muted mt-1">Resolved with relief</p>
      </div>
      <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
        <p class={`text-2xl font-bold ${trendColor[stats.complaint_trend || 'stable']}`}>
          {trendLabel[stats.complaint_trend || 'stable'] || 'Stable'}
        </p>
        <p class="text-xs text-muted mt-1">Complaint trend</p>
      </div>
    </div>
  )}

  <!-- Top issues -->
  {topIssues.length > 0 && (
    <div class="mb-4">
      <p class="text-sm font-semibold text-text mb-2">Most Common Complaint Categories</p>
      <div class="space-y-2">
        {topIssues.map(issue => (
          <div class="flex items-center gap-3">
            <span class="text-xs text-muted w-40 shrink-0 truncate" title={issue.name}>{issue.name}</span>
            <div class="flex-1 h-2 bg-bg-alt rounded-full overflow-hidden">
              <div class="h-full bg-primary/70 rounded-full" style={`width: ${Math.min(issue.pct || 0, 100)}%`}></div>
            </div>
            <span class="text-xs font-medium text-text w-10 text-right">{issue.pct != null ? `${issue.pct.toFixed(1)}%` : '—'}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- FDIC branch count -->
  {stats.fdic_branch_count > 0 && (
    <p class="text-sm text-muted mb-4">
      <span class="font-semibold text-text">{fmt(stats.fdic_branch_count)}</span> FDIC-insured branch locations nationwide.
    </p>
  )}

  <!-- Enforcement Actions -->
  {enforcement.length > 0 && (
    <>
      <h2 class="text-xl font-bold text-text mb-4 mt-6 pt-4 border-t border-border">CFPB Enforcement Actions</h2>
      <div class="space-y-3">
        {enforcement.map(action => (
          <div class="flex gap-3 items-start">
            <span class="text-xs font-semibold text-muted bg-bg-alt border border-border rounded px-2 py-1 shrink-0">
              {action.action_date ? action.action_date.slice(0, 4) : '—'}
            </span>
            <p class="text-sm text-muted">
              {action.title || 'Consent order'}
              {action.penalty_amount && action.penalty_amount > 0
                ? <> &mdash; <span class="font-semibold text-text">{dollar(action.penalty_amount)}</span></>
                : null}
              {action.description ? ` — ${action.description}` : ''}
            </p>
          </div>
        ))}
      </div>
    </>
  )}

  <!-- SBA Rankings -->
  {(bestSbaState || bestSbaNational) && (
    <>
      <h2 class="text-xl font-bold text-text mb-4 mt-6 pt-4 border-t border-border">SBA Lending Record</h2>
      <div class="space-y-2">
        {bestSbaNational && (
          <p class="text-sm text-muted">
            Ranked <span class="font-semibold text-text">#{bestSbaNational.rank_national} nationally</span> for
            SBA {bestSbaNational.program.toUpperCase()} lending in FY{bestSbaNational.fiscal_year}.
            Recorded {dollar(bestSbaNational.total_approval)} in approvals across {fmt(bestSbaNational.loan_count)} loans.
          </p>
        )}
        {bestSbaState && (
          <p class="text-sm text-muted">
            Ranked <span class="font-semibold text-text">#{bestSbaState.rank_state} in {bestSbaState.state}</span> for
            SBA {bestSbaState.program.toUpperCase()} lending in FY{bestSbaState.fiscal_year}.
          </p>
        )}
      </div>
    </>
  )}

  <!-- Source attribution -->
  <p class="text-xs text-muted mt-5 pt-3 border-t border-border">
    Source: <a href="https://www.consumerfinance.gov/data-research/consumer-complaints/" class="text-primary hover:underline" target="_blank" rel="noopener">Consumer Financial Protection Bureau</a>
    {enforcement.length > 0 && ' · CFPB Enforcement Records'}
    {(bestSbaState || bestSbaNational) && (
      <> · <a href="https://data.sba.gov/" class="text-primary hover:underline" target="_blank" rel="noopener">SBA</a></>
    )}
    {stats.fdic_branch_count > 0 && ' · FDIC BankFind'}
  </p>
</div>
