---
import BaseLayout from '../layouts/BaseLayout.astro';

type LinkCard = {
  title: string;
  href: string;
  text: string;
};

type OfficialSource = {
  name: string;
  href: string;
  text: string;
};

type LetterTemplatePage = {
  title: string;
  description: string;
  canonical: string;
  h1: string;
  kicker: string;
  intro: string;
  published: string;
  modified: string;
  designedFor: string[];
  whenToUse: string[];
  whenNotToUse: string[];
  gatherFirst: string[];
  templateTitle: string;
  templateBody: string[];
  checklist: string[];
  whereToSend: LinkCard[];
  relatedTemplates: LinkCard[];
  relatedAnswers: LinkCard[];
  moreGuides: LinkCard[];
  officialSources: OfficialSource[];
  toolCta?: LinkCard;
};

const { page } = Astro.props as { page: LetterTemplatePage };

const howToSteps = [
  ...page.gatherFirst.slice(0, 3).map((text, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: `Prepare item ${index + 1}`,
    text,
  })),
  {
    '@type': 'HowToStep',
    position: 4,
    name: 'Customize the letter',
    text: 'Replace placeholders with your own account details, dates, mailing address, and requested action before sending.',
  },
  {
    '@type': 'HowToStep',
    position: 5,
    name: 'Save proof of delivery',
    text: 'Keep a copy of the final letter, attachments, mailing receipt, delivery confirmation, and any response you receive.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: page.h1,
    description: page.description,
    url: page.canonical,
    datePublished: page.published,
    dateModified: page.modified,
    author: { '@type': 'Organization', name: 'CreditDoc Editorial Team' },
    publisher: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
      logo: { '@type': 'ImageObject', url: 'https://www.creditdoc.co/favicon.svg' },
    },
    mainEntityOfPage: page.canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    name: page.h1,
    description: page.description,
    step: howToSteps,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.creditdoc.co/resources/' },
      { '@type': 'ListItem', position: 3, name: 'Debt and Credit Letter Templates', item: 'https://www.creditdoc.co/resources/debt-credit-letter-templates/' },
      { '@type': 'ListItem', position: 4, name: page.h1, item: page.canonical },
    ],
  },
];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonical={page.canonical}
  jsonLd={jsonLd}
  ogType="article"
  articlePublishedTime={page.published}
  articleModifiedTime={page.modified}
  articleAuthor="CreditDoc Editorial Team"
  articleSection="Debt and Credit Letters"
  publicResource={true}
>
  <nav class="mx-auto max-w-5xl px-4 pt-6 text-sm text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-primary">Home</a>
    <span class="px-2">/</span>
    <a href="/resources/" class="hover:text-primary">Resources</a>
    <span class="px-2">/</span>
    <a href="/resources/debt-credit-letter-templates/" class="hover:text-primary">Debt and Credit Letter Templates</a>
    <span class="px-2">/</span>
    <span class="text-text">{page.kicker}</span>
  </nav>

  <section class="border-b border-border bg-white">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 md:grid-cols-[1.4fr_0.8fr] md:items-center">
      <div>
        <span class="inline-flex rounded-full bg-primary-light px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">Free public resource</span>
        <h1 class="mt-5 text-3xl font-bold leading-tight text-text sm:text-5xl">{page.h1}</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">{page.intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#template" class="inline-flex min-h-[44px] items-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-hover">
            View letter template
          </a>
          <a href="#checklist" class="inline-flex min-h-[44px] items-center rounded-lg border border-border px-5 py-3 text-sm font-semibold text-text hover:bg-bg-alt">
            Review checklist
          </a>
        </div>
      </div>
      <aside class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
        <h2 class="text-base font-bold text-text">Designed for</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
          {page.designedFor.map((item) => <li>{item}</li>)}
        </ul>
      </aside>
    </div>
  </section>

  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 lg:grid-cols-[1fr_280px]">
    <main class="space-y-12">
      <section class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
        <h2 class="text-xl font-bold text-text">Use This Template With Broader Context</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          This template is an educational documentation aid, not legal advice, debt settlement advice, credit repair advice, or a guaranteed outcome. Review official sources, related answers, relevant categories, and complaint-data context before sending documents or contacting a company.
        </p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          <a href="/resources/credit-report-checklist/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Credit report checklist</a>
          <a href="/answers/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Borrower answers</a>
          <a href="/categories/debt-relief/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Debt relief providers</a>
          <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Complaint data context</a>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">Before you use this template</h2>
        <div class="mt-5 rounded-xl border border-border bg-white p-6 text-sm leading-relaxed text-muted">
          <p>
            This page is educational and does not provide legal, tax, credit repair, or debt settlement advice. A letter can help you document a request, but it cannot guarantee that a collector, creditor, credit bureau, or court will agree with you.
          </p>
          <p class="mt-4">
            If you are facing a lawsuit, wage garnishment, identity theft, tax consequences, or a state-law deadline, consider contacting a qualified consumer attorney, nonprofit credit counselor, state consumer agency, or the Consumer Financial Protection Bureau before sending anything.
          </p>
        </div>
      </section>

      <section>
        <div class="grid gap-4 md:grid-cols-2">
          <div class="rounded-xl border border-border bg-white p-6">
            <h2 class="text-xl font-bold text-text">When to use this letter</h2>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
              {page.whenToUse.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-primary"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="rounded-xl border border-border bg-white p-6">
            <h2 class="text-xl font-bold text-text">When not to use it</h2>
            <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
              {page.whenNotToUse.map((item) => (
                <li class="flex gap-3">
                  <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-warning"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">What to gather first</h2>
        <ol class="mt-6 space-y-4">
          {page.gatherFirst.map((item, index) => (
            <li class="rounded-xl border border-border bg-white p-5">
              <div class="flex gap-4">
                <span class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white">{index + 1}</span>
                <p class="text-sm leading-relaxed text-muted">{item}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="template">
        <h2 class="text-2xl font-bold text-text">{page.templateTitle}</h2>
        <div class="mt-6 rounded-xl border border-border bg-white p-6">
          <div class="rounded-lg border border-border bg-bg-alt p-5 font-mono text-sm leading-relaxed text-text">
            {page.templateBody.map((line) => (
              line === '' ? <br /> : <p class="mb-3 whitespace-pre-wrap last:mb-0">{line}</p>
            ))}
          </div>
          <p class="mt-4 text-xs leading-relaxed text-muted">
            Replace bracketed placeholders before sending. Keep the tone factual. Do not include threats, false statements, or claims you cannot support with documents.
          </p>
        </div>
      </section>

      <section id="checklist">
        <h2 class="text-2xl font-bold text-text">Checklist before sending</h2>
        <div class="mt-6 rounded-xl border border-border bg-white p-6">
          <ul class="grid gap-3 sm:grid-cols-2">
            {page.checklist.map((item) => (
              <li class="flex gap-3 text-sm leading-relaxed text-muted">
                <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded border border-border bg-bg-alt"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">Where to send this letter</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {page.whereToSend.map((item) => (
            <a href={item.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">Official resources</h2>
        <div class="mt-6 rounded-xl border border-border bg-white p-6">
          <ul class="space-y-4 text-sm leading-relaxed text-muted">
            {page.officialSources.map((source) => (
              <li>
                <a class="font-medium text-primary hover:underline" href={source.href} rel="noopener noreferrer">{source.name}</a>: {source.text}
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">Related CreditDoc templates</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {page.relatedTemplates.map((item) => (
            <a href={item.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
              <span class="mt-4 inline-flex text-sm font-semibold text-primary">Open template</span>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">Related CreditDoc answers</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {page.relatedAnswers.map((item) => (
            <a href={item.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
              <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read answer</span>
            </a>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-bold text-text">More CreditDoc guides</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          {page.moreGuides.map((item) => (
            <a href={item.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
              <h3 class="font-semibold text-text">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
              <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read guide</span>
            </a>
          ))}
        </div>
      </section>

      {page.toolCta && (
        <section class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
          <h2 class="text-xl font-bold text-text">{page.toolCta.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-muted">{page.toolCta.text}</p>
          <a href={page.toolCta.href} class="mt-5 inline-flex min-h-[44px] items-center rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-hover">
            Open tool
          </a>
        </section>
      )}
    </main>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-xl border border-border bg-white p-5">
        <h2 class="text-sm font-bold uppercase tracking-wider text-muted">Resource links</h2>
        <ul class="mt-4 space-y-3 text-sm">
          <li><a href="#template" class="text-primary hover:underline">Letter template</a></li>
          <li><a href="#checklist" class="text-primary hover:underline">Checklist</a></li>
          <li><a href="/resources/debt-credit-letter-templates/" class="text-primary hover:underline">All letter templates</a></li>
          <li><a href="/resources/credit-report-checklist/" class="text-primary hover:underline">Credit report checklist</a></li>
          <li><a href="/financial-wellness/dealing-with-debt-collectors/" class="text-primary hover:underline">Debt collector guide</a></li>
        </ul>
      </div>
      <div class="rounded-xl border border-primary/20 bg-primary-light/30 p-5">
        <h2 class="text-sm font-bold text-text">Keep records</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Save your final letter, attachments, delivery proof, dates, and every response. Documentation matters more than a perfect template.</p>
      </div>
    </aside>
  </div>
</BaseLayout>
