---
interface LinkItem {
  href: string;
  label: string;
  detail: string;
}

interface Props {
  compact?: boolean;
  context?: 'money' | 'tool' | 'education';
  title?: string;
  description?: string;
  links?: LinkItem[];
}

const {
  compact = false,
  context = 'money',
  title = 'Check The Regulatory Context',
  description = 'Before relying on a lender, card, credit repair, or debt-service page, compare the offer with state rules, complaint resources, and CreditDoc data notes. This is educational context, not a licensing decision or legal advice.',
  links = [
    {
      href: '/tools/state-consumer-credit-regulator-directory/',
      label: 'Regulator directory',
      detail: 'Find state regulator and complaint-resource starting points.',
    },
    {
      href: '/state/',
      label: 'State law hub',
      detail: 'Review state lending-law and consumer finance context.',
    },
    {
      href: '/research/consumer-complaints/',
      label: 'Complaint data',
      detail: 'Use CFPB complaint patterns as one research input.',
    },
    {
      href: '/about/creditdoc-data/',
      label: 'Data methodology',
      detail: 'See how CreditDoc handles public regulatory records.',
    },
  ],
} = Astro.props;

const eyebrow = context === 'tool'
  ? 'Regulatory research layer'
  : context === 'education'
    ? 'Consumer protection context'
    : 'CreditDoc regulatory context';
---

<section class:list={[
  compact ? 'mt-6 rounded-xl border border-border bg-white p-5' : 'mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8',
]}>
  <div class:list={[
    compact ? '' : 'rounded-xl border border-border bg-white p-6',
  ]}>
    <div class="flex flex-col gap-3 md:flex-row md:items-start md:justify-between">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">{eyebrow}</p>
        <h2 class="mt-1 text-xl font-bold text-text">{title}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{description}</p>
      </div>
      <a href="/tools/state-consumer-credit-regulator-directory/" class="inline-flex shrink-0 items-center justify-center rounded-lg border border-primary/30 px-4 py-2 text-sm font-semibold text-primary transition-colors hover:bg-primary/10">
        Open directory
      </a>
    </div>

    <div class:list={[
      'mt-5 grid gap-3',
      compact ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-4',
    ]}>
      {links.map((link) => (
        <a href={link.href} class="rounded-lg border border-border bg-bg-alt p-4 transition-colors hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">{link.label}</span>
          <span class="mt-1 block text-xs leading-relaxed text-muted">{link.detail}</span>
        </a>
      ))}
    </div>

    <p class="mt-4 border-t border-border pt-3 text-xs leading-relaxed text-muted">
      CreditDoc does not confirm that a listed provider or location is licensed unless a page states a directly verified source. Always verify current licensing, complaint instructions, and state rules with the official regulator.
    </p>
  </div>
</section>
