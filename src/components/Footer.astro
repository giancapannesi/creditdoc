---
const currentYear = new Date().getFullYear();
const linkedinUrl = 'https://www.linkedin.com/company/creditdoc-co/';

const categoryLinks = [
  { name: 'Credit Repair', href: '/categories/credit-repair/' },
  { name: 'Personal Loans', href: '/categories/personal-loans/' },
  { name: 'Debt Relief', href: '/categories/debt-relief/' },
  { name: 'Credit Building', href: '/categories/build-credit/' },
  { name: 'Emergency Cash', href: '/categories/emergency-cash/' },
  { name: 'Credit Monitoring', href: '/categories/credit-monitoring/' },
  { name: 'Credit Counseling', href: '/best/best-credit-counseling-agencies/' },
  { name: 'Payday Alternatives', href: '/categories/payday-alternatives/' },
];

const resourceLinks = [
  { name: 'About', href: '/about/' },
  { name: 'Contact', href: '/contact/' },
  { name: 'Financial Wellness', href: '/financial-wellness/' },
  { name: 'Methodology', href: '/methodology/' },
  { name: 'Editorial Policy', href: '/editorial-policy/' },
  { name: 'How We Earn Money', href: '/disclosure/' },
  { name: 'FAQ', href: '/faq/' },
  { name: 'Disclaimer', href: '/disclaimer/' },
  { name: 'Privacy Policy', href: '/privacy/' },
  { name: 'Terms of Service', href: '/terms/' },
  { name: 'Accessibility', href: '/accessibility/' },
  { name: 'LinkedIn', href: linkedinUrl, external: true },
];

const toolLinks = [
  { name: 'Borrowing Power Quiz', href: '/tools/borrowing-power-quiz/' },
  { name: 'Credit Score Simulator', href: '/tools/credit-score-simulator/' },
  { name: 'Debt Payoff Calculator', href: '/tools/debt-payoff-calculator/' },
  { name: 'Loan Denial Checker', href: '/tools/loan-denial-reason-checker/' },
  { name: 'Credit Denial Checklist', href: '/tools/credit-denial-action-checklist/' },
  { name: 'Business Loan Calculator', href: '/tools/business-loan-calculator/' },
  { name: 'Commercial Loan Calculator', href: '/tools/commercial-loan-calculator/' },
  { name: 'Business Line of Credit Calculator', href: '/tools/business-line-of-credit-calculator/' },
  { name: 'Business Readiness Quiz', href: '/tools/business-loan-readiness-quiz/' },
  { name: 'Credit Repair Qualify Quiz', href: '/tools/credit-repair-qualify-quiz/' },
  { name: 'SBA Loan Calculator', href: '/tools/sba-loan-calculator/' },
  { name: 'Cash Flow Calculator', href: '/tools/bank-statement-cash-flow-calculator/' },
  { name: 'MCA Repayment Calculator', href: '/tools/mca-repayment-calculator/' },
  { name: 'Equipment Financing Calculator', href: '/tools/equipment-financing-calculator/' },
  { name: 'Working Capital Calculator', href: '/tools/working-capital-calculator/' },
  { name: 'AR Financing Calculator', href: '/tools/accounts-receivable-financing-calculator/' },
  { name: 'SBA Guarantee Fee Calculator', href: '/tools/sba-guarantee-fee-calculator/' },
  { name: 'Regulator Directory', href: '/tools/state-consumer-credit-regulator-directory/' },
];

const courseLinks = [
  { name: 'Credit Fundamentals Course', href: '/courses/credit-fundamentals/' },
  { name: 'Understanding Credit Scores', href: '/courses/credit-fundamentals/understanding-your-credit-score/' },
  { name: 'Read Your Credit Report', href: '/courses/credit-fundamentals/how-to-read-your-credit-report/' },
  { name: 'Build Credit From Scratch', href: '/courses/credit-fundamentals/building-credit-from-scratch/' },
  { name: 'Manage Debt Effectively', href: '/courses/credit-fundamentals/managing-debt-effectively/' },
  { name: 'Credit Repair DIY vs Help', href: '/courses/credit-fundamentals/credit-repair-diy-vs-hiring-help/' },
  { name: 'Borrowing Smart', href: '/courses/credit-fundamentals/personal-loans-and-borrowing-smart/' },
  { name: 'Avoid Scams', href: '/courses/credit-fundamentals/avoiding-scams-and-predatory-lending/' },
  { name: 'Know Your Rights', href: '/courses/credit-fundamentals/know-your-rights/' },
];

const comparisonLinks = [
  { name: 'Small Business Loan Profiles', href: '/best/best-small-business-loans/' },
  { name: 'SBA Loan Profiles', href: '/best/best-sba-loans/' },
  { name: 'Personal Loan Lender Profiles', href: '/best/best-personal-loan-lenders/' },
  { name: 'Bad Credit Personal Loan Profiles', href: '/best/best-personal-loans-bad-credit/' },
  { name: 'Debt Consolidation Loan Profiles', href: '/best/best-debt-consolidation-loans/' },
  { name: 'Debt Relief Company Profiles', href: '/best/best-debt-relief-companies/' },
  { name: 'Credit Builder Loan Profiles', href: '/best/best-credit-builder-loans/' },
  { name: 'Secured Credit Card Profiles', href: '/best/best-secured-credit-cards/' },
  { name: 'Credit Repair Company Profiles', href: '/best/best-credit-repair-companies/' },
  { name: 'Credit Monitoring Profiles', href: '/best/best-credit-monitoring-services/' },
  { name: 'Cash Advance App Profiles', href: '/best/best-cash-advance-apps/' },
];
---

<footer class="border-t border-border bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
            <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/>
            <circle cx="20" cy="10" r="2"/>
          </svg>
          <span>CreditDoc</span>
        </a>
        <p class="mt-3 text-sm text-muted leading-relaxed">
          Consumer-finance profiles, local guides, public-data context, and comparison tools for researching credit repair, loans, and debt relief services.
        </p>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Categories</h3>
        <ul class="mt-4 space-y-3">
          {categoryLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Resources</h3>
        <ul class="mt-4 space-y-3">
          {resourceLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted hover:text-primary transition-colors" target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Quick Links</h3>
        <ul class="mt-4 space-y-3">
          <li><a href="/courses/credit-fundamentals/" class="text-sm text-muted hover:text-primary transition-colors">Free Credit Course</a></li>
          <li><a href="/tools/borrowing-power-quiz/" class="text-sm text-muted hover:text-primary transition-colors">Borrowing Power Quiz</a></li>
          <li><a href="/best/best-credit-repair-companies/" class="text-sm text-muted hover:text-primary transition-colors">Credit Repair Guide</a></li>
          <li><a href="/city/" class="text-sm text-muted hover:text-primary transition-colors">Browse by City</a></li>
          <li><a href="/search/" class="text-sm text-muted hover:text-primary transition-colors">Search by Location</a></li>
          <li><a href="/trends/" class="text-sm text-muted hover:text-primary transition-colors">Consumer Response Data</a></li>
          <li><a href="/deals/" class="text-sm text-muted hover:text-primary transition-colors">Current Deals</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-8 border-t border-border pt-8 lg:grid-cols-3">
      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Calculators and Quizzes</h3>
        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {toolLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Credit Course Modules</h3>
        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {courseLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Comparison Guides</h3>
        <ul class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {comparisonLinks.map(link => (
            <li>
              <a href={link.href} class="text-sm text-muted hover:text-primary transition-colors">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Affiliate Disclosure -->
    <div class="mt-10 rounded-lg bg-bg-alt p-4 border border-border">
      <p class="text-xs text-muted leading-relaxed">
        <strong class="text-text">Affiliate Disclosure:</strong> CreditDoc may earn a commission when you click on links to products and services featured on this site. These commissions help us maintain and improve our free research. Compensation does not determine whether a provider can be covered; visible star ratings use stored Google review ratings when available. <a href="/disclosure/" class="text-primary hover:underline">Learn more</a>.
      </p>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row">
      <p class="text-xs text-muted">
        &copy; {currentYear} CreditDoc. All rights reserved.
      </p>
      <div class="flex items-center gap-4">
        <a href="/privacy/" class="text-xs text-muted hover:text-primary transition-colors">Privacy</a>
        <span class="text-border">|</span>
        <a href="/terms/" class="text-xs text-muted hover:text-primary transition-colors">Terms</a>
        <span class="text-border">|</span>
        <a href="/disclosure/" class="text-xs text-muted hover:text-primary transition-colors">Disclosure</a>
        <span class="text-border">|</span>
        <a href="/do-not-sell/" class="text-xs text-muted hover:text-primary transition-colors">Do Not Sell</a>
        <span class="text-border">|</span>
        <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-muted hover:text-primary transition-colors">LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
