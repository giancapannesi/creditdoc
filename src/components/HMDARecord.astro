---
import type { HMDAData } from '../lib/db';

interface Props {
  data: HMDAData;
  lenderName: string;
}

const { data, lenderName } = Astro.props;
const { stats, geo } = data;

const fmt = (n: number) => n.toLocaleString('en-US');
const dollar = (n: number) => {
  if (n >= 1_000_000) return `$${(n / 1_000_000).toFixed(1)}M`;
  if (n >= 1_000) return `$${(n / 1_000).toFixed(0)}K`;
  return `$${n.toFixed(0)}`;
};

const denialReasons = stats.denial_reasons_json
  ? Object.values(JSON.parse(stats.denial_reasons_json) as Record<string, { reason: string; pct: number; count: number }>)
    .sort((a, b) => b.pct - a.pct)
    .slice(0, 5)
  : [];

const incomeTiers = [
  { label: 'Under $50K', apps: stats.income_under_50k_apps, rate: stats.income_under_50k_rate },
  { label: '$50K–$100K', apps: stats.income_50_100k_apps, rate: stats.income_50_100k_rate },
  { label: '$100K–$200K', apps: stats.income_100_200k_apps, rate: stats.income_100_200k_rate },
  { label: 'Over $200K', apps: stats.income_over_200k_apps, rate: stats.income_over_200k_rate },
].filter(t => t.apps > 0 && t.rate != null);

const stateNames: Record<string, string> = {
  AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',
  CO:'Colorado',CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',
  HI:'Hawaii',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',
  KS:'Kansas',KY:'Kentucky',LA:'Louisiana',ME:'Maine',MD:'Maryland',
  MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',MO:'Missouri',
  MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',
  NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',
  OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',
  SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',
  VA:'Virginia',WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming',
  DC:'District of Columbia',PR:'Puerto Rico',GU:'Guam',VI:'Virgin Islands',
};
---

<div class="glass-card p-6">
  <h2 class="text-xl font-bold text-text mb-4">Mortgage Lending Transparency</h2>
  <p class="text-sm text-muted mb-4">
    {lenderName} processed <span class="font-semibold text-text">{fmt(stats.total_applications)} mortgage applications</span> in {stats.year},
    approving <span class="font-semibold text-text">{stats.approval_rate}%</span> of applicants across {stats.states_served} states.
  </p>

  <!-- Key metrics -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
    <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
      <p class="text-2xl font-bold text-text">{fmt(stats.total_applications)}</p>
      <p class="text-xs text-muted mt-1">Applications</p>
    </div>
    <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
      <p class="text-2xl font-bold text-primary">{stats.approval_rate}%</p>
      <p class="text-xs text-muted mt-1">Approval Rate</p>
    </div>
    <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
      <p class="text-2xl font-bold text-text">{dollar(stats.avg_loan_amount)}</p>
      <p class="text-xs text-muted mt-1">Avg Loan</p>
    </div>
    <div class="rounded-lg bg-bg-alt border border-border p-3 text-center">
      <p class="text-2xl font-bold text-text">{stats.states_served}</p>
      <p class="text-xs text-muted mt-1">States Served</p>
    </div>
  </div>

  <!-- Approval by income tier -->
  {incomeTiers.length > 0 && (
    <div class="mb-5">
      <h3 class="text-sm font-semibold text-text mb-3">Approval Rate by Applicant Income</h3>
      <div class="space-y-2">
        {incomeTiers.map(tier => (
          <div class="flex items-center gap-3">
            <span class="text-xs text-muted w-24 shrink-0">{tier.label}</span>
            <div class="flex-1 bg-bg-alt rounded-full h-5 border border-border overflow-hidden">
              <div
                class="h-full rounded-full bg-primary/70"
                style={`width: ${Math.min(tier.rate!, 100)}%`}
              ></div>
            </div>
            <span class="text-sm font-semibold text-text w-14 text-right">{tier.rate}%</span>
          </div>
        ))}
      </div>
      <p class="text-xs text-muted mt-2">
        Based on {fmt(stats.total_applications)} applications. Income in thousands (reported by applicant).
      </p>
    </div>
  )}

  <!-- Denial reasons -->
  {denialReasons.length > 0 && stats.total_denied > 10 && (
    <div class="mb-5">
      <h3 class="text-sm font-semibold text-text mb-3">Top Denial Reasons ({fmt(stats.total_denied)} denied)</h3>
      <div class="space-y-1">
        {denialReasons.map(d => (
          <div class="flex items-center justify-between text-sm">
            <span class="text-muted">{d.reason}</span>
            <span class="text-text font-medium">{d.pct}%</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Top states -->
  {geo.length > 0 && (
    <div class="mb-4">
      <h3 class="text-sm font-semibold text-text mb-3">Top Lending States</h3>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {geo.slice(0, 6).map(g => (
          <div class="flex items-center justify-between text-sm rounded-lg bg-bg-alt border border-border px-3 py-2">
            <span class="text-muted">{stateNames[g.state_code] || g.state_code}</span>
            <span class="text-text font-medium">
              {fmt(g.total_applications)} apps · {g.approval_rate}%
            </span>
          </div>
        ))}
      </div>
    </div>
  )}

  <p class="text-xs text-muted/60 mt-4">
    Source: CFPB Home Mortgage Disclosure Act (HMDA) Data, {stats.year}. Applications include originated, approved, and denied loans.
  </p>
</div>
