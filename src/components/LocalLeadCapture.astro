---
interface Props {
  city: string;
  stateAbbr: string;
  stateName?: string;
  categorySlug?: string;
  categoryName?: string;
  routeFamily: 'city' | 'browse' | 'credit-guide';
  compact?: boolean;
  consumerRightsSummary?: string | null;
  usuryCap?: string | null;
  paydayLoanStatus?: string | null;
  consumerProtectionAgency?: string | null;
  consumerProtectionUrl?: string | null;
  licensingBoard?: string | null;
}

const {
  city,
  stateAbbr,
  stateName = stateAbbr,
  categorySlug = '',
  categoryName = '',
  routeFamily,
  compact = false,
  consumerRightsSummary = null,
  usuryCap = null,
  paydayLoanStatus = null,
  consumerProtectionAgency = null,
  consumerProtectionUrl = null,
  licensingBoard = null,
} = Astro.props;

const captureConfig: Record<string, { signupType: string; heading: string; body: string; button: string; secondaryHref: string; secondaryLabel: string }> = {
  'credit-repair': {
    signupType: 'local-credit-repair',
    heading: `Get the ${city} credit report checklist`,
    body: `Use it before comparing credit repair companies in ${city}. It helps you check reports, spot dispute issues, and avoid paying for the wrong next step.`,
    button: 'Send the checklist',
    secondaryHref: '/tools/credit-repair-qualify-quiz/',
    secondaryLabel: `${city} Credit Repair Quiz`,
  },
  'business-loans': {
    signupType: 'local-business-loans',
    heading: `Get the ${city} business funding prep list`,
    body: `Review documents, cash-flow pressure, credit range, and lender-fit questions before comparing business financing options in ${city}.`,
    button: 'Send the prep list',
    secondaryHref: '/tools/business-loan-readiness-quiz/',
    secondaryLabel: `${city} Business Loan Quiz`,
  },
  'personal-loans': {
    signupType: 'local-personal-loans',
    heading: `Get safer borrowing steps for ${city}`,
    body: `Use this before comparing personal loan profiles, emergency cash options, or short-term borrowing routes near ${city}.`,
    button: 'Send borrowing steps',
    secondaryHref: '/tools/borrowing-power-quiz/',
    secondaryLabel: `${city} Borrowing Power Quiz`,
  },
  'emergency-cash': {
    signupType: 'local-emergency-cash',
    heading: `Get safer short-term cash options in ${city}`,
    body: `Compare emergency cash, repayment pressure, and lower-cost alternatives before using a high-cost short-term product.`,
    button: 'Send safer options',
    secondaryHref: '/tools/borrowing-power-quiz/',
    secondaryLabel: `${city} Borrowing Power Quiz`,
  },
  'pawn-shops': {
    signupType: 'local-emergency-cash',
    heading: `Get safer pawn and cash options in ${city}`,
    body: `Use this before pledging property or comparing collateral-based cash options. It includes questions to ask before accepting terms.`,
    button: 'Send safer options',
    secondaryHref: '/tools/borrowing-power-quiz/',
    secondaryLabel: `${city} Short-Term Cash Quiz`,
  },
  'check-cashing': {
    signupType: 'local-emergency-cash',
    heading: `Get safer money-service steps for ${city}`,
    body: `Use this before comparing check-cashing, money transfer, or short-term cash options. Review fees, alternatives, and consumer-rights basics.`,
    button: 'Send the guide',
    secondaryHref: '/financial-wellness/',
    secondaryLabel: 'Read financial wellness guides',
  },
  'debt-relief': {
    signupType: 'local-debt-relief',
    heading: `Get the ${city} debt review checklist`,
    body: `Use this before contacting a debt relief company. Review balances, collection notices, counseling options, and state consumer protections.`,
    button: 'Send the checklist',
    secondaryHref: '/tools/debt-payoff-calculator/',
    secondaryLabel: 'Use the debt payoff calculator',
  },
  'banking': {
    signupType: 'local-banking',
    heading: `Get the ${city} banking comparison checklist`,
    body: `Compare fees, account access, credit-building paths, and local banking alternatives before choosing a provider.`,
    button: 'Send the checklist',
    secondaryHref: '/financial-wellness/',
    secondaryLabel: 'Read financial wellness guides',
  },
  'credit-unions': {
    signupType: 'local-banking',
    heading: `Get the ${city} credit union checklist`,
    body: `Review membership rules, fees, loan options, and credit-building features before choosing a credit union.`,
    button: 'Send the checklist',
    secondaryHref: '/financial-wellness/',
    secondaryLabel: 'Read financial wellness guides',
  },
};

const defaultConfig = {
  signupType: 'local-finance-guide',
  heading: `Save the ${city} local finance guide`,
  body: `Get a practical checklist for comparing local providers, ${stateName} rules, credit steps, and safer borrowing options in ${city}, ${stateAbbr}.`,
  button: 'Send the local guide',
  secondaryHref: '/tools/borrowing-power-quiz/',
  secondaryLabel: `${city} Borrowing Power Quiz`,
};

const config = captureConfig[categorySlug] || defaultConfig;
const formId = `local-capture-${routeFamily}-${categorySlug || 'city'}-${city.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const eyebrow = categoryName ? `${categoryName} in ${city}, ${stateAbbr}` : `${city}, ${stateAbbr}`;
const faqSubject = categoryName ? `${categoryName.toLowerCase()} in ${city}` : `financial services in ${city}`;
const faqHeading = categoryName ? `Frequently asked questions about ${categoryName.toLowerCase()} in ${city}` : `Frequently asked questions in ${city}`;
const hasLocalLawContext = Boolean(consumerRightsSummary || usuryCap || paydayLoanStatus || consumerProtectionAgency || licensingBoard);
const quizCards = categorySlug
  ? [
      [config.secondaryLabel, config.secondaryHref, 'Use the local context on this page with the matching CreditDoc tool.'],
      [`${city} Credit Calculator`, '/tools/credit-score-simulator/', 'Model broad credit-score factors before comparing providers.'],
    ]
  : [
      [`${city} Borrowing Power Quiz`, '/tools/borrowing-power-quiz/', 'Estimate a broad borrowing range before comparing options.'],
      [`${city} Credit Repair Quiz`, '/tools/credit-repair-qualify-quiz/', 'Check whether credit repair research or DIY credit steps may fit.'],
      [`${city} Credit Calculator`, '/tools/credit-score-simulator/', 'Model credit-score factors before contacting a provider.'],
      [`${city} Business Loan Quiz`, '/tools/business-loan-readiness-quiz/', 'Review funding readiness before comparing business lenders.'],
    ];
const faqs = [
  {
    q: categoryName ? `How should I compare ${categoryName.toLowerCase()} options in ${city}?` : `How should I compare financial services in ${city}?`,
    a: `Start with the local profiles, state rules, fees or terms where available, complaint context, and whether the provider fits your actual need. CreditDoc is educational research, not an approval decision or provider recommendation.`,
  },
  {
    q: `Does the ${config.secondaryLabel} affect my credit score?`,
    a: `No. CreditDoc tools and quizzes do not ask for a Social Security number, do not run a credit check, and do not contact lenders or credit bureaus.`,
  },
  {
    q: `Can CreditDoc tell me which ${city} provider will approve me?`,
    a: `No. Approval depends on the provider, your documents, credit profile, income, collateral, business history, and current underwriting rules. Use the page and tools to prepare better questions before contacting a company.`,
  },
  {
    q: `Why use a local ${city} page instead of a national list?`,
    a: `Local pages combine nearby provider profiles, ${stateName} consumer protections, category context, and related CreditDoc tools so you can research options with more location-specific context.`,
  },
];
---

<section class:list={[
  'local-lead-capture rounded-xl border border-primary/20 bg-white shadow-sm',
  compact ? 'p-4' : 'mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8',
]}>
  <div class:list={[compact ? '' : 'rounded-xl bg-primary-light/30 p-5 md:p-6']}>
    <div class="grid gap-5 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-primary">{eyebrow}</p>
        <h2 class:list={[compact ? 'mt-2 text-lg' : 'mt-2 text-2xl', 'font-bold text-text']}>{config.heading}</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">{config.body}</p>
        <a href={config.secondaryHref} class="mt-3 inline-block text-sm font-medium text-primary hover:underline">{config.secondaryLabel} &rarr;</a>
      </div>
      <form
        id={formId}
        class="local-lead-capture-form grid gap-3"
        data-signup-type={config.signupType}
        data-route-family={routeFamily}
        data-category={categorySlug || 'city'}
        data-city={city}
        data-state={stateAbbr}
      >
        <input type="text" name="company" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted">First name</span>
            <input name="name" type="text" autocomplete="given-name" class="w-full rounded-lg border border-border bg-white px-3 py-2 text-sm text-text outline-none focus:border-primary" />
          </label>
          <label class="block">
            <span class="mb-1 block text-xs font-medium text-muted">Email</span>
            <input name="email" type="email" required autocomplete="email" class="w-full rounded-lg border border-border bg-white px-3 py-2 text-sm text-text outline-none focus:border-primary" />
          </label>
        </div>
        <button type="submit" class="rounded-lg bg-primary px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-hover">
          {config.button}
        </button>
        <p class="local-lead-capture-status min-h-5 text-xs leading-relaxed text-muted" role="status" aria-live="polite">
          Educational follow-up only. This is not an application, quote, approval, or credit check.
        </p>
      </form>
    </div>
    <div class="mt-5 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
      {quizCards.map(([label, href, description]) => (
        <a href={href} class="rounded-lg border border-border bg-white p-3 text-sm text-primary transition-colors hover:border-primary/40 hover:bg-primary-light/20">
          <span class="block font-semibold">{label}</span>
          <span class="mt-1 block text-xs leading-relaxed text-muted">{description}</span>
        </a>
      ))}
    </div>
    {hasLocalLawContext && (
      <div class="mt-5 rounded-lg border border-primary/15 bg-white p-4">
        <h3 class="text-base font-bold text-text">{stateName} rules to check before choosing an option in {city}</h3>
        <div class="mt-3 grid gap-3 text-sm leading-relaxed text-muted md:grid-cols-2">
          {consumerRightsSummary && (
            <p><strong class="text-text">Consumer protection:</strong> {consumerRightsSummary}</p>
          )}
          {usuryCap && (
            <p><strong class="text-text">Rate context:</strong> {stateName} usury cap: {usuryCap}.</p>
          )}
          {paydayLoanStatus && (
            <p><strong class="text-text">Short-term lending:</strong> Payday loan status in {stateName}: {paydayLoanStatus}.</p>
          )}
          {consumerProtectionAgency && (
            <p>
              <strong class="text-text">Regulator:</strong>{' '}
              {consumerProtectionUrl
                ? <a href={consumerProtectionUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{consumerProtectionAgency}</a>
                : consumerProtectionAgency}
            </p>
          )}
          {licensingBoard && (
            <p><strong class="text-text">Finance department:</strong> {licensingBoard}.</p>
          )}
        </div>
        <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {consumerProtectionUrl && consumerProtectionAgency && (
            <a href={consumerProtectionUrl} target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
              {stateName} consumer complaints
            </a>
          )}
          <a href="/tools/state-consumer-credit-regulator-directory/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
            {stateName} finance regulator directory
          </a>
          <a href="https://www.consumerfinance.gov/complaint/" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
            CFPB complaint portal
          </a>
          <a href="https://www.annualcreditreport.com/" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
            Free credit reports
          </a>
        </div>
      </div>
    )}
    <div class="mt-5">
      <h3 class="text-base font-bold text-text">{faqHeading}</h3>
      <div class="mt-3 grid gap-3 md:grid-cols-2">
        {faqs.map((faq) => (
          <details class="rounded-lg border border-border bg-white p-3">
            <summary class="cursor-pointer text-sm font-semibold text-text">{faq.q}</summary>
            <p class="mt-2 text-sm leading-relaxed text-muted">{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (() => {
    const forms = document.querySelectorAll('.local-lead-capture-form:not([data-bound="true"])');
    forms.forEach((form) => {
      form.setAttribute('data-bound', 'true');
      const loadedAt = Date.now();
      const status = form.querySelector('.local-lead-capture-status');
      const emit = (name, params = {}) => {
        if (typeof (window as any).gtag === 'function') {
          (window as any).gtag('event', name, params);
        }
      };
      emit('local_lead_capture_view', {
        route_family: form.dataset.routeFamily,
        category: form.dataset.category,
        city: form.dataset.city,
        state: form.dataset.state,
      });
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const email = String(data.get('email') || '').trim();
        const name = String(data.get('name') || '').trim();
        const honeypot = String(data.get('company') || '').trim();
        const button = form.querySelector('button[type="submit"]');
        if (!email) return;
        button?.setAttribute('disabled', 'true');
        if (status) status.textContent = 'Sending...';
        emit('local_lead_capture_submit', {
          route_family: form.dataset.routeFamily,
          category: form.dataset.category,
          city: form.dataset.city,
          state: form.dataset.state,
        });
        try {
          const response = await fetch('/api/email-signup', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              email,
              name,
              honeypot,
              signup_type: form.dataset.signupType,
              source_page: window.location.pathname,
              elapsed_ms: Date.now() - loadedAt,
            }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.ok) throw new Error(result.error || 'Signup failed');
          if (status) status.textContent = 'Sent. Check your inbox for the CreditDoc follow-up.';
          form.reset();
          emit('local_lead_capture_success', {
            route_family: form.dataset.routeFamily,
            category: form.dataset.category,
            city: form.dataset.city,
            state: form.dataset.state,
          });
        } catch (error) {
          if (status) status.textContent = 'Could not save that email. Please try again in a moment.';
          emit('local_lead_capture_error', {
            route_family: form.dataset.routeFamily,
            category: form.dataset.category,
            city: form.dataset.city,
            state: form.dataset.state,
          });
        } finally {
          button?.removeAttribute('disabled');
        }
      });
    });
  })();
</script>
