---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
  jsonLd?: object;
  noindex?: boolean;
  publicResource?: boolean;
}

const {
  title: rawTitle,
  description: rawDesc,
  canonical,
  ogImage,
  ogType,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
  jsonLd,
  noindex,
  publicResource = false,
} = Astro.props;

function trimTitleAtWord(value: string, maxLength: number) {
  const cleaned = String(value || '').replace(/\s+/g, ' ').trim();
  if (cleaned.length <= maxLength) return cleaned;
  const truncated = cleaned.slice(0, maxLength).replace(/\s+\S*$/, '').trim();
  return truncated || cleaned.slice(0, maxLength).trim();
}

const TITLE_MAX_LENGTH = 60;

function normalizeTitle(value: string) {
  const cleaned = String(value || '').replace(/\s+/g, ' ').trim();
  const brandSuffix = ' | CreditDoc';
  if (cleaned.length <= TITLE_MAX_LENGTH) return cleaned;
  if (cleaned.endsWith(brandSuffix)) {
    const base = cleaned.slice(0, -brandSuffix.length).trim();
    if (base.length <= TITLE_MAX_LENGTH) return base;
    return trimTitleAtWord(base, TITLE_MAX_LENGTH);
  }
  return trimTitleAtWord(cleaned, TITLE_MAX_LENGTH);
}

const title = normalizeTitle(rawTitle);
const description = rawDesc.length > 160 ? rawDesc.slice(0, 157) + '...' : rawDesc;
const canonicalUrl = canonical || new URL(Astro.url.pathname, Astro.site).href;
const ogImg = ogImage || 'https://www.creditdoc.co/og-default.png';
const resolvedOgType = ogType || 'website';
const linkedinUrl = 'https://www.linkedin.com/company/creditdoc-co/';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="TnwnBl_kT6XgHUFwFmR5JstL3ebCSAQf6iuoFwI-A-0" />
  <meta name="msvalidate.01" content="4B5251D006A8437B1A0C7C45CB7C374D" />
  <meta name="fo-verify" content="0bd4cd1e-5a7d-47e5-976c-c250d846b8ee" />
  <meta name="impact-site-verification" value="df51c98d-280b-421a-85a8-0cf69f2fad48" />
  <meta name="p:domain_verify" content="bf5a253c11c084976f9375cfe1a363b0" />

  <!-- Google Analytics — Consent Mode v2: default-deny until cookie banner accepted. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      wait_for_update: 500,
    });
    try {
      var prior = localStorage.getItem('cd_consent');
      if (prior === 'granted') {
        gtag('consent', 'update', { analytics_storage: 'granted' });
      }
    } catch (e) {}
    gtag('js', new Date());
    gtag('config', 'G-ZBSCZ1GRXL');
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-ZBSCZ1GRXL"></script>

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" type="application/rss+xml" title="CreditDoc Blog RSS" href="https://www.creditdoc.co/rss.xml" />

  <!-- DNS prefetch for external resources -->
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://icons.duckduckgo.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content={resolvedOgType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImg} />
  <meta property="og:site_name" content="CreditDoc" />
  {resolvedOgType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  {resolvedOgType === 'article' && articleModifiedTime && (
    <meta property="article:modified_time" content={articleModifiedTime} />
  )}
  {resolvedOgType === 'article' && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {resolvedOgType === 'article' && articleSection && (
    <meta property="article:section" content={articleSection} />
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImg} />

  <!-- JSON-LD -->
  {jsonLd && (
    Array.isArray(jsonLd)
      ? jsonLd.map((item: any) => (
          <script type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      : <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )}
</head>
<body class="min-h-screen flex flex-col">
  {publicResource ? (
    <header class="border-b border-border bg-white">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl hover:opacity-90 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
            <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/>
            <circle cx="20" cy="10" r="2"/>
          </svg>
          <span>CreditDoc</span>
        </a>
        <div class="hidden items-center gap-6 md:flex">
          <a href="/resources/" class="text-sm font-medium text-text hover:text-primary">Resources</a>
          <a href="/financial-wellness/" class="text-sm font-medium text-text hover:text-primary">Wellness</a>
          <a href="/tools/" class="text-sm font-medium text-text hover:text-primary">Tools</a>
          <a href="/learn/" class="text-sm font-medium text-text hover:text-primary">Learn</a>
          <a href="/about/" class="text-sm font-medium text-text hover:text-primary">About</a>
          <a href="/contact/" class="text-sm font-medium text-text hover:text-primary">Contact</a>
        </div>
      </nav>
    </header>
  ) : (
    <Header />
  )}
  <main class="flex-1">
    <slot />
  </main>
  {publicResource ? (
    <footer class="border-t border-border bg-white">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <a href="/" class="flex items-center gap-2 text-primary font-bold text-xl">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
                <path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/>
                <circle cx="20" cy="10" r="2"/>
              </svg>
              <span>CreditDoc</span>
            </a>
            <p class="mt-3 text-sm leading-relaxed text-muted">
              Free consumer finance resources for educational use. Resource pages contain no affiliate links, no lead forms, and no paid placement.
            </p>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Education</h3>
            <ul class="mt-4 space-y-3">
              <li><a href="/resources/" class="text-sm text-muted hover:text-primary">Free Resources</a></li>
              <li><a href="/resources/credit-report-checklist/" class="text-sm text-muted hover:text-primary">Credit Report Checklist</a></li>
              <li><a href="/resources/loan-approval-readiness-toolkit/" class="text-sm text-muted hover:text-primary">Loan Readiness Toolkit</a></li>
              <li><a href="/financial-wellness/" class="text-sm text-muted hover:text-primary">Financial Wellness</a></li>
              <li><a href="/learn/" class="text-sm text-muted hover:text-primary">Learn Center</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Tools</h3>
            <ul class="mt-4 space-y-3">
              <li><a href="/tools/credit-score-simulator/" class="text-sm text-muted hover:text-primary">Credit Score Simulator</a></li>
              <li><a href="/tools/debt-payoff-calculator/" class="text-sm text-muted hover:text-primary">Debt Payoff Calculator</a></li>
              <li><a href="/tools/borrowing-power-quiz/" class="text-sm text-muted hover:text-primary">Borrowing Power Quiz</a></li>
              <li><a href="/glossary/" class="text-sm text-muted hover:text-primary">Glossary</a></li>
            </ul>
          </div>

          <div>
            <h3 class="text-sm font-semibold text-text uppercase tracking-wider">Company</h3>
            <ul class="mt-4 space-y-3">
              <li><a href="/about/" class="text-sm text-muted hover:text-primary">About</a></li>
              <li><a href="/contact/" class="text-sm text-muted hover:text-primary">Contact</a></li>
              <li><a href="/methodology/" class="text-sm text-muted hover:text-primary">Methodology</a></li>
              <li><a href="/editorial-policy/" class="text-sm text-muted hover:text-primary">Editorial Policy</a></li>
              <li><a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-muted hover:text-primary">LinkedIn</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 rounded-lg border border-border bg-bg-alt p-4">
          <p class="text-xs leading-relaxed text-muted">
            <strong class="text-text">Resource disclosure:</strong> CreditDoc resource pages are built for consumer education and may be used by libraries, universities, nonprofit educators, and public agencies as supplemental references. These resource pages do not contain affiliate links or lead forms. Other areas of CreditDoc may include commercial comparisons or affiliate-supported reviews.
          </p>
        </div>

        <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row">
          <p class="text-xs text-muted">
            &copy; {new Date().getFullYear()} CreditDoc. All rights reserved.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
            <a href="/privacy/" class="text-xs text-muted hover:text-primary">Privacy</a>
            <a href="/terms/" class="text-xs text-muted hover:text-primary">Terms</a>
            <a href="/disclaimer/" class="text-xs text-muted hover:text-primary">Disclaimer</a>
            <a href="/accessibility/" class="text-xs text-muted hover:text-primary">Accessibility</a>
            <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="text-xs text-muted hover:text-primary">LinkedIn</a>
          </div>
        </div>
      </div>
    </footer>
  ) : (
    <Footer />
  )}
  <CookieConsent />
</body>
</html>
