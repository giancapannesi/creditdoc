    </div>
  </section>

  <!-- Deals Grid -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="mb-6">
      <h2 class="text-xl sm:text-2xl font-bold text-text">Current deals</h2>
      <p class="mt-2 text-sm text-muted leading-relaxed">
        Offers from credit repair companies we have profiled. Click "Read profile" before redeeming so you can review provider context and current terms.
      </p>
    </div>
    {specials.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {specials.map(special => {
          const lender = getLenderBySlug(special.lender_slug);
          const bbbRating = lender ? normalizedBbbRating(lender.company_info.bbb_rating) : '';
          const bbbCls = lender ? getBbbClass(bbbRating) : '';
          return (
            <div class="glass-card p-6 flex flex-col">
              <!-- Header -->
              <div class="flex items-start gap-4 mb-4">
                <div class="w-12 h-12 rounded-xl bg-bg-alt border border-border flex items-center justify-center shrink-0 overflow-hidden">
