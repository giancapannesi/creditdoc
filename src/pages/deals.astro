                  ) : (
                    <span class="text-sm font-bold text-primary">{special.lender_name.charAt(0)}</span>
                  )}
                </div>
                <div class="min-w-0">
                  <h3 class="text-base font-semibold text-text">{special.lender_name}</h3>
