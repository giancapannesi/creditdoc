  <!-- Section C: Quick FAQ -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-text">Quick answers</h2>
