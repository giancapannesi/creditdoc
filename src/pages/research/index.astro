---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "CreditDoc Research Reports";
const description = "Original research and data reports on consumer lending, credit repair, and financial access in America.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "CreditDoc Research",
  "description": description,
  "url": "https://www.creditdoc.co/research/",
  "publisher": { "@type": "Organization", "name": "CreditDoc", "url": "https://www.creditdoc.co" }
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav class="max-w-4xl mx-auto px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li class="text-text font-medium">Research</li>
    </ol>
  </nav>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-text mb-3">Research</h1>
    <p class="text-lg text-muted max-w-2xl mb-8">
      Original data analysis and reports on consumer lending, credit access, and financial services in America.
    </p>

    <section class="glass-card p-5 mb-8">
      <h2 class="text-lg font-bold text-text mb-2">Use Research With the Directory</h2>
      <p class="text-sm text-muted leading-relaxed">
        CreditDoc research is designed to add context to local guides, state pages, provider categories, and borrower questions. These reports are data explainers, not recommendations, approval predictions, price quotes, or licensing determinations.
      </p>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/credit-guide/amarillo-tx/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Example local guide
        </a>
        <a href="/state/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          State lending context
        </a>
        <a href="/categories/personal-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Provider categories
        </a>
        <a href="/answers/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Borrower questions
        </a>
      </div>
    </section>

    <div class="space-y-4">
      <a href="/research/most-responsive-consumer-finance-providers-2026/" class="glass-card p-6 block hover:border-primary transition-all group">
        <span class="text-xs font-semibold text-primary uppercase tracking-wider">May 2026</span>
        <h2 class="text-xl font-bold text-text mt-2 group-hover:text-primary transition-colors">America's Most Responsive Consumer Finance Providers 2026</h2>
        <p class="text-muted mt-2">
          A positive-framed CFPB complaint-response analysis highlighting providers with strong timely-response records, consumer relief outcomes, and transparent public complaint histories.
        </p>
        <span class="text-sm text-primary mt-3 inline-block">Read the report &rarr;</span>
      </a>

      <a href="/research/lending-transparency/" class="glass-card p-6 block hover:border-primary transition-all group">
        <span class="text-xs font-semibold text-primary uppercase tracking-wider">May 2026</span>
        <h2 class="text-xl font-bold text-text mt-2 group-hover:text-primary transition-colors">Mortgage Application Outcomes by Bank</h2>
        <p class="text-muted mt-2">
          Analysis of 3.4 million mortgage applications from 2023 HMDA data. Compare recorded low-income application outcomes, income-based gaps, and public-data context by institution.
        </p>
        <span class="text-sm text-primary mt-3 inline-block">Read the report &rarr;</span>
      </a>

      <a href="/research/consumer-complaints/" class="glass-card p-6 block hover:border-primary transition-all group">
        <span class="text-xs font-semibold text-primary uppercase tracking-wider">May 2026</span>
        <h2 class="text-xl font-bold text-text mt-2 group-hover:text-primary transition-colors">Consumer Complaints: What Federal Data Reveals About Lenders</h2>
        <p class="text-muted mt-2">
          How CreditDoc uses 9.8 million CFPB consumer complaints to give you an independent picture of every lender's track record — complaint volume, response rates, enforcement actions, and what the numbers actually mean.
        </p>
        <span class="text-sm text-primary mt-3 inline-block">Read the report &rarr;</span>
      </a>

      <a href="/research/state-of-subprime-lending-2026/" class="glass-card p-6 block hover:border-primary transition-all group">
        <span class="text-xs font-semibold text-primary uppercase tracking-wider">March 2026</span>
        <h2 class="text-xl font-bold text-text mt-2 group-hover:text-primary transition-colors">State of Subprime Lending in America 2026</h2>
        <p class="text-muted mt-2">
          Analysis of 28,000+ consumer lending companies across 50 states. Examines credit access, payday lending regulations, poverty rates, and financial vulnerability state by state.
        </p>
        <span class="text-sm text-primary mt-3 inline-block">Read the report &rarr;</span>
      </a>
    </div>
  </div>
</BaseLayout>
