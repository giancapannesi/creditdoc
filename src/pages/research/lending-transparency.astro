---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface RuntimeEnv {
  SUPABASE_URL?: string;
  SUPABASE_ANON_KEY?: string;
}

const runtimeEnv = (Astro.locals as any)?.runtime?.env as RuntimeEnv | undefined;
const env: RuntimeEnv = {
  SUPABASE_URL: runtimeEnv?.SUPABASE_URL ?? import.meta.env.SUPABASE_URL ?? process.env.SUPABASE_URL,
  SUPABASE_ANON_KEY: runtimeEnv?.SUPABASE_ANON_KEY ?? import.meta.env.SUPABASE_ANON_KEY ?? process.env.SUPABASE_ANON_KEY,
};

interface LenderRow {
  slug: string;
  total_applications: number;
  total_originated: number;
  total_denied: number;
  approval_rate: number;
  avg_loan_amount: number;
  states_served: number;
  income_under_50k_apps: number;
  income_under_50k_rate: number | null;
  income_over_200k_apps: number;
  income_over_200k_rate: number | null;
  denial_reasons_json: string | null;
}

let allLenders: LenderRow[] = [];
let topApprovers: LenderRow[] = [];
let topDeniers: LenderRow[] = [];
let biggestGap: { slug: string; high_rate: number; low_rate: number; gap: number }[] = [];
let totalApps = 0;
let totalOriginated = 0;
let avgApproval = 0;
let lenderCount = 0;

if (env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY) {
  const headers = {
    apikey: env.SUPABASE_ANON_KEY,
    authorization: `Bearer ${env.SUPABASE_ANON_KEY}`,
    accept: 'application/json',
  };
  const base = env.SUPABASE_URL;

  const res = await fetch(
    `${base}/rest/v1/hmda_lender_stats?total_applications=gte.500&select=slug,total_applications,total_originated,total_denied,approval_rate,avg_loan_amount,states_served,income_under_50k_apps,income_under_50k_rate,income_over_200k_apps,income_over_200k_rate,denial_reasons_json&order=total_applications.desc&limit=2000`,
    { headers, signal: AbortSignal.timeout(5000) }
  ).catch(() => null);

  if (res?.ok) {
    allLenders = await res.json();
    lenderCount = allLenders.length;
    totalApps = allLenders.reduce((s, l) => s + l.total_applications, 0);
    totalOriginated = allLenders.reduce((s, l) => s + l.total_originated, 0);
    avgApproval = lenderCount > 0 ? Math.round(allLenders.reduce((s, l) => s + l.approval_rate, 0) / lenderCount * 10) / 10 : 0;

    // Higher recorded low-income approval-rate records (min 1000 apps, min 100 low-income apps)
    topApprovers = allLenders
      .filter(l => l.total_applications >= 1000 && l.income_under_50k_apps >= 100 && l.income_under_50k_rate != null)
      .sort((a, b) => (b.income_under_50k_rate || 0) - (a.income_under_50k_rate || 0))
      .slice(0, 15);

    // Lower recorded low-income approval-rate records (min 1000 apps)
    topDeniers = allLenders
      .filter(l => l.total_applications >= 1000 && l.income_under_50k_apps >= 100 && l.income_under_50k_rate != null)
      .sort((a, b) => (a.income_under_50k_rate || 0) - (b.income_under_50k_rate || 0))
      .slice(0, 15);

    // Largest recorded gap between high-income and low-income approval rates
    biggestGap = allLenders
      .filter(l => l.income_under_50k_rate != null && l.income_over_200k_rate != null && l.income_under_50k_apps >= 100 && l.income_over_200k_apps >= 100)
      .map(l => ({
        slug: l.slug,
        high_rate: l.income_over_200k_rate!,
        low_rate: l.income_under_50k_rate!,
        gap: l.income_over_200k_rate! - l.income_under_50k_rate!,
      }))
      .sort((a, b) => b.gap - a.gap)
      .slice(0, 15);
  }
}

const fmt = (n: number) => n.toLocaleString('en-US');
const slugToName = (slug: string) => slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase());

const title = "Mortgage Application Outcomes by Bank | CreditDoc";
const description = "Analysis of 3.4 million mortgage applications from 2023 HMDA data. See recorded low-income application outcomes and income-based outcome gaps by institution.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Mortgage Application Outcomes by Bank: A Transparency Report",
  "description": description,
  "author": { "@type": "Organization", "name": "CreditDoc" },
  "publisher": { "@type": "Organization", "name": "CreditDoc", "url": "https://www.creditdoc.co" },
  "datePublished": "2026-05-16",
  "url": "https://www.creditdoc.co/research/lending-transparency/"
};
---

<BaseLayout title={title} description={description} jsonLd={[jsonLd]}>
  <main class="max-w-4xl mx-auto px-4 py-10">
    <!-- Header -->
    <nav class="mb-6 text-sm text-muted">
      <a href="/" class="hover:text-primary">Home</a>
      <span class="mx-2">/</span>
      <a href="/research/" class="hover:text-primary">Research</a>
      <span class="mx-2">/</span>
      <span class="text-text">Lending Transparency</span>
    </nav>

    <h1 class="text-3xl sm:text-4xl font-bold text-text mb-4">
      Mortgage Application Outcomes by Bank
    </h1>
    <p class="text-lg text-muted mb-8">
      We analyzed <span class="text-text font-semibold">{fmt(totalApps)} mortgage applications</span> across {fmt(lenderCount)} institutions using 2023 HMDA data from the Consumer Financial Protection Bureau. Here's what the public data shows about recorded approval outcomes.
    </p>

    <!-- Key Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-10">
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-text">{fmt(totalApps)}</p>
        <p class="text-xs text-muted mt-1">Applications Analyzed</p>
      </div>
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-primary">{avgApproval}%</p>
        <p class="text-xs text-muted mt-1">Average Recorded Approval Rate</p>
      </div>
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-text">{fmt(lenderCount)}</p>
        <p class="text-xs text-muted mt-1">Institutions Tracked</p>
      </div>
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-text">{fmt(totalOriginated)}</p>
        <p class="text-xs text-muted mt-1">Loans Originated</p>
      </div>
    </div>

    <section class="glass-card p-6 mb-10">
      <h2 class="text-xl font-bold text-text mb-3">Use HMDA Data With Other CreditDoc Context</h2>
      <p class="text-sm text-muted leading-relaxed">
        HMDA approval data is one public-data signal. Use it with lender profiles, mortgage category pages, state and local research, and borrower questions. It is not a recommendation, approval prediction, price quote, or licensing determination.
      </p>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/categories/mortgages/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Mortgage providers
        </a>
        <a href="/state/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          State lending context
        </a>
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Local guides
        </a>
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          CFPB complaint data
        </a>
      </div>
    </section>

    <!-- Section 1: Low-income approval-rate records -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-text mb-2">Low-Income Approval Rate Records</h2>
      <p class="text-sm text-muted mb-4">
        These institutions show higher recorded approval rates for applicants reporting income under $50,000 in the HMDA file. Minimum 1,000 total applications and 100 low-income applications required.
      </p>
      {topApprovers.length > 0 && (
        <div class="glass-card p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-2 pr-3 text-muted font-medium">#</th>
                <th class="text-left py-2 pr-3 text-muted font-medium">Lender</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Low-Income Rate</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Overall Rate</th>
                <th class="text-center py-2 pl-2 text-muted font-medium">Total Apps</th>
              </tr>
            </thead>
            <tbody>
              {topApprovers.map((l, i) => (
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3 text-muted">{i + 1}</td>
                  <td class="py-2 pr-3">
                    <a href={`/review/${l.slug}/`} class="text-primary hover:underline font-medium">
                      {slugToName(l.slug)}
                    </a>
                  </td>
                  <td class="text-center py-2 px-2">
                    <span class="font-bold text-positive">{l.income_under_50k_rate}%</span>
                  </td>
                  <td class="text-center py-2 px-2 text-text">{l.approval_rate}%</td>
                  <td class="text-center py-2 pl-2 text-muted">{fmt(l.total_applications)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Section 2: Lower recorded approval-rate records for low-income applicants -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-text mb-2">Lower Low-Income Approval Rate Records</h2>
      <p class="text-sm text-muted mb-4">
        These institutions show lower recorded approval rates for applicants reporting income under $50,000 in the HMDA file. This does not necessarily indicate discrimination because lenders serve different markets, products, and borrower profiles.
      </p>
      {topDeniers.length > 0 && (
        <div class="glass-card p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-2 pr-3 text-muted font-medium">#</th>
                <th class="text-left py-2 pr-3 text-muted font-medium">Lender</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Low-Income Rate</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Overall Rate</th>
                <th class="text-center py-2 pl-2 text-muted font-medium">Total Apps</th>
              </tr>
            </thead>
            <tbody>
              {topDeniers.map((l, i) => (
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3 text-muted">{i + 1}</td>
                  <td class="py-2 pr-3">
                    <a href={`/review/${l.slug}/`} class="text-primary hover:underline font-medium">
                      {slugToName(l.slug)}
                    </a>
                  </td>
                  <td class="text-center py-2 px-2">
                    <span class="font-bold text-red-400">{l.income_under_50k_rate}%</span>
                  </td>
                  <td class="text-center py-2 px-2 text-text">{l.approval_rate}%</td>
                  <td class="text-center py-2 pl-2 text-muted">{fmt(l.total_applications)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Section 3: Biggest Income Gap -->
    <section class="mb-12">
      <h2 class="text-2xl font-bold text-text mb-2">Largest Recorded Approval-Rate Gaps by Income</h2>
      <p class="text-sm text-muted mb-4">
        The largest recorded difference between approval rates for high-income (over $200K) and low-income (under $50K) applicants at the same institution. A larger gap shows a stronger income-based pattern in this public dataset, not a prediction for any individual applicant.
      </p>
      {biggestGap.length > 0 && (
        <div class="glass-card p-4 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-border">
                <th class="text-left py-2 pr-3 text-muted font-medium">#</th>
                <th class="text-left py-2 pr-3 text-muted font-medium">Lender</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Over $200K</th>
                <th class="text-center py-2 px-2 text-muted font-medium">Under $50K</th>
                <th class="text-center py-2 pl-2 text-muted font-medium">Gap</th>
              </tr>
            </thead>
            <tbody>
              {biggestGap.map((l, i) => (
                <tr class="border-b border-border/50">
                  <td class="py-2 pr-3 text-muted">{i + 1}</td>
                  <td class="py-2 pr-3">
                    <a href={`/review/${l.slug}/`} class="text-primary hover:underline font-medium">
                      {slugToName(l.slug)}
                    </a>
                  </td>
                  <td class="text-center py-2 px-2 text-positive">{l.high_rate}%</td>
                  <td class="text-center py-2 px-2 text-red-400">{l.low_rate}%</td>
                  <td class="text-center py-2 pl-2">
                    <span class="font-bold text-text">{l.gap.toFixed(1)}pp</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>

    <!-- Methodology -->
    <section class="glass-card p-6 mb-8">
      <h2 class="text-xl font-bold text-text mb-3">Methodology</h2>
      <ul class="space-y-2 text-sm text-muted">
        <li><span class="text-text font-medium">Data source:</span> CFPB Home Mortgage Disclosure Act (HMDA) Snapshot, 2023</li>
        <li><span class="text-text font-medium">Applications counted:</span> Originated (action_taken=1), approved not accepted (2), denied (3), and preapproval denied (7)</li>
        <li><span class="text-text font-medium">Approval rate:</span> (Originated + Approved not accepted) / Total applications × 100</li>
        <li><span class="text-text font-medium">Income tiers:</span> Based on applicant-reported income in thousands. Under $50K = income field &lt; 50</li>
        <li><span class="text-text font-medium">Minimum thresholds:</span> 500+ total applications for inclusion; 100+ low-income applications for income-tier rankings</li>
        <li><span class="text-text font-medium">Institutions:</span> Matched via LEI (Legal Entity Identifier) from the HMDA panel file to our lender directory using FDIC cert and name-based entity resolution</li>
      </ul>
    </section>

    <!-- CTA -->
    <div class="text-center">
      <p class="text-muted mb-4">Look up recorded lender outcome context on available profile pages.</p>
      <a href="/" class="inline-block px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:opacity-90 transition-opacity">
        Search Lenders
      </a>
    </div>

    <p class="text-xs text-muted/50 text-center mt-8">
      Last updated: May 2026. Data reflects 2023 HMDA filings. CreditDoc is not affiliated with CFPB or any listed institution.
    </p>
  </main>
</BaseLayout>
