---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import LenderCard from '../../components/LenderCard.astro';
import { getBrandInfoRuntime, shapeBodyInlineToLender, getGlossaryTermsForContextRuntime } from '../../utils/data-runtime';
import { createLinker } from '../../utils/inline-linker';
import { getLendersByBrandRuntime } from '../../lib/db';
import { softenEducationalTeaserCopy } from '../../utils/safe-copy';
import type { Lender } from '../../utils/data';

const env = (Astro.locals as any).runtime?.env;
const { brand: brandSlug } = Astro.params;

const [brandInfo, lenderRows] = await Promise.all([
  getBrandInfoRuntime(brandSlug!, env),
  getLendersByBrandRuntime(brandSlug!, env),
]);

if (!brandInfo) {
  return new Response('Not found', { status: 404 });
}

const lenders: Lender[] = lenderRows.map(shapeBodyInlineToLender);
const locationCount = lenders.length;

Astro.response.headers.set('cache-control', 'public, max-age=86400, s-maxage=86400');
Astro.response.headers.set('x-cdm-rev-source', 'ssr-brand');

// Group lenders by state
const byState = new Map<string, Lender[]>();
for (const l of lenders) {
  const state = l.company_info?.state || 'Unknown';
  if (!byState.has(state)) byState.set(state, []);
  byState.get(state)!.push(l);
}

// Sort states alphabetically
const sortedStates = Array.from(byState.keys()).sort();

// Compute stats
const statesCount = sortedStates.length;

// Aggregate lender data for brand overview. Public star ratings use stored Google data only.
const googleRatings = lenders
  .map(l => ({ rating: l.google_rating, count: l.google_reviews_count }))
  .filter(({ rating, count }) => rating && rating > 0 && !(rating > 5) && count && count >= 1);
const avgGoogleRating = googleRatings.length > 0
  ? (googleRatings.reduce((sum, item) => sum + item.rating!, 0) / googleRatings.length)
  : 0;

const allServices = new Set<string>();
const allPros = new Map<string, number>();
const allCons = new Map<string, number>();
let hasFreeConsultation = false;
let companyHeadquarters = '';
let companyFounded = 0;
let bbbRating = '';
let phoneNumber = '';

for (const l of lenders) {
  if (l.services) l.services.forEach(s => allServices.add(s));
  if (l.pros) l.pros.forEach(p => allPros.set(p, (allPros.get(p) || 0) + 1));
  if (l.cons) l.cons.forEach(c => allCons.set(c, (allCons.get(c) || 0) + 1));
  if (l.pricing?.free_consultation) hasFreeConsultation = true;
  if (!companyHeadquarters && l.company_info?.headquarters) companyHeadquarters = l.company_info.headquarters;
  if (!companyFounded && l.company_info?.founded_year) companyFounded = l.company_info.founded_year;
  if (!bbbRating && l.company_info?.bbb_rating && l.company_info.bbb_rating !== 'NR') bbbRating = l.company_info.bbb_rating;
  if (!phoneNumber && l.phone) phoneNumber = l.phone;
}

const topPros = [...allPros.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5).map(e => e[0]);
const topCons = [...allCons.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(e => e[0]);
const servicesList = [...allServices].sort();

// Fetch related questions and blog posts by category
const category = brandInfo.category;
let relatedQuestions: { slug: string; title: string }[] = [];
let relatedPosts: { slug: string; title: string }[] = [];

if (env?.SUPABASE_URL && env?.SUPABASE_ANON_KEY) {
  const headers = { apikey: env.SUPABASE_ANON_KEY, authorization: `Bearer ${env.SUPABASE_ANON_KEY}`, accept: 'application/json' };
  const [qRes, bRes] = await Promise.all([
    fetch(`${env.SUPABASE_URL}/rest/v1/answers?cluster_pillar=eq.${encodeURIComponent(category)}&select=slug,title&limit=6`, { headers, signal: AbortSignal.timeout(3000) }).catch(() => null),
    fetch(`${env.SUPABASE_URL}/rest/v1/blog_posts?category=eq.${encodeURIComponent(category)}&select=slug,title&limit=6`, { headers, signal: AbortSignal.timeout(3000) }).catch(() => null),
  ]);
  if (qRes?.ok) relatedQuestions = await qRes.json();
  if (bRes?.ok) relatedPosts = await bRes.json();
}
const displayRelatedQuestions = relatedQuestions.map((q) => ({
  ...q,
  title: softenEducationalTeaserCopy(q.title.replace(/ \| CreditDoc$/, '')),
}));
const displayRelatedPosts = relatedPosts.map((post) => ({
  ...post,
  title: softenEducationalTeaserCopy(post.title),
}));

const glossaryTerms = getGlossaryTermsForContextRuntime(['brand']);
const linker = createLinker(glossaryTerms, { moneyBudget: 5, glossaryBudget: 5 });
const linkedSummary = brandInfo.summary_long
  ? brandInfo.summary_long.split('\n\n').map((para: string) => linker(para).join(' '))
  : [];
const linkedFaq = (brandInfo.faq || []).map((item: { q: string; a: string }) => ({
  q: item.q,
  a: linker(item.a).join(' '),
}));

// Build JSON-LD
const canonicalUrl = `https://www.creditdoc.co/brand/${brandSlug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: brandInfo.display_name,
    url: brandInfo.official_website ?? undefined,
    description: brandInfo.summary_short,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: `${brandInfo.display_name} Locations`,
    description: `Browse all ${locationCount} ${brandInfo.display_name} locations across ${statesCount} states.`,
    url: canonicalUrl,
    numberOfItems: locationCount,
    provider: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Brands', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 3, name: brandInfo.display_name, item: canonicalUrl },
    ],
  },
];

const title = `${brandInfo.display_name} Locations — Find Your Nearest Branch | CreditDoc`;
const description = `Browse all ${locationCount} ${brandInfo.display_name} locations across ${statesCount} states. Find hours, addresses, and contact info for each branch.`;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs -->
  <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/" class="hover:text-primary transition-colors">Brands</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-text font-medium">{brandInfo.display_name}</li>
    </ol>
  </nav>

  <!-- Header -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="lg:flex lg:gap-10">
      <!-- Main content -->
      <div class="flex-1">
        <h1 class="text-2xl sm:text-3xl font-bold text-text">
          {brandInfo.display_name} Locations
        </h1>
        <p class="mt-3 text-muted leading-relaxed">
          {brandInfo.summary_short}
        </p>

        <!-- Stats bar -->
        <div class="mt-5 flex flex-wrap gap-3">
          {avgGoogleRating > 0 && (
            <div class="glass-card px-4 py-2 text-sm flex items-center gap-1.5">
              <span class="text-yellow-400 text-base">&#9733;</span>
              <span class="font-semibold text-text">{avgGoogleRating.toFixed(1)}</span>
              <span class="text-muted">avg Google rating across {googleRatings.length} location{googleRatings.length === 1 ? '' : 's'}</span>
            </div>
          )}
          <div class="glass-card px-4 py-2 text-sm">
            <span class="font-semibold text-text">{locationCount}</span>
            <span class="text-muted ml-1">locations</span>
          </div>
          <div class="glass-card px-4 py-2 text-sm">
            <span class="font-semibold text-text">{statesCount}</span>
            <span class="text-muted ml-1">states</span>
          </div>
          {servicesList.length > 0 && (
            <div class="glass-card px-4 py-2 text-sm">
              <span class="font-semibold text-text">{servicesList.length}</span>
              <span class="text-muted ml-1">services</span>
            </div>
          )}
          <div class="glass-card px-4 py-2 text-sm">
            <span class="text-muted">Category:</span>
            <a
              href={`/categories/${brandInfo.category}/`}
              class="ml-1 font-semibold text-primary hover:underline"
            >
              {brandInfo.category.replace(/-/g, ' ')}
            </a>
          </div>
          {hasFreeConsultation && (
            <div class="glass-card px-4 py-2 text-sm text-green-400 font-medium">
              Free Consultation
            </div>
          )}
        </div>

        <!-- Services offered -->
        {servicesList.length > 0 && (
          <div class="mt-6 glass-card p-5">
            <h2 class="text-lg font-semibold text-text mb-3">Services Offered</h2>
            <div class="flex flex-wrap gap-2">
              {servicesList.map(service => (
                <span class="px-3 py-1.5 text-sm rounded-full bg-surface text-muted border border-border">
                  {service}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Pros and Cons -->
        {(topPros.length > 0 || topCons.length > 0) && (
          <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
            {topPros.length > 0 && (
              <div class="glass-card p-5">
                <h2 class="text-lg font-semibold text-text mb-3 flex items-center gap-2">
                  <span class="text-green-400">&#10003;</span> Strengths
                </h2>
                <ul class="space-y-2">
                  {topPros.map(pro => (
                    <li class="text-sm text-muted flex gap-2">
                      <span class="text-green-400 flex-shrink-0 mt-0.5">+</span>
                      <span>{pro}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {topCons.length > 0 && (
              <div class="glass-card p-5">
                <h2 class="text-lg font-semibold text-text mb-3 flex items-center gap-2">
                  <span class="text-red-400">&#10007;</span> Things to Consider
                </h2>
                <ul class="space-y-2">
                  {topCons.map(con => (
                    <li class="text-sm text-muted flex gap-2">
                      <span class="text-red-400 flex-shrink-0 mt-0.5">&ndash;</span>
                      <span>{con}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        )}

        <!-- Company info -->
        {(companyHeadquarters || companyFounded || bbbRating || phoneNumber) && (
          <div class="mt-6 glass-card p-5">
            <h2 class="text-lg font-semibold text-text mb-3">Company Details</h2>
            <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
              {companyFounded > 0 && (
                <div>
                  <dt class="text-muted">Founded</dt>
                  <dd class="font-semibold text-text mt-0.5">{companyFounded}</dd>
                </div>
              )}
              {companyHeadquarters && (
                <div class="col-span-2">
                  <dt class="text-muted">Headquarters</dt>
                  <dd class="font-semibold text-text mt-0.5">{companyHeadquarters}</dd>
                </div>
              )}
              {bbbRating && (
                <div>
                  <dt class="text-muted">BBB Rating</dt>
                  <dd class="font-semibold text-text mt-0.5">{bbbRating}</dd>
                </div>
              )}
              {phoneNumber && (
                <div>
                  <dt class="text-muted">Phone</dt>
                  <dd class="font-semibold text-text mt-0.5">
                    <a href={`tel:${phoneNumber}`} class="text-primary hover:underline">{phoneNumber}</a>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        )}

        <!-- State-grouped locations -->
        <div class="mt-8 space-y-4">
          {sortedStates.map(state => {
            const stateLenders = byState.get(state)!;
            return (
              <details class="glass-card" open={sortedStates.indexOf(state) < 3}>
                <summary class="cursor-pointer px-4 py-3 flex items-center justify-between">
                  <span class="font-semibold text-text">
                    {state}
                    <span class="ml-2 text-sm font-normal text-muted">
                      ({stateLenders.length} {stateLenders.length === 1 ? 'location' : 'locations'})
                    </span>
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-4 pb-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-2">
                  {stateLenders.map(lender => (
                    <LenderCard lender={lender} />
                  ))}
                </div>
              </details>
            );
          })}
        </div>
      </div>

      <!-- Sidebar -->
      <aside class="mt-8 lg:mt-0 lg:w-72 flex-shrink-0">
        <div class="glass-card p-5 space-y-4">
          <h2 class="text-base font-semibold text-text">About {brandInfo.display_name}</h2>
          <div class="text-sm text-muted leading-relaxed prose prose-sm max-w-none">
            {linkedSummary.length > 0
              ? linkedSummary.map((html: string) => <p set:html={html} />)
              : brandInfo.summary_long.split('\n\n').map((para: string) => <p>{para}</p>)
            }
          </div>
          {brandInfo.official_website && (
            <a
              href={brandInfo.official_website}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline"
            >
              Official website
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          )}
          {brandInfo.parent_company && (
            <p class="text-xs text-muted">
              Parent company: <span class="font-medium text-text">{brandInfo.parent_company}</span>
            </p>
          )}
          <div class="pt-2 border-t border-border">
            <a
              href={`/categories/${brandInfo.category}/`}
              class="text-sm text-primary hover:underline"
            >
              Browse all {brandInfo.category.replace(/-/g, ' ')} companies
            </a>
          </div>
        </div>

        <!-- FAQ -->
        {brandInfo.faq && brandInfo.faq.length > 0 && (
          <div class="glass-card p-5 mt-4 space-y-3">
            <h2 class="text-base font-semibold text-text">Common Questions</h2>
            <dl class="space-y-4">
              {linkedFaq.map((item: { q: string; a: string }) => (
                <div>
                  <dt class="text-sm font-medium text-text">{item.q}</dt>
                  <dd class="mt-1 text-sm text-muted" set:html={item.a} />
                </div>
              ))}
            </dl>
          </div>
        )}
      </aside>
    </div>
  </section>

  <!-- Related Questions -->
  {displayRelatedQuestions.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="glass-card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-text">
            Questions About {brandInfo.category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
          </h2>
          <a href="/answers/" class="text-sm text-primary hover:underline">View all questions &rarr;</a>
        </div>
        <p class="text-sm text-muted mb-4">
          Get answers to common questions about {brandInfo.display_name} and {brandInfo.category.replace(/-/g, ' ')} in general.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {displayRelatedQuestions.map(q => (
            <a
              href={`/answers/${q.slug}/`}
              class="glass-card p-4 block hover:border-primary transition-colors group"
            >
              <span class="text-sm font-medium text-text group-hover:text-primary transition-colors">
                {q.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CreditDoc Context -->
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="glass-card p-6">
      <h2 class="text-lg font-semibold text-text mb-4">Use This Brand Page With CreditDoc Context</h2>
      <p class="text-sm text-muted leading-relaxed mb-4">
        Brand pages collect known locations for one company. Pair them with local guides, state rules, category pages, and public complaint-data context before relying on a listing.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">City Guides</span>
          <span class="mt-1 block text-xs text-muted">Local provider lists, maps, and regional context.</span>
        </a>
        <a href="/state/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">State Rules</span>
          <span class="mt-1 block text-xs text-muted">State lending-law and regulator context.</span>
        </a>
        <a href={`/categories/${brandInfo.category}/`} class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Category Context</span>
          <span class="mt-1 block text-xs text-muted">Compare this brand with other providers in the same category.</span>
        </a>
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Complaint Data</span>
          <span class="mt-1 block text-xs text-muted">Use CFPB complaint patterns as one research input.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Related Blog Posts -->
  {displayRelatedPosts.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
      <div class="glass-card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-text">
            Learn More About {brandInfo.category.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
          </h2>
          <a href="/blog/" class="text-sm text-primary hover:underline">Browse all articles &rarr;</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {displayRelatedPosts.map(post => (
            <a
              href={`/blog/${post.slug}/`}
              class="glass-card p-4 block hover:border-primary transition-colors group"
            >
              <span class="text-sm font-medium text-text group-hover:text-primary transition-colors">
                {post.title}
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
