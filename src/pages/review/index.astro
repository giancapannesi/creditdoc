---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import categories from '../../content/categories.json';

const priorityCategorySlugs = [
  'credit-repair',
  'personal-loans',
  'debt-relief',
  'credit-monitoring',
  'business-loans',
  'credit-cards',
  'credit-unions',
  'banking',
  'check-cashing',
  'pawn-shops',
  'mortgages',
  'free-help',
];

const categoryLookup = new Map(categories.map((category) => [category.slug, category]));
const priorityCategories = priorityCategorySlugs
  .map((slug) => categoryLookup.get(slug))
  .filter(Boolean);

const title = 'Financial Service Reviews and Research | CreditDoc';
const description =
  'Browse CreditDoc research hubs for credit repair, loans, credit cards, banking, financial wellness, tools, answers, and local financial services.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Financial Service Reviews and Research',
    description,
    url: 'https://www.creditdoc.co/review/',
    publisher: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Reviews', item: 'https://www.creditdoc.co/review/' },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical="https://www.creditdoc.co/review/" jsonLd={jsonLd}>
  <nav class="mx-auto max-w-6xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li class="font-medium text-text">Reviews</li>
    </ol>
  </nav>

  <section class="border-b border-border bg-white">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:py-16">
      <p class="mb-4 text-xs font-semibold uppercase tracking-wider text-primary">CreditDoc Research Hub</p>
      <div class="max-w-3xl">
        <h1 class="text-3xl font-bold text-text sm:text-5xl">Financial Service Reviews</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Browse provider research by product type, location, educational guide, and comparison tool. CreditDoc organizes public financial-service information so borrowers can compare options before applying.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {priorityCategories.map((category) => (
        <a href={`/categories/${category.slug}/`} class="rounded-lg border border-border bg-white p-5 transition-all hover:border-primary hover:shadow-sm">
          <h2 class="text-lg font-semibold text-text">{category.name}</h2>
          <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{category.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-bg-alt">
    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-4 px-4 py-12 md:grid-cols-2 lg:grid-cols-4">
      <a href="/best/best-credit-repair-companies/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Best Credit Repair</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Compare major credit repair services, pricing signals, guarantees, and fit.</p>
      </a>
      <a href="/best/best-personal-loan-lenders/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Best Personal Loans</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Review personal loan lender options by credit profile, cost, and borrower needs.</p>
      </a>
      <a href="/tools/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Free Tools</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Use calculators and quizzes for credit, borrowing power, SBA costs, and debt payoff planning.</p>
      </a>
      <a href="/answers/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Finance Answers</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Find direct answers to credit, loans, debt, cards, and financial wellness questions.</p>
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
      <a href="/financial-wellness/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Financial Wellness Guides</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Learn practical credit, budgeting, borrowing, and debt habits.</p>
      </a>
      <a href="/city/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Browse by City</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Find local financial-service research across major cities.</p>
      </a>
      <a href="/state/" class="rounded-lg border border-border bg-white p-5 hover:border-primary">
        <h2 class="font-semibold text-text">Browse by State</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted">Review state-level lending context, consumer rights, and local provider signals.</p>
      </a>
    </div>
  </section>
</BaseLayout>
