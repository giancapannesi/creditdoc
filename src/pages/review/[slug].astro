  'compramos-todo-tipo-de-carros': '/categories/personal-loans/',
  'used-cars-for-sale-miami-financing-available-auto-dealer': '/credit-guide/miami-fl/personal-loans/',
  'auto-savings': '/categories/personal-loans/',
  'thinksmart-financial': '/categories/personal-loans/',
  '3f-auto-sales-llc-albuquerque-nm': '/credit-guide/albuquerque-nm/personal-loans/',
  'atkins-auto': '/categories/personal-loans/',
  'az-debt-relief-group': '/categories/debt-relief/',
  'argus-check-cashing-inside-danys-supermarket': '/categories/check-cashing/',
  'midtown-gold-and-silver-buyers': '/categories/pawn-shops/',
  'flat-rate-auto-outlet': '/categories/personal-loans/',
  'pjs-auto-sales': '/categories/personal-loans/',
  'hall-pre-owned-express-and-buying-center': '/categories/personal-loans/',
  'star-motor-express-auto-sales': '/categories/personal-loans/',
  'a2z-express-mart': '/categories/check-cashing/',
  'direct-motorsport-of-virginia-beach': '/credit-guide/virginia-beach-va/personal-loans/',
  '1st-budget-car-outlet': '/categories/personal-loans/',
  'alvarez-motorsports': '/categories/personal-loans/',
  'new-car-dealers-dallas': '/credit-guide/dallas-tx/personal-loans/',
  'mayra-cars-indy': '/credit-guide/indianapolis-in/personal-loans/',
  'greater-metro': '/categories/credit-unions/',
  'vfs-global-india-passport-application-center': '/categories/credit-repair/',
  'fix-my-auto-credit-score': '/categories/personal-loans/',
  'jm-auto-title-service-titulos-y-placas-surety-bond-title': '/credit-guide/dallas-tx/personal-loans/',
  'ny-identity-theft-group': '/categories/credit-repair/',
  'the-ivy-league-solutions': '/categories/credit-repair/',
  'pacific-check-cashing-financial': '/categories/check-cashing/',
  'autocarhouston-autos-usados': '/credit-guide/houston-tx/personal-loans/',
  'auto-titles-and-bonds': '/credit-guide/dallas-tx/personal-loans/',
  'burns-buy-here-pay-here-of-spartanburg': '/categories/personal-loans/',
  'fraud': '/categories/credit-repair/',
  'good-price-title-auto-title-services-bonded-titles-by-appointment-only': '/categories/personal-loans/',
  'ria-money-transfer-envios-el-papi': '/credit-guide/san-diego-ca/check-cashing/',
  'loanmart-auto-title-loans': '/categories/personal-loans/',
  '5-star-car-title-loans-youngstown-oh': '/categories/personal-loans/',
  'montana-capital-car-title-loans-greenville': '/categories/personal-loans/',
  'montana-capital-car-title-loans-dallas': '/categories/personal-loans/',
  'swift-title-loans-dallas': '/categories/personal-loans/',
  '5-star-car-title-loans-san-antonio': '/categories/personal-loans/',
  'montana-capital-car-title-loans-norman-ok': '/categories/personal-loans/',
  'mvp-car-title-loan-long-beach': '/categories/personal-loans/',
  'pawn-shop-bronx': '/categories/pawn-shops/',
  'macro-international-cargo': '/categories/check-cashing/',
  'victor-pawn-broker': '/categories/pawn-shops/',
};

if (staleReviewRedirects[slug]) {
  return Astro.redirect(staleReviewRedirects[slug], 302);
}

const primaryRow = await getLenderWithBodyBySlugRuntime(slug, env);
if (!primaryRow) return new Response('Not found', { status: 404 });

const lender = shapeBodyInlineToLender(primaryRow);
const lenderGoHref = buildLenderGoHref(lender);
const lenderTelHref = normalizeTelHref(lender.phone);
const responsiveReportProvider = ((cfpbResponsiveReport as any).allProviders || [])
  .find((provider: any) => provider.slug === lender.slug);

// Related-lender resolution: 2-tier (explicit similar_lenders → category top-rated).
// Replaces the build-time 4-tier fallback (similar → nearby → category → state)
// because the city/state-scoped catalog queries require denormalised lookups
// the SSR path can't afford. The 2-tier version covers the same intent for
// the user (related options) without per-request join cost.
const similarSlugList = (lender.similar_lenders ?? []).filter(
  (s): s is string => typeof s === 'string' && s.length > 0
);
const slugRows = similarSlugList.length > 0
  ? await getLendersBySlugListRuntime(similarSlugList.slice(0, 3), env)
  : [];
const slugLenders = slugRows.map(shapeBodyInlineToLender);
let categoryStubs: Lender[] = [];
if (slugLenders.length < 3) {
  const more = await getRelatedLendersByCategoryRuntime(
    lender.category,
    lender.slug,
    env,
    3 - slugLenders.length
  );
  categoryStubs = more.map(shapeCatalogToLenderStub);
}
const relatedLenders: Lender[] = [...slugLenders, ...categoryStubs].slice(0, 3);

// Backward-compat aliases — the template body downstream references these
// names; with the 2-tier runtime fallback they collapse into a single bucket.
const similarLenders = similarSlugList.length > 0 ? relatedLenders : [];
const nearbyLenders: Lender[] = [];
const categoryLenders = similarSlugList.length === 0 ? relatedLenders : [];
const stateLenders: Lender[] = [];
const usedSlugs = new Set([lender.slug, ...relatedLenders.map((l) => l.slug)]);

const categories = getCategoriesRuntime();
const category = categories.find((c) => c.slug === lender.category);
const categoryLinkFallbacks: Record<string, string> = {
  'credit-counseling': '/best/best-credit-counseling-agencies/',
};
const categoryHref = category
  ? `/categories/${lender.category}/`
  : (categoryLinkFallbacks[lender.category] || '/city/');
const absoluteCategoryHref = `https://www.creditdoc.co${categoryHref}`;

const stateAbbr = lender.company_info?.state
  ? (STATE_ABBR[lender.company_info.state] || lender.company_info.state)
  : '';

const relatedLendersLabel = similarLenders.length > 0
  ? 'Similar Companies'
  : `More ${category?.name || 'Lenders'}`;

const categoryAlternativeBestHref: Record<string, string> = {
  'credit-repair': '/best/best-credit-repair-companies/',
  'fix-my-credit': '/best/best-credit-repair-companies/',
  'personal-loans': '/best/best-personal-loans-bad-credit/',
  'emergency-cash': '/best/best-personal-loans-bad-credit/',
  'payday-alternatives': '/best/best-payday-loan-alternatives/',
  'check-cashing': '/best/best-payday-loan-alternatives/',
  'debt-relief': '/best/best-debt-relief-companies/',
  'credit-counseling': '/best/best-credit-counseling-agencies/',
  'build-credit': '/best/best-credit-builder-loans/',
  'credit-monitoring': '/best/best-credit-monitoring-services/',
  'credit-cards': '/best/best-secured-credit-cards/',
  'credit-unions': '/best/best-personal-loan-lenders/',
  'banking': '/best/best-personal-loan-lenders/',
  'business-loans': '/best/best-small-business-loans/',
  'mortgages': '/best/best-personal-loan-lenders/',
  'pawn-shops': '/best/best-payday-loan-alternatives/',
};
const alternativeBestHref = categoryAlternativeBestHref[lender.category] || categoryHref;

// Category-mapped wellness guides — DB-backed (A.2).
const categoryGuideMap: Record<string, string> = {
  'credit-repair': 'credit-repair',
  'debt-relief': 'financial-recovery',
  'personal-loans': 'loans-and-interest',
  'check-cashing': 'everyday-finance',
  'credit-counseling': 'financial-recovery',
  'pawn-lenders': 'everyday-finance',
  'buy-here-pay-here': 'loans-and-interest',
};
const guideCategory = categoryGuideMap[lender.category] || 'understanding-credit';
const relatedWellnessGuidesPromise = getWellnessGuidesByCategoryRuntime(guideCategory, env, 3);

const answerPillarMap: Record<string, string> = {
  'personal-loans': 'personal-loans',
  'business-loans': 'business-loans',
  'debt-relief': 'debt-relief',
  'credit-repair': 'credit-score',
  'credit-counseling': 'debt-relief',
  'build-credit': 'build-credit',
  'credit-monitoring': 'credit-score',
  'credit-cards': 'credit-cards',
  'banking': 'personal-loans',
  'credit-unions': 'personal-loans',
  'emergency-cash': 'personal-loans',
  'payday-alternatives': 'personal-loans',
  'check-cashing': 'personal-loans',
  'pawn-shops': 'personal-loans',
  'free-help': 'debt-relief',
  'bankruptcy': 'debt-relief',
  'mortgages': 'personal-loans',
};
const relatedAnswerPillar = answerPillarMap[lender.category] || 'credit-score';
const relatedAnswersPromise = getAnswersByPillarRuntime(relatedAnswerPillar, env, 4);

Astro.response.headers.set('cache-control', 'public, max-age=86400, s-maxage=86400');
Astro.response.headers.set('x-cdm-rev-source', 'ssr-review');
Astro.response.headers.set('x-cdm-route', '/review/[slug]');
Astro.response.headers.set('x-cdm-slug', lender.slug);

const cityName = lender.company_info?.city || '';
const regionName = stateAbbr || lender.company_info?.state || '';
const locationLabel = [cityName, regionName].filter(Boolean).join(', ');
const categoryLabel = category?.name || lender.category.replace(/-/g, ' ');
const [
  relatedWellnessGuidesRaw,
  relatedAnswers,
  stateRegulatoryContext,
  regulatorData,
  hmdaData,
  comparisons,
  brandInfo,
] = await Promise.all([
  relatedWellnessGuidesPromise,
  relatedAnswersPromise,
  stateAbbr ? getStateByCodeRuntimeFromDb(stateAbbr, env) : Promise.resolve(null),
  getRegulatorDataRuntime(lender.slug, env as any),
  lender.category === 'mortgages' ? getHMDADataRuntime(lender.slug, env as any) : Promise.resolve(null),
  getComparisonsForLenderRuntime(lender.slug, env, 12),
  lender.brand_slug ? getBrandInfoRuntime(lender.brand_slug, env) : Promise.resolve(null),
]);
const relatedWellnessGuides = relatedWellnessGuidesRaw.slice(0, 3);
const displayRelatedWellnessGuides = relatedWellnessGuides.map((guide: any) => ({
  ...guide,
  title: softenEducationalTeaserCopy(guide.title || ''),
  description: softenEducationalTeaserCopy(guide.description || ''),
}));
const primaryWellnessGuide = relatedWellnessGuides[0];
const nextStepWellnessHref = primaryWellnessGuide
  ? `/financial-wellness/${primaryWellnessGuide.slug}/`
  : '/financial-wellness/';
const nextStepWellnessTitle = primaryWellnessGuide
  ? softenEducationalTeaserCopy(primaryWellnessGuide.title || '')
  : 'Financial Wellness Guides';
const reviewToolMap: Record<string, { href: string; label: string; body: string }> = {
  'credit-repair': {
    href: '/resources/credit-report-checklist/',
    label: 'Credit report checklist',
    body: 'Organize report errors, dispute notes, and verification steps before contacting a repair provider.',
  },
  'build-credit': {
    href: '/tools/credit-score-simulator/',
    label: 'Credit score simulator',
    body: 'Model common score-factor scenarios before choosing a credit-building path.',
  },
  'credit-monitoring': {
    href: '/tools/credit-score-simulator/',
    label: 'Credit score simulator',
    body: 'Review score-factor context before comparing monitoring or identity-theft products.',
  },
  'personal-loans': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Estimate borrowing context privately before comparing loan providers.',
  },
  'business-loans': {
    href: '/tools/business-loan-readiness-quiz/',
    label: 'Business readiness quiz',
    body: 'Check revenue, cash-flow, and documentation readiness before comparing business lenders.',
  },
  'emergency-cash': {
    href: '/tools/debt-payoff-calculator/',
    label: 'Debt payoff calculator',
    body: 'Compare repayment pressure before using short-term cash options.',
  },
  'payday-alternatives': {
    href: '/tools/debt-payoff-calculator/',
    label: 'Debt payoff calculator',
    body: 'Compare payoff paths and lower-cost alternatives before choosing emergency cash.',
  },
  'check-cashing': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Review borrowing context before using check-cashing, money-service, or short-term cash options.',
  },
  'pawn-shops': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Check borrowing context before comparing collateral, pawn, or short-term cash options.',
  },
  'debt-relief': {
    href: '/tools/debt-payoff-calculator/',
    label: 'Debt payoff calculator',
    body: 'Estimate payoff paths before comparing debt-relief or counseling options.',
  },
  'credit-counseling': {
    href: '/tools/debt-payoff-calculator/',
    label: 'Debt payoff calculator',
    body: 'Frame balances and repayment options before speaking with a counselor.',
  },
  'mortgages': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Review income, debt, and credit context before comparing mortgage profiles.',
  },
  'credit-unions': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Frame borrowing needs before comparing credit unions, banks, or personal-loan options.',
  },
  'banking': {
    href: '/tools/borrowing-power-quiz/',
    label: 'Borrowing power quiz',
    body: 'Review account and borrowing context before comparing bank or credit-union profiles.',
  },
  'credit-cards': {
    href: '/tools/credit-score-simulator/',
    label: 'Credit score simulator',
    body: 'Model credit-factor scenarios before comparing secured-card or card-building options.',
  },
};
const primaryReviewTool = reviewToolMap[lender.category] || {
  href: '/tools/',
  label: 'CreditDoc tools',
  body: 'Use calculators, quizzes, and checklists to frame the next step before contacting a provider.',
};
const reviewDecisionPaths = [
  {
    href: primaryReviewTool.href,
    label: primaryReviewTool.label,
    body: primaryReviewTool.body,
  },
  {
    href: alternativeBestHref,
    label: 'Compare alternatives',
    body: `Review related ${categoryLabel.toLowerCase()} options before relying on one profile.`,
  },
  {
    href: '/courses/credit-fundamentals/',
    label: 'Credit fundamentals course',
    body: 'Study credit scores, reports, debt, borrowing terms, scams, and consumer rights.',
  },
  {
    href: nextStepWellnessHref,
    label: nextStepWellnessTitle,
    body: 'Use a related guide for context before applying, disputing, consolidating, or contacting a provider.',
  },
];
const reviewSummaryItems = [
  `${lender.name} is listed as a ${categoryLabel}${locationLabel ? ` provider in ${locationLabel}` : ' provider'} on CreditDoc.`,
  `Use this page to check contact details, location, listed services, review signals, FAQs, and similar providers before deciding what to do next.`,
  `If you need a loan, account, installment option, credit help, or debt support, start with the fit quiz and compare alternatives before contacting a provider.`,
  `For broader context, continue into the free Credit Fundamentals course or a relevant financial wellness guide.`,
];

// Map lender category to glossary contexts
const glossaryContextMap: Record<string, string[]> = {
  'credit-repair': ['review-credit-repair'],
  'build-credit': ['review-build-credit'],
  'credit-monitoring': ['review-credit-monitoring'],
  'personal-loans': ['review-personal-loans'],
  'business-loans': ['review-business-loans'],
  'emergency-cash': ['review-emergency-cash'],
  'payday-alternatives': ['review-emergency-cash'],
  'mortgages': ['review-mortgages'],
  'debt-relief': ['review-debt-relief'],
  'bankruptcy': ['review-debt-relief'],
  'credit-counseling': ['review-credit-repair', 'review-debt-relief'],
};
const glossaryContexts = glossaryContextMap[lender.category] || [];
const glossaryTerms = getGlossaryTermsForContextRuntime(glossaryContexts);

// Auto-link glossary terms and money keywords in description text.
// If lender has affiliate_url + affiliate_anchors, the first match of each
// anchor phrase becomes a highlighted affiliate CTA (takes priority).
const affiliateConfig = lender.affiliate_url && Array.isArray(lender.affiliate_anchors) && lender.affiliate_anchors.length
  ? { url: lender.affiliate_url, anchors: lender.affiliate_anchors }
  : undefined;

const linkedParagraphs = lender.description_long
  ? linkifyDescription(softenYmylCopy(lender.description_long), glossaryTerms, lender.slug, affiliateConfig, lender.category)
  : [];

// Pre-fetch the "other side" lender names for the Compare-With cards.
// Single batched query keeps the SSR round-trip count bounded.
const otherSlugs = Array.from(new Set(
  comparisons.map((c) => (c.lender_a === lender.slug ? c.lender_b : c.lender_a))
));
const otherLendersRows = otherSlugs.length > 0
  ? await getLendersBySlugListRuntime(otherSlugs, env)
  : [];
const otherLenderNames = new Map(otherLendersRows.map((r) => [r.slug, r.name]));

const diagnosis = softenYmylCopy(generateDiagnosis(lender));
const safePros = (lender.pros || []).map(softenYmylCopy);
const safeCons = (lender.cons || []).map(softenYmylCopy);
const safeBestFor = (lender.best_for || []).map(softenYmylCopy);
const bbbClass = getBbbClass(lender.company_info.bbb_rating);
const badges = getBadgeEligibility(lender.category);

// Category-aware feature labels — credit repair features only show on credit repair pages
const creditRepairFeatures: Record<string, string> = {
  credit_monitoring: 'Credit Monitoring',
  all_three_bureaus: 'All Three Bureaus',
  goodwill_letters: 'Goodwill Letters',
  cease_desist_letters: 'Cease & Desist Letters',
  debt_validation: 'Debt Validation',
  credit_education: 'Credit Education',
  identity_theft_protection: 'Identity Theft Protection',
  score_tracking: 'Score Tracking',
  mobile_app: 'Mobile App',
  online_portal: 'Online Portal',
  personal_advisor: 'Personal Advisor',
  ai_powered: 'AI-Powered Tools',
};
const generalFeatures: Record<string, string> = {
  mobile_app: 'Mobile App',
  online_portal: 'Online Portal',
  personal_advisor: 'Personal Advisor',
  credit_education: 'Credit Education',
  score_tracking: 'Score Tracking',
  identity_theft_protection: 'Identity Theft Protection',
};
const featureLabels = category?.filter_type === 'credit-repair' ? creditRepairFeatures : generalFeatures;

const hq = lender.company_info?.headquarters?.trim();
const year = lender.company_info?.founded_year;
const bbb = lender.company_info?.bbb_rating?.trim();
const bbbAcc = lender.company_info?.bbb_accredited;

// --- Data-driven FAQ builder (unique per company) ---
const faqCandidates: Array<{ question: string; answer: string; priority: number }> = [];

// 1. Services FAQ — what does this company actually do? (100% coverage)
const svcList = lender.services ?? [];
if (svcList.length >= 2) {
  const svcDisplay = svcList.slice(0, 5).join(', ') + (svcList.length > 5 ? `, and ${svcList.length - 5} more` : '');
  faqCandidates.push({
    question: `What services does ${lender.name} offer?`,
    answer: `${lender.name} offers ${svcList.length} services including ${svcDisplay}.`,
    priority: 10,
  });
}

// 2. Profile-signal FAQ — who is the company commonly associated with? (100% coverage)
const bestFor = safeBestFor ?? [];
if (bestFor.length >= 1) {
  faqCandidates.push({
    question: `What profile signals are listed for ${lender.name}?`,
    answer: `${lender.name} has profile signals associated with ${bestFor.join(', ')}.`,
    priority: 9,
  });
}

// 3. Pros & cons FAQ — unique per company (100% coverage)
const prosList = safePros ?? [];
const consList = safeCons ?? [];
if (prosList.length >= 1 && consList.length >= 1) {
  const topPros = prosList.slice(0, 3).join('; ');
  const topCons = consList.slice(0, 2).join('; ');
  faqCandidates.push({
    question: `What are the strengths and weaknesses of ${lender.name}?`,
    answer: `Key strengths: ${topPros}. Areas to consider: ${topCons}.`,
    priority: 8,
  });
}

// 4. CFPB complaint response FAQ — only for companies with CFPB data (3%, ~475)
const cfpb = lender.cfpb_data ?? {};
if (cfpb.found_in_cfpb && cfpb.resolution_rate != null) {
  const timelyPart = cfpb.timely_response_rate != null
    ? `, with ${cfpb.timely_response_rate}% of those responses delivered within the CFPB's 15-day window`
    : '';
  faqCandidates.push({
    question: `Does ${lender.name} respond to consumer complaints?`,
    answer: `According to CFPB data (${cfpb.data_period || 'recent'}), ${lender.name} has a ${cfpb.resolution_rate}% response rate to consumer complaints${timelyPart}. Response rate measures whether the company replied — not whether the consumer's issue was resolved in their favor.`,
    priority: 12,
  });
}


// 6. Comparison FAQ — only when we have named competitors (99%)
if (relatedLenders.length >= 2) {
  const compNames = relatedLenders.map(l => l.name).join(', ');
  const catLabel = category?.name || 'financial services';
  faqCandidates.push({
    question: `How does ${lender.name} compare to similar companies?`,
    answer: `In the ${catLabel} category, comparable providers include ${compNames}. Each company has different strengths, so compare services, pricing, and consumer complaint records before deciding what to do next.`,
    priority: 6,
  });
}

// 7. Geographic coverage FAQ — only when states_served exists (82%)
const statesServed = (lender as any).states_served ?? [];
if (statesServed.length >= 2 && statesServed.length <= 50) {
  const stateCount = statesServed.length;
  const statePreview = statesServed.slice(0, 8).join(', ') + (stateCount > 8 ? `, and ${stateCount - 8} more states` : '');
  faqCandidates.push({
    question: `Where does ${lender.name} operate?`,
    answer: `${lender.name} serves customers in ${stateCount} states including ${statePreview}.`,
    priority: 5,
  });
} else if (statesServed.length > 50) {
  faqCandidates.push({
    question: `Where does ${lender.name} operate?`,
    answer: `${lender.name} operates nationwide across all 50 states.`,
    priority: 5,
  });
}

// 8. BBB FAQ — only when real BBB data exists (1.2%, ~185)
if (bbb && bbb !== 'NR' && bbb !== 'N/A' && bbb !== '') {
  faqCandidates.push({
    question: `Is ${lender.name} accredited by the Better Business Bureau?`,
    answer: `${lender.name} holds a ${bbb} rating with the Better Business Bureau${bbbAcc ? ' and is BBB-accredited' : ' but is not BBB-accredited'}.`,
    priority: 4,
  });
}

// Sort by priority (highest first), take top 6
const faqs = faqCandidates
  .sort((a, b) => b.priority - a.priority)
  .slice(0, 6)
  .map(({ question, answer }) => ({ question, answer }));

// Quality score — persisted by the autonomous engine, fallback to 0
const qualityScore = lender.quality_score ?? 0;
const isPendingApproval = lender.processing_status === 'pending_approval';
const isSkeleton = qualityScore < 3 || isPendingApproval || lender.no_index === true;
const isEnriched = lender.has_been_enriched === true || lender.data_source === 'enriched' || lender.data_source === 'editorial' || lender.data_source === 'verified';
const showGoogleRating = !isSkeleton && lender.google_rating && lender.google_rating > 0 && !(lender.google_rating > 5) && lender.google_reviews_count && lender.google_reviews_count >= 1;

// Website health warnings
const websiteStatus = (lender as any).website_status || '';
const hasWebsiteWarning = ['ssl_expired', 'dead', 'parked', 'hacked', 'redirect_suspicious'].includes(websiteStatus);
const websiteWarnings: Record<string, { label: string; detail: string }> = {
  ssl_expired: { label: 'Insecure Website (SSL Expired)', detail: 'This company\'s website has an expired SSL certificate. The site may be inaccessible or insecure. Exercise caution before sharing personal information.' },
  dead: { label: 'Website Unavailable', detail: 'This company\'s website appears to be offline or no longer operational. The company may have closed or moved to a different address.' },
  parked: { label: 'Website Not Active', detail: 'This company\'s website appears to be parked or for sale. The company may no longer be operating.' },
  hacked: { label: 'Website Compromised', detail: 'This company\'s website appears to have been compromised. Do not visit the site or enter any personal information.' },
  redirect_suspicious: { label: 'Suspicious Website Redirect', detail: 'This company\'s website redirects to an unrelated domain. The original business may no longer operate at this address.' },
};
const warning = websiteWarnings[websiteStatus];

// FinancialService inherits from LocalBusiness in schema.org.
// Google requires an eligible type (LocalBusiness, Product, etc.) for Review snippets.
// Array type includes both for semantic accuracy + rich result eligibility.
const financialService: Record<string, any> = {
  '@context': 'https://schema.org',
  '@type': ['FinancialService', 'LocalBusiness'],
  name: lender.name,
  description: lender.description_short,
  url: lender.website_url?.trim() ? lender.website_url : `https://www.creditdoc.co/review/${lender.slug}/`,
};

// Address (always have city/state from data)
if (lender.company_info?.city || lender.company_info?.state) {
  const addr: Record<string, string> = { '@type': 'PostalAddress' };
  if (lender.company_info.address) addr.streetAddress = lender.company_info.address;
  if (lender.company_info.city) addr.addressLocality = lender.company_info.city;
  if (lender.company_info.state) addr.addressRegion = lender.company_info.state;
  if (lender.company_info.zip) addr.postalCode = lender.company_info.zip;
  addr.addressCountry = 'US';
  financialService.address = addr;
}

// Phone
if (lender.company_info?.phone) {
  financialService.telephone = lender.company_info.phone;
}

// AggregateRating from real Google Reviews data (not editorial scores).
// Only added when actual customer review data exists (google_rating + google_reviews_count).
if (showGoogleRating) {
  financialService.aggregateRating = {
    '@type': 'AggregateRating',
    ratingValue: lender.google_rating.toFixed(1),
    bestRating: '5',
    worstRating: '1',
    reviewCount: lender.google_reviews_count,
  };
}


const breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: category?.name || lender.category, item: absoluteCategoryHref },
      { '@type': 'ListItem', position: 3, name: lender.name, item: `https://www.creditdoc.co/review/${lender.slug}/` },
    ],
  };
const shouldEmitEntitySchema = !isSkeleton && primaryRow.processing_status === 'ready_for_index';
const jsonLd = shouldEmitEntitySchema
  ? [
      financialService,
      breadcrumbSchema,
      ...(faqs.length > 0 ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map(faq => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }] : []),
    ]
  : [breadcrumbSchema];

const canonicalUrl = `https://www.creditdoc.co/review/${lender.slug}/`;

const reviewSeoOverrides: Record<string, { title?: string; h1?: string; description?: string }> = {
  lookout: {
    title: 'Lookout Profile and Security Context | CreditDoc',
    description: 'Lookout profile with business context, category notes, source signals, and alternatives for CreditDoc readers.',
  },
  gain: {
    title: 'GAIN Profile and Platform Context | CreditDoc',
    description: 'GAIN profile with classification context, source signals, and alternatives for CreditDoc readers.',
  },
  'sofi-bank': {
    title: 'SoFi Bank Review: Loans, Banking, and App Context',
    h1: 'SoFi Bank in San Francisco, CA',
    description: 'SoFi Bank profile covering loans, banking, app features, complaint signals, and alternatives for borrowers.',
  },
  sofi: {
    title: 'SoFi Financial Services Review and Context',
    h1: 'SoFi Financial Services in San Francisco, CA',
    description: 'SoFi profile covering digital banking, loans, investing, credit tools, complaint signals, and alternatives.',
  },
  'eagle-finance': {
    title: 'Eagle Finance Review: Indianapolis Personal Loan Context',
    h1: 'Eagle Finance in Indianapolis, IN',
    description: 'Eagle Finance profile covering Indianapolis personal-loan context, branch access, funding notes, credit reporting, and alternatives.',
  },
  'eagle-loan': {
    title: 'Eagle Loan Company Review: Regional Personal Loans',
    h1: 'Eagle Loan Company in Indianapolis, IN',
    description: 'Eagle Loan Company profile covering regional branch lending in Kentucky, Ohio, and Indiana, loan limits, funding steps, and alternatives.',
  },
};

const reviewSeoOverride = reviewSeoOverrides[lender.slug] || {};

// Per-entity OG image: prefer logo, fall through to default in BaseLayout
const ogImageUrl = lender.logo_url?.trim()
  ? (lender.logo_url.startsWith('http') ? lender.logo_url : `https://www.creditdoc.co${lender.logo_url}`)
  : undefined;
---

<BaseLayout
  canonical={canonicalUrl}
  ogImage={ogImageUrl}
  title={(() => {
    if (reviewSeoOverride.title) return reviewSeoOverride.title;
    if (lender.seo_title) return lender.seo_title;
    const city = lender.company_info?.city;
    const state = lender.company_info?.state;
    const stAbbr = state ? (STATE_ABBR[state] || state.slice(0, 2).toUpperCase()) : '';
    const locSuffix = city ? ` in ${city}${stAbbr ? ', ' + stAbbr : ''}` : '';
    const nameWithLoc = locSuffix ? `${lender.name}${locSuffix}` : lender.name;
    if (nameWithLoc.length <= 45) return `${nameWithLoc} | CreditDoc`;
    if (nameWithLoc.length <= 60) return nameWithLoc;
    return nameWithLoc.slice(0, 60);
  })()}
  description={(() => {
    if (reviewSeoOverride.description) return reviewSeoOverride.description;
    if (lender.meta_description) return lender.meta_description.slice(0, 155);
    const base = lender.description_short || `${lender.name} review with services, contact details, review signals, and alternatives.`;
    const city = lender.company_info?.city;
    if (city && !base.includes(city)) {
      const locNote = ` Located in ${city}${lender.company_info?.state ? ', ' + lender.company_info.state : ''}.`;
      return (base + locNote).slice(0, 155);
    }
    return base.slice(0, 155);
  })()}
  jsonLd={jsonLd}
  noindex={isSkeleton || primaryRow.processing_status !== 'ready_for_index'}
>
  <!-- Breadcrumbs -->
  <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8" aria-label="Breadcrumb">
