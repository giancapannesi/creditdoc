---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingStars from '../../components/RatingStars.astro';
import ProsCons from '../../components/ProsCons.astro';
import DiagnosisCard from '../../components/DiagnosisCard.astro';
import LenderCard from '../../components/LenderCard.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import GlossaryAppendix from '../../components/GlossaryAppendix.astro';
import RegulatoryRecord from '../../components/RegulatoryRecord.astro';
import HMDARecord from '../../components/HMDARecord.astro';
import InfoLink from '../../components/InfoLink.astro';
import StateRegulatoryContext from '../../components/StateRegulatoryContext.astro';
import cfpbResponsiveReport from '../../data/cfpb-responsive-providers-2026.json';
import gscReview404Redirects from '../../../data/gsc_404_review_redirects_2026-07-06.json';
import { linkifyDescription, autoParagraphs } from '../../utils/inline-linker';
import { buildLenderGoHref, normalizeTelHref } from '../../utils/outbound';
import { softenEducationalTeaserCopy, softenYmylCopy } from '../../utils/safe-copy';
import {
  getBbbClass,
  generateDiagnosis,
  getBadgeEligibility,
  getCategoriesRuntime,
  getGlossaryTermsForContextRuntime,
  getWellnessGuidesByCategoryRuntime,
  getComparisonsForLenderRuntime,
  getBrandInfoRuntime,
  getStateByCodeRuntimeFromDb,
  shapeBodyInlineToLender,
  shapeCatalogToLenderStub,
} from '../../utils/data-runtime';
import {
  getLenderWithBodyBySlugRuntime,
  getLendersBySlugListRuntime,
  getRelatedLendersByCategoryRuntime,
  getRegulatorDataRuntime,
  getHMDADataRuntime,
  getAnswersByPillarRuntime,
  type RuntimeLenderEnv,
} from '../../lib/db';
import type { Lender } from '../../utils/data';

// CDM-REV-2026-04-29 Phase 1.3.B-A.1 — SSR cutover.
// `prerender = false` switches this route from build-time static to per-request
// SSR on the Cloudflare Worker. Combined with the body_inline column on
// `lenders` (A.1) and the wellness/comparisons/brands tables (A.2), every
// content surface on this page is fetched from Postgres at request time.
// OBJ-1 mechanism: DB row update bumps lenders.updated_at → CF Cache content-version
// invalidates → next request re-fetches. <10s globally, no rebuild.
export const prerender = false;

function normalizeStaleReviewPath(pathname: string): string {
  let decoded = pathname;
  try {
    decoded = decodeURIComponent(pathname);
  } catch {
    decoded = pathname;
  }
  return decoded
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/\/+$/, '/');
}

const GSC_REVIEW_404_REDIRECTS = new Map<string, string>(
  Object.entries(gscReview404Redirects as Record<string, string>).map(([pathname, target]) => [
    normalizeStaleReviewPath(pathname),
    target,
  ])
);

const STATE_ABBR: Record<string, string> = {
  'Alabama':'AL','Alaska':'AK','Arizona':'AZ','Arkansas':'AR','California':'CA',
  'Colorado':'CO','Connecticut':'CT','Delaware':'DE','Florida':'FL','Georgia':'GA',
  'Hawaii':'HI','Idaho':'ID','Illinois':'IL','Indiana':'IN','Iowa':'IA',
  'Kansas':'KS','Kentucky':'KY','Louisiana':'LA','Maine':'ME','Maryland':'MD',
  'Massachusetts':'MA','Michigan':'MI','Minnesota':'MN','Mississippi':'MS','Missouri':'MO',
  'Montana':'MT','Nebraska':'NE','Nevada':'NV','New Hampshire':'NH','New Jersey':'NJ',
  'New Mexico':'NM','New York':'NY','North Carolina':'NC','North Dakota':'ND','Ohio':'OH',
  'Oklahoma':'OK','Oregon':'OR','Pennsylvania':'PA','Rhode Island':'RI','South Carolina':'SC',
  'South Dakota':'SD','Tennessee':'TN','Texas':'TX','Utah':'UT','Vermont':'VT',
  'Virginia':'VA','Washington':'WA','West Virginia':'WV','Wisconsin':'WI','Wyoming':'WY',
  'District of Columbia':'DC'
};

// Runtime env from Cloudflare Worker (Astro.locals.runtime.env on Pages adapter).
// Falls back to undefined in build-mode preview without secrets — runtime
// fetchers degrade gracefully (return null/[]) so the 404 path still renders.
const env = (Astro.locals as any)?.runtime?.env as RuntimeLenderEnv | undefined;

const { slug } = Astro.params;
if (!slug) return new Response('Bad request', { status: 400 });

const gscReview404RedirectTarget = GSC_REVIEW_404_REDIRECTS.get(normalizeStaleReviewPath(`/review/${slug}/`));
if (gscReview404RedirectTarget) {
  return Astro.redirect(gscReview404RedirectTarget, 301);
}

const staleReviewRedirects: Record<string, string> = {
