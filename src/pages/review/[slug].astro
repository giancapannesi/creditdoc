            </div>
          ) : (
            <p class="mt-2 text-sm font-medium text-muted">No stored Google rating available.</p>
          )}
          <p class="mt-3 text-muted leading-relaxed">{lender.description_short}</p>
          {lender.is_protected ? (
            <p class="mt-2 text-xs text-muted">
              Editorially reviewed by <a href="/about/harvey-brooks/" class="text-primary hover:underline">Harvey Brooks</a>
              · Google rating shown only when a stored review count is available
            </p>
          ) : (
            <p class="mt-2 text-xs text-muted">
              Data compiled from public sources
              {showGoogleRating && <> · Google rating shown when a stored review count is available</>}
            </p>
          )}
        </div>
      </div>

      <!-- Quick Badges -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {bbb && bbb !== 'NR' && bbb !== 'N/A' && (
        <span class:list={['inline-flex items-center px-3 py-1.5 rounded-full text-sm font-semibold', bbbClass]}>
