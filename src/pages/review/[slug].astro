                    </svg>
                  </a>
                  <a href="/best/best-no-credit-check-cards/" class="inline-flex items-center px-4 py-2 rounded-lg border border-primary/30 text-primary text-sm font-semibold hover:bg-primary/10 transition-colors">
                    Card Eligibility Profiles
                  </a>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Internal Cross-Sell Banner (credit repair / debt) -->
        {(lender.category === 'credit-repair' || lender.category === 'debt-relief') && (
          <div class="rounded-xl border-2 border-primary/30 bg-gradient-to-r from-primary/5 to-primary/10 p-6">
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-text">Research Secured Credit Card Options</h3>
                <p class="mt-1 text-sm text-muted">While repairing your credit, a secured card can add payment-history context when it reports to the bureaus. Compare deposits, fees, bureau reporting, and any no-credit-check claims directly.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <a href="/best/best-secured-credit-cards/" class="inline-flex items-center px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-hover transition-colors">
                    See Secured Card Profiles
                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                    </svg>
                  </a>
                  <a href="/best/best-no-credit-check-cards/" class="inline-flex items-center px-4 py-2 rounded-lg border border-primary/30 text-primary text-sm font-semibold hover:bg-primary/10 transition-colors">
                    Card Eligibility Profiles
                  </a>
                </div>
              </div>
            </div>
          </div>
        )}

        <!-- Internal Cross-Sell Banner (personal loans / emergency cash) -->
        {(lender.category === 'personal-loans' || lender.category === 'emergency-cash' || lender.category === 'payday-alternatives') && (
          <div class="rounded-xl border-2 border-primary/30 bg-gradient-to-r from-primary/5 to-primary/10 p-6">
            <div class="flex items-start gap-3">
              <div class="shrink-0 w-10 h-10 rounded-full bg-primary/20 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div>
                <h3 class="text-base font-bold text-text">Compare Personal Loan Options</h3>
                <p class="mt-1 text-sm text-muted">Review lender profiles, APR ranges, fees, minimum-score fields, and funding-speed notes before deciding what to do next.</p>
                <div class="mt-3 flex flex-wrap gap-2">
                  <a href="/best/best-personal-loans-bad-credit/" class="inline-flex items-center px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-hover transition-colors">
                    Bad Credit Loan Guide
                    <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/>
                    </svg>
                  </a>
                  <a href="/best/best-payday-loan-alternatives/" class="inline-flex items-center px-4 py-2 rounded-lg border border-primary/30 text-primary text-sm font-semibold hover:bg-primary/10 transition-colors">
                    Payday Alternatives
                  </a>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* Regulatory data — dynamic from regulator.db → Supabase sync */}
        {regulatorData && (
          <RegulatoryRecord data={regulatorData} lenderName={lender.name} />
        )}

        {/* State-level consumer finance context from the states table. */}
        {stateRegulatoryContext && (
          <StateRegulatoryContext
            data={stateRegulatoryContext}
            lenderName={lender.name}
            lenderCategory={lender.category}
            categoryLabel={categoryLabel}
            cityName={cityName}
            stateAbbr={stateAbbr}
          />
        )}

        {/* HMDA mortgage lending transparency */}
        {hmdaData && (
          <HMDARecord data={hmdaData} lenderName={lender.name} />
        )}

        <!-- FAQ -->
        <div class="glass-card p-6">
          <h2 class="text-xl font-bold text-text mb-4">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {faqs.map(faq => (
              <details class="group border-b border-border pb-4 last:border-0 last:pb-0">
                <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-text hover:text-primary transition-colors py-1">
                  {faq.question}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"/>
                  </svg>
                </summary>
                <p class="mt-2 text-sm text-muted leading-relaxed">{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Quick Facts -->
        <div class="glass-card p-5">
          <h3 class="text-base font-semibold text-text mb-4">Quick Facts</h3>
          <dl class="space-y-3">
            {lender.company_info.founded_year > 0 && (
              <div class="flex items-center justify-between py-2 border-b border-border/50">
                <dt class="text-sm text-muted">Founded</dt>
                <dd class="text-sm font-medium text-text">{lender.company_info.founded_year}</dd>
              </div>
            )}
            {hq && (
            <div class="flex items-start justify-between gap-3 py-2 border-b border-border/50">
              <dt class="text-sm text-muted shrink-0">Headquarters</dt>
              <dd class="text-sm font-medium text-text text-right break-words min-w-0">{hq}</dd>
            </div>
            )}
            {lender.company_info.employees && (
              <div class="flex items-center justify-between py-2 border-b border-border/50">
                <dt class="text-sm text-muted">Employees</dt>
                <dd class="text-sm font-medium text-text">{lender.company_info.employees}</dd>
              </div>
            )}
            {bbb && bbb !== 'NR' && bbb !== 'N/A' && (
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <dt class="text-sm text-muted">BBB Rating</dt>
              <dd>
                <span class:list={['inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold', bbbClass]}>
                  {bbb}
                </span>
              </dd>
            </div>
            )}
            <div class="flex items-center justify-between py-2 border-b border-border/50">
              <dt class="text-sm text-muted">BBB Accredited</dt>
              <dd class="text-sm font-medium text-text">{lender.company_info.bbb_accredited ? 'Yes' : 'No'}</dd>
            </div>
            {lender.company_info.certifications && lender.company_info.certifications.length > 0 && (
              <div class="py-2 border-b border-border/50">
                <dt class="text-sm text-muted mb-1">Certifications</dt>
                <dd class="flex flex-wrap gap-1">
                  {lender.company_info.certifications.map(cert => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-primary/10 text-primary">
                      {cert}
                    </span>
                  ))}
                </dd>
              </div>
            )}
          </dl>
          {lenderGoHref ? (
          <a
            href={`${lenderGoHref}?source=review_sidebar`}
            target="_blank"
            rel="noopener noreferrer sponsored"
            class="mt-5 flex items-center justify-center w-full rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white hover:bg-primary-hover transition-colors min-h-[44px]"
          >
            Visit {lender.name}
          </a>
          ) : (
          <p class="mt-5 text-center text-sm text-muted">No Website Currently Available</p>
          )}

          {/* Contact & Location */}
          {(lender.phone || lender.address) && (
            <div class="mt-4 pt-4 border-t border-border/50 space-y-2" id="contact-location">
              {lender.phone && lenderTelHref && (
                <a href={lenderTelHref} class="flex items-center gap-2 text-sm text-muted hover:text-primary transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd"/>
                  </svg>
                  {lender.phone}
                </a>
              )}
              {lender.address && (
                <a
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(lender.address)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-start gap-2 text-sm text-muted hover:text-primary transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                  </svg>
                  <span>{lender.address}</span>
                </a>
              )}
            </div>
          )}

          {/* Embedded Map */}
          {lender.address && (
            <div class="mt-4 rounded-lg overflow-hidden border border-border/50">
              <iframe
                src={`https://www.google.com/maps?q=${encodeURIComponent(lender.address)}&output=embed`}
                width="100%"
                height="180"
                style="border:0"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`${lender.name} location map`}
              ></iframe>
            </div>
          )}
        </div>

        <!-- Diagnosis Card -->
        <DiagnosisCard diagnosis={diagnosis} lenderName={lender.name} />

        <!-- CFPB Transparency Report -->
        {lender.cfpb_data?.found_in_cfpb && (
          <div class="glass-card p-5">
            <div class="flex items-center gap-2 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 2a.75.75 0 01.75.75v.258a33.186 33.186 0 016.668.83.75.75 0 01-.336 1.461 31.28 31.28 0 00-1.103-.232l1.702 7.545a.75.75 0 01-.387.832A4.981 4.981 0 0115 14c-.825 0-1.606-.2-2.294-.556a.75.75 0 01-.387-.832l1.77-7.849a31.743 31.743 0 00-3.339-.254v11.505a20.01 20.01 0 013.78.501.75.75 0 11-.339 1.462A18.558 18.558 0 0010 17.5c-1.442 0-2.845.165-4.191.477a.75.75 0 01-.338-1.462 20.01 20.01 0 013.779-.501V4.509c-1.129.026-2.243.112-3.34.254l1.771 7.85a.75.75 0 01-.387.83A4.981 4.981 0 015 14a4.981 4.981 0 01-2.294-.556.75.75 0 01-.387-.832L4.02 5.067c-.37.07-.738.148-1.103.232a.75.75 0 01-.336-1.462 33.053 33.053 0 016.668-.829V2.75A.75.75 0 0110 2zM5 12.662l-1.395-6.178A31.27 31.27 0 005 6.19c.474-.034.95-.058 1.428-.074L5 12.662zm10 0l-1.395-6.546c.478.016.954.04 1.428.074.466.034.93.077 1.395.128L15 12.662z" clip-rule="evenodd"/>
              </svg>
              <h3 class="text-base font-semibold text-text">CFPB Transparency Report<InfoLink href="/about/creditdoc-data/#cfpb-data" label="How we use CFPB data" /></h3>
            </div>
            <p class="text-xs text-muted mb-3">Public data from the Consumer Financial Protection Bureau</p>
            <dl class="space-y-2">
              {lender.cfpb_data.resolution_rate > 0 && (
                <div class="flex items-center justify-between py-1.5">
                  <dt class="text-sm text-muted">Response Rate*<InfoLink href="/about/creditdoc-data/#cfpb-data" label="What Response Rate means" /></dt>
                  <dd class:list={[
                    'text-sm font-semibold',
                    lender.cfpb_data.resolution_rate >= 90 ? 'text-positive' :
                    lender.cfpb_data.resolution_rate >= 70 ? 'text-warning' : 'text-negative'
                  ]}>
                    {lender.cfpb_data.resolution_rate}%
                  </dd>
                </div>
              )}
              {lender.cfpb_data.timely_response_rate > 0 && (
                <div class="flex items-center justify-between py-1.5">
                  <dt class="text-sm text-muted">On-Time Response**<InfoLink href="/about/creditdoc-data/#cfpb-data" label="What On-Time Response means" /></dt>
                  <dd class:list={[
                    'text-sm font-semibold',
                    lender.cfpb_data.timely_response_rate >= 90 ? 'text-positive' :
                    lender.cfpb_data.timely_response_rate >= 70 ? 'text-warning' : 'text-negative'
                  ]}>
                    {lender.cfpb_data.timely_response_rate}%
                  </dd>
                </div>
              )}
            </dl>
            <div class="mt-3 space-y-1">
              <p class="text-[10px] text-muted/70 leading-relaxed">* Percentage of consumer complaints that received a company response (does not indicate the complaint was resolved in the consumer's favor)</p>
              <p class="text-[10px] text-muted/70 leading-relaxed">** Percentage of responses delivered within the CFPB's 15-day window</p>
            </div>
            <p class="mt-2 text-[10px] text-muted/70 leading-relaxed">
              Source: <a href="https://www.consumerfinance.gov/data-research/consumer-complaints/" target="_blank" rel="noopener noreferrer" class="underline hover:text-primary">consumerfinance.gov</a>
              {lender.cfpb_data.last_checked && ` | Last checked ${lender.cfpb_data.last_checked}`}
            </p>
            {responsiveReportProvider && (
              <div class="mt-4 rounded-lg border border-primary/20 bg-primary-light/40 p-3">
                <p class="text-xs font-semibold text-text">Included in CreditDoc research</p>
                <p class="mt-1 text-xs text-muted leading-relaxed">
                  {lender.name} appears in CreditDoc's
                  {' '}<a href="/research/most-responsive-consumer-finance-providers-2026/" class="text-primary hover:underline">2026 Most Responsive Consumer Finance Providers report</a>
                  {' '}for its public CFPB complaint-response record. This is a transparency signal, not an endorsement, safety rating, pricing review, licensing determination, or suitability recommendation.
                </p>
              </div>
            )}
          </div>
        )}

        <!-- Profile Signals -->
        {safeBestFor.length > 0 && (
          <div class="glass-card p-5">
            <h3 class="text-base font-semibold text-text mb-3">Profile Signals</h3>
            <ul class="space-y-2">
              {safeBestFor.map(item => (
                <li class="flex items-start gap-2 text-sm text-muted">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mt-0.5 text-primary shrink-0" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Last Updated -->
        <div class="text-center">
          <TrustBadge type="updated" text={`Updated ${lender.last_updated}`} />
        </div>
      </div>
    </div>
  </section>

  <!-- Compare With Section -->
  {comparisons.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8" id="related-companies">
      <h2 class="text-xl font-bold text-text mb-4">Compare {lender.name} With Others</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {comparisons.map(comp => {
          const otherSlug = comp.lender_a === lender.slug ? comp.lender_b : comp.lender_a;
          const otherLenderName = otherLenderNames.get(otherSlug);
          return (
            <a
              href={`/compare/${comp.slug}/`}
              class="glass-card p-4 flex items-center gap-3 group"
            >
              <div class="w-10 h-10 rounded-lg bg-bg-alt border border-border flex items-center justify-center shrink-0">
                <span class="text-sm font-bold text-primary">vs</span>
              </div>
              <div>
                <p class="text-sm font-semibold text-text group-hover:text-primary transition-colors">
                  {lender.name} vs {otherLenderName || otherSlug}
                </p>
                <p class="text-xs text-muted mt-0.5">Side-by-side comparison</p>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- Related Lenders -->
  {relatedLenders.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-text mb-4">{relatedLendersLabel}<InfoLink href="/about/creditdoc-data/#similar-companies" label="How we find similar companies" /></h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedLenders.map(related => (
          <LenderCard lender={related} showRatings={showGoogleRating} />
        ))}
      </div>
    </section>
  )}

  <!-- Mini Fit Quiz -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="glass-card p-6 border-primary/20 border" id="fit-quiz">
      <h2 class="text-xl font-bold text-text mb-2">Compare Your Needs With {lender.name}</h2>
      <p class="text-sm text-muted mb-5">Answer 3 quick questions to review category, service, and profile context.</p>
      <div id="quiz-questions">
        <div class="quiz-step" data-step="1">
          <p class="text-sm font-semibold text-text mb-3">1. What's your primary financial goal?</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="repair">Improve my credit score</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="loan">Get a loan or financing</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="debt">Manage or consolidate debt</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="build">Build credit from scratch</button>
          </div>
        </div>
        <div class="quiz-step hidden" data-step="2">
          <p class="text-sm font-semibold text-text mb-3">2. What's your current credit situation?</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="poor">Poor (below 580)</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="fair">Fair (580-669)</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="good">Good (670-739)</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="excellent">Excellent (740+)</button>
          </div>
        </div>
        <div class="quiz-step hidden" data-step="3">
          <p class="text-sm font-semibold text-text mb-3">3. Which provider detail do you want to review first?</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="price">Low cost / free options</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="speed">Timing notes</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="trust">Public rating fields</button>
            <button class="quiz-btn text-left px-4 py-3 rounded-lg border border-border text-sm text-text hover:border-primary hover:bg-primary/5 transition-colors" data-value="service">Full-service support</button>
          </div>
        </div>
        <div class="quiz-step hidden" data-step="result">
          <div class="text-center py-4">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-emerald-100 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
            </div>
            <p class="text-lg font-bold text-text mb-2" id="quiz-verdict"></p>
            <p class="text-sm text-muted mb-4" id="quiz-reason"></p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
              {lenderGoHref && (
                <a href={`${lenderGoHref}?source=review_quiz`} target="_blank" rel="noopener noreferrer sponsored" class="inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded-lg bg-primary text-white hover:bg-primary-hover transition-colors">
                  Visit {lender.name}
                </a>
              )}
              <a href={alternativeBestHref} class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-alt transition-colors">
                Compare alternatives
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script define:vars={{ quizCategory: lender.category, quizServices: lender.services, quizHasGuarantee: lender.pricing?.money_back_guarantee || false, quizHasFreeConsult: lender.pricing?.free_consultation || false, quizRating: showGoogleRating ? lender.google_rating : 0, quizName: lender.name }}>
    (function() {
      const quiz = document.getElementById('fit-quiz');
      if (!quiz) return;
      const answers = [];
      const steps = quiz.querySelectorAll('.quiz-step');
      quiz.addEventListener('click', function(e) {
        const btn = e.target.closest('.quiz-btn');
        if (!btn) return;
        answers.push(btn.dataset.value);
        const currentStep = btn.closest('.quiz-step');
        const nextStepNum = parseInt(currentStep.dataset.step) + 1;
        currentStep.classList.add('hidden');
        const nextStep = nextStepNum <= 3
          ? quiz.querySelector('[data-step="' + nextStepNum + '"]')
          : quiz.querySelector('[data-step="result"]');
        if (nextStep) {
          nextStep.classList.remove('hidden');
          if (nextStepNum > 3) showResult();
        }
      });
      function showResult() {
        const [goal, credit, priority] = answers;
        let score = 0;
        const cats = (quizCategory || '').toLowerCase();
        const creditRepairCats = new Set(['credit-repair', 'credit-monitoring', 'build-credit']);
        const loanCats = new Set(['personal-loans', 'business-loans', 'mortgages', 'emergency-cash', 'payday-alternatives']);
        const debtCats = new Set(['debt-relief', 'credit-counseling', 'bankruptcy']);
        const buildCats = new Set(['build-credit', 'credit-repair', 'credit-monitoring', 'banking']);
        if (goal === 'repair' && creditRepairCats.has(cats)) score += 2;
        if (goal === 'loan' && loanCats.has(cats)) score += 2;
        if (goal === 'debt' && debtCats.has(cats)) score += 2;
        if (goal === 'build' && buildCats.has(cats)) score += 1;
        if (priority === 'price' && (quizHasFreeConsult || quizHasGuarantee)) score += 1;
        if (priority === 'trust' && quizRating >= 4) score += 1;
        if (priority === 'service' && quizServices && quizServices.length >= 4) score += 1;
        if (credit === 'poor' && (creditRepairCats.has(cats) || loanCats.has(cats))) score += 1;
        const verdict = document.getElementById('quiz-verdict');
        const reason = document.getElementById('quiz-reason');
        if (score >= 3) {
          verdict.textContent = quizName + ' has several relevant profile signals.';
          reason.textContent = 'Based on your answers, this profile has category, service, or public-rating fields to review more closely.';
        } else if (score >= 1) {
          verdict.textContent = quizName + ' has some relevant profile context.';
          reason.textContent = 'Review the listed services, current terms, public ratings, and complaint records alongside similar providers before deciding what to do next.';
        } else {
          verdict.textContent = 'Review additional provider profiles.';
          reason.textContent = 'Based on your answers, compare similar providers and category pages before contacting a company.';
        }
      }
    })();
  </script>

