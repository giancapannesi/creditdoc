  <script>
    const isEnrolled = localStorage.getItem('cd_course_enrolled') === 'true';

    // Handle enrollment form
    document.getElementById('enroll-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('enroll-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('enroll-email') as HTMLInputElement).value.trim();
      if (!email || !name) return;
      const btn = (e.target as HTMLFormElement).querySelector('button')!;
      (btn as HTMLButtonElement).disabled = true;
      btn.textContent = 'Enrolling...';
      try {
        const body = new URLSearchParams();
        body.append('list', 'Yj7BPjltZ5YG9nUBw892y93g');
        body.append('email', email);
        body.append('name', name);
        body.append('boolean', 'true');
        const res = await fetch('https://sendy.creditdoc.co/subscribe', { method: 'POST', body });
        const text = await res.text();
        if (text.trim() === '1' || text.includes('Already subscribed')) {
          document.getElementById('enroll-form')!.classList.add('hidden');
          document.getElementById('enroll-success')!.classList.remove('hidden');
          localStorage.setItem('cd_course_enrolled', 'true');
          localStorage.setItem('cd_course_email', email);
          localStorage.setItem('cd_course_name', name);
          unlockModules();
        } else {
          throw new Error(text);
        }
      } catch {
        document.getElementById('enroll-error')!.classList.remove('hidden');
        (btn as HTMLButtonElement).disabled = false;
        btn.textContent = 'Enroll Free — Get Instant Access';
      }
    });

    function unlockModules() {
      // Show module links as clickable
      document.querySelectorAll('.module-link').forEach(link => {
        link.classList.remove('pointer-events-none', 'opacity-60');
      });
      document.getElementById('module-lock-msg')?.classList.add('hidden');

      // Update bottom CTA
      document.getElementById('bottom-cta-enroll')?.classList.add('hidden');
      document.getElementById('bottom-cta-start')?.classList.remove('hidden');
    }

    function lockModules() {
      document.querySelectorAll('.module-link').forEach(link => {
        link.classList.add('pointer-events-none', 'opacity-60');
        link.addEventListener('click', (e) => {
          if (!localStorage.getItem('cd_course_enrolled')) {
            e.preventDefault();
            document.getElementById('enroll-section')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });
      document.getElementById('module-lock-msg')?.classList.remove('hidden');
    }

    if (isEnrolled) {
      // Already enrolled — show success state
      const form = document.getElementById('enroll-form');
      const success = document.getElementById('enroll-success');
      if (form && success) {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        const name = localStorage.getItem('cd_course_name') || '';
        success.querySelector('h3')!.textContent = name ? `Welcome back, ${name}!` : 'You\'re enrolled!';
        success.querySelector('p:last-of-type')!.textContent = 'Scroll down to continue your course.';
      }
      unlockModules();
    } else {
      lockModules();
    }
  </script>
</BaseLayout>
