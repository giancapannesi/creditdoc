---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import courseData from '../../../content/course-credit-fundamentals.json';
import { softenYmylCopy } from '../../../utils/safe-copy';
import fs from 'node:fs';
import path from 'node:path';

const moduleFiles: Record<string, string> = {
  'understanding-your-credit-score': 'module-1-credit-scores.md',
  'how-to-read-your-credit-report': 'module-2-credit-reports.md',
  'building-credit-from-scratch': 'module-3-building-credit.md',
  'managing-debt-effectively': 'module-4-managing-debt.md',
  'credit-repair-diy-vs-hiring-help': 'module-5-credit-repair.md',
  'personal-loans-and-borrowing-smart': 'module-6-personal-loans.md',
  'avoiding-scams-and-predatory-lending': 'module-7-avoiding-scams.md',
  'know-your-rights': 'module-8-know-your-rights.md',
};

export function getStaticPaths() {
  return courseData.modules.map((mod: any) => ({
    params: { slug: mod.slug },
  }));
}

const { slug } = Astro.params;
const mod = courseData.modules.find((m: any) => m.slug === slug)!;
const modIndex = courseData.modules.findIndex((m: any) => m.slug === slug);
const prevMod = modIndex > 0 ? courseData.modules[modIndex - 1] : null;
const nextMod = modIndex < courseData.modules.length - 1 ? courseData.modules[modIndex + 1] : null;

// Parse the markdown content
const mdFile = moduleFiles[slug];
let lessons: { title: string; content: string }[] = [];
let quizQuestions: { question: string; options: { label: string; text: string; correct: boolean }[] }[] = [];
let completionContent = '';

if (mdFile) {
  const mdPath = path.resolve('/srv/BusinessOps/data/outreach/edu_gov/course/modules', mdFile);
  const raw = fs.readFileSync(mdPath, 'utf-8');

  // Extract lessons: ## Lesson N: Title
  const lessonRegex = /^## Lesson \d+:\s*(.+)$/gm;
  const lessonMatches = [...raw.matchAll(lessonRegex)];

  for (let i = 0; i < lessonMatches.length; i++) {
    const start = lessonMatches[i].index! + lessonMatches[i][0].length;
    const end = i + 1 < lessonMatches.length
      ? lessonMatches[i + 1].index!
      : raw.indexOf('## Module', start) !== -1
        ? raw.indexOf('## Module', start)
        : raw.length;

    let content = raw.slice(start, end).trim();
    content = content.replace(/### IMAGE:[\s\S]*?(?=\n(?:###?\s|\*\*[A-Z])|$)/g, '').trim();
    content = content.replace(/## IMAGE:[\s\S]*?(?=\n---)/g, '').trim();

    content = content.replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>');
    content = content.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    content = content.replace(/\*(.+?)\*/g, '<em>$1</em>');

    content = content.replace(/^### \d+\.\s*(.+)$/gm, '<h4 class="text-lg font-semibold text-text mt-6 mb-2">$1</h4>');
    content = content.replace(/^### (.+)$/gm, '<h4 class="text-lg font-semibold text-text mt-6 mb-2">$1</h4>');

    content = content.replace(/^- (.+)$/gm, '<li class="ml-4">$1</li>');
    content = content.replace(/(<li[^>]*>.*<\/li>\n?)+/g, (match) => `<ul class="list-disc pl-5 space-y-1 text-muted my-3">${match}</ul>`);

    content = content.split('\n\n').map(block => {
      block = block.trim();
      if (!block) return '';
      if (block.startsWith('<')) return block;
      if (block.startsWith('---')) return '';
      return `<p class="text-muted leading-relaxed mb-4">${block}</p>`;
    }).join('\n');

    content = content.replace(/<p[^>]*>\*\*Canva search:\*\*[^<]*<\/p>/g, '');
    content = content
      .replace(/\bmay be worth it\b/gi, 'may be worth evaluating')
      .replace(/\bworth it\b/gi, 'worth evaluating')
      .replace(/\btop lenders\b/gi, 'major lenders');

    lessons.push({ title: lessonMatches[i][1], content });
  }

  // Extract quiz
  const quizMatch = raw.match(/## Module \d+ Quiz([\s\S]*?)(?=\n---\s*\n|\n\*\*CTA)/);
  if (quizMatch) {
    const quizBlock = quizMatch[1];
    const questionRegex = /\*\*Question \d+:\*\*\s*(.+?)(?=\n)/g;
    const qMatches = [...quizBlock.matchAll(questionRegex)];
    for (const qm of qMatches) {
      const qStart = qm.index! + qm[0].length;
      const qEnd = quizBlock.indexOf('**Question', qStart);
      const optionBlock = quizBlock.slice(qStart, qEnd === -1 ? undefined : qEnd);
      const optionRegex = /^-\s+(\*\*)?([A-D])\)(\*\*)?\s*(.+?)(?:\s*✓)?$/gm;
      const opts = [...optionBlock.matchAll(optionRegex)].map(om => ({
        label: om[2],
        text: om[4].replace(/\*\*/g, '').replace(/✓/g, '').trim(),
        correct: om[0].includes('✓'),
      }));
      if (opts.length > 0) {
        quizQuestions.push({ question: qm[1], options: opts });
      }
    }
  }

  const completionMatch = raw.match(/## 🎓 Congratulations[\s\S]*?(?=### IMAGE:|$)/);
  if (completionMatch) {
    completionContent = completionMatch[0];
  }
}

// Keep title under 60 chars for Google
const shortTitle = mod.title.replace(/ — .*$/, '');
const candidate = `${shortTitle} — Free Credit Course | CreditDoc`;
const title = candidate.length <= 60 ? candidate : `${shortTitle} | Free Course — CreditDoc`;
const description = mod.description;

const defaultContextLinks = [
  { href: '/answers/', label: 'Answers Library', description: 'Review short explanations connected to this module topic.' },
  { href: '/tools/', label: 'Financial Tools', description: 'Use CreditDoc calculators and simulators after studying the lesson.' },
  { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Compare course concepts with public CFPB complaint trends.' },
  { href: '/city/', label: 'Local City Guides', description: 'Connect education with local pages, maps, and state rule context.' },
];

const moduleContextLinks: Record<string, typeof defaultContextLinks> = {
  'understanding-your-credit-score': [
    { href: '/tools/credit-score-simulator/', label: 'Credit Score Simulator', description: 'Model score-factor scenarios while reviewing payment, balance, and account-history concepts.' },
    { href: '/glossary/#fico-score', label: 'FICO Score Definition', description: 'Review the glossary definition for one of the core scoring terms.' },
    { href: '/answers/', label: 'Credit Score Answers', description: 'Use question-led explainers for common credit-score topics.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Compare scoring topics with public credit-reporting complaint patterns.' },
  ],
  'how-to-read-your-credit-report': [
    { href: '/resources/credit-report-checklist/', label: 'Credit Report Checklist', description: 'Use a structured checklist while reviewing report sections and possible follow-up items.' },
    { href: '/resources/debt-credit-letter-templates/', label: 'Letter Templates', description: 'Review template language for common credit and debt correspondence.' },
    { href: '/answers/', label: 'Credit Report Answers', description: 'Move from report terms to common consumer questions.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Review credit-reporting complaint patterns from public CFPB data.' },
  ],
  'building-credit-from-scratch': [
    { href: '/tools/credit-score-simulator/', label: 'Credit Score Simulator', description: 'Estimate how credit-building behaviors can affect a score scenario.' },
    { href: '/financial-wellness/building-credit/', label: 'Building Credit Guides', description: 'Read longer CreditDoc explainers connected to starter-credit topics.' },
    { href: '/answers/', label: 'Credit Builder Answers', description: 'Review question-led pages for common first-credit decisions.' },
    { href: '/city/', label: 'Local City Guides', description: 'Connect general credit education with local lender and rule context.' },
  ],
  'managing-debt-effectively': [
    { href: '/tools/debt-payoff-calculator/', label: 'Debt Payoff Calculator', description: 'Compare payoff scenarios after studying repayment methods.' },
    { href: '/categories/debt-relief/', label: 'Debt Relief Research', description: 'Review provider-category context before comparing debt-relief options.' },
    { href: '/answers/', label: 'Debt Answers', description: 'Use question-led explainers for debt-management topics.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Check public complaint patterns for debt collection and debt relief topics.' },
  ],
  'credit-repair-diy-vs-hiring-help': [
    { href: '/resources/credit-report-checklist/', label: 'Credit Report Checklist', description: 'Organize report review before deciding how to handle dispute follow-up.' },
    { href: '/categories/credit-repair/', label: 'Credit Repair Research', description: 'Review category context before comparing credit repair providers.' },
    { href: '/resources/debt-credit-letter-templates/', label: 'Letter Templates', description: 'Use template examples for credit-report and debt correspondence.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Review public complaint trends connected to credit repair and reporting.' },
  ],
  'personal-loans-and-borrowing-smart': [
    { href: '/tools/borrowing-power-quiz/', label: 'Borrowing Power Quiz', description: 'Estimate borrowing context before comparing personal-loan options.' },
    { href: '/categories/personal-loans/', label: 'Personal Loan Research', description: 'Review provider-category context for personal loan comparisons.' },
    { href: '/city/', label: 'Local City Guides', description: 'Connect borrowing education with local lender pages and state rule context.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Check public complaint patterns for loan products and servicing topics.' },
  ],
  'avoiding-scams-and-predatory-lending': [
    { href: '/resources/', label: 'Resource Library', description: 'Use checklists and templates while reviewing warning signs and next steps.' },
    { href: '/answers/', label: 'Consumer Finance Answers', description: 'Review short explainers for common scam, debt, and lending questions.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Look at public complaint patterns for products and practices discussed in the module.' },
    { href: '/state/', label: 'State Rule Context', description: 'Check state-level pages where local rule context matters.' },
  ],
  'know-your-rights': [
    { href: '/resources/debt-credit-letter-templates/', label: 'Letter Templates', description: 'Review example correspondence for credit, debt, and dispute topics.' },
    { href: '/answers/', label: 'Rights Answers', description: 'Use question-led explainers for consumer-rights topics.' },
    { href: '/research/consumer-complaints/', label: 'Complaint Data Research', description: 'Compare rights topics with public complaint patterns.' },
    { href: '/state/', label: 'State Rule Context', description: 'Connect federal rights education with state-level context pages.' },
  ],
};

const contextLinks = moduleContextLinks[slug] || defaultContextLinks;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Course",
    "name": `Credit Fundamentals: ${mod.title}`,
    "description": mod.description,
    "url": `https://www.creditdoc.co/courses/credit-fundamentals/${slug}/`,
    "provider": { "@type": "Organization", "name": "CreditDoc", "url": "https://www.creditdoc.co" },
    "isAccessibleForFree": true,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "educationalLevel": "Beginner",
    "inLanguage": "en",
    "isPartOf": {
      "@type": "Course",
      "name": "Credit Fundamentals",
      "url": "https://www.creditdoc.co/courses/credit-fundamentals/"
    },
    "datePublished": "2026-05-15",
    "dateModified": "2026-05-15"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creditdoc.co/" },
      { "@type": "ListItem", "position": 2, "name": "Courses", "item": "https://www.creditdoc.co/courses/" },
      { "@type": "ListItem", "position": 3, "name": "Credit Fundamentals", "item": "https://www.creditdoc.co/courses/credit-fundamentals/" },
      { "@type": "ListItem", "position": 4, "name": mod.title, "item": `https://www.creditdoc.co/courses/credit-fundamentals/${slug}/` }
    ]
  }
];
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <!-- Breadcrumbs -->
  <nav class="max-w-4xl mx-auto px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted flex-wrap">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li><a href="/courses/" class="hover:text-primary transition-colors">Courses</a></li>
      <li class="text-border">/</li>
      <li><a href="/courses/credit-fundamentals/" class="hover:text-primary transition-colors">Credit Fundamentals</a></li>
      <li class="text-border">/</li>
      <li class="text-text font-medium">{mod.title}</li>
    </ol>
  </nav>

  <!-- Hero (always visible) -->
  <section class="bg-gradient-to-b from-primary/5 to-white border-b border-border">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold text-lg">{mod.number}</span>
        <span class="text-sm text-muted uppercase tracking-wider font-semibold">Module {mod.number} of {courseData.modules.length}</span>
      </div>
      <h1 class="text-3xl font-bold text-text sm:text-4xl">{mod.title}</h1>
      <p class="mt-4 text-lg text-muted leading-relaxed max-w-2xl">{mod.description}</p>
      <div class="mt-6 flex flex-wrap gap-4 text-sm text-muted">
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          {mod.duration}
        </span>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" /></svg>
          {mod.lessons} lessons
        </span>
        <span class="flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" /></svg>
          {mod.quizQuestions} quiz questions
        </span>
      </div>
      <!-- Progress bar -->
      <div class="mt-6">
        <div class="flex items-center justify-between text-xs text-muted mb-1">
          <span>Course progress</span>
          <span>{mod.number} / {courseData.modules.length} modules</span>
        </div>
        <div class="w-full bg-border/50 rounded-full h-2">
          <div class="bg-primary rounded-full h-2 transition-all" style={`width: ${(mod.number / courseData.modules.length) * 100}%`}></div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Table of Contents (always visible) -->
    <nav class="glass-card p-6 mb-10">
      <h2 class="text-lg font-bold text-text mb-3">In this module</h2>
      <ol class="space-y-2">
        {lessons.map((lesson, i) => (
          <li>
            <a href={`#lesson-${i + 1}`} class="toc-link flex items-center gap-3 text-sm text-muted hover:text-primary transition-colors group">
              <span class="shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold group-hover:bg-primary group-hover:text-white transition-colors">{i + 1}</span>
              <span>{lesson.title}</span>
            </a>
          </li>
        ))}
        {quizQuestions.length > 0 && (
          <li>
            <a href="#quiz" class="toc-link flex items-center gap-3 text-sm text-muted hover:text-primary transition-colors group">
              <span class="shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold group-hover:bg-primary group-hover:text-white transition-colors">?</span>
              <span>Quiz — Test your knowledge</span>
            </a>
          </li>
        )}
      </ol>
    </nav>

    <section class="glass-card p-6 sm:p-8 mb-10">
      <h2 class="text-xl font-bold text-text">Use This Module With CreditDoc Context</h2>
      <p class="mt-2 text-sm text-muted leading-relaxed">
        Use these related pages to connect the module to CreditDoc tools, local guides, provider-category research, templates, and public complaint data.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {contextLinks.map(link => (
          <a href={link.href} class="rounded-lg border border-border bg-white p-4 hover:border-primary/40 transition-colors">
            <span class="text-sm font-semibold text-text">{link.label}</span>
            <p class="mt-1 text-xs text-muted leading-relaxed">{link.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- ============================================ -->
    <!--  ENROLLMENT GATE — shown when NOT enrolled   -->
    <!-- ============================================ -->
    <div id="enrollment-gate" class="hidden">
      <!-- Teaser: first lesson preview (blurred) -->
      {lessons.length > 0 && (
        <div class="relative mb-8">
          <article class="mb-0 blur-sm select-none pointer-events-none" aria-hidden="true">
            <div class="flex items-center gap-3 mb-4">
              <span class="shrink-0 w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-sm font-bold">1</span>
              <h2 class="text-2xl font-bold text-text">{lessons[0].title}</h2>
            </div>
            <div class="prose-content pl-11" set:html={lessons[0].content.slice(0, 600) + '...'} />
          </article>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/60 to-white flex items-end justify-center pb-4">
          </div>
        </div>
      )}

      <!-- Enrollment form -->
      <div class="glass-card p-8 sm:p-10 border-2 border-primary/30 mb-10">
        <div class="text-center mb-6">
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-primary/10 mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" /></svg>
          </div>
          <h2 class="text-2xl font-bold text-text mb-3">Enroll to Unlock This Module</h2>
          <p class="text-muted max-w-lg mx-auto leading-relaxed">
            This module contains {mod.lessons} in-depth lessons and a {mod.quizQuestions}-question quiz. Enter your email to get instant access — plus we'll send you a <strong class="text-text">summary of the key takeaways</strong> from each module so you can review them anytime.
          </p>
        </div>

        <form id="gate-enroll-form" class="max-w-lg mx-auto">
          <div class="flex flex-col sm:flex-row gap-3 mb-3">
            <input type="text" id="gate-name" placeholder="First name" required class="flex-1 rounded-lg border border-border bg-white px-4 py-3 text-sm text-text placeholder:text-muted/60 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
            <input type="email" id="gate-email" placeholder="Email address" required class="flex-1 rounded-lg border border-border bg-white px-4 py-3 text-sm text-text placeholder:text-muted/60 focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20" />
          </div>
          <button type="submit" class="w-full rounded-lg bg-primary px-6 py-3.5 text-base font-semibold text-white hover:bg-primary/90 transition-colors">Enroll Free — Unlock All Modules</button>
          <p class="mt-4 text-xs text-muted text-center leading-relaxed">
            By enrolling, you agree to receive module summaries and course-related emails from CreditDoc. We'll send you 8 emails — one per module — with key takeaways and action steps. No spam, no third-party sharing. Unsubscribe with one click anytime.
          </p>
        </form>
        <div id="gate-error" class="hidden mt-4 text-red-500 text-sm text-center">Something went wrong. Please try again.</div>
      </div>

      <!-- What you'll learn in this module (visible to encourage signup) -->
      <div class="glass-card p-8 mb-10">
        <h2 class="text-xl font-bold text-text mb-4">What You'll Learn in Module {mod.number}</h2>
        <ul class="space-y-3">
          {lessons.map((lesson, i) => (
            <li class="flex items-start gap-3 text-muted">
              <span class="shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary text-xs font-bold mt-0.5">{i + 1}</span>
              <div>
                <p class="font-medium text-text">{lesson.title}</p>
              </div>
            </li>
          ))}
        </ul>
        <div class="mt-6 text-center">
          <a href="#gate-enroll-form" class="text-primary font-semibold hover:underline text-sm">Enroll free to access all lessons</a>
        </div>
      </div>

      <!-- Course overview link -->
      <div class="text-center mb-10">
        <a href="/courses/credit-fundamentals/" class="inline-flex items-center gap-2 text-primary font-medium hover:underline">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
          View full course overview
        </a>
      </div>
    </div>

    <!-- ============================================ -->
    <!--  FULL CONTENT — shown when enrolled          -->
    <!-- ============================================ -->
    <div id="course-content" class="hidden">

      <!-- Lessons -->
      {lessons.map((lesson, i) => (
        <article id={`lesson-${i + 1}`} class="mb-12 scroll-mt-20">
          <div class="flex items-center gap-3 mb-4">
            <span class="shrink-0 w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white text-sm font-bold">{i + 1}</span>
            <h2 class="text-2xl font-bold text-text">{lesson.title}</h2>
          </div>
          <div class="prose-content pl-11" set:html={lesson.content} />
        </article>
      ))}

      <!-- Quiz -->
      {quizQuestions.length > 0 && (
        <section id="quiz" class="glass-card p-8 mb-10 scroll-mt-20">
          <h2 class="text-2xl font-bold text-text mb-2">Module {mod.number} Quiz</h2>
          <p class="text-muted mb-6">Test what you've learned. Pick the most accurate answer for each question.</p>

          <div id="quiz-container">
            {quizQuestions.map((q, qi) => (
              <div class="quiz-question mb-8" data-question={qi}>
                <p class="font-semibold text-text mb-3">{qi + 1}. {q.question}</p>
                <div class="space-y-2">
                  {q.options.map((opt, oi) => (
                    <button
                      type="button"
                      class="quiz-option w-full text-left px-4 py-3 rounded-lg border border-border hover:border-primary/40 transition-colors text-sm text-text"
                      data-question={qi}
                      data-option={oi}
                      data-correct={opt.correct ? 'true' : 'false'}
                    >
                      <span class="font-semibold text-primary mr-2">{opt.label})</span> {opt.text}
                    </button>
                  ))}
                </div>
                <div class="quiz-feedback hidden mt-3 text-sm px-4 py-2 rounded-lg"></div>
              </div>
            ))}
          </div>

          <div id="quiz-result" class="hidden mt-6 p-4 rounded-lg text-center">
            <p class="text-lg font-bold text-text"><span id="quiz-score">0</span> / {quizQuestions.length} correct</p>
            <p id="quiz-message" class="text-muted mt-1"></p>
          </div>
        </section>
      )}

      <!-- CTA -->
      <div class="glass-card p-6 mb-10 border-2 border-primary/20 text-center">
        <p class="text-muted mb-3">Ready to take action?</p>
        <a href={mod.ctaUrl} class="inline-block rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-white hover:bg-primary/90 transition-colors">{softenYmylCopy(mod.ctaText)}</a>
      </div>

      <!-- Related Guides -->
      {mod.relatedGuides && mod.relatedGuides.length > 0 && (
        <div class="mb-10">
          <h2 class="text-xl font-bold text-text mb-4">Related Guides</h2>
          <div class="grid sm:grid-cols-2 gap-3">
            {mod.relatedGuides.map((guide: string) => {
              const guideName = guide.split('/').filter(Boolean).pop()?.replace(/-/g, ' ').replace(/\b\w/g, (l: string) => l.toUpperCase());
              return (
                <a href={guide} class="glass-card px-4 py-3 flex items-center gap-3 hover:border-primary/40 transition-colors group text-sm">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
                  <span class="text-text group-hover:text-primary transition-colors">{guideName}</span>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <!-- Prev/Next Navigation -->
      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        {prevMod ? (
          <a href={`/courses/credit-fundamentals/${prevMod.slug}/`} class="glass-card p-4 flex-1 flex items-center gap-3 hover:border-primary/40 transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary/50 group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <div>
              <span class="text-xs text-muted">Previous</span>
              <p class="text-sm font-semibold text-text group-hover:text-primary transition-colors">{prevMod.title}</p>
            </div>
          </a>
        ) : (
          <a href="/courses/credit-fundamentals/" class="glass-card p-4 flex-1 flex items-center gap-3 hover:border-primary/40 transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary/50 group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg>
            <div>
              <span class="text-xs text-muted">Back to</span>
              <p class="text-sm font-semibold text-text group-hover:text-primary transition-colors">Course Overview</p>
            </div>
          </a>
        )}
        {nextMod ? (
          <a href={`/courses/credit-fundamentals/${nextMod.slug}/`} class="glass-card p-4 flex-1 flex items-center gap-3 justify-end text-right hover:border-primary/40 transition-colors group">
            <div>
              <span class="text-xs text-muted">Next</span>
              <p class="text-sm font-semibold text-text group-hover:text-primary transition-colors">{nextMod.title}</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary/50 group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
          </a>
        ) : (
          <a href="/courses/credit-fundamentals/" class="glass-card p-4 flex-1 flex items-center gap-3 justify-end text-right hover:border-primary/40 transition-colors group">
            <div>
              <span class="text-xs text-muted">Complete!</span>
              <p class="text-sm font-semibold text-text group-hover:text-primary transition-colors">Back to Course Overview</p>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-primary/50 group-hover:text-primary transition-colors shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
          </a>
        )}
      </div>

    </div>
  </div>

  <script>
    // Gate logic: check enrollment status
    const isEnrolled = localStorage.getItem('cd_course_enrolled') === 'true';
    const gate = document.getElementById('enrollment-gate')!;
    const content = document.getElementById('course-content')!;

    if (isEnrolled) {
      gate.classList.add('hidden');
      content.classList.remove('hidden');
    } else {
      gate.classList.remove('hidden');
      content.classList.add('hidden');
    }

    // Enrollment form on module page
    document.getElementById('gate-enroll-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const name = (document.getElementById('gate-name') as HTMLInputElement).value.trim();
      const email = (document.getElementById('gate-email') as HTMLInputElement).value.trim();
      if (!email || !name) return;
      const btn = (e.target as HTMLFormElement).querySelector('button')!;
      (btn as HTMLButtonElement).disabled = true;
      btn.textContent = 'Enrolling...';
      try {
        const body = new URLSearchParams();
        body.append('list', 'Yj7BPjltZ5YG9nUBw892y93g');
        body.append('email', email);
        body.append('name', name);
        body.append('boolean', 'true');
        const res = await fetch('https://sendy.creditdoc.co/subscribe', { method: 'POST', body });
        const text = await res.text();
        if (text.trim() === '1' || text.includes('Already subscribed')) {
          localStorage.setItem('cd_course_enrolled', 'true');
          localStorage.setItem('cd_course_email', email);
          localStorage.setItem('cd_course_name', name);
          // Reveal content
          gate.classList.add('hidden');
          content.classList.remove('hidden');
          // Scroll to first lesson
          document.getElementById('lesson-1')?.scrollIntoView({ behavior: 'smooth' });
        } else {
          throw new Error(text);
        }
      } catch {
        document.getElementById('gate-error')!.classList.remove('hidden');
        (btn as HTMLButtonElement).disabled = false;
        btn.textContent = 'Enroll Free — Unlock All Modules';
      }
    });

    // Quiz logic (only runs when content is visible)
    let answered = 0;
    let correct = 0;
    const total = document.querySelectorAll('.quiz-question').length;

    document.querySelectorAll('.quiz-option').forEach(btn => {
      btn.addEventListener('click', () => {
        const qIndex = btn.getAttribute('data-question');
        const parent = document.querySelector(`.quiz-question[data-question="${qIndex}"]`)!;
        if (parent.classList.contains('answered')) return;
        parent.classList.add('answered');

        const isCorrect = btn.getAttribute('data-correct') === 'true';
        const feedback = parent.querySelector('.quiz-feedback') as HTMLElement;

        parent.querySelectorAll('.quiz-option').forEach(o => {
          (o as HTMLElement).style.pointerEvents = 'none';
          if (o.getAttribute('data-correct') === 'true') {
            o.classList.add('border-green-500', 'bg-green-50');
          }
        });

        if (isCorrect) {
          btn.classList.add('border-green-500', 'bg-green-50');
          feedback.textContent = 'Correct!';
          feedback.className = 'quiz-feedback mt-3 text-sm px-4 py-2 rounded-lg bg-green-50 text-green-700';
          correct++;
        } else {
          btn.classList.add('border-red-400', 'bg-red-50');
          feedback.textContent = 'Not quite — see the correct answer highlighted above.';
          feedback.className = 'quiz-feedback mt-3 text-sm px-4 py-2 rounded-lg bg-red-50 text-red-600';
        }
        feedback.classList.remove('hidden');

        answered++;
        if (answered === total) {
          const result = document.getElementById('quiz-result')!;
          const score = document.getElementById('quiz-score')!;
          const message = document.getElementById('quiz-message')!;
          score.textContent = String(correct);
          if (correct === total) {
            result.className = 'mt-6 p-4 rounded-lg text-center bg-green-50 border border-green-200';
            message.textContent = 'Perfect score! You\'ve mastered this module.';
          } else if (correct >= total * 0.6) {
            result.className = 'mt-6 p-4 rounded-lg text-center bg-primary/5 border border-primary/20';
            message.textContent = 'Good job! Review the lessons you missed and try again.';
          } else {
            result.className = 'mt-6 p-4 rounded-lg text-center bg-amber-50 border border-amber-200';
            message.textContent = 'Consider re-reading the lessons above before moving on.';
          }
          result.classList.remove('hidden');
        }
      });
    });
  </script>

  <style>
    .prose-content p { margin-bottom: 1rem; }
    .prose-content ul { margin: 0.75rem 0; }
    .prose-content li { padding-left: 0.25rem; }
  </style>
</BaseLayout>
