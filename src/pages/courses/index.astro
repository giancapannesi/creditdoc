---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Free Financial Literacy Courses | CreditDoc";
const description = "Free, self-paced courses on credit scores, credit reports, debt management, credit repair, and consumer rights. No cost, no credit check.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creditdoc.co/" },
    { "@type": "ListItem", "position": 2, "name": "Courses", "item": "https://www.creditdoc.co/courses/" }
  ]
};

const contextLinks = [
  { href: '/financial-wellness/', label: 'Wellness Guides', description: 'Read longer explainers that expand on credit, debt, loan, and budgeting lessons.' },
  { href: '/resources/credit-report-checklist/', label: 'Credit Report Checklist', description: 'Use a practical checklist while working through reporting and dispute lessons.' },
  { href: '/tools/credit-score-simulator/', label: 'Credit Score Simulator', description: 'Model how common credit factors can affect a score estimate.' },
  { href: '/city/', label: 'Local City Guides', description: 'Connect course topics with local lender pages, maps, and state rule context.' },
];
---

<BaseLayout title={title} description={description} jsonLd={[jsonLd]}>
  <nav class="max-w-4xl mx-auto px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li class="text-text font-medium">Courses</li>
    </ol>
  </nav>

  <section class="mx-auto max-w-4xl px-4 py-16 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold text-text mb-4">Free Financial Literacy Courses</h1>
    <p class="text-lg text-muted mb-12 max-w-2xl">Self-paced courses that explain how credit works, how consumer protections apply, and how to compare next steps with better context.</p>

    <a href="/courses/credit-fundamentals/" class="glass-card p-6 flex flex-col sm:flex-row items-start sm:items-center gap-6 hover:border-primary/40 transition-colors group block">
      <div class="shrink-0 w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 0 0-.491 6.347A48.62 48.62 0 0 1 12 20.904a48.62 48.62 0 0 1 8.232-4.41 60.46 60.46 0 0 0-.491-6.347m-15.482 0a50.636 50.636 0 0 0-2.658-.813A59.906 59.906 0 0 1 12 3.493a59.903 59.903 0 0 1 10.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0 1 12 13.489a50.702 50.702 0 0 1 7.74-3.342" /></svg>
      </div>
      <div class="flex-1">
        <h2 class="text-xl font-bold text-text group-hover:text-primary transition-colors">Credit Fundamentals</h2>
        <p class="text-muted mt-1">8 modules covering credit scores, reports, debt management, credit repair, personal loans, scam avoidance, and your legal rights.</p>
        <div class="mt-3 flex flex-wrap gap-4 text-xs text-muted">
          <span>8 modules</span>
          <span>40 lessons</span>
          <span>~2 hours</span>
          <span class="text-primary font-semibold">100% Free</span>
        </div>
      </div>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-primary/40 group-hover:text-primary transition-colors shrink-0 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
    </a>

    <div class="mt-12 glass-card p-6 sm:p-8">
      <h2 class="text-xl font-bold text-text">Use Courses With CreditDoc Context</h2>
      <p class="mt-2 text-sm text-muted leading-relaxed">
        Course pages are designed to connect education with the rest of CreditDoc: guides, tools, local pages, and research pages that help readers verify and compare what they learn.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2">
        {contextLinks.map(link => (
          <a href={link.href} class="rounded-lg border border-border bg-white p-4 hover:border-primary/40 transition-colors">
            <span class="text-sm font-semibold text-text">{link.label}</span>
            <p class="mt-1 text-xs text-muted leading-relaxed">{link.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
