---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LenderCard from '../../components/LenderCard.astro';
import LocalLeadCapture from '../../components/LocalLeadCapture.astro';
import CityLandingEnhancement from '../../components/CityLandingEnhancement.astro';
import { getCitiesWithLenders, getLendersByCityState, getCategories, getStateData } from '../../utils/data-build';
import type { CityInfo, Lender } from '../../utils/data';
import { softenYmylCopy } from '../../utils/safe-copy';
import cityLandingEnhancements from '../../content/local-city-landing-enhancements.json';

export function getStaticPaths() {
  const cities = getCitiesWithLenders(5);
  const stateData = getStateData();
  return cities.map(city => ({
    params: { slug: city.slug },
    props: { cityInfo: city, sd: stateData[city.stateAbbr] || null },
  }));
}

const { cityInfo, sd } = Astro.props as { cityInfo: CityInfo; sd: any };
const lenders = getLendersByCityState(cityInfo.city, cityInfo.stateAbbr);
const categories = getCategories();
const categoryAliases: Record<string, string> = {
  'fix-my-credit': 'credit-repair',
};

// Group lenders by category
const categoryGroups = new Map<string, Lender[]>();
for (const l of lenders) {
  const cat = categoryAliases[l.category] || l.category;
  if (!categoryGroups.has(cat)) categoryGroups.set(cat, []);
  categoryGroups.get(cat)!.push(l);
}

// Sort groups by count
const sortedGroups = Array.from(categoryGroups.entries())
  .sort((a, b) => b[1].length - a[1].length);

// Get category display names
const catNames: Record<string, string> = {};
for (const cat of categories) {
  catNames[cat.slug] = cat.name;
}

// Featured providers for local section, ordered by stored Google rating where available
const googleRatingValue = (l: Lender) => l.google_rating && l.google_rating > 0 && !(l.google_rating > 5) && l.google_reviews_count && l.google_reviews_count >= 1 ? l.google_rating : 0;
const featuredLenders = [...lenders].sort((a, b) => googleRatingValue(b) - googleRatingValue(a)).slice(0, 6);
const rawCityEnhancement = (cityLandingEnhancements as Record<string, any>)[cityInfo.slug] || null;

function normalizeLocalEnhancementLink(link: any) {
  const href = String(link?.href || '');
  const browseMatch = href.match(/^\/browse\/([^/]+)\/([^/]+)\/$/);
  if (!browseMatch) return link;
  const [, catSlug, citySlug] = browseMatch;
  const items = categoryGroups.get(catSlug) || [];
  if (citySlug === cityInfo.slug && items.length >= 5) return link;
  const label = String(link?.label || catNames[catSlug] || 'Related provider category');
  return {
    ...link,
    label: label.replace(/\s+in\s+.+$/i, ''),
    href: `/categories/${catSlug}/`,
  };
}

const cityEnhancement = rawCityEnhancement
  ? {
      ...rawCityEnhancement,
      priorityLinks: (rawCityEnhancement.priorityLinks || []).map(normalizeLocalEnhancementLink),
    }
  : null;

// Map center (use city name for Google Maps embed)
const mapQuery = `${cityInfo.city}, ${cityInfo.stateAbbr}`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": `Credit Repair & Financial Services in ${cityInfo.city}, ${cityInfo.state}`,
    "description": `Review ${lenders.length} credit repair companies, personal lenders, and financial services in ${cityInfo.city}, ${cityInfo.stateAbbr}. Compare stored ratings, pricing fields, and BBB context where available.`,
    "url": `https://www.creditdoc.co/city/${cityInfo.slug}/`,
    "about": {
      "@type": "City",
      "name": cityInfo.city,
      "containedInPlace": {
        "@type": "State",
        "name": cityInfo.state,
      }
    }
  },
  ...(featuredLenders.length > 0 ? [{
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": `Financial Service Profiles in ${cityInfo.city}, ${cityInfo.stateAbbr}`,
    "itemListOrder": "https://schema.org/ItemListOrderDescending",
    "numberOfItems": featuredLenders.length,
    "itemListElement": featuredLenders.map((l: any, i: number) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": l.name,
      "url": `https://www.creditdoc.co/review/${l.slug}/`,
    })),
  }] : []),
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creditdoc.co/" },
      { "@type": "ListItem", "position": 2, "name": "Cities", "item": "https://www.creditdoc.co/city/" },
      { "@type": "ListItem", "position": 3, "name": `${cityInfo.city}, ${cityInfo.stateAbbr}`, "item": `https://www.creditdoc.co/city/${cityInfo.slug}/` }
    ]
  },
  ...(cityEnhancement ? [{
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "name": `Frequently asked questions in ${cityInfo.city}, ${cityInfo.stateAbbr}`,
    "mainEntity": cityEnhancement.localFaqs.map((faq: any) => ({
      "@type": "Question",
      "name": faq.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": faq.a,
      },
    })),
  }] : []),
];
---

<BaseLayout
  title={`Credit Repair & Financial Services in ${cityInfo.city}, ${cityInfo.stateAbbr} (2026) | CreditDoc`}
  description={`Review ${lenders.length} credit repair companies, personal lenders, and financial services in ${cityInfo.city}, ${cityInfo.state}. Stored ratings, BBB context, and pricing fields where available.`}
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs -->
  <div class="border-b border-border bg-white">
    <div class="mx-auto max-w-7xl px-4 py-3 sm:px-6 lg:px-8">
      <nav class="flex items-center text-sm text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-primary transition-colors">Home</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-2 h-4 w-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
        </svg>
        <a href="/city/" class="hover:text-primary transition-colors">Cities</a>
        <svg xmlns="http://www.w3.org/2000/svg" class="mx-2 h-4 w-4 flex-shrink-0" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/>
        </svg>
        <span class="text-text font-medium">{cityInfo.city}, {cityInfo.stateAbbr}</span>
      </nav>
    </div>
  </div>

  <!-- Hero -->
  <section class="bg-white border-b border-border">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-center">
        <div>
          <span class="inline-block rounded-full bg-primary-light px-4 py-1.5 text-xs font-semibold text-primary uppercase tracking-wider mb-4">
            {cityInfo.city}, {cityInfo.stateAbbr}
          </span>
          <h1 class="text-3xl font-bold text-text sm:text-4xl leading-tight">
            Credit Repair & Financial Services in {cityInfo.city}
          </h1>
          <p class="mt-4 text-lg text-muted leading-relaxed">
            Review {lenders.length} credit repair companies, personal lenders, and financial services in {cityInfo.city}, {cityInfo.state}. Profiles include stored ratings, BBB context, pricing fields, maps, and local rules where available.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            {sortedGroups.slice(0, 4).map(([cat, items]) => (
              <a
                href={`#${cat}`}
                class="inline-flex items-center gap-1.5 rounded-full border border-border px-3.5 py-1.5 text-sm text-text hover:border-primary/30 hover:bg-primary-light/20 transition-colors"
              >
                <span class="font-medium">{catNames[cat] || cat}</span>
                <span class="text-xs text-muted">({items.length})</span>
              </a>
            ))}
          </div>
        </div>
        <div class="rounded-xl overflow-hidden border border-border shadow-sm">
          <iframe
            src={`https://www.google.com/maps?q=${encodeURIComponent(mapQuery + ' credit repair financial services')}&output=embed`}
            width="100%"
            height="280"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Map of financial services in ${cityInfo.city}`}
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  {/* State economic context */}
  {sd && (
    <div class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-4 text-xs text-muted">
        {sd.avg_credit_score && (
          <span class="flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
            {cityInfo.state} avg credit score: <strong class="text-text">{sd.avg_credit_score}</strong>
          </span>
        )}
        {sd.median_household_income && (
          <span>Median income: <strong class="text-text">${sd.median_household_income.toLocaleString()}</strong></span>
        )}
        {sd.poverty_rate && (
          <span>Poverty rate: <strong class="text-text">{sd.poverty_rate}%</strong></span>
        )}
        {sd.payday_loan_status && (
          <span class:list={["font-medium px-1.5 py-0.5 rounded",
            sd.payday_loan_status === 'Banned' ? 'bg-positive-light text-positive' :
            sd.payday_loan_status === 'Restricted' ? 'bg-warning-light text-warning' :
            'bg-negative-light text-negative']}>
            Payday loans: {sd.payday_loan_status}
          </span>
        )}
        <a href={`/state/${cityInfo.state.toLowerCase().replace(/\s+/g, '-')}/`} class="text-primary hover:underline ml-auto">
          {cityInfo.state} overview &rarr;
        </a>
      </div>
    </div>
  )}

  <LocalLeadCapture
    city={cityInfo.city}
    stateAbbr={cityInfo.stateAbbr}
    stateName={cityInfo.state}
    routeFamily="city"
    consumerRightsSummary={sd?.consumer_rights_summary ? softenYmylCopy(sd.consumer_rights_summary) : null}
    usuryCap={sd?.usury_cap || null}
    paydayLoanStatus={sd?.payday_loan_status || null}
    consumerProtectionAgency={sd?.consumer_protection_agency || null}
    consumerProtectionUrl={sd?.consumer_protection_url || null}
    licensingBoard={sd?.licensing_board || null}
  />

  {cityEnhancement && (
    <CityLandingEnhancement
      city={cityInfo.city}
      stateAbbr={cityInfo.stateAbbr}
      enhancement={cityEnhancement}
    />
  )}

  <!-- Featured Providers -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold text-text">Featured Provider Profiles in {cityInfo.city}</h2>
      <span class="text-sm text-muted">{lenders.length} companies</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredLenders.map(lender => (
        <LenderCard lender={lender} />
      ))}
    </div>
  </section>

  <!-- By Category -->
  {sortedGroups.map(([cat, items]) => (
    <section id={cat} class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-xl font-bold text-text">
          {catNames[cat] || cat} in {cityInfo.city}
        </h2>
        <a
          href={`/categories/${cat}/`}
          class="text-sm font-medium text-primary hover:text-primary-hover transition-colors"
        >
          View all &rarr;
        </a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {items.sort((a: any, b: any) => googleRatingValue(b) - googleRatingValue(a)).slice(0, 6).map((lender: any) => (
          <LenderCard lender={lender} />
        ))}
      </div>
      {items.length >= 5 ? (
        <div class="mt-4 text-center">
          <a
            href={`/browse/${cat}/${cityInfo.slug}/`}
            class="text-sm font-medium text-primary hover:text-primary-hover transition-colors"
          >
            View all {items.length} {catNames[cat] || cat} providers in {cityInfo.city} &rarr;
          </a>
        </div>
      ) : items.length > 6 && (
        <div class="mt-4 text-center">
          <a
            href={`/search/?city=${encodeURIComponent(cityInfo.city)}`}
            class="text-sm font-medium text-primary hover:text-primary-hover transition-colors"
          >
            View all {items.length} {catNames[cat] || cat} providers in {cityInfo.city} &rarr;
          </a>
        </div>
      )}
    </section>
  ))}

  <!-- Know Your Rights -->
  <section class="bg-white border-t border-b border-border">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
      <h2 class="text-xl font-bold text-text mb-4">Your Rights in {cityInfo.state}</h2>
      <div class="glass-card p-6 space-y-4 text-sm text-muted leading-relaxed">
        {sd?.consumer_rights_summary && (
          <p><strong class="text-text">{cityInfo.state} Consumer Protections:</strong> {softenYmylCopy(sd.consumer_rights_summary)}</p>
        )}
        {sd?.usury_cap && (
          <p><strong class="text-text">Interest Rate Cap:</strong> {cityInfo.state} usury cap: {sd.usury_cap}.
            {sd.payday_loan_status === 'Banned' && ' Payday lending is banned in this state.'}
            {sd.payday_loan_status === 'Restricted' && ` Payday lending is restricted${sd.max_payday_amount ? ` (max $${sd.max_payday_amount})` : ''}.`}
          </p>
        )}
        {sd?.key_regulations && sd.key_regulations.length > 0 && (
          <div>
            <strong class="text-text">Key Regulations:</strong>
            <ul class="mt-1 ml-4 list-disc space-y-0.5">
              {sd.key_regulations.map((reg: string) => <li>{softenYmylCopy(reg)}</li>)}
            </ul>
          </div>
        )}
        <p>
          <strong class="text-text">Federal protections:</strong> The FCRA gives you the right to dispute inaccurate credit report information for free. Credit repair companies cannot charge before performing services (Credit Repair Organizations Act).
        </p>
        <p>
          <strong class="text-text">Free resources:</strong> Get a free credit report annually at <a href="https://www.annualcreditreport.com" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">AnnualCreditReport.com</a>.
          {sd?.consumer_protection_url ? (
            <> File complaints with <a href={sd.consumer_protection_url} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{sd.consumer_protection_agency || `${cityInfo.state} consumer protection`}</a>.</>
          ) : (
            <> HUD-approved counselors in {cityInfo.city} offer free guidance at <a href="https://www.consumerfinance.gov/housing/" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">consumerfinance.gov</a>.</>
          )}
        </p>
      </div>
    </div>
  </section>

  <!-- Research Resources -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 class="text-xl font-bold text-text mb-4">Research Service Guides</h2>
    <p class="text-sm text-muted mb-4">Use these guides with local pages, state rules, and provider profiles before contacting a company.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href="/best/best-credit-repair-companies/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Credit Repair Guide</p>
        <p class="text-xs text-muted mt-1">Company profiles compared</p>
      </a>
      <a href="/best/best-personal-loans-bad-credit/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Personal Loans</p>
        <p class="text-xs text-muted mt-1">Options for bad credit</p>
      </a>
      <a href="/best/best-debt-consolidation-loans/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Debt Consolidation</p>
        <p class="text-xs text-muted mt-1">Simplify your payments</p>
      </a>
      <a href="/financial-wellness/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Free Guides</p>
        <p class="text-xs text-muted mt-1">Financial wellness education</p>
      </a>
    </div>
  </section>

  <!-- Other Cities -->
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <h2 class="text-xl font-bold text-text mb-6">Browse Other Cities</h2>
    <div class="flex flex-wrap gap-2">
      {getCitiesWithLenders(30).filter(c => c.slug !== cityInfo.slug).slice(0, 24).map(city => (
        <a
          href={`/city/${city.slug}/`}
          class="inline-flex items-center gap-1 rounded-full border border-border px-3 py-1.5 text-sm text-text hover:border-primary/30 hover:bg-primary-light/20 transition-colors"
        >
          {city.city}, {city.stateAbbr}
          <span class="text-xs text-muted">({city.count})</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Disclaimer -->
  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="rounded-lg bg-bg-alt border border-border p-4">
      <p class="text-xs text-muted leading-relaxed">
        <strong class="text-text">Affiliate Disclosure:</strong> CreditDoc may earn a commission when you click links to products and services featured on this page. Compensation does not determine whether a provider can be covered or how visible star ratings are calculated. <a href="/disclosure/" class="text-primary hover:underline">Learn more</a>.
      </p>
    </div>
  </section>
</BaseLayout>
