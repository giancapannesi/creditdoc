---
// iter 37: SSR-fed search. The page is now a tiny shell — results come from
// /api/search/ at request time. Replaces the prior 20MB inline-data embed.
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import { US_STATES, STATE_ABBREVIATIONS } from '../utils/data';

const stateEntries = US_STATES.map((state) => ({
  name: state,
  abbr: STATE_ABBREVIATIONS[state] || '',
}));
---

<BaseLayout
  title="Search Credit Repair Companies by Location | CreditDoc"
  description="Search and filter credit repair companies by state, city, budget, and BBB rating. Find services available in your area."
  noindex={true}
>
  <!-- Header -->
  <section class="bg-white border-b border-border">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 text-center">
      <h1 class="text-2xl sm:text-3xl font-bold text-text">Search Credit Repair Companies</h1>
      <p class="mt-2 text-muted">Find companies by location, budget, BBB rating, and more.</p>
    </div>
  </section>

  <!-- Search Bar Component -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <SearchBar />
  </section>

  <!-- Results Header -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between mb-4">
      <h2 id="results-heading" class="text-lg font-bold text-text">
        All Companies (<span id="results-count">…</span>)
      </h2>
      <select
        id="sort-select"
        class="rounded-lg border border-border bg-white px-3 py-2 text-sm text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
      >
        <option value="rating">Highest Google Rated</option>
        <option value="reviews">Most Reviewed</option>
        <option value="price-low">Lowest Price</option>
        <option value="price-high">Highest Price</option>
        <option value="name">Alphabetical</option>
      </select>
    </div>
  </section>

  <!-- Results Grid (dynamically rendered) -->
  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6 lg:px-8">
    <!-- Loading state -->
    <div id="loading-state" class="text-center py-16 text-muted text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="animate-spin h-6 w-6 mx-auto mb-3 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="3" opacity="0.25"/><path d="M12 2a10 10 0 0 1 10 10" stroke-width="3"/></svg>
      Searching…
    </div>

    <div id="results-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 hidden"></div>

    <!-- Load More -->
    <div id="load-more-wrap" class="hidden mt-8 text-center">
      <button
        id="load-more-btn"
        class="inline-flex items-center px-6 py-3 rounded-lg border-2 border-primary text-primary text-sm font-semibold hover:bg-primary-light transition-colors"
      >
        Show More Results
        <span id="load-more-count" class="ml-2 text-muted text-xs"></span>
      </button>
    </div>

    <!-- No Results State -->
    <div id="no-results" class="hidden glass-card p-12 text-center">
      <div class="mx-auto w-16 h-16 rounded-2xl bg-bg-alt flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-muted" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
        </svg>
      </div>
      <h3 class="text-lg font-semibold text-text">No companies found</h3>
      <p class="mt-2 text-sm text-muted">Try adjusting your search filters or browsing all companies.</p>
      <button
        id="clear-filters-btn"
        class="mt-4 inline-flex items-center px-5 py-2.5 rounded-lg bg-primary text-white text-sm font-medium hover:bg-primary-hover transition-colors"
      >
        Clear All Filters
      </button>
    </div>
  </section>

  <!-- Search Error State -->
  <section id="search-error-section" class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 hidden">
    <div class="glass-card p-6 text-sm text-muted text-center">
      Search service is temporarily unavailable — please try again in a moment.
    </div>
  </section>

  <!-- US States Map Section -->
  <section id="browse-by-state" class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="glass-card p-6">
      <h2 class="text-lg font-bold text-text mb-4 text-center">Browse by State</h2>
      <div class="grid grid-cols-5 sm:grid-cols-10 gap-2">
        {stateEntries.map(state => (
          <a
            href={`/search/?state=${encodeURIComponent(state.name)}`}
            class="flex items-center justify-center px-2 py-2 rounded-lg text-xs font-medium text-text bg-bg-alt hover:bg-primary-light hover:text-primary transition-colors border border-transparent hover:border-primary/20"
            title={state.name}
          >
            {state.abbr}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Client-side controller -->
  <script>
    const PAGE_SIZE = 48;
    let currentResults = [];
    let displayedCount = 0;

    function bbbClass(rating) {
      if (rating === 'A+') return 'bbb-a-plus';
      if (rating === 'A') return 'bbb-a';
      if (rating === 'B+') return 'bbb-b-plus';
      if (rating === 'B') return 'bbb-b';
      if (rating === 'C' || rating === 'C+' || rating === 'C-') return 'bbb-c';
      if (rating === 'F') return 'bbb-f';
      return 'bbb-nr';
    }

    function fmtPrice(p) {
      if (!p || p === 0) return 'Contact';
      return '$' + p.toFixed(2);
    }

    function starsSvg(rating) {
      const r = rating || 0;
      const full = Math.floor(r);
      const half = r - full >= 0.25;
      let html = '<div class="flex items-center gap-1">';
      const star = '<svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
      const halfStar = '<svg class="h-3.5 w-3.5 text-amber-400" viewBox="0 0 20 20" fill="currentColor" style="clip-path:inset(0 50% 0 0)"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
      const empty = '<svg class="h-3.5 w-3.5 text-gray-200" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>';
      for (let i = 0; i < 5; i++) {
        if (i < full) html += star;
        else if (i === full && half) html += halfStar;
        else html += empty;
      }
      html += '<span class="text-xs font-medium text-text ml-1">' + r.toFixed(1) + '</span></div>';
      return html;
    }

    function escapeHtml(s) {
      return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function renderCard(l) {
      const priceLabel = l.mp > 0 ? fmtPrice(l.mp) + '/mo' : 'Contact';
      const bestFor = (l.bf || []).slice(0, 2).map(escapeHtml).join(', ');
      const reviewCount = l.gr > 0 ? '<span class="text-xs text-muted ml-1">(' + l.gr.toLocaleString() + ' reviews)</span>' : '';
      return `<article class="glass-card p-5 sm:p-6 flex flex-col h-full">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-14 h-14 rounded-xl bg-bg-alt border border-border flex items-center justify-center overflow-hidden">
            <span class="text-lg font-bold text-primary">${escapeHtml(l.n.charAt(0))}</span>
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-semibold text-text truncate">${escapeHtml(l.n)}</h3>
            <p class="text-sm text-muted mt-0.5 line-clamp-2">${escapeHtml(l.ds)}</p>
          </div>
        </div>
        <div class="mt-4">${l.r > 0 && l.gr > 0 ? starsSvg(l.r) + reviewCount : '<p class="text-xs text-muted">No verified Google rating</p>'}</div>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-bg-alt px-3 py-1 text-xs font-semibold text-text border border-border">${priceLabel}</span>
          <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ${bbbClass(l.bb)}">BBB: ${escapeHtml(l.bb)}</span>
          ${l.mg ? '<span class="inline-flex items-center rounded-full bg-positive/10 text-positive px-2.5 py-0.5 text-xs font-semibold">Guarantee</span>' : ''}
        </div>
        ${bestFor ? '<div class="mt-3"><p class="text-xs text-muted"><span class="font-medium">Best for:</span> ' + bestFor + '</p></div>' : ''}
        <div class="flex-1"></div>
        <div class="mt-5">
          <a href="/review/${encodeURIComponent(l.s)}/" class="flex items-center justify-center w-full rounded-lg bg-primary px-4 py-3 text-sm font-semibold text-white hover:bg-primary-hover transition-colors min-h-[44px]">
            View Details
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
          </a>
        </div>
      </article>`;
    }

    function renderCards(lenders, startIdx, count) {
      const grid = document.getElementById('results-grid');
      if (!grid) return;
      const end = Math.min(startIdx + count, lenders.length);
      const frag = document.createDocumentFragment();
      for (let i = startIdx; i < end; i++) {
        const div = document.createElement('div');
        div.innerHTML = renderCard(lenders[i]);
        if (div.firstElementChild) frag.appendChild(div.firstElementChild);
      }
      grid.appendChild(frag);
      displayedCount = end;
      updateLoadMore(lenders.length);
    }

    function updateLoadMore(total) {
      const wrap = document.getElementById('load-more-wrap');
      const countEl = document.getElementById('load-more-count');
      if (!wrap) return;
      const remaining = total - displayedCount;
      if (remaining > 0) {
        wrap.classList.remove('hidden');
        if (countEl) countEl.textContent = `(${remaining} more)`;
      } else {
        wrap.classList.add('hidden');
      }
    }

    function getParams() {
      const params = new URLSearchParams(window.location.search);
      return {
        mode: params.get('mode') || '',
        category: params.get('category') || '',
        q: (params.get('q') || '').trim(),
        state: (params.get('state') || '').trim(),
        city: (params.get('city') || '').trim(),
        guarantee: params.get('guarantee') === '1',
        bbb_a_plus: params.get('bbb_a_plus') === '1',
        free_consult: params.get('free_consult') === '1',
        bbb: params.get('bbb') || '',
      };
    }

    function applyClientSort(rows, sortValue) {
      // The API returns enriched-first by default; we re-sort by user choice.
      rows.sort((a, b) => {
        if (sortValue === 'rating') return (b.r || 0) - (a.r || 0);
        if (sortValue === 'reviews') return (b.gr || 0) - (a.gr || 0);
        if (sortValue === 'price-low') return (a.mp || 0) - (b.mp || 0);
        if (sortValue === 'price-high') return (b.mp || 0) - (a.mp || 0);
        if (sortValue === 'name') return a.n.localeCompare(b.n);
        // Default: enriched first → quality tier → stored Google rating
        if (a.en !== b.en) return b.en - a.en;
        const aTier = a.qs >= 10 ? 2 : a.qs >= 5 ? 1 : 0;
        const bTier = b.qs >= 10 ? 2 : b.qs >= 5 ? 1 : 0;
        if (aTier !== bTier) return bTier - aTier;
        return (b.r || 0) - (a.r || 0);
      });
    }

    function applyCityFilter(rows, cityRaw) {
      if (!cityRaw) return rows;
      const cityName = cityRaw.split(',')[0].trim().toLowerCase();
      return rows.filter((r) =>
        (r.ct || []).some((c) => c.toLowerCase() === cityName) ||
        (r.st || []).some((s) => s.toLowerCase() === 'all' || s === 'All 50 States')
      );
    }

    async function runSearch() {
      const params = getParams();
      const loading = document.getElementById('loading-state');
      const grid = document.getElementById('results-grid');
      const noResults = document.getElementById('no-results');
      const errorSection = document.getElementById('search-error-section');
      const heading = document.getElementById('results-heading');
      const countEl = document.getElementById('results-count');

      if (!grid || !noResults) return;

      // Show loading, hide everything else
      loading?.classList.remove('hidden');
      grid.classList.add('hidden');
      noResults.classList.add('hidden');
      errorSection?.classList.add('hidden');
      grid.innerHTML = '';
      displayedCount = 0;
      currentResults = [];

      // Build API URL
      const api = new URLSearchParams();
      if (params.q) api.set('q', params.q);
      if (params.category) api.set('category', params.category);
      if (params.state) api.set('state', params.state);
      if (params.guarantee) api.set('guarantee', '1');
      if (params.free_consult) api.set('free_consult', '1');
      if (params.bbb_a_plus) api.set('bbb_a_plus', '1');
      if (params.bbb) api.set('bbb', params.bbb);
      api.set('limit', '300');

      let payload = null;
      try {
        const res = await fetch('/api/search/?' + api.toString(), {
          headers: { accept: 'application/json' },
        });
        if (!res.ok) throw new Error('http_' + res.status);
        payload = await res.json();
      } catch (err) {
        loading?.classList.add('hidden');
        errorSection?.classList.remove('hidden');
        return;
      }

      let rows = (payload && payload.results) || [];
      // Client-side city filter (city info isn't a direct DB column)
      rows = applyCityFilter(rows, params.city);
      // Sort per current select
      const sortSelect = document.getElementById('sort-select');
      const sortValue = sortSelect && sortSelect.value ? sortSelect.value : 'rating';
      applyClientSort(rows, sortValue);

      currentResults = rows;
      loading?.classList.add('hidden');

      if (rows.length === 0) {
        noResults.classList.remove('hidden');
        grid.classList.add('hidden');
        if (countEl) countEl.textContent = '0';
      } else {
        grid.classList.remove('hidden');
        noResults.classList.add('hidden');
        renderCards(rows, 0, PAGE_SIZE);
        if (countEl) countEl.textContent = String(rows.length);
      }

      // Heading text
      let headingText = 'All Companies';
      if (params.category) {
        const labels = {
          'credit-repair': 'Credit Repair',
          'personal-loans': 'Personal Loans',
          'emergency-cash': 'Emergency Cash',
          'payday-alternatives': 'Payday Alternatives',
          'debt-relief': 'Debt Relief',
          'build-credit': 'Credit Building',
          'credit-monitoring': 'Credit Monitoring & Protection',
          'free-help': 'Free Help',
        };
        headingText = (labels[params.category] || params.category) + ' Results';
      } else if (params.state && params.city) {
        headingText = `Companies in ${params.city.split(',')[0].trim()}, ${params.state}`;
      } else if (params.state) {
        headingText = `Companies in ${params.state}`;
      } else if (params.city) {
        headingText = `Companies in ${params.city.split(',')[0].trim()}`;
      } else if (params.q) {
        headingText = `Results for "${params.q}"`;
      }
      if (heading) {
        heading.innerHTML = `${headingText} (<span id="results-count">${rows.length}</span>)`;
      }
    }

    // Initial fetch on load
    runSearch();

    // SearchBar submits with new URL params, then dispatches this event
    window.addEventListener('searchbar:submit', runSearch);

    // Sort change re-sorts the cached result set without refetching
    document.getElementById('sort-select')?.addEventListener('change', () => {
      const grid = document.getElementById('results-grid');
      if (!grid || currentResults.length === 0) return;
      const sortSelect = document.getElementById('sort-select');
      applyClientSort(currentResults, sortSelect && sortSelect.value ? sortSelect.value : 'rating');
      grid.innerHTML = '';
      displayedCount = 0;
      renderCards(currentResults, 0, PAGE_SIZE);
    });

    // Load More — render next PAGE_SIZE from current cached set
    document.getElementById('load-more-btn')?.addEventListener('click', () => {
      renderCards(currentResults, displayedCount, PAGE_SIZE);
    });

    // Clear filters
    document.getElementById('clear-filters-btn')?.addEventListener('click', () => {
      window.history.pushState({}, '', '/search/');
      const svcForm = document.getElementById('search-form-services');
      const loanForm = document.getElementById('search-form-loans');
      if (svcForm && svcForm.reset) svcForm.reset();
      if (loanForm && loanForm.reset) loanForm.reset();
      runSearch();
    });
  </script>
</BaseLayout>
