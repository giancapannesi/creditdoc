---
import LetterTemplatePage from '../../../../components/LetterTemplatePage.astro';

const page = {
  title: 'Pay-for-Delete Letter Template | CreditDoc',
  description: 'Use this free pay-for-delete letter template carefully, with clear warnings that collectors may refuse and accurate credit information may remain.',
  canonical: 'https://www.creditdoc.co/resources/debt-credit-letter-templates/pay-for-delete-letter/',
  h1: 'Pay-for-Delete Letter Template',
  kicker: 'Pay-for-Delete Letter',
  intro: 'Use this template only when you are considering a written payment offer tied to a request about credit reporting. Pay-for-delete is not guaranteed, creditors and collectors may refuse, and credit bureaus are not required to remove accurate information because you paid.',
  published: '2026-05-19',
  modified: '2026-05-19',
  designedFor: [
    'Consumers considering settlement of a collection account',
    'People who want any payment-related reporting request in writing',
    'Readers who understand removal is not guaranteed',
    'Educators explaining why accurate negative information can remain',
  ],
  whenToUse: [
    'You have identified the collector or creditor and the account involved.',
    'You are willing and able to make the payment only if written terms are acceptable.',
    'You want to avoid paying based only on a phone promise.',
    'You understand that the request may be refused.',
  ],
  whenNotToUse: [
    'You do not recognize the debt; request validation first.',
    'You are asking a credit bureau to remove accurate information without a factual basis.',
    'You cannot afford the payment you are offering.',
    'You have not considered tax, legal, or settlement consequences.',
  ],
  gatherFirst: [
    'The collector or creditor name, address, account number, and current claimed balance.',
    'Written confirmation that the company is authorized to collect or settle the account.',
    'Your maximum affordable payment amount and the date you could pay.',
    'Copies of credit reports showing how the account is currently reported.',
    'A plan to get written acceptance before sending money.',
  ],
  templateTitle: 'Editable pay-for-delete request',
  templateBody: [
    '[Your full name]',
    '[Your mailing address]',
    '[City, State ZIP]',
    '[Date]',
    '',
    '[Collector or creditor name]',
    '[Mailing address]',
    '[City, State ZIP]',
    '',
    'Re: Proposed payment arrangement',
    'Account or reference number: [insert number if shown]',
    '',
    'To whom it may concern:',
    '',
    'I am writing about the account referenced above. Without admitting liability for this account, I am willing to discuss resolving the matter if the terms are confirmed in writing before any payment is made.',
    '',
    'My proposed payment amount is [insert amount]. In exchange, I request written confirmation of how your company will report or update this account with any consumer reporting agencies after payment. If you are willing to request deletion or removal, please state that clearly in your written response.',
    '',
    'I will not send payment based on a verbal promise. Please send any proposed agreement in writing, including the payment amount, due date, account number, and the exact credit reporting action your company agrees to take.',
    '',
    'Sincerely,',
    '',
    '[Your printed name]',
  ],
  checklist: [
    'I validated or recognized the debt before making an offer.',
    'I can afford the amount I proposed.',
    'I did not rely on a phone promise.',
    'I understand deletion is not guaranteed.',
    'I understand accurate information may remain on credit reports.',
    'I saved current credit report screenshots or PDFs.',
    'I will get written acceptance before paying.',
    'I considered possible tax or legal consequences of settlement.',
  ],
  whereToSend: [
    {
      title: 'The collector or creditor handling the account',
      href: '/categories/debt-relief/',
      text: 'Send the request only to the company authorized to accept payment or settle the account. Use CreditDoc category pages for context, not as a substitute for verifying authority.',
    },
    {
      title: 'Credit bureau dispute resources',
      href: '/resources/credit-report-checklist/',
      text: 'If the issue is inaccurate reporting rather than a settlement request, start with the CreditDoc checklist and dispute process instead.',
    },
  ],
  relatedTemplates: [
    {
      title: 'Debt Validation Letter',
      href: '/resources/debt-credit-letter-templates/debt-validation-letter/',
      text: 'Use this before offering payment if you do not recognize the debt or collector.',
    },
    {
      title: 'Cease and Desist Debt Collector Letter',
      href: '/resources/debt-credit-letter-templates/cease-and-desist-debt-collector-letter/',
      text: 'Use this when the immediate issue is unwanted contact from a collector.',
    },
  ],
  relatedAnswers: [
    {
      title: 'Can I do debt consolidation myself?',
      href: '/answers/can-i-do-debt-consolidation-myself/',
      text: 'Compare do-it-yourself organization steps before paying or consolidating collections.',
    },
    {
      title: 'Debt consolidation vs. personal loan',
      href: '/answers/debt-consolidation-vs-personal-loan/',
      text: 'Understand whether a new loan is a sensible alternative to settlement.',
    },
  ],
  moreGuides: [
    {
      title: 'Credit Report Checklist',
      href: '/resources/credit-report-checklist/',
      text: 'Document how the account appears before and after any settlement or dispute.',
    },
    {
      title: 'Credit Repair Scams',
      href: '/financial-wellness/credit-repair-scams/',
      text: 'Avoid anyone promising guaranteed deletion of accurate negative information.',
    },
  ],
  officialSources: [
    {
      name: 'CFPB credit reports and scores',
      href: 'https://www.consumerfinance.gov/consumer-tools/credit-reports-and-scores/',
      text: 'Consumer guidance on credit reports, scores, and disputes.',
    },
    {
      name: 'FTC credit repair scams',
      href: 'https://consumer.ftc.gov/articles/credit-repair-scams',
      text: 'Warnings about false promises to remove accurate negative information.',
    },
    {
      name: 'AnnualCreditReport.com',
      href: 'https://www.annualcreditreport.com/',
      text: 'Federally authorized source for free credit reports.',
    },
  ],
  toolCta: {
    title: 'Check affordability before offering payment',
    href: '/tools/borrowing-power-quiz/',
    text: 'If paying a collection changes your monthly budget or borrowing options, use the free quiz as an educational estimate before committing money.',
  },
};
---

<LetterTemplatePage page={page} />
