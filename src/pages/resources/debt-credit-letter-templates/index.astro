---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const title = 'Debt and Credit Letter Templates | CreditDoc';
const description = 'Free CreditDoc letter templates for debt validation, debt collector contact requests, pay-for-delete requests, settlement offers, and credit report disputes.';
const canonical = 'https://www.creditdoc.co/resources/debt-credit-letter-templates/';
const published = '2026-05-19';

const priorityTemplates = [
  {
    title: 'Debt Validation Letter',
    href: '/resources/debt-credit-letter-templates/debt-validation-letter/',
    label: 'Debt collection',
    text: 'Ask a debt collector to provide information about a debt before you decide what to do next.',
  },
  {
    title: 'Cease and Desist Debt Collector Letter',
    href: '/resources/debt-credit-letter-templates/cease-and-desist-debt-collector-letter/',
    label: 'Collector contact',
    text: 'Tell a debt collector to stop contacting you, while preserving records and understanding the limits of the request.',
  },
  {
    title: 'Pay-for-Delete Letter',
    href: '/resources/debt-credit-letter-templates/pay-for-delete-letter/',
    label: 'Collections and credit reports',
    text: 'Make a careful written request tied to payment, with clear warnings that removal may not happen.',
  },
];

const plannedTemplates = [
  'Debt settlement offer letter',
  'Debt settlement agreement checklist',
  'Goodwill letter for a late payment',
  'Credit bureau dispute letter',
  'Credit report denial request letter',
  'Expired statute of limitations letter',
  'Wage assignment revocation letter',
  'Request creditor payment plan letter',
];

const officialSources = [
  {
    name: 'Consumer Financial Protection Bureau',
    href: 'https://www.consumerfinance.gov/consumer-tools/debt-collection/',
    text: 'Debt collection rights, sample letters, and complaint resources.',
  },
  {
    name: 'Federal Trade Commission',
    href: 'https://consumer.ftc.gov/debt',
    text: 'Consumer education on debt collection, credit reports, and scams.',
  },
  {
    name: 'AnnualCreditReport.com',
    href: 'https://www.annualcreditreport.com/',
    text: 'Federally authorized source for free credit reports.',
  },
  {
    name: 'Electronic Code of Federal Regulations',
    href: 'https://www.ecfr.gov/current/title-12/chapter-X/part-1006',
    text: 'Regulation F text implementing parts of the Fair Debt Collection Practices Act.',
  },
];

const relatedGuides = [
  {
    title: 'Credit Report Checklist',
    href: '/resources/credit-report-checklist/',
    text: 'Review reports, spot errors, gather documents, and track disputes.',
  },
  {
    title: 'How to Deal with Debt Collectors',
    href: '/financial-wellness/dealing-with-debt-collectors/',
    text: 'Understand collection calls, letters, documentation, and consumer rights.',
  },
  {
    title: 'Credit Repair Scams',
    href: '/financial-wellness/credit-repair-scams/',
    text: 'Avoid promises that overstate what letters or disputes can legally do.',
  },
  {
    title: 'FCRA and CROA Rights',
    href: '/financial-wellness/credit-repair-rights-fcra-croa/',
    text: 'Read plain-English background on credit reporting and credit repair rights.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Debt and Credit Letter Templates',
    description,
    url: canonical,
    datePublished: published,
    dateModified: published,
    publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.creditdoc.co/resources/' },
      { '@type': 'ListItem', position: 3, name: 'Debt and Credit Letter Templates', item: canonical },
    ],
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} publicResource={true}>
  <nav class="mx-auto max-w-5xl px-4 pt-6 text-sm text-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-primary">Home</a>
    <span class="px-2">/</span>
    <a href="/resources/" class="hover:text-primary">Resources</a>
    <span class="px-2">/</span>
    <span class="text-text">Debt and Credit Letter Templates</span>
  </nav>

  <section class="border-b border-border bg-white">
    <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 md:grid-cols-[1.4fr_0.8fr] md:items-center">
      <div>
        <span class="inline-flex rounded-full bg-primary-light px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">Free public resource</span>
        <h1 class="mt-5 text-3xl font-bold leading-tight text-text sm:text-5xl">Debt and Credit Letter Templates</h1>
        <p class="mt-5 text-lg leading-relaxed text-muted">
          Plain-English templates for consumers dealing with debt collectors, creditors, credit bureaus, and credit report issues. Each page explains when a letter fits, what to gather first, where to send it, and which official sources to check.
        </p>
      </div>
      <aside class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
        <h2 class="text-base font-bold text-text">Resource standards</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
          <li>No signup required.</li>
          <li>No affiliate links inside templates.</li>
          <li>Official sources are prioritized.</li>
          <li>Templates do not replace legal advice.</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-10 rounded-xl border border-primary/20 bg-primary-light/30 p-6">
      <h2 class="text-xl font-bold text-text">Use Templates With Debt and Credit Context</h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        Letter templates help document requests, but they cannot create a certain outcome with a collector, creditor, bureau, or court. Use them with debt tools, borrower answers, category pages, official sources, and CFPB complaint context.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/tools/debt-payoff-calculator/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Debt payoff calculator</a>
        <a href="/answers/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Borrower answers</a>
        <a href="/categories/debt-relief/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Debt relief providers</a>
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-white p-3 text-sm font-medium text-primary hover:underline">Complaint data context</a>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-text">Start with the situation</h2>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
      Pick the letter by the problem you are trying to document. Keep copies of every letter, attachment, mailing receipt, delivery confirmation, and response.
    </p>
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {priorityTemplates.map((item) => (
        <a href={item.href} class="rounded-xl border border-border bg-white p-6 transition hover:border-primary hover:shadow-md">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">{item.label}</p>
          <h2 class="mt-3 text-xl font-bold text-text">{item.title}</h2>
          <p class="mt-3 text-sm leading-relaxed text-muted">{item.text}</p>
          <span class="mt-5 inline-flex text-sm font-semibold text-primary">Open template</span>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-text">More templates planned</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">
        These are being added carefully because debt collection, credit reporting, and settlement letters can affect legal rights. The first published pages focus on high-utility, high-documentation scenarios.
      </p>
      <div class="mt-6 grid gap-3 sm:grid-cols-2">
        {plannedTemplates.map((item) => (
          <div class="rounded-xl border border-border bg-white p-4">
            <p class="text-sm font-semibold text-text">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-bold text-text">Official institutions to know</h2>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {officialSources.map((source) => (
        <a href={source.href} rel="noopener noreferrer" class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
          <h3 class="font-semibold text-text">{source.name}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{source.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-text">Related CreditDoc guides</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        {relatedGuides.map((guide) => (
          <a href={guide.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
            <h3 class="font-semibold text-text">{guide.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{guide.text}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read guide</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
