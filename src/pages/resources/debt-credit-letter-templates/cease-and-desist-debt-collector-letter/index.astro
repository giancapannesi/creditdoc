---
import LetterTemplatePage from '../../../../components/LetterTemplatePage.astro';

const page = {
  title: 'Cease and Desist Debt Collector Letter Template | CreditDoc',
  description: 'Use this free cease and desist debt collector letter template to tell a collector to stop contacting you and keep written records.',
  canonical: 'https://www.creditdoc.co/resources/debt-credit-letter-templates/cease-and-desist-debt-collector-letter/',
  h1: 'Cease and Desist Debt Collector Letter Template',
  kicker: 'Cease and Desist Letter',
  intro: 'Use this template when you want a debt collector to stop contacting you. The letter can limit contact, but it does not erase a valid debt, stop credit reporting by itself, or prevent a collector from using lawful remedies.',
  published: '2026-05-19',
  modified: '2026-05-19',
  designedFor: [
    'Consumers receiving unwanted collector calls or letters',
    'People who want communications moved into written records',
    'Consumers who already know which collector is contacting them',
    'Educators explaining contact-control rights and limits',
  ],
  whenToUse: [
    'A third-party debt collector keeps contacting you and you want the contact to stop.',
    'You want future communication limited to legally required notices.',
    'You have already documented the collector name and mailing address.',
    'You understand that stopping contact does not resolve the debt.',
  ],
  whenNotToUse: [
    'You need information about whether the debt is yours; start with validation instead.',
    'You have been sued or received court papers.',
    'You want to negotiate payment terms in the same letter.',
    'You are trying to stop all legal action; this letter does not do that.',
  ],
  gatherFirst: [
    'The collector name and mailing address from the most recent notice.',
    'Any account or reference number shown by the collector.',
    'Dates and times of recent calls, texts, emails, or letters.',
    'Copies or screenshots of communications you want to preserve.',
    'A mailing method that provides proof of delivery.',
  ],
  templateTitle: 'Editable cease and desist letter',
  templateBody: [
    '[Your full name]',
    '[Your mailing address]',
    '[City, State ZIP]',
    '[Date]',
    '',
    '[Debt collector name]',
    '[Debt collector mailing address]',
    '[City, State ZIP]',
    '',
    'Re: Request to cease communication',
    'Account or reference number: [insert number if shown]',
    '',
    'To whom it may concern:',
    '',
    'I am writing about the account referenced above. Please cease further communication with me about this debt except as allowed or required by law.',
    '',
    'This letter is not a promise to pay, and it is not an admission of liability for the debt. I am keeping a copy of this letter and all related communications for my records.',
    '',
    'Please direct any legally required written notice to the mailing address listed above.',
    '',
    'Sincerely,',
    '',
    '[Your printed name]',
  ],
  checklist: [
    'I confirmed this is a debt collector, not necessarily the original creditor.',
    'I understand the letter does not erase the debt.',
    'I did not include a payment offer in this letter.',
    'I saved call logs or communications that prompted the request.',
    'I used the collector address from a recent notice.',
    'I saved a copy of the final letter.',
    'I kept mailing or delivery proof.',
    'I know court papers require separate attention.',
  ],
  whereToSend: [
    {
      title: 'The debt collector contacting you',
      href: '/financial-wellness/dealing-with-debt-collectors/',
      text: 'Send the request to the collector address shown on the notice. The CreditDoc collector guide explains why records and timing matter.',
    },
    {
      title: 'CFPB complaint portal',
      href: 'https://www.consumerfinance.gov/complaint/',
      text: 'If contact continues after a proper written request, a complaint may help document the issue with a regulator.',
    },
  ],
  relatedTemplates: [
    {
      title: 'Debt Validation Letter',
      href: '/resources/debt-credit-letter-templates/debt-validation-letter/',
      text: 'Use this first if you need the collector to identify the debt or original creditor.',
    },
    {
      title: 'Pay-for-Delete Letter',
      href: '/resources/debt-credit-letter-templates/pay-for-delete-letter/',
      text: 'Use this only if you are considering a payment-related credit reporting request.',
    },
  ],
  relatedAnswers: [
    {
      title: 'Can I do debt consolidation myself?',
      href: '/answers/can-i-do-debt-consolidation-myself/',
      text: 'Organize confirmed debts before deciding whether consolidation makes sense.',
    },
    {
      title: 'Debt consolidation vs. personal loan',
      href: '/answers/debt-consolidation-vs-personal-loan/',
      text: 'Understand the tradeoffs before using new credit to manage old balances.',
    },
  ],
  moreGuides: [
    {
      title: 'How to Deal with Debt Collectors',
      href: '/financial-wellness/dealing-with-debt-collectors/',
      text: 'Review practical steps for collector calls, letters, documentation, and complaints.',
    },
    {
      title: 'Your Legal Rights: FCRA and CROA',
      href: '/financial-wellness/credit-repair-rights-fcra-croa/',
      text: 'Get broader context on credit reporting and credit repair rights.',
    },
  ],
  officialSources: [
    {
      name: 'CFPB debt collection resources',
      href: 'https://www.consumerfinance.gov/consumer-tools/debt-collection/',
      text: 'Consumer guidance on debt collection rights and complaints.',
    },
    {
      name: 'FTC debt collection FAQs',
      href: 'https://consumer.ftc.gov/articles/debt-collection-faqs',
      text: 'Federal consumer education on collector conduct and your options.',
    },
    {
      name: 'Regulation F',
      href: 'https://www.ecfr.gov/current/title-12/chapter-X/part-1006',
      text: 'Federal regulation for many debt collection communications.',
    },
  ],
};
---

<LetterTemplatePage page={page} />
