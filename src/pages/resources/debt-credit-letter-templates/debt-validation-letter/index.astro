---
import LetterTemplatePage from '../../../../components/LetterTemplatePage.astro';

const page = {
  title: 'Debt Validation Letter Template | CreditDoc',
  description: 'Use this free debt validation letter template to ask a collector for information about a debt before you decide how to respond.',
  canonical: 'https://www.creditdoc.co/resources/debt-credit-letter-templates/debt-validation-letter/',
  h1: 'Debt Validation Letter Template',
  kicker: 'Debt Validation Letter',
  intro: 'Use this template to ask a debt collector for information that helps you identify the debt, the original creditor, the amount claimed, and the collector contacting you.',
  published: '2026-05-19',
  modified: '2026-05-19',
  designedFor: [
    'Consumers who received a collection letter or call',
    'People who do not recognize the debt',
    'Anyone who wants written records before discussing payment',
    'Financial educators explaining debt collection documentation',
  ],
  whenToUse: [
    'A collector contacts you about a debt and you need more information.',
    'The amount, original creditor, account number, or collection company is unclear.',
    'You want written records before deciding whether to dispute, negotiate, or pay.',
    'You need to preserve a factual paper trail for your files.',
  ],
  whenNotToUse: [
    'You have already been served with a lawsuit and need legal advice quickly.',
    'You are trying to dispute accurate credit report information only because it is negative.',
    'You plan to include false statements or deny a debt you know is yours without basis.',
    'A deadline is close and you have not checked state-law or court requirements.',
  ],
  gatherFirst: [
    'The collector name, mailing address, phone number, and any reference number from the notice.',
    'The date you first received the collection letter or call.',
    'Any account number, original creditor name, claimed balance, and dates shown in the notice.',
    'Copies of your credit reports if the collection account appears on a report.',
    'A mailing method that gives you proof of delivery, if you choose to send by mail.',
  ],
  templateTitle: 'Editable debt validation letter',
  templateBody: [
    '[Your full name]',
    '[Your mailing address]',
    '[City, State ZIP]',
    '[Date]',
    '',
    '[Debt collector name]',
    '[Debt collector mailing address]',
    '[City, State ZIP]',
    '',
    'Re: Request for debt validation',
    'Account or reference number: [insert number if shown]',
    '',
    'To whom it may concern:',
    '',
    'I am writing about your recent communication regarding the debt referenced above. I am requesting information so I can identify the debt, the creditor, and the amount you claim is owed.',
    '',
    'Please provide the name of the current creditor, the name of the original creditor if different, the amount claimed, an itemization of interest or fees if applicable, the account number associated with the debt, and information showing that your company is authorized to collect this debt.',
    '',
    'Please send your response in writing to the mailing address listed above. I am keeping a copy of this letter for my records.',
    '',
    'Sincerely,',
    '',
    '[Your printed name]',
  ],
  checklist: [
    'I replaced every bracketed placeholder.',
    'I kept the letter factual and did not admit or deny more than I intended.',
    'I included the collector reference number if available.',
    'I saved a copy of the notice that prompted the letter.',
    'I saved a copy of the final letter.',
    'I kept mailing or delivery proof.',
    'I made a note of the date sent.',
    'I know this letter does not stop a lawsuit deadline by itself.',
  ],
  whereToSend: [
    {
      title: 'The debt collector contacting you',
      href: '/categories/debt-relief/',
      text: 'Use the mailing address from the collection notice. CreditDoc category pages can help you understand the debt-relief landscape, but the letter should go to the collector that contacted you.',
    },
    {
      title: 'CFPB complaint portal',
      href: 'https://www.consumerfinance.gov/complaint/',
      text: 'If a collector will not respond, keeps contacting the wrong person, or appears to violate collection rules, the CFPB complaint portal may be relevant.',
    },
  ],
  relatedTemplates: [
    {
      title: 'Cease and Desist Debt Collector Letter',
      href: '/resources/debt-credit-letter-templates/cease-and-desist-debt-collector-letter/',
      text: 'Use this when the issue is unwanted collector contact rather than identifying the debt.',
    },
    {
      title: 'Pay-for-Delete Letter',
      href: '/resources/debt-credit-letter-templates/pay-for-delete-letter/',
      text: 'Use this only after you understand the debt and want to make a cautious payment-related request.',
    },
  ],
  relatedAnswers: [
    {
      title: 'Can I do debt consolidation myself?',
      href: '/answers/can-i-do-debt-consolidation-myself/',
      text: 'A useful next read if the validation response confirms multiple debts you need to organize.',
    },
    {
      title: 'Debt consolidation vs. personal loan',
      href: '/answers/debt-consolidation-vs-personal-loan/',
      text: 'Compare repayment structures before turning a collection problem into a new loan.',
    },
  ],
  moreGuides: [
    {
      title: 'How to Deal with Debt Collectors',
      href: '/financial-wellness/dealing-with-debt-collectors/',
      text: 'Review collector contact rules, documentation habits, and practical response steps.',
    },
    {
      title: 'Credit Report Checklist',
      href: '/resources/credit-report-checklist/',
      text: 'Check whether the collection account appears on your credit reports and document any errors.',
    },
  ],
  officialSources: [
    {
      name: 'CFPB debt collection resources',
      href: 'https://www.consumerfinance.gov/consumer-tools/debt-collection/',
      text: 'Consumer guidance on debt collection rights, notices, and complaints.',
    },
    {
      name: 'FTC debt collection guidance',
      href: 'https://consumer.ftc.gov/articles/debt-collection-faqs',
      text: 'Plain-English guidance on debt collectors and consumer rights.',
    },
    {
      name: 'Regulation F',
      href: 'https://www.ecfr.gov/current/title-12/chapter-X/part-1006',
      text: 'Federal regulation covering certain debt collection practices.',
    },
  ],
};
---

<LetterTemplatePage page={page} />
