---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const title = 'Printable Loan Readiness Checklist | CreditDoc';
const description = 'Print a free loan readiness checklist covering documents, credit reports, income, debt, cash flow, denial reasons, and safer next steps before applying.';
const canonical = 'https://www.creditdoc.co/resources/loan-approval-readiness-toolkit/print/';
const published = '2026-06-16';

const checklistGroups = [
  {
    title: 'Identity and contact details',
    items: ['Government ID is current', 'Current address is consistent across documents', 'Name variations are understood before report review'],
  },
  {
    title: 'Credit report review',
    items: ['Official credit reports pulled', 'Late payments reviewed', 'Collections reviewed', 'Balances and credit limits checked', 'Unrecognized accounts marked for follow-up'],
  },
  {
    title: 'Income, debt, and budget',
    items: ['Income documents gathered', 'Monthly debt payments listed', 'Rent or mortgage payment listed', 'Estimated new payment tested against budget'],
  },
  {
    title: 'Business funding documents',
    items: ['Recent business bank statements gathered', 'Deposits and balances summarized', 'Business tax or financial records available', 'Use of funds written clearly'],
  },
  {
    title: 'Denial follow-up',
    items: ['Adverse action notice saved', 'Denial reasons copied into notes', 'Credit report items matched to denial reasons', 'Next application paused until missing items are reviewed'],
  },
  {
    title: 'Safer next steps',
    items: ['Used the denial checker if recently declined', 'Reviewed business readiness if applying for funding', 'Checked MCA repayment pressure if considering fast funding', 'Used official sources for reports, complaints, or fraud issues'],
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'Printable Loan Readiness Checklist',
    description,
    url: canonical,
    datePublished: published,
    dateModified: published,
    author: { '@type': 'Organization', name: 'CreditDoc Editorial Team' },
    publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
    mainEntityOfPage: canonical,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.creditdoc.co/resources/' },
      { '@type': 'ListItem', position: 3, name: 'Loan Approval Readiness Toolkit', item: 'https://www.creditdoc.co/resources/loan-approval-readiness-toolkit/' },
      { '@type': 'ListItem', position: 4, name: 'Printable Checklist', item: canonical },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  ogType="article"
  articlePublishedTime={published}
  articleModifiedTime={published}
  articleAuthor="CreditDoc Editorial Team"
  articleSection="Loan Readiness"
  publicResource={true}
>
  <div class="mx-auto max-w-4xl px-4 py-10 print:max-w-none print:px-0 print:py-0">
    <nav class="mb-8 text-sm text-muted print:hidden" aria-label="Breadcrumb">
      <a href="/resources/loan-approval-readiness-toolkit/" class="hover:text-primary">Back to toolkit</a>
    </nav>

    <header class="border-b border-border pb-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-primary">CreditDoc printable resource</p>
      <h1 class="mt-3 text-3xl font-bold text-text sm:text-4xl">Printable Loan Readiness Checklist</h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-muted">
        Use this worksheet before applying for a personal loan, business loan, credit card, debt consolidation loan, SBA loan, or cash-flow product. It is a preparation aid, not an approval estimate.
      </p>
      <button onclick="window.print()" class="mt-5 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-white hover:bg-primary-hover print:hidden">
        Print checklist
      </button>
    </header>

    <section class="mt-8 grid gap-5 md:grid-cols-2 print:grid-cols-2">
      {checklistGroups.map((group) => (
        <article class="break-inside-avoid rounded-xl border border-border bg-white p-5">
          <h2 class="text-lg font-bold text-text">{group.title}</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            {group.items.map((item) => (
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex h-5 w-5 flex-shrink-0 items-center justify-center rounded border border-border text-xs"> </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </section>

    <section class="mt-8 rounded-xl border border-border bg-bg-alt p-5">
      <h2 class="text-lg font-bold text-text">Notes before applying again</h2>
      <div class="mt-4 min-h-[140px] rounded-lg border border-dashed border-border bg-white"></div>
    </section>

    <footer class="mt-8 border-t border-border pt-5 text-xs leading-relaxed text-muted">
      <p>
        CreditDoc provides educational resources only. This checklist does not provide legal, financial, underwriting, or approval advice. Use official sources such as AnnualCreditReport.com, the CFPB, the FTC, and lender-specific document instructions where relevant.
      </p>
      <p class="mt-2">Full toolkit: https://www.creditdoc.co/resources/loan-approval-readiness-toolkit/</p>
    </footer>
  </div>

  <style>
    @media print {
      :global(body > header),
      :global(body > footer),
      :global(#cd-cookie-banner) {
        display: none !important;
      }
    }
  </style>
</BaseLayout>
