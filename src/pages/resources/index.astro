---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Free Credit Resources, Guides & Quizzes | CreditDoc';
const description = 'Free CreditDoc resources: credit report checklist, dispute guides, financial wellness articles, quizzes, and calculators for consumers and educators.';
const canonical = 'https://www.creditdoc.co/resources/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Free Credit Resources, Guides & Quizzes',
  description,
  url: canonical,
  publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
};

const relatedAnswers = [
  {
    title: 'How much can you borrow with your credit score?',
    href: '/answers/how-much-can-you-borrow-with-your-credit-score/',
    text: 'Understand how credit ranges can affect borrowing options before you apply.',
  },
  {
    title: 'Can I get a car loan with my credit score?',
    href: '/answers/can-i-get-a-car-loan-with-my-credit-score/',
    text: 'See how lenders may evaluate credit when reviewing auto-loan applications.',
  },
  {
    title: 'Should I get a secured credit card to build credit?',
    href: '/answers/should-i-get-a-secured-credit-card-to-build-credit/',
    text: 'Learn when a secured card can help establish positive payment history.',
  },
  {
    title: 'How to build credit score fast',
    href: '/answers/how-to-build-credit-score-fast/',
    text: 'Focus on the highest-impact credit habits without falling for shortcuts.',
  },
];

const wellnessGuides = [
  {
    title: 'How to Read Your Credit Report',
    href: '/financial-wellness/how-credit-reports-work/',
    category: 'Understanding Credit',
    text: 'A deeper guide to report sections, account data, inquiries, collections, and dispute rights.',
  },
  {
    title: 'How to Dispute Credit Report Errors',
    href: '/financial-wellness/dispute-credit-report-errors/',
    category: 'Credit Repair',
    text: 'Step-by-step dispute guidance for errors that may be hurting your credit profile.',
  },
  {
    title: 'Credit Repair Scams: Red Flags',
    href: '/financial-wellness/credit-repair-scams/',
    category: 'Credit Repair',
    text: 'Warning signs to review before paying anyone who promises to fix your credit.',
  },
  {
    title: 'Your Legal Rights: FCRA and CROA',
    href: '/financial-wellness/credit-repair-rights-fcra-croa/',
    category: 'Credit Repair',
    text: 'Plain-English overview of consumer rights around credit reporting and credit repair.',
  },
  {
    title: 'What Happens When You Miss a Payment',
    href: '/financial-wellness/what-happens-miss-payment/',
    category: 'Everyday Finance',
    text: 'How missed payments can affect fees, collections, credit reports, and recovery plans.',
  },
  {
    title: 'How to Deal with Debt Collectors',
    href: '/financial-wellness/dealing-with-debt-collectors/',
    category: 'Financial Recovery',
    text: 'Practical scripts and rights-focused guidance for collection calls and letters.',
  },
];

const interactiveTools = [
  {
    title: 'Borrowing Power Quiz',
    href: '/tools/borrowing-power-quiz/',
    label: 'Quiz',
    text: 'Answer a few questions to estimate how income, debt, credit range, and loan purpose may affect borrowing power.',
  },
  {
    title: 'Credit Score Simulator',
    href: '/tools/credit-score-simulator/',
    label: 'Simulator',
    text: 'Estimate how common credit actions may affect a score range before making a change.',
  },
  {
    title: 'Debt Payoff Calculator',
    href: '/tools/debt-payoff-calculator/',
    label: 'Calculator',
    text: 'Compare payoff timelines using snowball and avalanche methods.',
  },
  {
    title: 'All CreditDoc Tools',
    href: '/tools/',
    label: 'Tools hub',
    text: 'Browse the full set of free CreditDoc tools, quizzes, and calculators in one place.',
  },
];
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={jsonLd} publicResource={true}>
  <section class="border-b border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <span class="inline-flex rounded-full bg-primary-light px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary">Resources</span>
      <h1 class="mt-5 text-3xl font-bold text-text sm:text-5xl">Free Consumer Finance Resources</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        Practical, no-signup education for consumers, financial educators, libraries, and student financial wellness programs. These resources are written to stand on their own as public-benefit references, not sales pages.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-text">Printable guides and checklists</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
        These pages are designed for people who need a simple, practical next step: print a checklist, gather documents, or understand where official government resources fit into the process.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      <a href="/resources/debt-credit-letter-templates/" class="rounded-xl border border-border bg-white p-6 transition hover:border-primary hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Letter templates</p>
        <h2 class="mt-3 text-xl font-bold text-text">Debt and Credit Letter Templates</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Plain-English templates for debt validation, debt collector contact requests, pay-for-delete requests, and credit report documentation.
        </p>
        <span class="mt-5 inline-flex text-sm font-semibold text-primary">Open library</span>
      </a>

      <a href="/resources/credit-report-checklist/" class="rounded-xl border border-border bg-white p-6 transition hover:border-primary hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Printable checklist</p>
        <h2 class="mt-3 text-xl font-bold text-text">How to Check and Dispute Your Credit Report</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          A plain-English guide and printable checklist for reviewing credit reports, spotting errors, preparing documents, and tracking disputes.
        </p>
        <span class="mt-5 inline-flex text-sm font-semibold text-primary">Open resource</span>
      </a>

      <a href="/financial-wellness/how-credit-reports-work/" class="rounded-xl border border-border bg-white p-6 transition hover:border-primary hover:shadow-md">
        <p class="text-xs font-semibold uppercase tracking-wider text-primary">Related guide</p>
        <h2 class="mt-3 text-xl font-bold text-text">How Credit Reports Work</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted">
          Learn what appears on a credit report, how bureaus collect information, and why reports from different bureaus may not match.
        </p>
        <span class="mt-5 inline-flex text-sm font-semibold text-primary">Read guide</span>
      </a>
    </div>
  </section>

  <section class="border-y border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
        <div>
          <h2 class="text-2xl font-bold text-text">For libraries and educators</h2>
          <p class="mt-4 text-sm leading-relaxed text-muted">
            The resources in this section are intentionally ungated and written in plain English. They can be used as supplemental references alongside official sources such as AnnualCreditReport.com, the Consumer Financial Protection Bureau, the Federal Trade Commission, and state consumer-protection agencies.
          </p>
          <p class="mt-4 text-sm leading-relaxed text-muted">
            CreditDoc does not ask readers to submit contact information to use these resources. The goal is to give patrons, students, and consumers a clear worksheet or reading path they can use before making decisions about credit, debt, or disputes.
          </p>
        </div>
        <div class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
          <h3 class="font-bold text-text">Resource standards</h3>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed text-muted">
            <li>No signup required to read or print.</li>
            <li>No affiliate links inside resource pages.</li>
            <li>Official government and nonprofit sources are prioritized.</li>
            <li>Commercial comparisons are kept outside this resource section.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-12">
    <h2 class="text-2xl font-bold text-text">Credit report and recovery guides</h2>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
      These existing CreditDoc wellness guides add context around credit reports, disputes, credit repair rights, and debt recovery. They are useful follow-up reading after someone prints or completes a checklist.
    </p>
    <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {wellnessGuides.map((guide) => (
        <a href={guide.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary">{guide.category}</p>
          <h3 class="mt-2 font-semibold text-text">{guide.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{guide.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-text">Quizzes and calculators</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
        Interactive tools help readers move from education into a practical next step without submitting personal contact information.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
        {interactiveTools.map((tool) => (
          <a href={tool.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-wider text-primary">{tool.label}</p>
            <h3 class="mt-2 font-semibold text-text">{tool.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{tool.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-text">Helpful CreditDoc education</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <a href="/financial-wellness/credit-score-basics/" class="rounded-xl border border-border bg-white p-5 hover:border-primary">
          <h3 class="font-semibold text-text">Credit Score Basics</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Understand what affects a credit score and how to monitor progress.</p>
        </a>
        <a href="/financial-wellness/" class="rounded-xl border border-border bg-white p-5 hover:border-primary">
          <h3 class="font-semibold text-text">Financial Wellness Library</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Browse CreditDoc guides on credit reports, disputes, debt collectors, missed payments, and recovery planning.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="border-t border-border bg-white">
    <div class="mx-auto max-w-5xl px-4 py-12">
      <h2 class="text-2xl font-bold text-text">Common credit questions</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted">
        These answer pages help readers connect the checklist to practical next steps, such as borrowing, rebuilding credit, and choosing safe credit-building tools.
      </p>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {relatedAnswers.map((item) => (
          <a href={item.href} class="rounded-xl border border-border bg-white p-5 hover:border-primary hover:shadow-sm">
            <h3 class="font-semibold text-text">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{item.text}</p>
            <span class="mt-4 inline-flex text-sm font-semibold text-primary">Read answer</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
