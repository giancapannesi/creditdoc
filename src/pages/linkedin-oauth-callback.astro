---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'LinkedIn OAuth Callback | CreditDoc';
const description = 'Temporary CreditDoc LinkedIn OAuth callback helper.';
const canonical = 'https://www.creditdoc.co/linkedin-oauth-callback/';
---

<BaseLayout title={title} description={description} canonical={canonical} noindex={true}>
  <main class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-bold text-text">LinkedIn OAuth Callback</h1>
    <p class="mt-4 text-muted">Copy the authorization code below and exchange it on the VPS.</p>

    <section class="mt-6 rounded-xl border border-border bg-white p-5">
      <h2 class="font-bold text-text">Authorization Code</h2>
      <pre id="code" class="mt-3 overflow-x-auto rounded-lg bg-bg-alt p-4 text-sm">No code found in the URL.</pre>
    </section>

    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5">
      <h2 class="font-bold text-text">Command</h2>
      <pre id="command" class="mt-3 overflow-x-auto rounded-lg bg-white p-4 text-sm">Waiting for code...</pre>
    </section>
  </main>

  <script>
    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const error = params.get('error');
    const codeEl = document.getElementById('code');
    const commandEl = document.getElementById('command');
    if (error) {
      codeEl.textContent = `${error}: ${params.get('error_description') || 'LinkedIn returned an OAuth error.'}`;
      commandEl.textContent = 'Fix the LinkedIn app settings and try again.';
    } else if (code) {
      codeEl.textContent = code;
      commandEl.textContent = `cd /srv/BusinessOps/creditdoc && node scripts/creditdoc_linkedin_manager.mjs exchange-code '${code}'`;
    }
  </script>
</BaseLayout>
