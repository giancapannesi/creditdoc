---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComparisonTable from '../../components/ComparisonTable.astro';
import DiagnosisCard from '../../components/DiagnosisCard.astro';
import RatingStars from '../../components/RatingStars.astro';
import { getComparisons, getLenderBySlug } from '../../utils/data-build';
import { formatPrice, getBbbClass } from '../../utils/data';
import { softenYmylCopy } from '../../utils/safe-copy';
import type { Lender } from '../../utils/data';

export function getStaticPaths() {
  const comparisons = getComparisons();
  return comparisons
    .filter(comp => getLenderBySlug(comp.lender_a) && getLenderBySlug(comp.lender_b))
    .map(comp => ({
      params: { slug: comp.slug },
    }));
}

const { slug } = Astro.params;
const comparisons = getComparisons();
const comparison = comparisons.find(c => c.slug === slug)!;

const lenderA = getLenderBySlug(comparison.lender_a)!;
const lenderB = getLenderBySlug(comparison.lender_b)!;

const winnerLender = comparison.winner === comparison.lender_a ? lenderA : lenderB;

function softenComparisonText(text: string): string {
  const locallySoftened = text
    .replace(new RegExp(`\\b${comparison.lender_a}\\b`, 'gi'), lenderA.name)
    .replace(new RegExp(`\\b${comparison.lender_b}\\b`, 'gi'), lenderB.name)
    .replace(/money-back guarantees/gi, 'listed refund terms')
    .replace(/money-back guarantee/gi, 'listed refund term')
    .replace(/\bwins\b/gi, 'is highlighted')
    .replace(/\bthe better value\b/gi, 'the lower listed-cost comparison')
    .replace(/\bthe better option\b/gi, 'the profile to compare')
    .replace(/\bbetter option\b/gi, 'profile to compare')
    .replace(/\bbest value\b/gi, 'lower listed-cost profile')
    .replace(/\bbest\b/gi, 'notable')
    .replace(/effective credit repair/gi, 'credit repair services')
    .replace(/without overpaying/gi, 'with listed pricing context')
    .replace(/comparable effectiveness/gi, 'comparable profile fields')
    .replace(/zero upfront cost to get started/gi, 'no listed setup fee');
  return softenYmylCopy(locallySoftened)
    .replace(/\bpredatory short-term lending model\b/gi, 'high-cost short-term lending model')
    .replace(/\bpredatory payday loan structure\b/gi, 'high-cost payday-loan structure')
    .replace(/\bpredatory lending structures\b/gi, 'high-cost lending structures')
    .replace(/\bpredatory lending terms\b/gi, 'high-cost lending terms')
    .replace(/\bpredatory loan rates\b/gi, 'high-cost loan-rate context')
    .replace(/\bpredatory rates\b/gi, 'high-cost rate context')
    .replace(/\bpredatory\b/gi, 'high-cost')
    .replace(/\bFor most borrowers\b/g, 'For borrowers comparing these stored profile fields')
    .replace(/\bfor most borrowers\b/g, 'for borrowers comparing these stored profile fields')
    .replace(/\bmore listed (stored|consumer|operational|credential|customer|pricing|accessibility|option|business|national|nationwide|market|legal|service|borrower|geographic|review|predictable|complaint|refund)\b/gi, 'more $1')
    .replace(/\bwith more listed (stored|consumer|operational|credential|customer|pricing|accessibility|option|business|national|nationwide|market|legal|service|borrower|geographic|review|predictable|complaint|refund)\b/gi, 'with more $1')
    .replace(/\bhas more listed (stored|consumer|operational|credential|customer|pricing|accessibility|option|business|national|nationwide|market|legal|service|borrower|geographic|review|predictable|complaint|refund)\b/gi, 'has more $1')
    .replace(/\bmore listed about\b/gi, 'more public context about')
    .replace(/\bmore listed and\b/gi, 'more profile context and')
    .replace(/\bmore listed combination\b/gi, 'more combined context')
    .replace(/\bmore listed context\b/gi, 'more profile context')
    .replace(/\bmore listed despite\b/gi, 'more profile context despite')
    .replace(/\bmore listed package\b/gi, 'more package context')
    .replace(/\bmore listed regulatory\b/gi, 'more regulatory context')
    .replace(/\bmore listed than\b/gi, 'more profile context than')
    .replace(/\bmore listed third-party\b/gi, 'more third-party context')
    .replace(/\bmore listed A\b/g, 'more A-rated context')
    .replace(/\bwith more listed\b/gi, 'with more profile context')
    .replace(/\bhas more listed\b/gi, 'has more profile context')
    .replace(/\ball more listed to\b/gi, 'all stronger listed context than')
    .replace(/\bmore profile context and competitive\b/gi, 'more cost context and a listed refund term')
    .replace(/\ba more profile context and accessible service\b/gi, 'more accessible profile context')
    .replace(/\bmore profile context-cost\b/gi, 'more cost')
    .replace(/\bmore package context context\b/gi, 'more bundled-feature context')
    .replace(/\bmore listed-cost\b/gi, 'more cost-relevant')
    .replace(/\bmore sustainable and profile with trust signals to verify\b/gi, 'more sustainable profile with trust signals to verify')
    .replace(/\bdevastating payday loan APRs\b/gi, 'very high payday-loan APRs')
    .replace(/\btraps borrowers in high-cost repeat-borrowing cycles\b/gi, 'can involve high-cost repeat-borrowing risk')
    .replace(/\bcreates repeat-borrowing cycles\b/gi, 'has repeat-borrowing risk to review')
    .replace(/\brepeat-borrowing cycles\b/gi, 'repeat-borrowing risk')
    .replace(/\bsaving borrowers hundreds of dollars\b/gi, 'showing materially different listed-cost context')
    .replace(/\bsignaling serious customer dissatisfaction\b/gi, 'adding review-context risk to verify')
    .replace(/\bneed lower interest rates to make real progress\b/gi, 'are comparing lower-interest repayment options')
    .replace(/\baffordable short-term funds\b/gi, 'lower-listed-cost short-term funds')
    .replace(/\bhigher high-cost lending risk context\b/gi, 'higher lending-cost risk context')
    .replace(/\blower in listed-cost context and with more risk context\b/gi, 'the profile with lower listed-cost context and more risk context to review')
    .replace(/\bprofile with more context for long-term financial-health context\b/gi, 'profile with more long-term financial-health context to review')
    .replace(/\bmethodology context for credit-building context to review\b/gi, 'methodology context for credit-building features to review')
    .replace(/\blegally questionable tradeline practices\b/gi, 'tradeline practices with compliance context to verify')
    .replace(/\blegally questionable authorized user tradelines\b/gi, 'authorized user tradelines with compliance context to verify')
    .replace(/\bare relevant to your situation\b/gi, 'are relevant to your research')
    .replace(/([.!?])\s+for national-access\b/g, '$1 For national-access');
}

const safeSummary = softenComparisonText(comparison.summary);
const safeWinnerReason = softenComparisonText(comparison.winner_reason);
const displayComparisonTitle = `${lenderA.name} vs ${lenderB.name} (2026)`;
const lenderASignals = lenderA.best_for.slice(0, 2).map(softenComparisonText).join('. ');
const lenderBSignals = lenderB.best_for.slice(0, 2).map(softenComparisonText).join('. ');
const lenderAStrength = softenComparisonText(lenderA.pros[0] || 'Review the profile fields before contacting the provider');
const lenderBStrength = softenComparisonText(lenderB.pros[0] || 'Review the profile fields before contacting the provider');

function setupFeeContext(lender: Lender): string {
  return lender.pricing.setup_fee > 0
    ? `${lender.name} lists a ${formatPrice(lender.pricing.setup_fee)} setup fee`
    : `${lender.name} has no listed setup fee`;
}

function listedPrice(price: number | undefined): number | null {
  return typeof price === 'number' && Number.isFinite(price) && price >= 0 ? price : null;
}

function lowestListedMonthlyPrice(lender: Lender): number | null {
  const monthlyPrice = listedPrice(lender.pricing.monthly_price);
  const comparableTiers = lender.pricing.tiers
    .map(tier => listedPrice(tier.price))
    .filter((price): price is number => price !== null)
    .filter(price => monthlyPrice === null || monthlyPrice === 0 || price <= monthlyPrice * 2);

  if (comparableTiers.length > 0) return Math.min(...comparableTiers);
  return monthlyPrice;
}

function monthlyPriceLabel(lender: Lender): string {
  const price = lowestListedMonthlyPrice(lender);
  if (price === null) return 'No listed monthly price';
  return price === 0 ? 'No monthly subscription listed' : `From ${formatPrice(price)}/mo`;
}

function normalizedBbbRating(lender: Lender): string {
  return lender.company_info.bbb_rating?.trim() || '';
}

function bbbBadgeLabel(lender: Lender): string {
  const rating = normalizedBbbRating(lender);
  return rating && rating !== 'N/A' ? `BBB: ${rating}` : 'BBB: NR';
}

function bbbFaqLabel(lender: Lender): string {
  const rating = normalizedBbbRating(lender);
  if (!rating || rating === 'N/A') return `${lender.name} does not have a stored BBB rating in this profile`;
  const article = rating === 'NR' || rating.startsWith('A') || rating.startsWith('F') ? 'an' : 'a';
  return `${lender.name} has ${article} ${rating} BBB rating${lender.company_info.bbb_accredited ? ' (accredited)' : ''}`;
}

const lenderAMonthlyPrice = lowestListedMonthlyPrice(lenderA);
const lenderBMonthlyPrice = lowestListedMonthlyPrice(lenderB);

function monthlyPriceFaqAnswer(): string {
  const aContext = `${lenderA.name}: ${monthlyPriceLabel(lenderA)}`;
  const bContext = `${lenderB.name}: ${monthlyPriceLabel(lenderB)}`;
  const setupContext = `Setup fees can change first-month cost: ${setupFeeContext(lenderA)}, while ${setupFeeContext(lenderB)}.`;

  if (lenderAMonthlyPrice === null && lenderBMonthlyPrice === null) {
    return `Neither profile has a stored monthly-price field for this comparison. ${setupContext}`;
  }

  if (lenderAMonthlyPrice === null || lenderBMonthlyPrice === null) {
    return `The stored monthly-price fields are incomplete for this comparison. Current listed context: ${aContext}; ${bContext}. ${setupContext}`;
  }

  if (lenderAMonthlyPrice === 0 || lenderBMonthlyPrice === 0) {
    if (lenderAMonthlyPrice === 0 && lenderBMonthlyPrice === 0) {
      return `Neither profile lists a recurring monthly subscription fee. This does not mean all borrowing, card, usage, interest, or per-transaction costs are free. ${setupContext}`;
    }

    return `Only one profile lists a recurring monthly subscription fee. This does not make the other profile cost-free; review borrowing, card, usage, interest, and per-transaction costs before comparing total cost. Current listed context: ${aContext}; ${bContext}. ${setupContext}`;
  }

  if (lenderAMonthlyPrice < lenderBMonthlyPrice) {
    return `${lenderA.name} lists the lower monthly price at ${formatPrice(lenderAMonthlyPrice)}/mo, compared with ${lenderB.name} at ${formatPrice(lenderBMonthlyPrice)}/mo. ${setupContext}`;
  }

  if (lenderAMonthlyPrice > lenderBMonthlyPrice) {
    return `${lenderB.name} lists the lower monthly price at ${formatPrice(lenderBMonthlyPrice)}/mo, compared with ${lenderA.name} at ${formatPrice(lenderAMonthlyPrice)}/mo. ${setupContext}`;
  }

  return `Both ${lenderA.name} and ${lenderB.name} list the same monthly price of ${formatPrice(lenderAMonthlyPrice)}/mo. ${setupContext}`;
}

function refundTermLabel(lender: Lender): string | null {
  if (!lender.pricing.money_back_guarantee) return null;
  const refundDetails = softenComparisonText(lender.pricing.guarantee_details || 'refund term listed').replace(/[.\s]+$/g, '');
  return `${lender.name} has a listed refund term: ${refundDetails}`;
}

function refundTermsFaqAnswer(): string {
  const aRefund = refundTermLabel(lenderA);
  const bRefund = refundTermLabel(lenderB);

  if (!aRefund && !bRefund) {
    return 'Neither profile lists a refund term in the stored comparison data.';
  }

  if (aRefund && bRefund) {
    return `${aRefund}. ${bRefund}.`;
  }

  const listedRefund = aRefund || bRefund;
  const missingRefundLender = aRefund ? lenderB : lenderA;
  return `${listedRefund}. ${missingRefundLender.name} does not have a listed refund term in this profile.`;
}

const categoryLabels: Record<string, string> = {
  'build-credit': 'Credit Building',
  'business-loans': 'Business Loans',
  'credit-cards': 'Credit Cards',
  'credit-monitoring': 'Monitor & Protect',
  'credit-repair': 'Credit Repair',
  'debt-relief': 'Debt Relief',
  fintech: 'Fintech',
  'personal-loans': 'Personal Loans',
};

const comparedCategories = Array.from(new Set([lenderA.category, lenderB.category].filter(Boolean)));
const categoryContextCards = comparedCategories.map(category => ({
  href: `/categories/${category}/`,
  label: categoryLabels[category] || category.replace(/-/g, ' '),
}));

const faqs = [
  {
    question: `Which lists the lower monthly price, ${lenderA.name} or ${lenderB.name}?`,
    answer: monthlyPriceFaqAnswer(),
  },
  {
    question: `Which has the higher stored BBB rating, ${lenderA.name} or ${lenderB.name}?`,
    answer: `${bbbFaqLabel(lenderA)}, while ${bbbFaqLabel(lenderB)}. BBB ratings are third-party signals and should be checked with current provider, regulator, and complaint-response context.`,
  },
  {
    question: `Do ${lenderA.name} and ${lenderB.name} list refund terms?`,
    answer: refundTermsFaqAnswer(),
  },
  {
    question: `How should I compare ${lenderA.name} and ${lenderB.name}?`,
    answer: `Compare the profile details, pricing fields, public ratings where available, refund terms, and complaint-response context before contacting either company. CreditDoc's stored comparison note records ${winnerLender.name} for this matchup because: ${safeWinnerReason}`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: displayComparisonTitle,
    description: safeSummary,
    url: `https://www.creditdoc.co/compare/${comparison.slug}/`,
    author: {
      '@type': 'Person',
      name: 'CreditDoc Editorial Team',
      jobTitle: 'Chief Executive',
      description: 'International consumer finance executive with experience across multiple continents. MBA from a globally ranked university. Over 15 years in payments, lending, and risk management.',
      url: 'https://www.creditdoc.co/about/',
    },
    publisher: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
      logo: { '@type': 'ImageObject', url: 'https://www.creditdoc.co/favicon.svg' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Comparisons', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 3, name: displayComparisonTitle, item: `https://www.creditdoc.co/compare/${comparison.slug}/` },
    ],
  },
  ...((faqs || []).filter((faq: { question?: string; answer?: string }) => faq.question?.trim() && faq.answer?.trim()).length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: (faqs || [])
      .filter((faq: { question?: string; answer?: string }) => faq.question?.trim() && faq.answer?.trim())
      .map((faq: { question: string; answer: string }) => ({
        '@type': 'Question',
        name: faq.question.trim(),
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer.trim(),
        },
      })),
  }] : []),
];
---

<BaseLayout
  title={`${displayComparisonTitle} | CreditDoc`}
  description={safeSummary}
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs -->
  <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-text font-medium">{displayComparisonTitle}</li>
    </ol>
  </nav>

  <!-- Two-Column Header -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-text text-center mb-3">{displayComparisonTitle}</h1>
    <p class="text-sm text-muted text-center mb-8">
      Written by <a href="/about/" class="text-primary hover:underline font-medium">Harvey Brooks</a>
      <span class="mx-2 text-border">|</span>
      Reviewed by the CreditDoc Editorial Team
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {[lenderA, lenderB].map((lender) => {
        const isWinner = comparison.winner === lender.slug;
        const bbbCls = getBbbClass(normalizedBbbRating(lender));
        return (
          <div class:list={[
            'glass-card p-6 text-center relative',
            isWinner ? 'ring-2 ring-primary' : ''
          ]}>
            {isWinner && (
              <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-primary text-white shadow-md">
                Comparison Note
              </span>
            )}
            <div class="w-16 h-16 rounded-2xl bg-bg-alt border border-border flex items-center justify-center mx-auto overflow-hidden">
              {lender.logo_url ? (
                <img src={lender.logo_url} alt={`${lender.name} logo`} class="w-12 h-12 object-contain" loading="lazy" onerror={`this.onerror=null;this.parentElement.innerHTML='<span class="text-xl font-bold text-primary">${lender.name.charAt(0)}</span>'`} />
              ) : (
                <span class="text-xl font-bold text-primary">{lender.name.charAt(0)}</span>
              )}
            </div>
            <h2 class="mt-3 text-lg font-bold text-text">{lender.name}</h2>
            <div class="mt-2 flex items-center justify-center">
              {lender.google_rating && lender.google_rating > 0 && !(lender.google_rating > 5) && lender.google_reviews_count && lender.google_reviews_count >= 1 ? (
                <div class="flex flex-col items-center">
                  <RatingStars rating={lender.google_rating} size="sm" showValue={true} />
                  <p class="mt-0.5 text-xs text-muted">Google rating from {lender.google_reviews_count.toLocaleString()} reviews</p>
                </div>
              ) : (
                <span class="text-xs text-muted">No stored Google rating</span>
              )}
            </div>
            <div class="mt-3 flex flex-wrap items-center justify-center gap-2">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-primary-light text-primary">
                {monthlyPriceLabel(lender)}
              </span>
              <span class:list={['inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold', bbbCls]}>
                {bbbBadgeLabel(lender)}
              </span>
            </div>
            <div class="mt-4 flex gap-2">
              <a
                href={`/review/${lender.slug}/`}
                class="flex-1 text-center px-4 py-2.5 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-alt transition-colors"
              >
                Full Review
              </a>
              <a
                href={lender.affiliate_url || lender.website_url}
                target="_blank"
                rel="noopener noreferrer nofollow"
                class="flex-1 text-center px-4 py-2.5 text-sm font-medium rounded-lg bg-primary text-white hover:bg-primary-hover transition-colors"
              >
                Visit Site
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- Summary -->
  <section class="mx-auto max-w-7xl px-4 pb-4 sm:px-6 lg:px-8">
    <div class="glass-card p-6">
      <h2 class="text-lg font-bold text-text mb-3">Summary</h2>
      <p class="text-sm text-muted leading-relaxed">{safeSummary}</p>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="glass-card p-4 sm:p-6">
      <h2 class="text-lg font-bold text-text mb-4">Side-by-Side Comparison</h2>
      <ComparisonTable lenderA={lenderA} lenderB={lenderB} />
    </div>
  </section>

  <!-- Diagnosis -->
  <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <h2 class="text-lg font-bold text-text mb-4">How to Compare These Two</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <DiagnosisCard
        diagnosis={`Review ${lenderA.name} if these stored profile signals are relevant to your research: ${lenderASignals}. Profile signal to verify: ${lenderAStrength}.`}
        lenderName={lenderA.name}
      />
      <DiagnosisCard
        diagnosis={`Review ${lenderB.name} if these stored profile signals are relevant to your research: ${lenderBSignals}. Profile signal to verify: ${lenderBStrength}.`}
        lenderName={lenderB.name}
      />
    </div>
    <div class="mt-4">
      <DiagnosisCard
        diagnosis={`CreditDoc comparison note: ${winnerLender.name}. ${safeWinnerReason}`}
        lenderName={winnerLender.name}
      />
    </div>
  </section>

  <!-- Authority Graph Context -->
  <section class="mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-text mb-2">Check the Context Before You Contact a Company</h2>
      <p class="text-sm text-muted leading-relaxed">
        Use this comparison with each company profile, related category pages, local guides, and CreditDoc data explainers. This page is directory context, not a recommendation, approval prediction, price quote, or licensing determination.
      </p>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href={`/review/${lenderA.slug}/`} class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          {lenderA.name} profile
        </a>
        <a href={`/review/${lenderB.slug}/`} class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          {lenderB.name} profile
        </a>
        {categoryContextCards.slice(0, 1).map(card => (
          <a href={card.href} class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
            {card.label} directory
          </a>
        ))}
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Complaint data context
        </a>
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Local guides
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <div class="glass-card p-6">
      <h2 class="text-xl font-bold text-text mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {faqs.map(faq => (
          <details class="group border-b border-border pb-4 last:border-0 last:pb-0">
            <summary class="flex items-center justify-between cursor-pointer text-sm font-semibold text-text hover:text-primary transition-colors py-1">
              {faq.question}
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-muted group-open:rotate-180 transition-transform shrink-0 ml-2" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 011.06 0L10 11.94l3.72-3.72a.75.75 0 111.06 1.06l-4.25 4.25a.75.75 0 01-1.06 0L5.22 9.28a.75.75 0 010-1.06z" clip-rule="evenodd"/>
              </svg>
            </summary>
            <p class="mt-2 text-sm text-muted leading-relaxed">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Explore More -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h2 class="text-lg font-bold text-text mb-4">Explore More Options</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
      <a href="/best/best-credit-repair-companies/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Credit Repair Guide</p>
        <p class="text-xs text-muted mt-1">Provider profiles and comparisons</p>
      </a>
      <a href="/best/best-personal-loans-bad-credit/" class="glass-card p-4 hover:border-primary transition-colors">
        <p class="text-sm font-semibold text-text">Personal Loans</p>
        <p class="text-xs text-muted mt-1">Bad credit options</p>
      </a>
