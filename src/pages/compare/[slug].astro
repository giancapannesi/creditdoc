import { buildLenderFallbackHref, buildLenderGoHref, buildReviewHref } from '../../utils/outbound';
import type { Lender } from '../../utils/data';

export function getStaticPaths() {
  const comparisons = getComparisons();
  return comparisons
    .filter(comp => getLenderBySlug(comp.lender_a) && getLenderBySlug(comp.lender_b))
    .map(comp => ({
      params: { slug: comp.slug },
    }));
}

const { slug } = Astro.params;
const comparisons = getComparisons();
const comparison = comparisons.find(c => c.slug === slug)!;

const lenderA = getLenderBySlug(comparison.lender_a)!;
const lenderB = getLenderBySlug(comparison.lender_b)!;

const winnerLender = comparison.winner === comparison.lender_a ? lenderA : lenderB;
const reviewHrefBySlug = new Map([
  [lenderA.slug, buildReviewHref(lenderA)],
  [lenderB.slug, buildReviewHref(lenderB)],
]);

function lenderDetailsHref(lender: Lender): string {
  return reviewHrefBySlug.get(lender.slug) ?? buildLenderFallbackHref(lender);
}

function lenderReviewLabel(lender: Lender): string {
  return reviewHrefBySlug.get(lender.slug) ? `Read the full ${lender.name} review` : `Compare ${lender.name} category`;
}

function softenComparisonText(text: string): string {
