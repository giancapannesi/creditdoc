const safeSummary = softenComparisonText(comparison.summary);
const safeWinnerReason = softenComparisonText(comparison.winner_reason);

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function titleCaseSlug(value: string): string {
  return value
    .split('-')
    .filter(Boolean)
    .map((part) => (part.length === 2 ? part.toUpperCase() : part.charAt(0).toUpperCase() + part.slice(1)))
    .join(' ');
}

function compact(value: string, maxLength: number): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;
  return normalized.slice(0, maxLength - 1).trimEnd();
}

function addressContext(lender: Lender): string {
  const address = String(lender.address || '');
  const match = address.match(/,\s*([^,]+),\s*([A-Z]{2})\s+\d{5}/);
  return match ? `${match[1].trim()} ${match[2].trim()}` : '';
}

function slugContext(lender: Lender): string {
  const legalSuffixes = new Set(['inc', 'llc', 'ltd', 'co', 'corp', 'corporation', 'company', 'pllc', 'lp']);
  const slugParts = lender.slug.split('-').filter(Boolean);
  const nameParts = slugify(lender.name)
    .split('-')
    .filter((part) => part && !legalSuffixes.has(part));

  let index = 0;
  for (const part of nameParts) {
    if (slugParts[index] === part) index += 1;
  }

  const contextParts = slugParts.slice(index);
  if (contextParts.length === 0 || contextParts.length === slugParts.length) return '';
  return titleCaseSlug(contextParts.join('-'));
}

function lenderMetaLabel(lender: Lender, maxLength = 38): string {
  const context = addressContext(lender) || slugContext(lender);
  const nameHasContext = context && lender.name.toLowerCase().includes(context.toLowerCase());
  const label = context && !nameHasContext ? `${lender.name} ${context}` : lender.name;
  return compact(label, maxLength);
}

const lenderATitleLabel = lenderMetaLabel(lenderA, 30);
const lenderBTitleLabel = lenderMetaLabel(lenderB, 30);
const displayComparisonTitle = `${lenderATitleLabel} vs ${lenderBTitleLabel} (2026)`;
const metaDescription = `${lenderMetaLabel(lenderA, 44)} vs ${lenderMetaLabel(lenderB, 44)}: compare listed pricing, services, review context, BBB/profile fields, and verification questions before contacting either provider.`;
const lenderASignals = profileSignals(lenderA);
const lenderBSignals = profileSignals(lenderB);
const lenderAStrength = profileStrength(lenderA);
const lenderBStrength = profileStrength(lenderB);

function setupFeeContext(lender: Lender): string {
  return lender.pricing.setup_fee > 0
    ? `${lender.name} lists a ${formatPrice(lender.pricing.setup_fee)} setup fee`
    : `${lender.name} has no listed setup fee`;
}

function listedPrice(price: number | undefined): number | null {
  return typeof price === 'number' && Number.isFinite(price) && price >= 0 ? price : null;
}

function lowestListedMonthlyPrice(lender: Lender): number | null {
  const monthlyPrice = listedPrice(lender.pricing.monthly_price);
  if (monthlyPrice !== null && monthlyPrice > 0) return monthlyPrice;
  const comparableTiers = lender.pricing.tiers
    .map(tier => listedPrice(tier.price))
    .filter((price): price is number => price !== null)
    .filter(price => price > 0)
    .filter(price => monthlyPrice === null || monthlyPrice === 0 || price <= monthlyPrice * 2);

  if (comparableTiers.length > 0) return Math.min(...comparableTiers);
  return monthlyPrice;
}

function monthlyPriceLabel(lender: Lender): string {
  const price = lowestListedMonthlyPrice(lender);
  if (price === null) return 'No listed monthly price';
  return price === 0 ? 'No monthly subscription listed' : `From ${formatPrice(price)}/mo`;
}

function normalizedBbbRating(lender: Lender): string {
  return lender.company_info.bbb_rating?.trim() || '';
}

function bbbBadgeLabel(lender: Lender): string {
  const rating = normalizedBbbRating(lender);
  return rating && rating !== 'N/A' ? `BBB: ${rating}` : 'BBB: NR';
}

function bbbFaqLabel(lender: Lender): string {
  const rating = normalizedBbbRating(lender);
  if (!rating || rating === 'N/A') return `${lender.name} does not have a stored BBB rating in this profile`;
  const article = rating === 'NR' || rating.startsWith('A') || rating.startsWith('F') ? 'an' : 'a';
  return `${lender.name} has ${article} ${rating} BBB rating${lender.company_info.bbb_accredited ? ' (accredited)' : ''}`;
}

const lenderAMonthlyPrice = lowestListedMonthlyPrice(lenderA);
const lenderBMonthlyPrice = lowestListedMonthlyPrice(lenderB);

function monthlyPriceFaqAnswer(): string {
  const aContext = `${lenderA.name}: ${monthlyPriceLabel(lenderA)}`;
  const bContext = `${lenderB.name}: ${monthlyPriceLabel(lenderB)}`;
  const setupContext = `Setup fees can change first-month cost: ${setupFeeContext(lenderA)}, while ${setupFeeContext(lenderB)}.`;

  if (lenderAMonthlyPrice === null && lenderBMonthlyPrice === null) {
    return `Neither profile has a stored monthly-price field for this comparison. ${setupContext}`;
  }

  if (lenderAMonthlyPrice === null || lenderBMonthlyPrice === null) {
    return `The stored monthly-price fields are incomplete for this comparison. Current listed context: ${aContext}; ${bContext}. ${setupContext}`;
  }

  if (lenderAMonthlyPrice === 0 || lenderBMonthlyPrice === 0) {
    if (lenderAMonthlyPrice === 0 && lenderBMonthlyPrice === 0) {
      return `Neither profile lists a recurring monthly subscription fee. This does not mean all borrowing, card, usage, interest, or per-transaction costs are free. ${setupContext}`;
    }

    return `Only one profile lists a recurring monthly subscription fee. This does not make the other profile cost-free; review borrowing, card, usage, interest, and per-transaction costs before comparing total cost. Current listed context: ${aContext}; ${bContext}. ${setupContext}`;
  }

  if (lenderAMonthlyPrice < lenderBMonthlyPrice) {
    return `${lenderA.name} lists the lower monthly price at ${formatPrice(lenderAMonthlyPrice)}/mo, compared with ${lenderB.name} at ${formatPrice(lenderBMonthlyPrice)}/mo. ${setupContext}`;
  }

  if (lenderAMonthlyPrice > lenderBMonthlyPrice) {
    return `${lenderB.name} lists the lower monthly price at ${formatPrice(lenderBMonthlyPrice)}/mo, compared with ${lenderA.name} at ${formatPrice(lenderAMonthlyPrice)}/mo. ${setupContext}`;
  }

  return `Both ${lenderA.name} and ${lenderB.name} list the same monthly price of ${formatPrice(lenderAMonthlyPrice)}/mo. ${setupContext}`;
}

function refundTermLabel(lender: Lender): string | null {
  if (!lender.pricing.money_back_guarantee) return null;
  const refundDetails = softenComparisonText(lender.pricing.guarantee_details || 'refund term listed').replace(/[.\s]+$/g, '');
  return `${lender.name} has a listed refund term: ${refundDetails}`;
}

function refundTermsFaqAnswer(): string {
  const aRefund = refundTermLabel(lenderA);
  const bRefund = refundTermLabel(lenderB);

  if (!aRefund && !bRefund) {
    return 'Neither profile lists a refund term in the stored comparison data.';
  }

  if (aRefund && bRefund) {
    return `${aRefund}. ${bRefund}.`;
  }

  const listedRefund = aRefund || bRefund;
  const missingRefundLender = aRefund ? lenderB : lenderA;
  return `${listedRefund}. ${missingRefundLender.name} does not have a listed refund term in this profile.`;
}

