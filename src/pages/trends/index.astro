---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

interface CfpbEntry {
  slug: string;
  company_name: string;
  resolution_rate: number | null;
  timely_rate: number | null;
  response_breakdown: Record<string, number> | null;
}

const raw = fs.readFileSync(path.join(process.cwd(), 'src/content/cfpb-trends.json'), 'utf-8');
const rawEntries: CfpbEntry[] = JSON.parse(raw);

const allEntries = rawEntries.filter((entry) => {
  const lenderPath = path.join(process.cwd(), 'src/content/lenders', `${entry.slug}.json`);
  if (!fs.existsSync(lenderPath)) return true;

  try {
    const lender = JSON.parse(fs.readFileSync(lenderPath, 'utf-8'));
    return lender.processing_status !== 'archived' && lender.no_index !== true;
  } catch {
    return true;
  }
});

// Deduplicate index by company_name — keep shortest slug (canonical) per brand.
// Individual /trends/[slug] detail pages remain untouched (branches have unique location data).
const canonicalMap = new Map<string, CfpbEntry>();
for (const e of allEntries) {
  const existing = canonicalMap.get(e.company_name);
  if (!existing || e.slug.length < existing.slug.length) {
    canonicalMap.set(e.company_name, e);
  }
}
const entries = [...canonicalMap.values()];
const sorted = entries.sort((a, b) => a.company_name.localeCompare(b.company_name));

const totalInteractions = allEntries.reduce((sum, e) => {
  if (!e.response_breakdown) return sum;
  return sum + Object.values(e.response_breakdown).reduce((s, v) => s + v, 0);
}, 0);

const title = 'Consumer Response Profiles — CFPB Context | CreditDoc';
const description = `Browse ${entries.length} consumer response profiles showing public CFPB response-outcome patterns, timely-response context, and product categories from CFPB complaint data.`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: 'https://www.creditdoc.co/trends/',
    isPartOf: { '@type': 'WebSite', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
    publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Consumer Response Data', item: 'https://www.creditdoc.co/trends/' },
    ],
  },
];

// Group by first letter
const grouped = new Map<string, CfpbEntry[]>();
for (const entry of sorted) {
  const letter = entry.company_name.charAt(0).toUpperCase();
  if (!grouped.has(letter)) grouped.set(letter, []);
  grouped.get(letter)!.push(entry);
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-text font-medium">Consumer Response Data</li>
    </ol>
  </nav>

  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-text mb-2">Consumer Response Profiles</h1>
    <p class="text-sm text-muted mb-6">
      {entries.length} financial companies tracked &bull; {totalInteractions.toLocaleString()} public CFPB complaint records summarized
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="glass-card p-4 text-center">
        <div class="text-2xl font-bold text-primary">{entries.length}</div>
        <div class="text-xs text-muted mt-1">Response Profiles</div>
      </div>
      <div class="glass-card p-4 text-center">
        <div class="text-2xl font-bold text-emerald-500">{totalInteractions.toLocaleString()}</div>
        <div class="text-xs text-muted mt-1">Public CFPB Records</div>
      </div>
      <div class="glass-card p-4 text-center">
        <div class="text-2xl font-bold text-text">CFPB</div>
        <div class="text-xs text-muted mt-1">Federal Data Source</div>
      </div>
    </div>

    <p class="text-sm text-muted mb-6">
      Each profile shows public CFPB response-outcome patterns by company: recorded response outcomes, timely-response context, and product categories named in public complaint records. Data sourced from the <a href="/research/consumer-complaints/" class="text-primary hover:underline">Consumer Financial Protection Bureau</a>; use it as transparency context, not as a rating, endorsement, or proof of wrongdoing.
    </p>

    <!-- Alphabet nav -->
    <div class="flex flex-wrap gap-1 mb-6">
      {[...grouped.keys()].map(letter => (
        <a href={`#letter-${letter}`} class="w-8 h-8 flex items-center justify-center rounded text-xs font-semibold text-primary bg-primary/5 hover:bg-primary/15 transition-colors">{letter}</a>
      ))}
    </div>

    <!-- Company listing -->
    <div class="space-y-8">
      {[...grouped.entries()].map(([letter, companies]) => (
        <div id={`letter-${letter}`}>
          <h2 class="text-lg font-bold text-text border-b border-border pb-2 mb-3">{letter}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
            {companies.map(company => {
              const total = company.response_breakdown ? Object.values(company.response_breakdown).reduce((s, v) => s + v, 0) : 0;
              return (
                <a href={`/trends/${company.slug}/`} class="flex items-center justify-between px-3 py-2 rounded-lg hover:bg-bg-alt transition-colors group">
                  <span class="text-sm text-text group-hover:text-primary transition-colors truncate mr-2">{company.company_name}</span>
                  <span class="text-xs text-muted whitespace-nowrap">
                    {company.resolution_rate != null ? `${company.resolution_rate.toFixed(0)}% outcome` : '—'}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-text mb-3">Use Consumer Response Data With CreditDoc Context</h2>
      <p class="text-sm text-muted leading-relaxed mb-4">
        CFPB response data is one public-data layer. Compare it with provider profiles, categories, local guides, state rules, and source notes before drawing conclusions.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Complaint Methodology</span>
          <span class="mt-1 block text-xs text-muted">How CreditDoc explains CFPB complaint data.</span>
        </a>
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">City Guides</span>
          <span class="mt-1 block text-xs text-muted">Add local provider and map context.</span>
        </a>
        <a href="/categories/fintech/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Fintech</span>
          <span class="mt-1 block text-xs text-muted">Review app-based finance providers separately.</span>
        </a>
        <a href="/about/creditdoc-data/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Data Sources</span>
          <span class="mt-1 block text-xs text-muted">Understand how CreditDoc uses public datasets.</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="glass-card p-5 text-center">
      <p class="text-sm text-muted mb-3">Want to understand what this data means?</p>
      <a href="/research/consumer-complaints/" class="inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded-lg bg-primary text-white hover:bg-primary-hover transition-colors">
        How We Use CFPB Data
      </a>
    </div>
  </section>
</BaseLayout>
