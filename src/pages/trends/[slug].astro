---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

interface CfpbProduct {
  name: string;
  pct: number;
}

interface CfpbIssue {
  name: string;
  pct: number;
}

interface CfpbEntry {
  slug: string;
  company_name: string;
  cfpb_company_name: string;
  checked_at: string;
  found_in_cfpb: number;
  resolution_rate: number | null;
  timely_rate: number | null;
  top_products: CfpbProduct[] | null;
  top_issues: CfpbIssue[] | null;
  response_breakdown: Record<string, number> | null;
  data_period: string | null;
  applied_to_profile: number;
}

export function getStaticPaths() {
  const raw = fs.readFileSync(path.join(process.cwd(), 'src/content/cfpb-trends.json'), 'utf-8');
  const entries: CfpbEntry[] = JSON.parse(raw);
  const crawlableEntries = entries.filter((entry) => {
    const lenderPath = path.join(process.cwd(), 'src/content/lenders', `${entry.slug}.json`);
    if (!fs.existsSync(lenderPath)) return true;

    try {
      const lender = JSON.parse(fs.readFileSync(lenderPath, 'utf-8'));
      return lender.processing_status !== 'archived' && lender.no_index !== true;
    } catch {
      return true;
    }
  });

  return crawlableEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { cfpb: entry },
  }));
}

const { cfpb } = Astro.props as { cfpb: CfpbEntry };

// Compute display values
const resolutionPct = cfpb.resolution_rate != null ? cfpb.resolution_rate.toFixed(1) : null;
const timelyPct = cfpb.timely_rate != null ? cfpb.timely_rate.toFixed(1) : null;

// Response breakdown total for percentage calc
const breakdownTotal = cfpb.response_breakdown
  ? Object.values(cfpb.response_breakdown).reduce((sum, v) => sum + v, 0)
  : 0;

// Color helpers for response breakdown
const breakdownColors: Record<string, string> = {
  'Closed with explanation': 'bg-indigo-500',
  'Closed with monetary relief': 'bg-emerald-500',
  'Closed with non-monetary relief': 'bg-sky-500',
  'Closed without relief': 'bg-amber-500',
  'Closed': 'bg-slate-400',
  'In progress': 'bg-purple-500',
  'Untimely response': 'bg-red-500',
};

function getBreakdownColor(key: string): string {
  return breakdownColors[key] || 'bg-slate-400';
}

function slugify(value: string): string {
  return value
    .toLowerCase()
    .replace(/&/g, ' and ')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

function titleCaseSlug(value: string): string {
  return value
    .split('-')
    .filter(Boolean)
    .map((part) => (part.length === 2 ? part.toUpperCase() : part.charAt(0).toUpperCase() + part.slice(1)))
    .join(' ');
}

function compact(value: string, maxLength: number): string {
  const normalized = value.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;
  return normalized.slice(0, maxLength - 1).trimEnd();
}

function slugContext(slug: string, companyName: string): string {
  const legalSuffixes = new Set(['inc', 'llc', 'ltd', 'co', 'corp', 'corporation', 'company', 'pllc', 'lp']);
  const slugParts = slug.split('-').filter(Boolean);
  const companyParts = slugify(companyName)
    .split('-')
    .filter((part) => part && !legalSuffixes.has(part));

  let index = 0;
  for (const part of companyParts) {
    if (slugParts[index] === part) index += 1;
  }

  const contextParts = slugParts.slice(index);
  if (contextParts.length === 0 || contextParts.length === slugParts.length) return '';
  return titleCaseSlug(contextParts.join('-'));
}

// SEO
const contextLabel = slugContext(cfpb.slug, cfpb.company_name);
const titleCompany = compact(cfpb.company_name, contextLabel ? Math.max(18, 48 - contextLabel.length) : 42);
const seoTitle = contextLabel
  ? `${titleCompany} ${contextLabel} CFPB | CreditDoc`
  : `${titleCompany} CFPB Data | CreditDoc`;
const seoDesc = `${cfpb.company_name}${contextLabel ? ` (${contextLabel})` : ''} CFPB response data: ${resolutionPct || '-'}% recorded response-outcome rate, ${timelyPct || '-'}% timely responses. Use as transparency context, not a rating.`;

// JSON-LD
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: seoTitle,
    description: seoDesc,
    url: `https://www.creditdoc.co/trends/${cfpb.slug}/`,
    isPartOf: {
      '@type': 'WebSite',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
    },
    author: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
    },
    publisher: {
      '@type': 'Organization',
      name: 'CreditDoc',
      url: 'https://www.creditdoc.co',
      logo: { '@type': 'ImageObject', url: 'https://www.creditdoc.co/favicon.svg' },
    },
    dateModified: cfpb.checked_at || undefined,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
      { '@type': 'ListItem', position: 2, name: 'Consumer Response Data', item: 'https://www.creditdoc.co/research/consumer-complaints/' },
      { '@type': 'ListItem', position: 3, name: `${cfpb.company_name}`, item: `https://www.creditdoc.co/trends/${cfpb.slug}/` },
    ],
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  jsonLd={jsonLd}
>
  <!-- Breadcrumbs -->
  <nav class="mx-auto max-w-7xl px-4 pt-6 sm:px-6 lg:px-8" aria-label="Breadcrumb">
    <ol class="flex items-center gap-1.5 text-sm text-muted flex-wrap">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/research/consumer-complaints/" class="hover:text-primary transition-colors">Consumer Response Data</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-text font-medium">{cfpb.company_name}</li>
    </ol>
  </nav>

  <!-- Header -->
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-text mb-2">
      {cfpb.company_name} — Consumer Response Profile
    </h1>
    <p class="text-sm text-muted">
      Public CFPB response-outcome context for this company
      {cfpb.data_period && <span> &bull; Period: {cfpb.data_period}</span>}
      {cfpb.checked_at && <span> &bull; Data checked: {cfpb.checked_at}</span>}
    </p>
  </section>

  <!-- Key Metrics -->
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <!-- Recorded Response Outcome Rate -->
      <div class="glass-card p-5 text-center">
        <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">Recorded Response Outcome</div>
        <div class="text-3xl font-bold text-primary">
          {resolutionPct != null ? `${resolutionPct}%` : '—'}
        </div>
        <p class="text-xs text-muted mt-1">CFPB complaints with a recorded company response outcome</p>
      </div>

      <!-- Timely Response -->
      <div class="glass-card p-5 text-center">
        <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">Timely Response</div>
        <div class="text-3xl font-bold text-emerald-500">
          {timelyPct != null ? `${timelyPct}%` : '—'}
        </div>
        <p class="text-xs text-muted mt-1">Company response recorded within the CFPB response window</p>
      </div>

      <!-- Total Responses -->
      <div class="glass-card p-5 text-center">
        <div class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">Recorded Complaints</div>
        <div class="text-3xl font-bold text-text">
          {breakdownTotal > 0 ? breakdownTotal.toLocaleString() : '—'}
        </div>
        <p class="text-xs text-muted mt-1">Public CFPB complaint records in this dataset</p>
      </div>
    </div>
  </section>

  <!-- Top Complaint Products -->
  {cfpb.top_products && cfpb.top_products.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-text mb-4">Products Named in CFPB Records</h2>
        <div class="space-y-3">
          {cfpb.top_products.map((product) => (
            <div>
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-text font-medium truncate mr-2">{product.name}</span>
                <span class="text-muted font-semibold whitespace-nowrap">{product.pct.toFixed(1)}%</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-bg-alt overflow-hidden">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-indigo-500 to-purple-500 transition-all"
                  style={`width: ${Math.min(product.pct, 100)}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Top Issues -->
  {cfpb.top_issues && cfpb.top_issues.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-text mb-4">Issue Categories in CFPB Records</h2>
        <div class="space-y-3">
          {cfpb.top_issues.map((issue) => (
            <div>
              <div class="flex items-center justify-between text-sm mb-1">
                <span class="text-text font-medium truncate mr-2">{issue.name}</span>
                <span class="text-muted font-semibold whitespace-nowrap">{issue.pct.toFixed(1)}%</span>
              </div>
              <div class="w-full h-2.5 rounded-full bg-bg-alt overflow-hidden">
                <div
                  class="h-full rounded-full bg-gradient-to-r from-amber-500 to-orange-500 transition-all"
                  style={`width: ${Math.min(issue.pct, 100)}%`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Response Breakdown -->
  {cfpb.response_breakdown && breakdownTotal > 0 && (
    <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
      <div class="glass-card p-5">
        <h2 class="text-lg font-bold text-text mb-4">Response Breakdown</h2>

        <!-- Stacked bar -->
        <div class="w-full h-6 rounded-full overflow-hidden flex mb-4">
          {Object.entries(cfpb.response_breakdown).map(([key, val]) => (
            <div
              class={`h-full ${getBreakdownColor(key)}`}
              style={`width: ${((val as number) / breakdownTotal * 100).toFixed(1)}%`}
              title={`${key}: ${val}`}
            />
          ))}
        </div>

        <!-- Legend -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {Object.entries(cfpb.response_breakdown).map(([key, val]) => (
            <div class="flex items-center gap-2 text-sm">
              <span class={`w-3 h-3 rounded-sm shrink-0 ${getBreakdownColor(key)}`}></span>
              <span class="text-text">{key}</span>
              <span class="text-muted ml-auto font-semibold">
                {val} ({((val as number) / breakdownTotal * 100).toFixed(1)}%)
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Educational Section -->
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-text mb-3">Understanding This Data</h2>
      <div class="prose prose-sm text-muted max-w-none space-y-3">
        <p>
          The <strong class="text-text">Consumer Financial Protection Bureau (CFPB)</strong> tracks
          how financial companies respond to consumer complaints. This profile shows
          public response patterns for <strong class="text-text">{cfpb.company_name}</strong>.
        </p>
        <ul class="list-disc list-inside space-y-1">
          <li>
            <strong class="text-text">Recorded Response Outcome</strong> — The share of public CFPB
            complaint records where the company has a recorded response outcome such as monetary
            relief, non-monetary relief, or explanation.
          </li>
          <li>
            <strong class="text-text">Timely Response Rate</strong> — The share of public CFPB
            complaint records with a company response inside the CFPB response window.
          </li>
          <li>
            <strong class="text-text">Products Named</strong> — Which CFPB product categories appear
            most often in this company's public complaint records.
          </li>
          <li>
            <strong class="text-text">Issue Categories</strong> — The complaint issue categories
            consumers selected most often in the public CFPB records.
          </li>
        </ul>
        <p>
          CFPB response data is transparency context, not proof of wrongdoing, endorsement,
          customer-satisfaction evidence, a safety rating, or a suitability determination.
          Complaint volume is not a quality indicator; larger companies often have more
          public complaint records.
        </p>
      </div>
    </div>
  </section>

  <!-- CreditDoc Context -->
  <section class="mx-auto max-w-7xl px-4 pb-8 sm:px-6 lg:px-8">
    <div class="glass-card p-5">
      <h2 class="text-lg font-bold text-text mb-3">Use This Response Profile With CreditDoc Context</h2>
      <p class="text-sm text-muted leading-relaxed mb-4">
        Treat CFPB response data as one research input. Review the provider profile, category page, local guides, and state rules for more context.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href={`/review/${cfpb.slug}/`} class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Provider Profile</span>
          <span class="mt-1 block text-xs text-muted">Review pricing, services, third-party ratings, and source notes.</span>
        </a>
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">Complaint Data</span>
          <span class="mt-1 block text-xs text-muted">Read the broader CFPB data explanation.</span>
        </a>
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">City Guides</span>
          <span class="mt-1 block text-xs text-muted">Add local provider and map context.</span>
        </a>
        <a href="/state/" class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary/40">
          <span class="block text-sm font-semibold text-text">State Rules</span>
          <span class="mt-1 block text-xs text-muted">Compare against state-level lending context.</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="glass-card p-6 text-center border-primary/20 border">
      <h2 class="text-lg font-bold text-text mb-2">Want the Full Picture?</h2>
      <p class="text-sm text-muted mb-5 max-w-lg mx-auto">
        Continue to the CreditDoc provider profile for listed services, contact details, stored rating context where available, and source notes.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={`/review/${cfpb.slug}/`}
          class="inline-flex items-center px-5 py-2.5 text-sm font-semibold rounded-lg bg-primary text-white hover:bg-primary-hover transition-colors"
        >
          View Full Profile
        </a>
        <a
          href="/research/consumer-complaints/"
          class="inline-flex items-center px-5 py-2.5 text-sm font-medium rounded-lg border border-border text-text hover:bg-bg-alt transition-colors"
        >
          Browse All Response Data
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
