---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';
import { getAllLenders } from '../../utils/data-build';

function isSafeCreditRepairProfile(l) {
  const processingStatus = String(l.processing_status || '');
  const reviewStatus = String(l.review_status || '');
  const quarantineReason = String(l.quarantine_reason || '');
  const noIndex = l.no_index === true || l.no_index === 1 || l.no_index === 'true';

  return (
    l.category === 'credit-repair' &&
    processingStatus === 'ready_for_index' &&
    reviewStatus === 'published' &&
    !noIndex &&
    !quarantineReason &&
    l.google_rating &&
    l.google_rating > 0 &&
    l.google_rating <= 5 &&
    l.google_reviews_count &&
    l.google_reviews_count >= 10 &&
    l.description_short &&
    l.description_short.length > 30
  );
}

function profileScore(l) {
  const rating = Number(l.google_rating || 0);
  const reviews = Number(l.google_reviews_count || 0);
  const quality = Number(l.quality_score || 0);
  const enriched =
    l.has_been_enriched === true ||
    l.data_source === 'enriched' ||
    l.data_source === 'editorial' ||
    l.data_source === 'verified';

  return (enriched ? 30 : 0) + quality * 2 + Math.log10(reviews + 1) * 12 + rating * 4;
}

const creditRepairProfiles = getAllLenders()
  .filter(isSafeCreditRepairProfile)
  .sort((a, b) => profileScore(b) - profileScore(a))
  .slice(0, 6)
  .map((l) => ({
    name: l.name,
    slug: l.slug,
    google_rating: l.google_rating || 0,
    google_reviews_count: l.google_reviews_count || 0,
    description: l.description_short?.substring(0, 130) || '',
    free_consultation: l.pricing?.free_consultation || false,
    money_back: l.pricing?.money_back_guarantee || false,
  }));

const title = 'Credit Repair Qualify Quiz | CreditDoc';
const description = 'Answer a few simple questions to see whether credit repair research, DIY dispute steps, or credit-building tools may fit your situation.';
const canonical = 'https://www.creditdoc.co/tools/credit-repair-qualify-quiz/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Credit Repair Qualify Quiz',
  description,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  image: 'https://www.creditdoc.co/og-default.png',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  datePublished: '2026-06-09',
  dateModified: '2026-06-09',
  author: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does this quiz repair my credit?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. This is an educational questionnaire. It does not dispute credit report items, contact bureaus, or provide legal or financial advice.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will this quiz affect my credit score?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The quiz does not ask for a Social Security number, does not run a credit check, and does not contact any lender or credit bureau.',
      },
    },
    {
      '@type': 'Question',
      name: 'When can a credit repair company help?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Credit repair companies generally focus on disputing inaccurate, incomplete, or unverifiable credit report information. They cannot legally guarantee a score increase or remove accurate negative information just because it hurts your score.',
      },
    },
  ],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Credit Repair Qualify Quiz', item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li><a href="/tools/" class="hover:text-primary transition-colors">Tools</a></li>
      <li class="text-border">/</li>
      <li class="font-medium text-text">Credit Repair Qualify Quiz</li>
    </ol>
  </nav>

  <div class="mx-auto max-w-4xl px-4 py-8">
    <section id="quiz-intro" class="text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">
        Free &middot; No credit check &middot; 2 minutes
      </div>
      <h1 class="text-3xl font-bold text-text md:text-4xl">Could Credit Repair Help Your Situation?</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Answer simple questions about credit report issues, payment history, and your timeline. The result points you toward credit repair research, DIY dispute steps, or safer credit-building paths.
      </p>
      <button id="start-quiz-btn" class="mt-8 inline-flex items-center justify-center rounded-xl bg-primary px-8 py-3.5 font-semibold text-white shadow-lg transition hover:bg-primary-hover">
        Start The Quiz
      </button>
    </section>

    <section class="glass-card mt-8 p-5">
      <h2 class="mb-2 text-lg font-bold text-text">Important Context Before You Start</h2>
      <p class="text-sm leading-relaxed text-muted">
        Credit repair is mainly about disputing inaccurate, incomplete, or unverifiable credit report information. A company cannot legally guarantee a specific score increase, erase accurate negative history, or charge upfront before promised work is performed.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/resources/credit-report-checklist/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Credit report checklist</a>
        <a href="/financial-wellness/credit-repair-rights-fcra-croa/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">FCRA and CROA rights</a>
        <a href="/best/best-credit-repair-companies/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Credit repair profiles</a>
        <a href="/methodology/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">How CreditDoc researches</a>
      </div>
    </section>

    <section id="quiz-panel" class="mt-8 hidden">
      <div class="mb-6">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-sm font-medium text-muted">Question <span id="current-q">1</span> of 6</span>
          <span id="progress-pct" class="text-sm font-medium text-primary">17%</span>
        </div>
        <div class="h-2.5 w-full rounded-full bg-bg-alt">
          <div id="progress-bar" class="h-2.5 rounded-full bg-primary transition-all duration-300" style="width: 17%"></div>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-white p-6">
        <p id="question-kicker" class="text-sm font-semibold uppercase tracking-wider text-primary"></p>
        <h2 id="question-title" class="mt-2 text-2xl font-bold text-text"></h2>
        <p id="question-help" class="mt-2 text-sm leading-relaxed text-muted"></p>
        <div id="option-list" class="mt-6 grid gap-3"></div>
      </div>
    </section>

    <section id="result-panel" class="mt-8 hidden">
      <div class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">Quiz result</p>
        <h2 id="result-title" class="mt-2 text-2xl font-bold text-text"></h2>
        <p id="result-summary" class="mt-3 text-sm leading-relaxed text-muted"></p>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-border bg-white p-6">
          <h3 class="font-bold text-text">What to review first</h3>
          <ul id="review-list" class="mt-4 space-y-3 text-sm leading-relaxed text-muted"></ul>
        </div>
        <div class="rounded-xl border border-border bg-white p-6">
          <h3 class="font-bold text-text">Next useful steps</h3>
          <ul id="step-list" class="mt-4 space-y-3 text-sm leading-relaxed text-muted"></ul>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-white p-6">
        <h3 class="font-bold text-text">Research paths</h3>
        <div id="action-list" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-white p-6">
        <h3 class="font-bold text-text">Credit repair profiles to compare</h3>
        <p class="mt-2 text-sm text-muted">These are profile links for research. They are not recommendations or guarantees.</p>
        <div id="profiles-grid" class="mt-4 grid gap-3"></div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-bg-alt p-6">
        <h3 class="font-bold text-text">Want the result emailed?</h3>
        <p class="mt-2 text-sm text-muted">Optional. No SSN, no credit pull, no account application.</p>
        <form id="email-form" class="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
          <input id="capture-name" type="text" placeholder="Name" class="rounded-lg border border-border bg-white px-4 py-3 text-text outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          <input id="capture-email" type="email" placeholder="Email" required class="rounded-lg border border-border bg-white px-4 py-3 text-text outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          <input id="capture-company" type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="rounded-lg bg-primary px-5 py-3 font-semibold text-white hover:bg-primary-hover">Send</button>
        </form>
        <p class="mt-2 text-xs leading-relaxed text-muted">Submitting this form sends your requested resources and saves your quiz result so CreditDoc can improve routing. It is not an application and it does not create marketing consent.</p>
        <p id="email-success" class="mt-3 hidden text-sm font-medium text-positive">Saved. We will send the next useful CreditDoc resources for this topic.</p>
        <p id="email-error" class="mt-3 hidden text-sm font-medium text-negative">That did not go through. You can still use the links above.</p>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-white p-6">
      <h2 class="text-xl font-bold text-text">Credit Repair Quiz FAQ</h2>
      <div class="mt-5 space-y-5">
        <div>
          <h3 class="font-semibold text-text">Does this quiz repair my credit?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">No. This is an educational questionnaire. It does not dispute credit report items, contact bureaus, or provide legal or financial advice.</p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Will this quiz affect my credit score?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">No. The quiz does not ask for a Social Security number, does not run a credit check, and does not contact any lender or credit bureau.</p>
        </div>
        <div>
          <h3 class="font-semibold text-text">When can a credit repair company help?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Credit repair companies generally focus on disputing inaccurate, incomplete, or unverifiable credit report information. They cannot legally guarantee a score increase or remove accurate negative information just because it hurts your score.</p>
        </div>
      </div>
    </section>
  </div>

  <script define:vars={{ creditRepairProfiles }}>
    const questions = [
      {
        key: 'reportStatus',
        kicker: 'Credit report',
        title: 'Have you checked your credit reports recently?',
        help: 'Start with what you can verify. You do not need exact scores for this quiz.',
        options: [
          { value: 'recent-errors', label: 'Yes, and I found possible errors', score: 28 },
          { value: 'recent-no-errors', label: 'Yes, and I did not see obvious errors', score: 8 },
          { value: 'not-recent', label: 'No, not in the last 6 months', score: 14 },
        ],
      },
      {
        key: 'negativeItems',
        kicker: 'Negative items',
        title: 'What is hurting your report the most?',
        help: 'Choose the closest answer. If several apply, pick the one that feels most serious.',
        options: [
          { value: 'errors', label: 'Accounts, balances, or personal details look wrong', score: 30 },
          { value: 'collections', label: 'Collections, charge-offs, or late payments', score: 22 },
          { value: 'thin-file', label: 'Not enough credit history', score: 6 },
          { value: 'utilization', label: 'High credit card balances', score: 10 },
        ],
      },
      {
        key: 'accuracy',
        kicker: 'Accuracy',
        title: 'Are the negative items accurate?',
        help: 'Credit repair is strongest when there are accuracy, verification, or reporting problems.',
        options: [
          { value: 'not-accurate', label: 'Some look wrong or unverifiable', score: 28 },
          { value: 'mixed', label: 'I am not sure', score: 16 },
          { value: 'accurate', label: 'Most are probably accurate', score: 2 },
        ],
      },
      {
        key: 'timeline',
        kicker: 'Timeline',
        title: 'Why are you trying to improve credit now?',
        help: 'A real deadline can change the best next step.',
        options: [
          { value: 'mortgage-loan', label: 'Mortgage, auto loan, card, or personal loan soon', score: 16 },
          { value: 'rent-job', label: 'Rental, job screening, or insurance concern', score: 14 },
          { value: 'general', label: 'General long-term improvement', score: 6 },
        ],
      },
      {
        key: 'capacity',
        kicker: 'Time and paperwork',
        title: 'Can you organize documents and send disputes yourself?',
        help: 'DIY can be effective, but some people prefer help tracking bureaus, notices, and follow-up.',
        options: [
          { value: 'yes', label: 'Yes, I can do it myself', score: 0 },
          { value: 'maybe', label: 'Maybe, but I want a checklist', score: 10 },
          { value: 'no', label: 'No, I need help staying organized', score: 18 },
        ],
      },
      {
        key: 'risk',
        kicker: 'Provider caution',
        title: 'Has anyone promised a fast score jump or guaranteed deletion?',
        help: 'Promises like that are warning signs. Credit repair companies have legal limits.',
        options: [
          { value: 'yes', label: 'Yes, I have seen those promises', score: 12 },
          { value: 'no', label: 'No', score: 0 },
          { value: 'not-sure', label: 'I am not sure what is allowed', score: 8 },
        ],
      },
    ];

    const answers = {};
    let currentIndex = 0;
    let currentResult = null;
    const sessionId = crypto.randomUUID?.() || String(Date.now());
    const quizLoadedAt = Date.now();

    const intro = document.getElementById('quiz-intro');
    const panel = document.getElementById('quiz-panel');
    const resultPanel = document.getElementById('result-panel');
    const startBtn = document.getElementById('start-quiz-btn');

    function showQuestion(index) {
      const q = questions[index];
      document.getElementById('current-q').textContent = String(index + 1);
      document.getElementById('progress-pct').textContent = Math.round(((index + 1) / questions.length) * 100) + '%';
      document.getElementById('progress-bar').style.width = ((index + 1) / questions.length) * 100 + '%';
      document.getElementById('question-kicker').textContent = q.kicker;
      document.getElementById('question-title').textContent = q.title;
      document.getElementById('question-help').textContent = q.help;

      const list = document.getElementById('option-list');
      list.innerHTML = '';
      q.options.forEach((opt) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'quiz-option';
        button.textContent = opt.label;
        button.addEventListener('click', () => {
          answers[q.key] = opt;
          if (currentIndex < questions.length - 1) {
            currentIndex += 1;
            showQuestion(currentIndex);
          } else {
            renderResult();
          }
        });
        list.appendChild(button);
      });
    }

    function buildResult() {
      const score = Object.values(answers).reduce((sum, item) => sum + item.score, 0);
      const hasErrors = ['recent-errors', 'errors', 'not-accurate'].some((value) =>
        Object.values(answers).some((item) => item.value === value)
      );
      const accurateNegatives = answers.accuracy?.value === 'accurate';
      const thinFile = answers.negativeItems?.value === 'thin-file';
      const highUtilization = answers.negativeItems?.value === 'utilization';

      if (hasErrors && score >= 80) {
        return {
          title: 'Credit repair research may be worth comparing',
          summary: 'Your answers point to possible reporting accuracy or verification issues. Review your reports, save notices, and compare credit repair profiles carefully before hiring anyone.',
          reviews: [
            'Check whether the disputed item is inaccurate, incomplete, duplicated, outdated, or unverifiable.',
            'Confirm which bureau reports the issue and whether all three reports match.',
            'Watch for companies promising guaranteed deletions or fast score increases.',
          ],
          steps: [
            'Save copies of credit reports, adverse action notices, collection letters, and dispute responses.',
            'Use the checklist before speaking with a company so you know what evidence exists.',
            'Compare pricing, cancellation rights, and CROA-compliant claims before signing anything.',
          ],
          actions: [
            ['Compare credit repair profiles', '/best/best-credit-repair-companies/'],
            ['Use the credit report checklist', '/resources/credit-report-checklist/'],
            ['Read FCRA and CROA rights', '/financial-wellness/credit-repair-rights-fcra-croa/'],
            ['Review the methodology', '/methodology/'],
          ],
          eventLabel: 'repair_research',
          recommendedRoute: '/best/best-credit-repair-companies/',
        };
      }

      if (thinFile || highUtilization || accurateNegatives) {
        return {
          title: 'Credit building or debt steps may matter more first',
          summary: 'Your answers do not point strongly to classic credit repair disputes. If the information is accurate, focus first on utilization, on-time payments, credit age, and safer credit-building options.',
          reviews: [
            'Separate accurate negative history from possible reporting errors.',
            'Check whether utilization or thin credit history is the main score drag.',
            'Avoid paying a company to dispute accurate information just because it is negative.',
          ],
          steps: [
            'Use the credit score simulator to test utilization and payment-history scenarios.',
            'Compare credit-builder options if you have a thin file.',
            'Build a repayment plan before applying for more credit.',
          ],
          actions: [
            ['Try the credit score simulator', '/tools/credit-score-simulator/'],
            ['Compare credit builder loans', '/best/best-credit-builder-loans/'],
            ['Read credit utilization guide', '/financial-wellness/credit-utilization-guide/'],
            ['Use the debt payoff calculator', '/tools/debt-payoff-calculator/'],
          ],
          eventLabel: 'build_first',
          recommendedRoute: '/tools/credit-score-simulator/',
        };
      }

      return {
        title: 'Start with report review before hiring anyone',
        summary: 'Your answers are mixed. The safest next step is to pull current reports, mark anything that looks wrong, and only then decide whether DIY disputes or a credit repair company make sense.',
        reviews: [
          'Check all three bureau reports before assuming the same issue appears everywhere.',
          'Mark the exact fields that look wrong: name, balance, status, date, account owner, or payment history.',
          'Review consumer rights before speaking with a paid provider.',
        ],
        steps: [
          'Use the checklist to organize documents and dispute evidence.',
          'Read the course module on credit reports and dispute basics.',
          'Come back to this quiz after checking current reports.',
        ],
        actions: [
          ['Use the credit report checklist', '/resources/credit-report-checklist/'],
          ['Take the credit fundamentals course', '/courses/credit-fundamentals/'],
          ['Read common report errors', '/financial-wellness/credit-report-errors-common/'],
          ['Browse credit repair category context', '/categories/credit-repair/'],
        ],
        eventLabel: 'review_first',
        recommendedRoute: '/resources/credit-report-checklist/',
      };
    }

    function addListItems(id, items) {
      const list = document.getElementById(id);
      list.innerHTML = '';
      items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        li.innerHTML = '<span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-primary"></span><span></span>';
        li.querySelector('span:last-child').textContent = item;
        list.appendChild(li);
      });
    }

    function renderResult() {
      const result = buildResult();
      currentResult = result;
      panel.classList.add('hidden');
      resultPanel.classList.remove('hidden');
      document.getElementById('result-title').textContent = result.title;
      document.getElementById('result-summary').textContent = result.summary;
      addListItems('review-list', result.reviews);
      addListItems('step-list', result.steps);

      const actionList = document.getElementById('action-list');
      actionList.innerHTML = '';
      result.actions.forEach(([label, href], index) => {
        const a = document.createElement('a');
        a.href = href;
        a.className = index === 0
          ? 'rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white hover:bg-primary-hover'
          : 'rounded-xl border border-border px-4 py-3 text-sm font-semibold text-text hover:bg-bg-alt';
        a.textContent = label;
        actionList.appendChild(a);
      });

      const profilesGrid = document.getElementById('profiles-grid');
      profilesGrid.innerHTML = '';
      creditRepairProfiles.forEach((profile) => {
        const card = document.createElement('a');
        card.href = '/review/' + profile.slug + '/';
        card.className = 'rounded-xl border border-border p-4 hover:bg-bg-alt';
        const row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-3';

        const copy = document.createElement('div');
        const name = document.createElement('p');
        name.className = 'font-semibold text-text';
        name.textContent = profile.name;
        const description = document.createElement('p');
        description.className = 'mt-1 text-sm text-muted';
        description.textContent = profile.description;
        copy.append(name, description);

        const rating = document.createElement('div');
        rating.className = 'text-right';
        const ratingValue = document.createElement('p');
        ratingValue.className = 'font-bold text-primary';
        ratingValue.textContent = Number(profile.google_rating).toFixed(1);
        const reviewCount = document.createElement('p');
        reviewCount.className = 'text-xs text-muted';
        reviewCount.textContent = `${Number(profile.google_reviews_count).toLocaleString()} reviews`;
        rating.append(ratingValue, reviewCount);

        row.append(copy, rating);
        card.appendChild(row);
        profilesGrid.appendChild(card);
      });

      if (typeof gtag === 'function') {
        gtag('event', 'quiz_completed', {
          event_category: 'engagement',
          event_label: 'credit_repair_qualify',
          quiz_result: result.eventLabel,
        });
      }
    }

    function compactAnswers() {
      return Object.fromEntries(
        Object.entries(answers).map(([key, item]) => [key, item.value])
      );
    }

    function collectUtm() {
      const params = new URLSearchParams(window.location.search);
      const utm = {};
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((key) => {
        const value = params.get(key);
        if (value) utm[key] = value.slice(0, 160);
      });
      return utm;
    }

    async function saveOriginationIntake({ name = '', email = '' } = {}) {
      if (!currentResult) return;
      const honeypot = document.getElementById('capture-company')?.value || '';
      const response = await fetch('/api/origination-intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tool_id: 'credit-repair-qualify-quiz',
          pillar: 'credit-repair',
          source_page: window.location.pathname,
          result_label: currentResult.eventLabel,
          email,
          name,
          consent_marketing: false,
          honeypot,
          elapsed_ms: Date.now() - quizLoadedAt,
          responses: {
            session_id: sessionId,
            ...compactAnswers(),
          },
          utm: collectUtm(),
        }),
      });
      if (!response.ok) {
        const detail = await response.text();
        throw new Error(detail);
      }
    }

    startBtn?.addEventListener('click', () => {
      intro.classList.add('hidden');
      panel.classList.remove('hidden');
      showQuestion(currentIndex);
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const emailForm = document.getElementById('email-form');
    const emailSuccess = document.getElementById('email-success');
    const emailError = document.getElementById('email-error');

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = document.getElementById('capture-name').value.trim();
      const email = document.getElementById('capture-email').value.trim();
      if (!email) return;

      const button = emailForm.querySelector('button[type="submit"]');
      button.textContent = 'Sending...';
      button.disabled = true;

      try {
        await saveOriginationIntake({ name, email });
        const body = new URLSearchParams({
          list: 'rCzcu8brUim88T892Y85IqRQ',
          email,
          name,
          boolean: 'true',
        });
        const response = await fetch('https://sendy.creditdoc.co/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        const text = await response.text();
        if (text.trim() === '1' || text.includes('Already subscribed')) {
          emailForm.classList.add('hidden');
          emailSuccess.classList.remove('hidden');
          emailError.classList.add('hidden');
          if (typeof gtag === 'function') {
            gtag('event', 'quiz_email_capture', {
              event_category: 'engagement',
              event_label: 'credit_repair_qualify',
            });
          }
        } else {
          throw new Error(text);
        }
      } catch {
        emailError.classList.remove('hidden');
        button.textContent = 'Send';
        button.disabled = false;
      }
    });
  </script>

