---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Accounts Receivable Financing Calculator | CreditDoc';
const description = 'Estimate AR financing advance amount, fees, net funds, and receivables cost before comparing invoice factoring or receivables financing.';
const canonical = 'https://www.creditdoc.co/tools/accounts-receivable-financing-calculator/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Accounts Receivable Financing Calculator', description, url: canonical, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' } };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: 'What does an accounts receivable financing calculator estimate?', acceptedAnswer: { '@type': 'Answer', text: 'It estimates the cash advance, financing fees, reserve amount, and net funds from eligible receivables based on assumptions you enter.' } }, { '@type': 'Question', name: 'Is accounts receivable financing the same as invoice factoring?', acceptedAnswer: { '@type': 'Answer', text: 'Not always. Some products are structured as receivables purchases, while others are loans secured by receivables. Contract structure, recourse, fees, and customer-notification rules can differ.' } }] };
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' }, { '@type': 'ListItem', position: 3, name: 'Accounts Receivable Financing Calculator', item: canonical }] };
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb"><ol class="flex items-center gap-2 text-sm text-muted"><li><a href="/" class="hover:text-primary">Home</a></li><li class="text-border">/</li><li><a href="/tools/" class="hover:text-primary">Tools</a></li><li class="text-border">/</li><li class="font-medium text-text">AR Financing Calculator</li></ol></nav>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <section class="mb-8 text-center"><div class="mb-4 inline-flex rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">Free &middot; Receivables estimate &middot; No signup</div><h1 class="text-3xl font-bold text-text md:text-4xl">Accounts Receivable Financing Calculator</h1><p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">Estimate how much cash you might net from eligible invoices after advance rates, reserves, and fee assumptions.</p></section>
    <section class="glass-card mb-6 p-5"><h2 class="mb-2 text-lg font-bold text-text">Use This Before Financing Invoices</h2><p class="text-sm leading-relaxed text-muted">Receivables financing costs depend on advance rate, customer quality, invoice age, recourse terms, reserve release, and whether the product is factoring or a secured loan.</p><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><a href="/best/best-small-business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan research</a><a href="/tools/working-capital-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Working capital calculator</a><a href="/tools/business-loan-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan calculator</a><a href="/answers/how-does-invoice-financing-work/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Invoice financing guide</a></div></section>
    <section class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <div class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Receivables Details</h2><div class="grid gap-4">
        <label><span class="label">Eligible invoice value</span><span class="money-wrap"><span>$</span><input id="invoices" class="input-field pl-7" type="number" min="0" step="1000" value="100000" /></span></label>
        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">Advance rate</span><span class="unit-wrap"><input id="advance" class="input-field pr-8" type="number" min="0" max="100" step="1" value="85" /><span>%</span></span></label><label><span class="label">Fee assumption</span><span class="unit-wrap"><input id="fee" class="input-field pr-8" type="number" min="0" max="30" step="0.1" value="3" /><span>%</span></span></label></div>
        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">Extra service or wire fees</span><span class="money-wrap"><span>$</span><input id="extra" class="input-field pl-7" type="number" min="0" step="50" value="500" /></span></label><label><span class="label">Collection period</span><span class="unit-wrap"><input id="days" class="input-field pr-14" type="number" min="1" max="180" step="1" value="45" /><span>days</span></span></label></div>
      </div></div>
      <aside class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Estimate</h2><div class="space-y-4"><div class="result"><p>Initial advance</p><strong id="advance-out">$85,000</strong></div><div class="grid grid-cols-2 gap-3"><div class="result"><p>Reserve held</p><strong id="reserve">$15,000</strong></div><div class="result"><p>Modeled fees</p><strong id="fees">$3,500</strong></div></div><div class="result"><p>Estimated net funds</p><strong id="net">$81,500</strong></div><div class="result"><p>Cost as invoice share</p><strong id="share">3.5%</strong><span id="copy">Compare this cost with waiting for payment, a line of credit, or a working capital loan.</span></div></div></aside>
    </section>
    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5"><h2 class="font-bold text-text">Important Limits</h2><p class="mt-2 text-xs leading-relaxed text-muted">This calculator does not review invoice eligibility, customer credit quality, recourse obligations, UCC filings, notice requirements, or reserve-release terms. Confirm all details in the financing agreement.</p></section>
  </div>
  <style>.label{margin-bottom:.5rem;display:block;font-size:.875rem;font-weight:500;color:var(--color-text,#172033)}.input-field{width:100%;border-radius:.5rem;border:1px solid var(--color-border,#d8dee8);background:#fff;padding:.75rem 1rem;color:var(--color-text,#172033);outline:none}.input-field:focus{border-color:var(--color-primary,#2563eb);box-shadow:0 0 0 1px var(--color-primary,#2563eb)}.money-wrap,.unit-wrap{position:relative;display:block}.money-wrap>span,.unit-wrap>span{position:absolute;top:50%;transform:translateY(-50%);color:var(--color-muted,#667085)}.money-wrap>span{left:.75rem}.unit-wrap>span{right:.75rem}.result{border:1px solid var(--color-border,#d8dee8);border-radius:.75rem;background:white;padding:1rem}.result p{font-size:.875rem;color:var(--color-muted,#667085)}.result strong{margin-top:.25rem;display:block;font-size:1.35rem;color:var(--color-text,#172033)}.result span{margin-top:.5rem;display:block;font-size:.875rem;line-height:1.5;color:var(--color-muted,#667085)}</style>
  <script>
    const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}); const ids=['invoices','advance','fee','extra','days']; const f=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)])); const v=id=>Math.max(Number(f[id]?.value||0),0);
    function calc(){ const inv=v('invoices'), adv=inv*v('advance')/100, reserve=Math.max(inv-adv,0), fees=inv*v('fee')/100+v('extra'), net=Math.max(adv-fees,0), share=inv?fees/inv*100:0; document.getElementById('advance-out').textContent=money.format(adv); document.getElementById('reserve').textContent=money.format(reserve); document.getElementById('fees').textContent=money.format(fees); document.getElementById('net').textContent=money.format(net); document.getElementById('share').textContent=`${share.toFixed(1)}%`; document.getElementById('copy').textContent = v('days') > 60 ? 'Longer collection periods can raise total financing cost. Confirm how fees accrue if customers pay late.' : 'Compare this cost with waiting for payment, a line of credit, or a working capital loan.'; }
    ids.forEach(id=>f[id]?.addEventListener('input',calc)); calc();
  </script>
</BaseLayout>
