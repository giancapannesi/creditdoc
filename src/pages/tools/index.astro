  },
  {
    title: "Credit Denial Action Checklist",
    description: "Organize an adverse action notice, credit report review, supporting documents, and next research steps before applying again.",
    href: "/tools/credit-denial-action-checklist/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M9 6.75h6M9 18h6M5.25 3.75h13.5A1.5 1.5 0 0 1 20.25 5.25v13.5a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V5.25a1.5 1.5 0 0 1 1.5-1.5Z" />',
