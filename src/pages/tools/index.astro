  },
];

const learningResources = [
  {
    title: "Loan Approval Readiness Toolkit",
    description: "Use the toolkit before personal loan, business loan, credit card, debt consolidation, SBA loan, or cash-flow funding research.",
    href: "/resources/loan-approval-readiness-toolkit/",
    badge: "Printable",
  },
  {
    title: "Free Credit Fundamentals Course",
    description: "Eight self-paced modules covering credit scores, reports, debt management, credit repair, loans, scam avoidance, and consumer rights.",
    href: "/courses/credit-fundamentals/",
    badge: "Free course",
  },
  {
    title: "Credit Report Checklist",
    description: "Use the checklist before disputes, credit repair research, loan applications, or provider conversations.",
    href: "/resources/credit-report-checklist/",
    badge: "Printable",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Free Financial Tools",
  "description": description,
  "url": "https://www.creditdoc.co/tools/",
  "publisher": {
    "@type": "Organization",
    "name": "CreditDoc",
    "url": "https://www.creditdoc.co"
  }
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creditdoc.co/" },
    { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://www.creditdoc.co/tools/" }
  ]
};
---

<BaseLayout title={title} description={description} jsonLd={[jsonLd, breadcrumbJsonLd]}>
  <nav class="max-w-4xl mx-auto px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li class="text-text font-medium">Tools</li>
    </ol>
  </nav>

  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-4">Free Financial Tools</h1>
      <p class="text-lg text-muted max-w-2xl mx-auto">Use free, no-signup-required tools as a starting point for credit, debt, and borrowing research.</p>
    </div>

    <section class="glass-card p-5 mb-8">
      <h2 class="text-lg font-bold text-text mb-2">Use Tools With Local Research</h2>
      <p class="text-sm text-muted leading-relaxed">
        These calculators and quizzes are educational planning aids. Use them alongside local guides, state lending context, provider categories, borrower answers, and CreditDoc research before contacting a company.
      </p>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/city/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Local guides
        </a>
        <a href="/state/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          State context
        </a>
        <a href="/categories/personal-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          Provider categories
        </a>
        <a href="/research/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">
          CreditDoc research
        </a>
      </div>
    </section>

    <section class="glass-card p-5 mb-8">
      <h2 class="text-lg font-bold text-text mb-2">Courses And Checklists</h2>
      <p class="text-sm text-muted leading-relaxed">
        Use these before or after a quiz result to understand the basics, organize documents, and avoid rushing into an application or paid service.
      </p>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {learningResources.map(resource => (
          <a href={resource.href} class="rounded-lg border border-border bg-bg-alt p-4 hover:border-primary transition-colors">
            <div class="flex items-center justify-between gap-3">
              <h3 class="font-semibold text-text">{resource.title}</h3>
              <span class="rounded-full bg-primary-light px-2.5 py-0.5 text-xs font-medium text-primary">{resource.badge}</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{resource.description}</p>
          </a>
        ))}
      </div>
    </section>

    <div class="grid gap-6">
      {tools.map(tool => (
        <a href={tool.live ? tool.href : undefined}
           class:list={["glass-card p-6 flex flex-col sm:flex-row items-start gap-5", { "opacity-60 cursor-default": !tool.live, "pointer-events-auto": !tool.live }]}
           style={!tool.live ? "pointer-events: none;" : ""}>
          <div class="w-14 h-14 rounded-2xl bg-primary-light flex items-center justify-center flex-shrink-0">
            <svg class="w-7 h-7 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <Fragment set:html={tool.icon} />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-center gap-3 mb-2">
              <h2 class="min-w-0 text-xl font-bold text-text">{tool.title}</h2>
              <span class:list={["shrink-0 text-xs font-medium px-2.5 py-0.5 rounded-full", tool.live ? "bg-positive-light text-positive" : "bg-bg-alt text-muted"]}>
                {tool.badge}
              </span>
            </div>
            <p class="text-muted">{tool.description}</p>
          </div>
          {tool.live && (
            <svg class="w-5 h-5 text-muted flex-shrink-0 mt-1 hidden sm:block" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" /></svg>
          )}
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-sm text-muted">More tools coming soon. <a href="/" class="text-primary hover:underline">Back to CreditDoc</a></p>
    </div>
  </div>
</BaseLayout>
