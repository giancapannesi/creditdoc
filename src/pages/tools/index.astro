  {
    title: "State Consumer Credit Regulator Directory",
    description: "Find state lending law starting points and official federal complaint resources before researching credit, debt, or finance providers.",
    href: "/tools/state-consumer-credit-regulator-directory/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7.5-4.5 7.5-11.25V5.625L12 2.25 4.5 5.625V9.75C4.5 16.5 12 21 12 21Zm-2.25-9 1.5 1.5 3-3" />',
    badge: "New directory",
    live: true,
  },
  {
    title: "Business Loan Readiness Quiz",
    description: "Map business age, revenue band, credit range, documents, funding use, and cash-flow pressure to CreditDoc business funding research paths.",
    href: "/tools/business-loan-readiness-quiz/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m6-6h1.5m-1.5 3h1.5m-1.5 3h1.5M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h.75c.621 0 1.125.504 1.125 1.125V21m6 0v-3.375c0-.621.504-1.125 1.125-1.125h.75c.621 0 1.125.504 1.125 1.125V21" />',
    badge: "New quiz",
    live: true,
  },
  {
    title: "MCA Repayment Calculator",
    description: "Estimate merchant cash advance payback, factor-rate cost, daily or weekly payment pressure, and holdback impact before comparing fast-funding options.",
    href: "/tools/mca-repayment-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.768 0-1.536-.22-2.121-.659-1.172-.879-1.172-2.303 0-3.182 1.171-.879 3.07-.879 4.242 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
    badge: "New calculator",
    live: true,
  },
  {
    title: "Bank Statement Cash Flow Calculator",
    description: "Estimate deposit trend, average balances, negative-balance days, and repayment load before comparing business funding options.",
    href: "/tools/bank-statement-cash-flow-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75c0 .621-.504 1.125-1.125 1.125h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75Zm6.75-4.5c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625Zm6.75-4.5c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />',
    badge: "New calculator",
    live: true,
  },
  {
    title: "Credit Repair Qualify Quiz",
    description: "Answer simple questions about credit report errors, collections, score pressure, and timeline to see which research path fits next.",
    href: "/tools/credit-repair-qualify-quiz/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M10.125 2.25h3.75c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125h-3.75A1.125 1.125 0 0 1 9 4.875v-1.5c0-.621.504-1.125 1.125-1.125ZM4.5 6.75A2.25 2.25 0 0 1 6.75 4.5H7.5m9 0h.75a2.25 2.25 0 0 1 2.25 2.25v12A2.25 2.25 0 0 1 17.25 21H6.75A2.25 2.25 0 0 1 4.5 18.75v-12ZM9 12l2 2 4-4" />',
    badge: "New quiz",
    live: true,
  },
  {
    title: "Loan Denial Reason Checker",
    description: "Map a denial notice and application profile to common review areas: credit, DTI, income proof, documents, business history, and lender fit.",
    href: "/tools/loan-denial-reason-checker/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
    badge: "New",
    live: true,
  },
  {
    title: "What's My Borrowing Power?",
    description: "Answer 5 quick questions to estimate borrowing capacity and see relevant research paths for your situation.",
    href: "/tools/borrowing-power-quiz/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />',
    badge: "60 seconds",
    live: true,
  },
  {
    title: "Debt Payoff Calculator",
    description: "Compare snowball vs. avalanche strategies and estimate payoff timing, total interest, and monthly payment order.",
    href: "/tools/debt-payoff-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 15.75V18m-7.5-6.75h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V13.5zm0 2.25h.008v.008H8.25v-.008zm0 2.25h.008v.008H8.25V18zm2.498-6.75h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V13.5zm0 2.25h.007v.008h-.007v-.008zm0 2.25h.007v.008h-.007V18zm2.504-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zm0 2.25h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V18zm2.498-6.75h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V13.5zM8.25 6h7.5v2.25h-7.5V6zM12 2.25c-1.892 0-3.758.11-5.593.322C5.307 2.7 4.5 3.65 4.5 4.757V19.5a2.25 2.25 0 002.25 2.25h10.5a2.25 2.25 0 002.25-2.25V4.757c0-1.108-.806-2.057-1.907-2.185A48.507 48.507 0 0012 2.25z" />',
    badge: "New",
    live: true,
  },
  {
    title: "Credit Score Simulator",
    description: "See how paying off debt, opening new accounts, or missing payments could affect your credit score.",
    href: "/tools/credit-score-simulator/",
