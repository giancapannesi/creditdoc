---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Free Financial Tools & Calculators | CreditDoc";
const description = "Free CreditDoc calculators, quizzes, and checklists for credit review, debt planning, business funding, cash-flow, and consumer finance research.";

const tools = [
  {
    title: "SBA Loan Calculator",
    description: "Estimate SBA loan monthly payments, total repayment, interest cost, fee impact, and payment pressure with editable assumptions.",
    href: "/tools/sba-loan-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.768 0-1.536-.22-2.121-.659-1.172-.879-1.172-2.303 0-3.182 1.171-.879 3.07-.879 4.242 0M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />',
    badge: "New calculator",
    live: true,
  },
  {
    title: "Business Loan Calculator",
    description: "Estimate business loan payment, total interest, modeled fee impact, and revenue pressure before comparing funding options.",
    href: "/tools/business-loan-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m6-6h1.5m-1.5 3h1.5m-1.5 3h1.5" />',
    badge: "New calculator",
    live: true,
  },
  {
    title: "Commercial Loan Calculator",
    description: "Estimate commercial loan or commercial mortgage payments, balloon balance, closing costs, and debt-service coverage.",
    href: "/tools/commercial-loan-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 21h19.5m-18-18v18m3.75 0v-4.875c0-.621.504-1.125 1.125-1.125h1.5c.621 0 1.125.504 1.125 1.125V21m6.75 0V9.75M6.75 6.75h1.5m-1.5 3h1.5m6-3h1.5m-1.5 3h1.5m-1.5 3h1.5" />',
    badge: "New calculator",
    live: true,
  },
  {
    title: "Business Line of Credit Calculator",
    description: "Estimate business credit line draw costs, interest, fees, payoff timing, and cash-flow pressure.",
    href: "/tools/business-line-of-credit-calculator/",
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h10.5M5.25 3.75h13.5a1.5 1.5 0 0 1 1.5 1.5v13.5a1.5 1.5 0 0 1-1.5 1.5H5.25a1.5 1.5 0 0 1-1.5-1.5V5.25a1.5 1.5 0 0 1 1.5-1.5Z" />',
    badge: "New calculator",
