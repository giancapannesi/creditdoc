---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Working Capital Calculator | CreditDoc';
const description = 'Estimate working capital gap, loan payment pressure, and runway impact before comparing short-term business funding options.';
const canonical = 'https://www.creditdoc.co/tools/working-capital-calculator/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Working Capital Calculator', description, url: canonical, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' } };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: 'How do you calculate working capital?', acceptedAnswer: { '@type': 'Answer', text: 'Basic working capital is current assets minus current liabilities. This calculator also lets you model a funding need, monthly payment, and cash runway.' } }, { '@type': 'Question', name: 'Is a working capital loan always the right answer?', acceptedAnswer: { '@type': 'Answer', text: 'No. A working capital gap may call for expense control, receivables collection, inventory changes, a line of credit, invoice financing, or a loan depending on the cause.' } }] };
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' }, { '@type': 'ListItem', position: 3, name: 'Working Capital Calculator', item: canonical }] };
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb"><ol class="flex items-center gap-2 text-sm text-muted"><li><a href="/" class="hover:text-primary">Home</a></li><li class="text-border">/</li><li><a href="/tools/" class="hover:text-primary">Tools</a></li><li class="text-border">/</li><li class="font-medium text-text">Working Capital Calculator</li></ol></nav>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <section class="mb-8 text-center"><div class="mb-4 inline-flex rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">Free &middot; Cash-flow estimate &middot; No signup</div><h1 class="text-3xl font-bold text-text md:text-4xl">Working Capital Calculator</h1><p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">Estimate current working capital, short-term funding gap, and payment pressure before comparing working capital loans or lines of credit.</p></section>
    <section class="glass-card mb-6 p-5"><h2 class="mb-2 text-lg font-bold text-text">Use This Before Short-Term Funding</h2><p class="text-sm leading-relaxed text-muted">Working capital needs can come from inventory, payroll timing, receivables, seasonal dips, or growth. Use this estimate with lender disclosures and cash-flow review.</p><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><a href="/tools/business-loan-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan calculator</a><a href="/tools/accounts-receivable-financing-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">AR financing calculator</a><a href="/tools/bank-statement-cash-flow-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Cash-flow calculator</a><a href="/best/best-small-business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan research</a></div></section>
    <section class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <div class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Working Capital Inputs</h2><div class="grid gap-4">
        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">Current assets</span><span class="money-wrap"><span>$</span><input id="assets" class="input-field pl-7" type="number" min="0" step="1000" value="180000" /></span></label><label><span class="label">Current liabilities</span><span class="money-wrap"><span>$</span><input id="liabilities" class="input-field pl-7" type="number" min="0" step="1000" value="125000" /></span></label></div>
        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">Average monthly operating expenses</span><span class="money-wrap"><span>$</span><input id="expenses" class="input-field pl-7" type="number" min="0" step="1000" value="45000" /></span></label><label><span class="label">Target cash cushion</span><span class="money-wrap"><span>$</span><input id="target" class="input-field pl-7" type="number" min="0" step="1000" value="90000" /></span></label></div>
        <div class="grid gap-4 sm:grid-cols-3"><label><span class="label">Funding amount to model</span><span class="money-wrap"><span>$</span><input id="loan" class="input-field pl-7" type="number" min="0" step="1000" value="50000" /></span></label><label><span class="label">APR estimate</span><span class="unit-wrap"><input id="rate" class="input-field pr-8" type="number" min="0" max="99" step="0.1" value="18" /><span>%</span></span></label><label><span class="label">Term</span><span class="unit-wrap"><input id="months" class="input-field pr-16" type="number" min="1" max="60" step="1" value="24" /><span>months</span></span></label></div>
      </div></div>
      <aside class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Estimate</h2><div class="space-y-4"><div class="result"><p>Current working capital</p><strong id="capital">$55,000</strong></div><div class="grid grid-cols-2 gap-3"><div class="result"><p>Cash runway</p><strong id="runway">1.2 mo</strong></div><div class="result"><p>Gap to target</p><strong id="gap">$35,000</strong></div></div><div class="result"><p>Modeled monthly payment</p><strong id="payment">$2,496</strong></div><div class="result"><p>Funding signal</p><strong id="signal">Moderate</strong><span id="copy">The target cushion is above current working capital. Compare repayment cost with receivables, inventory, and expense timing.</span></div></div></aside>
    </section>
    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5"><h2 class="font-bold text-text">Important Limits</h2><p class="mt-2 text-xs leading-relaxed text-muted">This calculator is not accounting, tax, financial, or underwriting advice. It does not inspect bank statements, receivables, inventory, margins, or loan agreements.</p></section>
  </div>
  <style>.label{margin-bottom:.5rem;display:block;font-size:.875rem;font-weight:500;color:var(--color-text,#172033)}.input-field{width:100%;border-radius:.5rem;border:1px solid var(--color-border,#d8dee8);background:#fff;padding:.75rem 1rem;color:var(--color-text,#172033);outline:none}.input-field:focus{border-color:var(--color-primary,#2563eb);box-shadow:0 0 0 1px var(--color-primary,#2563eb)}.money-wrap,.unit-wrap{position:relative;display:block}.money-wrap>span,.unit-wrap>span{position:absolute;top:50%;transform:translateY(-50%);color:var(--color-muted,#667085)}.money-wrap>span{left:.75rem}.unit-wrap>span{right:.75rem}.result{border:1px solid var(--color-border,#d8dee8);border-radius:.75rem;background:white;padding:1rem}.result p{font-size:.875rem;color:var(--color-muted,#667085)}.result strong{margin-top:.25rem;display:block;font-size:1.35rem;color:var(--color-text,#172033)}.result span{margin-top:.5rem;display:block;font-size:.875rem;line-height:1.5;color:var(--color-muted,#667085)}</style>
  <script>
    const money=new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}); const ids=['assets','liabilities','expenses','target','loan','rate','months']; const f=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)])); const v=id=>Math.max(Number(f[id]?.value||0),0);
    function pmt(principal, apr, months){ const r=apr/100/12; if(!principal||!months)return 0; return r ? principal*(r*(1+r)**months)/((1+r)**months-1) : principal/months; }
    function calc(){ const capital=v('assets')-v('liabilities'), runway=v('expenses')?capital/v('expenses'):0, gap=Math.max(v('target')-capital,0), pay=pmt(v('loan'),v('rate'),Math.max(v('months'),1)); let signal='Lower', copy='Current working capital is near or above the target cushion. Still review cash timing before borrowing.'; if(gap>0){ signal='Moderate'; copy='The target cushion is above current working capital. Compare repayment cost with receivables, inventory, and expense timing.'; } if(runway<1 || pay>v('expenses')*.15){ signal='Caution'; copy='The entered numbers show limited runway or higher payment pressure. Review lower-cost options and cash-flow timing before adding debt.'; } document.getElementById('capital').textContent=money.format(capital); document.getElementById('runway').textContent=`${runway.toFixed(1)} mo`; document.getElementById('gap').textContent=money.format(gap); document.getElementById('payment').textContent=money.format(pay); document.getElementById('signal').textContent=signal; document.getElementById('copy').textContent=copy; }
    ids.forEach(id=>f[id]?.addEventListener('input',calc)); calc();
  </script>
</BaseLayout>
