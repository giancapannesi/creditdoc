---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';
import { getAllStatesInfo } from '../../utils/data-build';

const states = getAllStatesInfo().sort((a, b) => a.name.localeCompare(b.name));

const title = 'State Consumer Credit Regulator Directory | CreditDoc';
const description = 'Find state-level CreditDoc lending law pages and official federal complaint resources before researching credit, debt, lending, or finance providers.';
const canonical = 'https://www.creditdoc.co/tools/state-consumer-credit-regulator-directory/';

const federalResources = [
  {
    name: 'CFPB complaint portal',
    href: 'https://www.consumerfinance.gov/complaint/',
    description: 'Submit complaints about many consumer financial products and services.',
  },
  {
    name: 'FTC ReportFraud',
    href: 'https://reportfraud.ftc.gov/',
    description: 'Report fraud, scams, and deceptive business practices to the Federal Trade Commission.',
  },
  {
    name: 'AnnualCreditReport.com',
    href: 'https://www.annualcreditreport.com/',
    description: 'Request free credit reports from the nationwide credit reporting agencies.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'State Consumer Credit Regulator Directory',
  description,
  url: canonical,
  image: 'https://www.creditdoc.co/og-default.png',
  isAccessibleForFree: true,
  hasPart: states.map((state) => ({
    '@type': 'WebPage',
    name: `${state.name} credit and lending law resources`,
    url: `https://www.creditdoc.co/state/${state.slug}/lending-laws/`,
  })),
  author: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  datePublished: '2026-06-11',
  dateModified: '2026-06-11',
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Does this directory replace official regulator websites?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. It is a starting point for state-level CreditDoc research pages. Current licensing, complaint, and enforcement instructions should be verified directly with the relevant state regulator or attorney general.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where should I file a consumer finance complaint?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Complaint routing depends on the product, company, and state. The CFPB complaint portal, FTC ReportFraud, state financial regulators, and state attorneys general may each be relevant depending on the issue.',
      },
    },
  ],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' },
    { '@type': 'ListItem', position: 3, name: 'State Consumer Credit Regulator Directory', item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-5xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li><a href="/tools/" class="hover:text-primary transition-colors">Tools</a></li>
      <li class="text-border">/</li>
      <li class="font-medium text-text">State Consumer Credit Regulator Directory</li>
    </ol>
  </nav>

  <div class="mx-auto max-w-5xl px-4 py-8">
    <section class="text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">
        State context &middot; Complaint research &middot; Educational only
      </div>
      <h1 class="text-3xl font-bold text-text md:text-4xl">State Consumer Credit Regulator Directory</h1>
      <p class="mx-auto mt-4 max-w-3xl text-lg leading-relaxed text-muted">
        Use this directory to start state-level research for lending laws, credit products, debt services, and consumer finance complaints. Then verify current licensing and complaint instructions directly with your state financial regulator or attorney general.
      </p>
    </section>

    <section class="glass-card mt-8 p-5">
      <h2 class="mb-2 text-lg font-bold text-text">Use Official Sources For Final Decisions</h2>
      <p class="text-sm leading-relaxed text-muted">
        State rules and agency processes can change. CreditDoc state pages provide local context and internal research paths; they are not a substitute for official state regulator records, attorney general guidance, licensing databases, or legal advice.
      </p>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-white p-6">
      <h2 class="text-xl font-bold text-text">Federal Complaint And Credit Report Resources</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-3">
        {federalResources.map((resource) => (
          <a href={resource.href} class="rounded-lg border border-border bg-bg-alt p-4 transition-colors hover:border-primary" rel="noopener noreferrer" target="_blank">
            <h3 class="font-semibold text-text">{resource.name}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{resource.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-white p-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-primary">All states</p>
          <h2 class="mt-1 text-2xl font-bold text-text">State Lending Law Starting Points</h2>
        </div>
        <span class="text-sm text-muted">{states.length} state pages</span>
      </div>

      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {states.map((state) => (
          <article class="rounded-lg border border-border bg-bg-alt p-4">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-bold text-text">{state.name}</h3>
              <span class="rounded-full bg-white px-2.5 py-0.5 text-xs font-medium text-muted">{state.abbr}</span>
            </div>
            <div class="mt-4 grid gap-2">
              <a href={`/state/${state.slug}/`} class="text-sm font-medium text-primary hover:underline">State overview</a>
              <a href={`/state/${state.slug}/lending-laws/`} class="text-sm font-medium text-primary hover:underline">Lending law resources</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-white p-6">
      <h2 class="text-xl font-bold text-text">Directory FAQ</h2>
      <div class="mt-5 space-y-5">
        <div>
          <h3 class="font-semibold text-text">Does this directory replace official regulator websites?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">No. It is a starting point for state-level CreditDoc research pages. Current licensing, complaint, and enforcement instructions should be verified directly with the relevant state regulator or attorney general.</p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Where should I file a consumer finance complaint?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Complaint routing depends on the product, company, and state. The CFPB complaint portal, FTC ReportFraud, state financial regulators, and state attorneys general may each be relevant depending on the issue.</p>
        </div>
      </div>
    </section>
  </div>
  <ToolRelatedLinks />
</BaseLayout>
