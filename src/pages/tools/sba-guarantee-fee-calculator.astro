---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'SBA Guarantee Fee Calculator | CreditDoc';
const description = 'Estimate the guaranteed portion of an SBA loan and model an upfront SBA guarantee-fee assumption before comparing lender disclosures.';
const canonical = 'https://www.creditdoc.co/tools/sba-guarantee-fee-calculator/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'SBA Guarantee Fee Calculator', description, url: canonical, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' } };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: 'What is an SBA guarantee fee?', acceptedAnswer: { '@type': 'Answer', text: 'An SBA guarantee fee is a fee tied to the portion of an SBA-backed loan that the SBA guarantees. Fee rules can vary by SBA program, loan amount, fiscal year, maturity, and lender.' } }, { '@type': 'Question', name: 'Does this calculator use current SBA fee rules?', acceptedAnswer: { '@type': 'Answer', text: 'No. It lets you enter a fee percentage from your lender disclosure or SBA program materials so you can model the math without relying on a fixed rate claim.' } }] };
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' }, { '@type': 'ListItem', position: 3, name: 'SBA Guarantee Fee Calculator', item: canonical }] };
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb"><ol class="flex items-center gap-2 text-sm text-muted"><li><a href="/" class="hover:text-primary">Home</a></li><li class="text-border">/</li><li><a href="/tools/" class="hover:text-primary">Tools</a></li><li class="text-border">/</li><li class="font-medium text-text">SBA Guarantee Fee Calculator</li></ol></nav>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <section class="mb-8 text-center"><div class="mb-4 inline-flex rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">Free &middot; Editable fee assumption &middot; No signup</div><h1 class="text-3xl font-bold text-text md:text-4xl">SBA Guarantee Fee Calculator</h1><p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">Model the guaranteed portion of an SBA loan and estimate the fee impact using the percentage shown in your lender or SBA program materials.</p></section>
    <section class="glass-card mb-6 p-5"><h2 class="mb-2 text-lg font-bold text-text">Use This With SBA Disclosures</h2><p class="text-sm leading-relaxed text-muted">SBA guarantee-fee rules can change and may depend on program details. This tool intentionally uses editable assumptions instead of claiming a universal current fee.</p><div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><a href="/tools/sba-loan-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">SBA loan calculator</a><a href="/best/best-sba-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">SBA loan research</a><a href="/answers/how-do-sba-loans-work/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">How SBA loans work</a><a href="/tools/business-loan-readiness-quiz/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Readiness quiz</a></div></section>
    <section class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <div class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Fee Assumptions</h2><div class="grid gap-4">
        <label><span class="label">Loan amount</span><span class="money-wrap"><span>$</span><input id="amount" class="input-field pl-7" type="number" min="1000" step="1000" value="350000" /></span></label>
        <div class="grid gap-4 sm:grid-cols-2"><label><span class="label">SBA guaranteed portion</span><span class="unit-wrap"><input id="guarantee" class="input-field pr-8" type="number" min="0" max="100" step="1" value="75" /><span>%</span></span></label><label><span class="label">Guarantee fee assumption</span><span class="unit-wrap"><input id="fee" class="input-field pr-8" type="number" min="0" max="10" step="0.1" value="2.5" /><span>%</span></span></label></div>
        <label><span class="label">Other closing or packaging fees</span><span class="money-wrap"><span>$</span><input id="other" class="input-field pl-7" type="number" min="0" step="100" value="2500" /></span></label>
      </div></div>
      <aside class="glass-card p-6"><h2 class="mb-5 text-xl font-bold text-text">Estimate</h2><div class="space-y-4"><div class="result"><p>Guaranteed amount</p><strong id="guaranteed">$262,500</strong></div><div class="result"><p>Modeled guarantee fee</p><strong id="guarantee-fee">$6,563</strong></div><div class="result"><p>Total modeled upfront costs</p><strong id="total">$9,063</strong></div><div class="result"><p>Fee share of loan amount</p><strong id="share">2.6%</strong><span>Ask the lender which fees are financed, paid at closing, refundable, or separate from SBA guarantee fees.</span></div></div></aside>
    </section>
    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5"><h2 class="font-bold text-text">Important Limits</h2><p class="mt-2 text-xs leading-relaxed text-muted">This calculator does not determine the fee required by the SBA or a lender. Always use current SBA notices and written lender disclosures for final fee calculations.</p></section>
  </div>
  <style>.label{margin-bottom:.5rem;display:block;font-size:.875rem;font-weight:500;color:var(--color-text,#172033)}.input-field{width:100%;border-radius:.5rem;border:1px solid var(--color-border,#d8dee8);background:#fff;padding:.75rem 1rem;color:var(--color-text,#172033);outline:none}.input-field:focus{border-color:var(--color-primary,#2563eb);box-shadow:0 0 0 1px var(--color-primary,#2563eb)}.money-wrap,.unit-wrap{position:relative;display:block}.money-wrap>span,.unit-wrap>span{position:absolute;top:50%;transform:translateY(-50%);color:var(--color-muted,#667085)}.money-wrap>span{left:.75rem}.unit-wrap>span{right:.75rem}.result{border:1px solid var(--color-border,#d8dee8);border-radius:.75rem;background:white;padding:1rem}.result p{font-size:.875rem;color:var(--color-muted,#667085)}.result strong{margin-top:.25rem;display:block;font-size:1.35rem;color:var(--color-text,#172033)}.result span{margin-top:.5rem;display:block;font-size:.875rem;line-height:1.5;color:var(--color-muted,#667085)}</style>
  <script>
    const money = new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}); const ids=['amount','guarantee','fee','other']; const f=Object.fromEntries(ids.map(id=>[id,document.getElementById(id)])); const v=id=>Math.max(Number(f[id]?.value||0),0);
    function calc(){ const amount=v('amount'), guaranteed=amount*v('guarantee')/100, fee=guaranteed*v('fee')/100, total=fee+v('other'); document.getElementById('guaranteed').textContent=money.format(guaranteed); document.getElementById('guarantee-fee').textContent=money.format(fee); document.getElementById('total').textContent=money.format(total); document.getElementById('share').textContent=amount?`${(total/amount*100).toFixed(1)}%`:'0.0%'; }
    ids.forEach(id=>f[id]?.addEventListener('input',calc)); calc();
  </script>
</BaseLayout>
