---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';
import { getAllLenders } from '../../utils/data-build';

function isSafeBusinessLoanProfile(l) {
  const processingStatus = String(l.processing_status || '');
  const reviewStatus = String(l.review_status || '');
  const quarantineReason = String(l.quarantine_reason || '');
  const noIndex = l.no_index === true || l.no_index === 1 || l.no_index === 'true';
  const archived =
    l.is_archived === true ||
    l.archived === true ||
    Boolean(l.archived_at) ||
    Boolean(l.archive_reason) ||
    processingStatus === 'archived' ||
    reviewStatus.includes('archived');
  const quarantined =
    l.quarantine === true ||
    Boolean(quarantineReason) ||
    processingStatus.includes('quarantine') ||
    reviewStatus.includes('quarantine');
  const heldForReview =
    processingStatus === 'pending_approval' ||
    processingStatus === 'raw' ||
    reviewStatus === 'draft' ||
    reviewStatus === 'pending_review' ||
    reviewStatus === 'ready_for_review';
  const safeSlug = typeof l.slug === 'string' && /^[a-z0-9-]+$/.test(l.slug);

  return (
    safeSlug &&
    l.name &&
    l.category === 'business-loans' &&
    processingStatus === 'ready_for_index' &&
    reviewStatus === 'published' &&
    !noIndex &&
    !archived &&
    !quarantined &&
    !heldForReview &&
    l.google_rating &&
    l.google_rating > 0 &&
    l.google_rating <= 5 &&
    l.google_reviews_count &&
    l.google_reviews_count >= 10 &&
    l.description_short &&
    l.description_short.length > 30
  );
}

function profileScore(l) {
  const rating = Number(l.google_rating || 0);
  const reviews = Number(l.google_reviews_count || 0);
  const quality = Number(l.quality_score || 0);
  const enriched =
    l.has_been_enriched === true ||
    l.data_source === 'enriched' ||
    l.data_source === 'editorial' ||
    l.data_source === 'verified';

  return (enriched ? 30 : 0) + quality * 2 + Math.log10(reviews + 1) * 12 + rating * 4;
}

const businessLoanProfiles = getAllLenders()
  .filter(isSafeBusinessLoanProfile)
  .sort((a, b) => profileScore(b) - profileScore(a))
  .slice(0, 6)
  .map((l) => ({
    name: l.name,
    slug: l.slug,
    google_rating: l.google_rating || 0,
    google_reviews_count: l.google_reviews_count || 0,
    description: l.description_short?.substring(0, 130) || '',
  }));

const title = 'Business Loan Readiness Quiz | CreditDoc';
const description = 'Answer business funding questions to map readiness across SBA loans, startup funding, MCA caution, documents, and lender-fit review.';
const canonical = 'https://www.creditdoc.co/tools/business-loan-readiness-quiz/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Business Loan Readiness Quiz',
  description,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  image: 'https://www.creditdoc.co/og-default.png',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  datePublished: '2026-06-10',
  dateModified: '2026-06-10',
  author: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
  publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is this business loan prequalification?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. This is an educational readiness quiz. It does not submit an application, contact lenders, check credit, or decide whether a business qualifies for financing.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does the quiz affect my credit score?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The quiz does not ask for a Social Security number, does not ask for bank login credentials, and does not run a credit check.',
      },
    },
    {
      '@type': 'Question',
      name: 'What should I prepare before comparing business lenders?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Most business funding research starts with time in business, revenue range, credit range, recent bank statements, tax or accounting records, debt schedule, and a clear use of funds.',
      },
    },
  ],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Business Loan Readiness Quiz', item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      <li><a href="/tools/" class="hover:text-primary transition-colors">Tools</a></li>
      <li class="text-border">/</li>
      <li class="font-medium text-text">Business Loan Readiness Quiz</li>
    </ol>
  </nav>

  <div class="mx-auto max-w-4xl px-4 py-8">
    <section id="quiz-intro" class="text-center">
      <div class="mb-4 inline-flex items-center gap-2 rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">
        Free &middot; No credit check &middot; Educational only
      </div>
      <h1 class="text-3xl font-bold text-text md:text-4xl">Business Loan Readiness Quiz</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">
        Answer six quick questions about business age, revenue band, credit range, documents, and cash-flow pressure. The result points to a research path, not an approval decision.
      </p>
      <button id="start-quiz-btn" class="mt-8 inline-flex items-center justify-center rounded-xl bg-primary px-8 py-3.5 font-semibold text-white shadow-lg transition hover:bg-primary-hover">
        Start The Quiz
      </button>
    </section>

    <section class="glass-card mt-8 p-5">
      <h2 class="mb-2 text-lg font-bold text-text">Use This Before You Apply</h2>
      <p class="text-sm leading-relaxed text-muted">
        Business financing depends on lender type, documentation, revenue history, owner credit, repayment pressure, and use of funds. This tool keeps the inputs broad and routes you to CreditDoc research pages before you submit applications.
      </p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/best/best-small-business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan research</a>
        <a href="/answers/how-to-apply-for-a-business-loan/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Application guide</a>
        <a href="/tools/loan-denial-reason-checker/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Denial checker</a>
        <a href="/categories/business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Category context</a>
      </div>
    </section>

    <section id="quiz-panel" class="mt-8 hidden">
      <div class="mb-6">
        <div class="mb-2 flex items-center justify-between">
          <span class="text-sm font-medium text-muted">Question <span id="current-q">1</span> of 6</span>
          <span id="progress-pct" class="text-sm font-medium text-primary">17%</span>
        </div>
        <div class="h-2.5 w-full rounded-full bg-bg-alt">
          <div id="progress-bar" class="h-2.5 rounded-full bg-primary transition-all duration-300" style="width: 17%"></div>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-white p-6">
        <p id="question-kicker" class="text-sm font-semibold uppercase tracking-wider text-primary"></p>
        <h2 id="question-title" class="mt-2 text-2xl font-bold text-text"></h2>
        <p id="question-help" class="mt-2 text-sm leading-relaxed text-muted"></p>
        <div id="option-list" class="mt-6 grid gap-3"></div>
      </div>
    </section>

    <section id="result-panel" class="mt-8 hidden">
      <div class="rounded-xl border border-primary/20 bg-primary-light/30 p-6">
        <p class="text-sm font-semibold uppercase tracking-wider text-primary">Readiness result</p>
        <h2 id="result-title" class="mt-2 text-2xl font-bold text-text"></h2>
        <p id="result-summary" class="mt-3 text-sm leading-relaxed text-muted"></p>
      </div>

      <div class="mt-6 grid gap-6 md:grid-cols-2">
        <div class="rounded-xl border border-border bg-white p-6">
          <h3 class="font-bold text-text">What to review first</h3>
          <ul id="review-list" class="mt-4 space-y-3 text-sm leading-relaxed text-muted"></ul>
        </div>
        <div class="rounded-xl border border-border bg-white p-6">
          <h3 class="font-bold text-text">Next useful steps</h3>
          <ul id="step-list" class="mt-4 space-y-3 text-sm leading-relaxed text-muted"></ul>
        </div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-white p-6">
        <h3 class="font-bold text-text">Research paths</h3>
        <div id="action-list" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-white p-6">
        <h3 class="font-bold text-text">Business funding profiles to compare</h3>
        <p class="mt-2 text-sm text-muted">These are profile links for research. They are not recommendations, approvals, or offers.</p>
        <div id="profiles-grid" class="mt-4 grid gap-3"></div>
      </div>

      <div class="mt-6 rounded-xl border border-border bg-bg-alt p-6">
        <h3 class="font-bold text-text">Want the readiness checklist emailed?</h3>
        <p class="mt-2 text-sm text-muted">Optional. No SSN, no bank login, no lender application.</p>
        <form id="email-form" class="mt-4 grid gap-3 sm:grid-cols-[1fr_1fr_auto]">
          <input id="capture-name" type="text" placeholder="Name" class="rounded-lg border border-border bg-white px-4 py-3 text-text outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          <input id="capture-email" type="email" placeholder="Email" required class="rounded-lg border border-border bg-white px-4 py-3 text-text outline-none focus:border-primary focus:ring-1 focus:ring-primary" />
          <input id="capture-company" type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button type="submit" class="rounded-lg bg-primary px-5 py-3 font-semibold text-white hover:bg-primary-hover">Send</button>
        </form>
        <p class="mt-2 text-xs leading-relaxed text-muted">Submitting this form sends CreditDoc follow-up resources and saves this educational result for routing analysis. It is not an application and it does not create marketing consent.</p>
        <p id="email-success" class="mt-3 hidden text-sm font-medium text-positive">Saved. We will send the next useful CreditDoc resources for this topic.</p>
        <p id="email-error" class="mt-3 hidden text-sm font-medium text-negative">That did not go through. You can still use the links above.</p>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-white p-6">
      <h2 class="text-xl font-bold text-text">Business Loan Readiness FAQ</h2>
      <div class="mt-5 space-y-5">
        <div>
          <h3 class="font-semibold text-text">Is this business loan prequalification?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">No. This is an educational readiness quiz. It does not submit an application, contact lenders, check credit, or decide whether a business qualifies for financing.</p>
        </div>
        <div>
          <h3 class="font-semibold text-text">Does the quiz affect my credit score?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">No. The quiz does not ask for a Social Security number, does not ask for bank login credentials, and does not run a credit check.</p>
        </div>
        <div>
          <h3 class="font-semibold text-text">What should I prepare before comparing business lenders?</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">Most business funding research starts with time in business, revenue range, credit range, recent bank statements, tax or accounting records, debt schedule, and a clear use of funds.</p>
        </div>
      </div>
    </section>

    <section class="mt-8 rounded-xl border border-border bg-bg-alt p-5">
      <h2 class="font-bold text-text">Important Limits</h2>
      <p class="mt-2 text-xs leading-relaxed text-muted">
        This tool is not legal, tax, financial, credit, brokerage, or underwriting advice. It does not know a lender's rules, does not access your credit report or bank account, and does not replace lender-specific eligibility review.
      </p>
    </section>
  </div>

  <script define:vars={{ businessLoanProfiles }}>
    const questions = [
      {
        key: 'timeInBusiness',
        kicker: 'Business history',
        title: 'How long has the business been operating?',
        help: 'Use broad operating history. Do not enter formation documents or account details.',
        options: [
          { value: 'startup', label: 'Under 6 months or not launched yet', score: 0 },
          { value: '6-12', label: '6 to 12 months', score: 8 },
          { value: '12-24', label: '1 to under 2 years', score: 16 },
          { value: '24plus', label: '2 years or more', score: 28 },
        ],
      },
      {
        key: 'monthlyRevenue',
        kicker: 'Revenue band',
        title: 'What is the closest monthly revenue band?',
        help: 'A rough band is enough. Do not upload statements or enter bank credentials.',
        options: [
          { value: 'pre-revenue', label: 'Pre-revenue or inconsistent sales', score: 0 },
          { value: 'under10k', label: 'Under $10k/month', score: 8 },
          { value: '10k-25k', label: '$10k to $25k/month', score: 16 },
          { value: '25k-75k', label: '$25k to $75k/month', score: 24 },
          { value: '75kplus', label: '$75k+/month', score: 30 },
        ],
      },
      {
        key: 'creditRange',
        kicker: 'Owner credit band',
        title: 'What owner credit range best fits?',
        help: 'Use a band only. This quiz does not check credit.',
        options: [
          { value: 'unknown', label: 'I do not know', score: 4 },
          { value: 'under580', label: 'Under 580', score: 0 },
          { value: '580-619', label: '580 to 619', score: 8 },
          { value: '620-679', label: '620 to 679', score: 18 },
          { value: '680plus', label: '680 or higher', score: 28 },
        ],
      },
      {
        key: 'fundingUse',
        kicker: 'Use of funds',
        title: 'What would the funding mainly support?',
        help: 'The purpose changes which research path is most useful.',
        options: [
          { value: 'working-capital', label: 'Working capital or inventory', score: 14 },
          { value: 'equipment', label: 'Equipment, vehicle, or machinery', score: 16 },
          { value: 'startup', label: 'Launch or early startup costs', score: 4 },
          { value: 'debt-refi', label: 'Refinance existing business debt', score: 8 },
          { value: 'fast-cash', label: 'Very fast cash for a short-term gap', score: 2 },
        ],
      },
      {
        key: 'docsReady',
        kicker: 'Documents',
        title: 'How ready are your business documents?',
        help: 'Think bank statements, tax/accounting records, entity details, owner ID, debt schedule, and use-of-funds notes.',
        options: [
          { value: 'ready', label: 'Mostly ready and organized', score: 24 },
          { value: 'partial', label: 'Some ready, some missing', score: 10 },
          { value: 'weak', label: 'Not organized yet', score: 0 },
        ],
      },
      {
        key: 'cashFlowPressure',
        kicker: 'Repayment pressure',
        title: 'How tight is current cash flow?',
        help: 'This helps separate slower lower-cost research from fast-funding caution paths.',
        options: [
          { value: 'low', label: 'Stable and payments feel manageable', score: 20 },
          { value: 'medium', label: 'Tight but manageable', score: 8 },
          { value: 'high', label: 'Already hard to cover payments', score: 0 },
        ],
      },
    ];

    const answers = {};
    let currentIndex = 0;
    let currentResult = null;
    let completionSaved = false;
    let completionSavePromise = null;
    const sessionId = crypto.randomUUID?.() || String(Date.now());
    const quizLoadedAt = Date.now();

    const intro = document.getElementById('quiz-intro');
    const panel = document.getElementById('quiz-panel');
    const resultPanel = document.getElementById('result-panel');
    const startBtn = document.getElementById('start-quiz-btn');

    function showQuestion(index) {
      const q = questions[index];
      document.getElementById('current-q').textContent = String(index + 1);
      document.getElementById('progress-pct').textContent = Math.round(((index + 1) / questions.length) * 100) + '%';
      document.getElementById('progress-bar').style.width = ((index + 1) / questions.length) * 100 + '%';
      document.getElementById('question-kicker').textContent = q.kicker;
      document.getElementById('question-title').textContent = q.title;
      document.getElementById('question-help').textContent = q.help;

      const list = document.getElementById('option-list');
      list.innerHTML = '';
      q.options.forEach((opt) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'quiz-option';
        button.textContent = opt.label;
        button.addEventListener('click', () => {
          answers[q.key] = opt;
          if (currentIndex < questions.length - 1) {
            currentIndex += 1;
            showQuestion(currentIndex);
          } else {
            renderResult();
          }
        });
        list.appendChild(button);
      });
    }

    function buildResult() {
      const score = Object.values(answers).reduce((sum, item) => sum + item.score, 0);
      const time = answers.timeInBusiness?.value;
      const revenue = answers.monthlyRevenue?.value;
      const credit = answers.creditRange?.value;
      const use = answers.fundingUse?.value;
      const docs = answers.docsReady?.value;
      const pressure = answers.cashFlowPressure?.value;
      const established = time === '24plus';
      const strongRevenue = ['25k-75k', '75kplus'].includes(revenue);
      const goodCredit = ['620-679', '680plus'].includes(credit);
      const startup = time === 'startup' || use === 'startup' || revenue === 'pre-revenue';
      const weakDocs = docs === 'partial' || docs === 'weak';
      const cashFlowCaution = pressure === 'high' || use === 'fast-cash';

      if (established && strongRevenue && goodCredit && docs === 'ready' && pressure === 'low') {
        return {
          title: 'Bank or SBA research may be worth comparing',
          summary: 'Your answers point to stronger readiness signals for lower-cost business funding research. Compare SBA, bank, line-of-credit, and equipment paths before choosing speed over cost.',
          reviews: [
            'Confirm revenue history, owner credit band, time in business, and business bank activity are documented.',
            'Compare SBA or bank timelines against your actual funding deadline.',
            'Review collateral, personal guarantee, and total repayment terms before applying.',
          ],
          steps: [
            'Start with SBA and bank research if the timeline allows.',
            'Prepare a document packet before submitting applications.',
            'Use lender profile pages to compare product fit, speed, and requirements.',
          ],
          actions: [
            ['Compare SBA loan research', '/best/best-sba-loans/'],
            ['Compare small business lenders', '/best/best-small-business-loans/'],
            ['Review business lines of credit', '/best/best-business-lines-of-credit/'],
            ['Read how to apply', '/answers/how-to-apply-for-a-business-loan/'],
          ],
          eventLabel: 'bank_sba_ready',
          recommendedRoute: '/best/best-sba-loans/',
        };
      }

      if (startup) {
        return {
          title: 'Startup funding and document-building path',
          summary: 'Your answers point toward early-stage business funding research. Many lower-cost lenders want more operating history, so focus on startup-friendly options and stronger documentation first.',
          reviews: [
            'Separate true startup costs from working capital for an operating business.',
            'Check whether revenue, business bank activity, and owner credit are enough for the products you are comparing.',
            'Avoid assuming SBA or bank criteria apply to a new business without checking time-in-business rules.',
          ],
          steps: [
            'Build a cleaner business bank and document trail before serious lender comparison.',
            'Compare startup-friendly and equipment-backed paths before fast cash products.',
            'Use CreditDoc denial and application guides to avoid preventable rejections.',
          ],
          actions: [
            ['Compare startup business loans', '/best/best-startup-business-loans/'],
            ['Read the application guide', '/answers/how-to-apply-for-a-business-loan/'],
            ['Use the denial checker', '/tools/loan-denial-reason-checker/'],
            ['Review credit report checklist', '/resources/credit-report-checklist/'],
          ],
          eventLabel: 'startup_build_path',
          recommendedRoute: '/best/best-startup-business-loans/',
        };
      }

      if (cashFlowCaution) {
        return {
          title: 'Cash-flow pressure needs careful review',
          summary: 'Your answers point to repayment pressure or a short deadline. Fast funding can be expensive, so compare total repayment, daily or weekly payment impact, and denial-risk factors before accepting any offer.',
          reviews: [
            'Estimate payment frequency and total repayment, not just speed.',
            'Review whether daily sales deductions or short terms would worsen cash flow.',
            'Check whether missing documents or credit issues are pushing you toward costlier options.',
          ],
          steps: [
            'Read the MCA guide before comparing fast-funding products.',
            'Use the denial checker if a prior application was declined.',
            'Consider waiting to organize documents if the funding need is not urgent.',
          ],
          actions: [
            ['Read the MCA guide', '/answers/merchant-cash-advance-guide/'],
            ['Compare MCA providers', '/best/best-merchant-cash-advance/'],
            ['Use the denial checker', '/tools/loan-denial-reason-checker/'],
            ['Compare small business lenders', '/best/best-small-business-loans/'],
          ],
          eventLabel: 'cash_flow_caution',
          recommendedRoute: '/answers/merchant-cash-advance-guide/',
        };
      }

      if (weakDocs || credit === 'unknown' || credit === 'under580') {
        return {
          title: 'Documents, credit, or denial-risk factors need review first',
          summary: 'Your answers show avoidable application friction. Before comparing offers, organize documents, check credit reports, and review lender-fit issues that commonly lead to denials.',
          reviews: [
            'Check owner credit reports and correct inaccurate items before applying broadly.',
            'Gather business bank statements, tax/accounting records, entity records, and debt schedules.',
            'Avoid repeated applications until the weak point is clear.',
          ],
          steps: [
            'Use the loan denial checker to map weak points before applying.',
            'Use the credit report checklist for owner-credit review.',
            'Compare bad-credit business loan research only after you understand the cost tradeoffs.',
          ],
          actions: [
            ['Use the loan denial checker', '/tools/loan-denial-reason-checker/'],
            ['Review bad credit business loans', '/best/best-bad-credit-business-loans/'],
            ['Use the credit report checklist', '/resources/credit-report-checklist/'],
            ['Read business loan with bad credit', '/answers/can-you-get-a-business-loan-with-bad-credit/'],
          ],
          eventLabel: 'repair_docs_first',
          recommendedRoute: '/tools/loan-denial-reason-checker/',
        };
      }

      return {
        title: 'Alternative business loan research may fit first',
        summary: 'Your answers point to a middle readiness band. You may want to compare online lenders, lines of credit, equipment financing, and SBA alternatives while tightening documents and repayment assumptions.',
        reviews: [
          'Compare speed, total repayment, documentation requirements, and minimum credit ranges.',
          'Match the product to the use of funds instead of applying broadly.',
          'Review lender profiles and category context before submitting applications.',
        ],
        steps: [
          'Start with small business loan and line-of-credit research.',
          'Prepare documents before requesting lender-specific quotes.',
          'Use the denial checker if anything has recently been declined.',
        ],
        actions: [
          ['Compare small business lenders', '/best/best-small-business-loans/'],
          ['Compare business lines of credit', '/best/best-business-lines-of-credit/'],
          ['Read how to apply', '/answers/how-to-apply-for-a-business-loan/'],
          ['Use the denial checker', '/tools/loan-denial-reason-checker/'],
        ],
        eventLabel: 'alternative_lender_fit',
        recommendedRoute: '/best/best-small-business-loans/',
      };
    }

    function addListItems(id, items) {
      const list = document.getElementById(id);
      list.innerHTML = '';
      items.forEach((item) => {
        const li = document.createElement('li');
        li.className = 'flex items-start gap-2';
        const marker = document.createElement('span');
        marker.className = 'mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-primary';
        const copy = document.createElement('span');
        copy.textContent = item;
        li.append(marker, copy);
        list.appendChild(li);
      });
    }

    function renderResult() {
      const result = buildResult();
      currentResult = result;
      completionSaved = false;
      completionSavePromise = saveOriginationIntake()
        .then(() => {
          completionSaved = true;
        })
        .catch(() => {});

      panel.classList.add('hidden');
      resultPanel.classList.remove('hidden');
      document.getElementById('result-title').textContent = result.title;
      document.getElementById('result-summary').textContent = result.summary;
      addListItems('review-list', result.reviews);
      addListItems('step-list', result.steps);

      const actionList = document.getElementById('action-list');
      actionList.innerHTML = '';
      result.actions.forEach(([label, href], index) => {
        const a = document.createElement('a');
        a.href = href;
        a.className = index === 0
          ? 'rounded-xl bg-primary px-4 py-3 text-sm font-semibold text-white hover:bg-primary-hover'
          : 'rounded-xl border border-border px-4 py-3 text-sm font-semibold text-text hover:bg-bg-alt';
        a.textContent = label;
        actionList.appendChild(a);
      });

      const profilesGrid = document.getElementById('profiles-grid');
      profilesGrid.innerHTML = '';
      businessLoanProfiles.forEach((profile) => {
        const card = document.createElement('a');
        card.href = '/review/' + profile.slug + '/';
        card.className = 'rounded-xl border border-border p-4 hover:bg-bg-alt';
        const row = document.createElement('div');
        row.className = 'flex items-start justify-between gap-3';

        const copy = document.createElement('div');
        const name = document.createElement('p');
        name.className = 'font-semibold text-text';
        name.textContent = profile.name;
        const description = document.createElement('p');
        description.className = 'mt-1 text-sm text-muted';
        description.textContent = profile.description;
        copy.append(name, description);

        const rating = document.createElement('div');
        rating.className = 'text-right';
        const ratingValue = document.createElement('p');
        ratingValue.className = 'font-bold text-primary';
        ratingValue.textContent = Number(profile.google_rating).toFixed(1);
        const reviewCount = document.createElement('p');
        reviewCount.className = 'text-xs text-muted';
        reviewCount.textContent = `${Number(profile.google_reviews_count).toLocaleString()} reviews`;
        rating.append(ratingValue, reviewCount);

        row.append(copy, rating);
        card.appendChild(row);
        profilesGrid.appendChild(card);
      });

      if (typeof gtag === 'function') {
        gtag('event', 'quiz_completed', {
          event_category: 'engagement',
          event_label: 'business_loan_readiness',
          quiz_result: result.eventLabel,
        });
      }
    }

    function compactAnswers() {
      return Object.fromEntries(
        Object.entries(answers).map(([key, item]) => [key, item.value])
      );
    }

    function collectUtm() {
      const params = new URLSearchParams(window.location.search);
      const utm = {};
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'].forEach((key) => {
        const value = params.get(key);
        if (value) utm[key] = value.slice(0, 160);
      });
      return utm;
    }

    async function saveOriginationIntake({ name = '', email = '', captureOnly = false } = {}) {
      if (!currentResult) return;
      const honeypot = document.getElementById('capture-company')?.value || '';
      const response = await fetch('/api/origination-intake', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tool_id: 'business-loan-readiness-quiz',
          source_page: window.location.pathname,
          result_label: currentResult.eventLabel,
          email,
          name,
          consent_marketing: false,
          capture_only: captureOnly,
          honeypot,
          elapsed_ms: Date.now() - quizLoadedAt,
          responses: {
            session_id: sessionId,
            ...compactAnswers(),
          },
          utm: collectUtm(),
        }),
      });
      if (!response.ok) {
        const detail = await response.text();
        throw new Error(detail);
      }
    }

    startBtn?.addEventListener('click', () => {
      intro.classList.add('hidden');
      panel.classList.remove('hidden');
      showQuestion(currentIndex);
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    const emailForm = document.getElementById('email-form');
    const emailSuccess = document.getElementById('email-success');
    const emailError = document.getElementById('email-error');

    emailForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = document.getElementById('capture-name').value.trim();
      const email = document.getElementById('capture-email').value.trim();
      if (!email) return;

      const button = emailForm.querySelector('button[type="submit"]');
      button.textContent = 'Sending...';
      button.disabled = true;

      try {
        if (completionSavePromise) await completionSavePromise;
        await saveOriginationIntake({ name, email, captureOnly: completionSaved });
        const body = new URLSearchParams({
          list: 'rCzcu8brUim88T892Y85IqRQ',
          email,
          name,
          boolean: 'true',
        });
        const response = await fetch('https://sendy.creditdoc.co/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: body.toString(),
        });
        const text = await response.text();
        if (text.trim() === '1' || text.includes('Already subscribed')) {
          emailForm.classList.add('hidden');
          emailSuccess.classList.remove('hidden');
          emailError.classList.add('hidden');
          if (typeof gtag === 'function') {
            gtag('event', 'quiz_email_capture', {
              event_category: 'engagement',
              event_label: 'business_loan_readiness',
            });
          }
        } else {
          throw new Error(text);
        }
      } catch {
        emailError.classList.remove('hidden');
        button.textContent = 'Send';
        button.disabled = false;
      }
    });
  </script>

  <style>
    .quiz-option {
      display: block;
      width: 100%;
      border: 1px solid var(--color-border, #d8dee8);
      border-radius: 0.75rem;
      background: #fff;
      padding: 1rem;
      text-align: left;
      font-weight: 600;
      color: var(--color-text, #172033);
      transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
    }

    .quiz-option:hover,
    .quiz-option:focus {
      border-color: var(--color-primary, #2563eb);
      background: var(--color-bg-alt, #f8fafc);
      outline: none;
      transform: translateY(-1px);
    }
  </style>
  <ToolRelatedLinks />
</BaseLayout>
