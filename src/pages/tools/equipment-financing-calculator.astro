---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';

const title = 'Equipment Financing Calculator | CreditDoc';
const description = 'Estimate equipment financing payments, down-payment impact, total interest, and cash-flow pressure before comparing equipment lenders.';
const canonical = 'https://www.creditdoc.co/tools/equipment-financing-calculator/';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Equipment Financing Calculator', description, url: canonical, applicationCategory: 'FinanceApplication', operatingSystem: 'Web', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' } };
const faqJsonLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [{ '@type': 'Question', name: 'What does an equipment financing calculator estimate?', acceptedAnswer: { '@type': 'Answer', text: 'It estimates the financed amount, monthly payment, total interest, and repayment pressure based on equipment cost, down payment, term, rate, and fees.' } }, { '@type': 'Question', name: 'Can this calculator compare buying and leasing?', acceptedAnswer: { '@type': 'Answer', text: 'This calculator models a simple equipment loan or financing agreement. Lease structures, residual values, purchase options, and tax treatment can differ.' } }] };
const breadcrumbJsonLd = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' }, { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' }, { '@type': 'ListItem', position: 3, name: 'Equipment Financing Calculator', item: canonical }] };
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted"><li><a href="/" class="hover:text-primary">Home</a></li><li class="text-border">/</li><li><a href="/tools/" class="hover:text-primary">Tools</a></li><li class="text-border">/</li><li class="font-medium text-text">Equipment Financing Calculator</li></ol>
  </nav>
  <div class="mx-auto max-w-4xl px-4 py-8">
    <section class="mb-8 text-center">
      <div class="mb-4 inline-flex rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">Free &middot; Equipment cost estimate &middot; No signup</div>
      <h1 class="text-3xl font-bold text-text md:text-4xl">Equipment Financing Calculator</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">Estimate payments and total cost for machinery, vehicles, technology, or other business equipment before comparing financing options.</p>
    </section>
    <section class="glass-card mb-6 p-5">
      <h2 class="mb-2 text-lg font-bold text-text">Use This With Equipment Financing Research</h2>
      <p class="text-sm leading-relaxed text-muted">Enter quote-level assumptions only. Actual offers may depend on asset type, age, useful life, down payment, owner credit, time in business, collateral, and lender rules.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/best/best-equipment-financing/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Equipment financing</a>
        <a href="/tools/business-loan-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan calculator</a>
        <a href="/answers/how-does-equipment-financing-work/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">How equipment financing works</a>
        <a href="/tools/business-loan-readiness-quiz/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Readiness quiz</a>
      </div>
    </section>
    <section class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <div class="glass-card p-6">
        <h2 class="mb-5 text-xl font-bold text-text">Equipment Details</h2>
        <div class="grid gap-4">
          <label><span class="label">Equipment cost</span><span class="money-wrap"><span>$</span><input id="cost" class="input-field pl-7" type="number" min="0" step="1000" value="75000" /></span></label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label><span class="label">Down payment</span><span class="money-wrap"><span>$</span><input id="down" class="input-field pl-7" type="number" min="0" step="500" value="7500" /></span></label>
            <label><span class="label">Trade-in or rebate</span><span class="money-wrap"><span>$</span><input id="trade" class="input-field pl-7" type="number" min="0" step="500" value="0" /></span></label>
          </div>
          <div class="grid gap-4 sm:grid-cols-3">
            <label><span class="label">APR estimate</span><span class="unit-wrap"><input id="rate" class="input-field pr-8" type="number" min="0" max="99" step="0.1" value="12" /><span>%</span></span></label>
            <label><span class="label">Term</span><span class="unit-wrap"><input id="term" class="input-field pr-16" type="number" min="1" max="10" step="1" value="5" /><span>years</span></span></label>
            <label><span class="label">Fees</span><span class="money-wrap"><span>$</span><input id="fees" class="input-field pl-7" type="number" min="0" step="100" value="1000" /></span></label>
          </div>
        </div>
      </div>
      <aside class="glass-card p-6">
        <h2 class="mb-5 text-xl font-bold text-text">Estimate</h2>
        <div class="space-y-4">
          <div class="result"><p>Amount financed</p><strong id="financed">$68,500</strong></div>
          <div class="result"><p>Monthly payment</p><strong id="payment">$1,523</strong></div>
          <div class="grid grid-cols-2 gap-3"><div class="result"><p>Total interest</p><strong id="interest">$22,877</strong></div><div class="result"><p>Total repayment</p><strong id="total">$91,377</strong></div></div>
          <div class="result"><p>Down payment share</p><strong id="down-share">10.0%</strong><span id="summary">A larger down payment usually lowers payment pressure, but keep enough cash for installation, insurance, maintenance, and working capital.</span></div>
        </div>
      </aside>
    </section>
    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5"><h2 class="font-bold text-text">Important Limits</h2><p class="mt-2 text-xs leading-relaxed text-muted">This is not a quote, approval, tax analysis, or lease-vs-loan recommendation. Confirm all terms, fees, collateral, insurance, maintenance, residual value, and tax treatment with qualified professionals and the lender.</p></section>
  </div>
  <style>
    .label{margin-bottom:.5rem;display:block;font-size:.875rem;font-weight:500;color:var(--color-text,#172033)}.input-field{width:100%;border-radius:.5rem;border:1px solid var(--color-border,#d8dee8);background:#fff;padding:.75rem 1rem;color:var(--color-text,#172033);outline:none}.input-field:focus{border-color:var(--color-primary,#2563eb);box-shadow:0 0 0 1px var(--color-primary,#2563eb)}.money-wrap,.unit-wrap{position:relative;display:block}.money-wrap>span,.unit-wrap>span{position:absolute;top:50%;transform:translateY(-50%);color:var(--color-muted,#667085)}.money-wrap>span{left:.75rem}.unit-wrap>span{right:.75rem}.result{border:1px solid var(--color-border,#d8dee8);border-radius:.75rem;background:white;padding:1rem}.result p{font-size:.875rem;color:var(--color-muted,#667085)}.result strong{margin-top:.25rem;display:block;font-size:1.35rem;color:var(--color-text,#172033)}.result span{margin-top:.5rem;display:block;font-size:.875rem;line-height:1.5;color:var(--color-muted,#667085)}
  </style>
  <script>
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const ids = ['cost','down','trade','rate','term','fees'];
    const fields = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
    const value = (id) => Math.max(Number(fields[id]?.value || 0), 0);
    function pmt(principal, apr, months){ const r=apr/100/12; if(!principal||!months)return 0; return r ? principal*(r*(1+r)**months)/((1+r)**months-1) : principal/months; }
    function calc(){ const cost=value('cost'), down=value('down'), trade=value('trade'), fees=value('fees'); const financed=Math.max(cost-down-trade+fees,0); const months=Math.max(value('term'),1)*12; const monthly=pmt(financed,value('rate'),months); const interest=Math.max(monthly*months-financed,0); const downShare=cost ? (down/cost)*100 : 0; document.getElementById('financed').textContent=money.format(financed); document.getElementById('payment').textContent=money.format(monthly); document.getElementById('interest').textContent=money.format(interest); document.getElementById('total').textContent=money.format(monthly*months); document.getElementById('down-share').textContent=`${downShare.toFixed(1)}%`; }
    ids.forEach((id)=>fields[id]?.addEventListener('input',calc)); calc();
  </script>
  <ToolRelatedLinks />
</BaseLayout>
