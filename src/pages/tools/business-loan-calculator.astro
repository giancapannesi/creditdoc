---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolRelatedLinks from '../../components/ToolRelatedLinks.astro';
import RegulatoryResearchModule from '../../components/RegulatoryResearchModule.astro';

const title = 'Business Loan Calculator | CreditDoc';
const description = 'Estimate business loan monthly payments, total repayment, interest cost, origination-fee impact, and payment pressure. Free educational calculator.';
const canonical = 'https://www.creditdoc.co/tools/business-loan-calculator/';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Business Loan Calculator',
  description,
  url: canonical,
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  image: 'https://www.creditdoc.co/og-default.png',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  publisher: { '@type': 'Organization', name: 'CreditDoc', url: 'https://www.creditdoc.co' },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What does a business loan calculator show?',
      acceptedAnswer: { '@type': 'Answer', text: 'A business loan calculator estimates payment amount, total interest, total repayment, and fee impact from the assumptions you enter.' },
    },
    {
      '@type': 'Question',
      name: 'Is this calculator a loan offer?',
      acceptedAnswer: { '@type': 'Answer', text: 'No. It is an educational estimate and does not approve, prequalify, price, or recommend any lender or financing product.' },
    },
  ],
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.creditdoc.co/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.creditdoc.co/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Business Loan Calculator', item: canonical },
  ],
};
---

<BaseLayout title={title} description={description} canonical={canonical} jsonLd={[jsonLd, faqJsonLd, breadcrumbJsonLd]}>
  <nav class="mx-auto max-w-4xl px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted">
      <li><a href="/" class="hover:text-primary">Home</a></li><li class="text-border">/</li>
      <li><a href="/tools/" class="hover:text-primary">Tools</a></li><li class="text-border">/</li>
      <li class="font-medium text-text">Business Loan Calculator</li>
    </ol>
  </nav>

  <div class="mx-auto max-w-4xl px-4 py-8">
    <section class="mb-8 text-center">
      <div class="mb-4 inline-flex rounded-full bg-primary-light px-4 py-1.5 text-sm font-medium text-primary">Free &middot; No signup &middot; Educational estimate</div>
      <h1 class="text-3xl font-bold text-text md:text-4xl">Business Loan Calculator</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-muted">Estimate business loan payment, interest, fee impact, and revenue pressure before comparing lenders or submitting applications.</p>
    </section>

    <section class="glass-card mb-6 p-5">
      <h2 class="mb-2 text-lg font-bold text-text">Use This With Business Funding Research</h2>
      <p class="text-sm leading-relaxed text-muted">This calculator models simple amortized loans. It does not model every line-of-credit draw, MCA factor rate, variable-rate schedule, prepayment penalty, or lender-specific fee.</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <a href="/best/best-small-business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Business loan research</a>
        <a href="/best/best-bad-credit-business-loans/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Bad-credit business loans</a>
        <a href="/tools/business-loan-readiness-quiz/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Readiness quiz</a>
        <a href="/tools/bank-statement-cash-flow-calculator/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Cash-flow calculator</a>
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[1fr_0.9fr]">
      <div class="glass-card p-6">
        <h2 class="mb-5 text-xl font-bold text-text">Loan Details</h2>
        <div class="grid gap-4">
          <label><span class="label">Loan amount</span><span class="money-wrap"><span>$</span><input id="amount" class="input-field pl-7" type="number" min="1000" step="1000" value="100000" /></span></label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label><span class="label">APR estimate</span><span class="unit-wrap"><input id="rate" class="input-field pr-8" type="number" min="0" max="99" step="0.1" value="14" /><span>%</span></span></label>
            <label><span class="label">Term</span><span class="unit-wrap"><input id="term" class="input-field pr-16" type="number" min="1" max="30" step="1" value="5" /><span>years</span></span></label>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label><span class="label">Origination or closing fee</span><span class="unit-wrap"><input id="fee" class="input-field pr-8" type="number" min="0" max="20" step="0.1" value="3" /><span>%</span></span></label>
            <label><span class="label">Monthly revenue</span><span class="money-wrap"><span>$</span><input id="revenue" class="input-field pl-7" type="number" min="0" step="1000" value="50000" /></span></label>
          </div>
          <label><span class="label">Existing monthly debt payments</span><span class="money-wrap"><span>$</span><input id="debt" class="input-field pl-7" type="number" min="0" step="100" value="4000" /></span></label>
        </div>
      </div>

      <aside class="glass-card p-6">
        <h2 class="mb-5 text-xl font-bold text-text">Estimate</h2>
        <div class="space-y-4">
          <div class="result"><p>Monthly payment</p><strong id="payment">$2,327</strong></div>
          <div class="grid grid-cols-2 gap-3">
            <div class="result"><p>Fee estimate</p><strong id="fee-out">$3,000</strong></div>
            <div class="result"><p>Total interest</p><strong id="interest">$39,629</strong></div>
          </div>
          <div class="result"><p>Total repayment plus modeled fees</p><strong id="total">$142,629</strong></div>
          <div class="result"><p>Revenue pressure</p><strong id="pressure">Moderate</strong><span id="pressure-copy">The modeled payment is meaningful but may be workable if cash flow is stable.</span></div>
        </div>
      </aside>
    </section>

    <section class="mt-6 rounded-xl border border-border bg-bg-alt p-5">
      <h2 class="font-bold text-text">Important Limits</h2>
      <p class="mt-2 text-xs leading-relaxed text-muted">This is not a lender quote, approval, APR offer, underwriting decision, or financial advice. Actual offers can include variable rates, draw fees, prepayment terms, collateral requirements, personal guarantees, and other lender-specific costs.</p>
    </section>
  </div>

  <style>
    .label { margin-bottom: 0.5rem; display: block; font-size: 0.875rem; font-weight: 500; color: var(--color-text, #172033); }
    .input-field { width: 100%; border-radius: 0.5rem; border: 1px solid var(--color-border, #d8dee8); background: #fff; padding: 0.75rem 1rem; color: var(--color-text, #172033); outline: none; }
    .input-field:focus { border-color: var(--color-primary, #2563eb); box-shadow: 0 0 0 1px var(--color-primary, #2563eb); }
    .money-wrap, .unit-wrap { position: relative; display: block; }
    .money-wrap > span, .unit-wrap > span { position: absolute; top: 50%; transform: translateY(-50%); color: var(--color-muted, #667085); }
    .money-wrap > span { left: 0.75rem; }
    .unit-wrap > span { right: 0.75rem; }
    .result { border: 1px solid var(--color-border, #d8dee8); border-radius: 0.75rem; background: white; padding: 1rem; }
    .result p { font-size: 0.875rem; color: var(--color-muted, #667085); }
    .result strong { margin-top: 0.25rem; display: block; font-size: 1.4rem; color: var(--color-text, #172033); }
    .result span { margin-top: 0.5rem; display: block; font-size: 0.875rem; line-height: 1.5; color: var(--color-muted, #667085); }
  </style>

  <script>
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const ids = ['amount', 'rate', 'term', 'fee', 'revenue', 'debt'];
    const fields = Object.fromEntries(ids.map((id) => [id, document.getElementById(id)]));
    const value = (id) => Math.max(Number(fields[id]?.value || 0), 0);
    function payment(principal, annualRate, months) {
      const r = annualRate / 100 / 12;
      if (!principal || !months) return 0;
      if (!r) return principal / months;
      return principal * (r * (1 + r) ** months) / ((1 + r) ** months - 1);
    }
    function calculate() {
      const amount = value('amount');
      const months = Math.max(value('term'), 1) * 12;
      const monthly = payment(amount, value('rate'), months);
      const fee = amount * value('fee') / 100;
      const interest = monthly * months - amount;
      const load = value('revenue') ? ((monthly + value('debt')) / value('revenue')) * 100 : 0;
      document.getElementById('payment').textContent = money.format(monthly);
      document.getElementById('fee-out').textContent = money.format(fee);
      document.getElementById('interest').textContent = money.format(Math.max(interest, 0));
      document.getElementById('total').textContent = money.format(monthly * months + fee);
      let label = 'Lower';
      let copy = 'The modeled payment uses a smaller share of monthly revenue. Review margins and seasonality before applying.';
      if (load >= 25) { label = 'High'; copy = 'The modeled payment plus existing debt uses a large share of monthly revenue. Review alternatives and cash-flow cushion carefully.'; }
      else if (load >= 12) { label = 'Moderate'; copy = 'The modeled payment is meaningful but may be workable if cash flow is stable.'; }
      document.getElementById('pressure').textContent = label;
      document.getElementById('pressure-copy').textContent = copy;
    }
    ids.forEach((id) => fields[id]?.addEventListener('input', calculate));
    calculate();
  </script>
  <RegulatoryResearchModule compact context="tool" />
  <ToolRelatedLinks />
</BaseLayout>
