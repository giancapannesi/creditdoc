{
  "name": "creditdoc",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check_content_text_integrity.mjs && node scripts/check_robots_contract.mjs && node scripts/check_ai_ingestion_contract.mjs && node scripts/check_ssr_sitemap_parity.mjs",
    "postbuild": "node scripts/check_sitemap_robots_conflicts.mjs && node scripts/check_sitemap_critical_urls.mjs && node scripts/check_feed_contract.mjs && node scripts/check_image_alt_contract.mjs && node scripts/check_image_filename_contract.mjs && node scripts/check_ai_ingestion_contract.mjs",
    "build": "astro build",
    "check:answer-meta": "node scripts/creditdoc_answer_meta_audit.mjs",
    "seo:answer-meta:apply": "node scripts/creditdoc_answer_meta_audit.mjs --apply --limit 50",
    "test:comparison-batch": "node --test test/comparison_batch_utils.test.mjs",
    "check:comparison-db-freshness": "node scripts/check_comparison_db_freshness.mjs",
    "check:content-text-integrity": "node scripts/check_content_text_integrity.mjs",
    "check:ai-ingestion": "node scripts/check_ai_ingestion_contract.mjs",
    "check:seo-deep": "node scripts/seo_deep_audit.mjs",
    "check:live-sitemap": "node scripts/check_live_sitemap_status.mjs",
    "check:comparison-batch-scope": "node scripts/check_comparison_batch_scope.mjs",
    "comparison:extract-source-facts": "node scripts/extract_comparison_source_facts.mjs",
    "comparison:claim-safety": "node scripts/check_comparison_claim_safety.mjs",
    "comparison:rendered-check": "node scripts/check_rendered_comparison_batch.mjs",
    "comparison:review-packet": "node scripts/build_comparison_review_packet.mjs",
    "comparison:batch:preflight": "node scripts/run_comparison_batch_guarded.mjs --mode preflight",
    "comparison:batch:check": "node scripts/run_comparison_batch_guarded.mjs --mode check",
    "comparison:live-check": "node scripts/check_live_comparison_batch.mjs",
    "comparison:campaign:report": "node scripts/write_comparison_campaign_report.mjs",
    "comparison:campaign:can-continue": "node scripts/check_comparison_campaign_can_continue.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^5.17.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "wrangler": "^4.86.0"
  }
}
