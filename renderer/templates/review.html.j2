{#
  /review/[slug]/index.html — Jinja2 template for lender review pages.

  Phase 1 iteration 2: added header + footer parity (extracted from Astro
  rendered output). Structural gap now dominated by content sections
  (similar lenders, related answers, FAQ, ratings), not chrome.
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ lender.name }} Review — {{ lender.category|title }} | CreditDoc</title>
<meta name="description" content="{{ (lender.meta_description or lender.description_short or '')|striptags|truncate(160, killwords=True, end='') }}">
<link rel="canonical" href="https://www.creditdoc.co/review/{{ lender.slug }}/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ lender.name }}">
<meta property="og:description" content="{{ (lender.description_short or '')|striptags|truncate(200, killwords=True, end='') }}">
<meta property="og:url" content="https://www.creditdoc.co/review/{{ lender.slug }}/">
<meta property="og:site_name" content="CreditDoc">
<meta property="og:image" content="https://www.creditdoc.co{{ lender.logo_url or '/og-default.png' }}">
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "FinancialService",
  "name": lender.name,
  "url": "https://www.creditdoc.co/review/" + lender.slug + "/",
  "description": lender.description_short or "",
  "image": ("https://www.creditdoc.co" + lender.logo_url) if lender.logo_url else "",
  "priceRange": (lender.pricing or {}).get("range", "") if (lender.pricing is mapping) else "",
} | tojson }}
</script>
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.creditdoc.co/"},
    {"@type": "ListItem", "position": 2, "name": lender.category|title, "item": "https://www.creditdoc.co/categories/" + lender.category + "/"},
    {"@type": "ListItem", "position": 3, "name": lender.name, "item": "https://www.creditdoc.co/review/" + lender.slug + "/"}
  ]
} | tojson }}
</script>
{% if lender.rating %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "AggregateRating",
  "itemReviewed": {"@type": "FinancialService", "name": lender.name},
  "ratingValue": lender.rating,
  "bestRating": 5,
  "reviewCount": lender.review_count or 1,
} | tojson }}
</script>
{% endif %}
{% if lender.faqs %}
{% set faq_entities = [] %}
{% for q in lender.faqs %}{% set _ = faq_entities.append({"@type": "Question", "name": q.q, "acceptedAnswer": {"@type": "Answer", "text": q.a}}) %}{% endfor %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faq_entities,
} | tojson }}
</script>
{% endif %}
{% if glossary %}
{% set glossary_entities = [] %}
{% for g in glossary %}{% set _ = glossary_entities.append({"@type": "DefinedTerm", "name": g.term, "description": g.plain_definition, "url": "https://www.creditdoc.co/glossary/#" + g.slug}) %}{% endfor %}
<script type="application/ld+json">
{{ {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "name": "CreditDoc Glossary — key terms for this page",
  "hasDefinedTerm": glossary_entities,
} | tojson }}
</script>
{% endif %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/styles.css">
</head>
<body class="min-h-screen flex flex-col">
{% include '_header.html' %}
<main class="flex-1 max-w-4xl mx-auto px-4 py-8 w-full">
<nav aria-label="Breadcrumb" class="text-sm text-muted mb-4">
<a href="/">Home</a> / <a href="/categories/{{ lender.category }}/">{{ lender.category|title }}</a> / <span>{{ lender.name }}</span>
</nav>
<div class="mb-6">
<h1 class="text-3xl font-bold mb-2">{{ lender.name }}</h1>
<p class="text-sm text-muted mb-2">{{ lender.category|title }}{% if lender.state %} · {{ lender.state }}{% endif %}</p>
{% if lender.rating %}<p class="text-sm">Rating: <strong>{{ lender.rating }}/5</strong></p>{% endif %}
</div>
{% if lender.logo_url %}<img src="{{ lender.logo_url }}" alt="{{ lender.name }} logo" class="mb-6 max-h-24">{% endif %}
{% if lender.description_short %}
<p class="text-lg mb-6">{{ lender.description_short }}</p>
{% endif %}
{% if lender.description_long_linked %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">{{ lender.name }} Review</h2>
<div>{{ lender.description_long_linked|safe }}</div>
</section>
{% endif %}
{% if lender.pros or lender.cons %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Pros & Cons</h2>
<p class="text-sm text-muted mb-4">Reader-focused summary of the strongest reasons to consider {{ lender.name }} and the factors most worth weighing before contracting. Individual outcomes depend on your credit situation and goals.</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
{% if lender.pros %}
<div class="glass-card p-5">
<h3 class="font-semibold mb-3 text-positive">Pros</h3>
<ul class="space-y-2">{% for p in lender.pros %}<li class="flex items-start gap-2 text-sm"><span class="text-positive mt-0.5">✓</span><span>{{ p }}</span></li>{% endfor %}</ul>
</div>
{% endif %}
{% if lender.cons %}
<div class="glass-card p-5">
<h3 class="font-semibold mb-3 text-warning">Areas to Consider</h3>
<ul class="space-y-2">{% for c in lender.cons %}<li class="flex items-start gap-2 text-sm"><span class="text-warning mt-0.5">!</span><span>{{ c }}</span></li>{% endfor %}</ul>
</div>
{% endif %}
</div>
{% if lender.pros and lender.cons %}
<div class="mt-4 glass-card p-5 bg-bg-alt">
<h3 class="font-semibold mb-2">Verdict Summary</h3>
<p class="text-sm">{{ lender.name }} works best for consumers who value {{ (lender.pros[0]|lower)|truncate(80, killwords=True, end='') }} and can accept the tradeoff of {{ (lender.cons[0]|lower)|truncate(80, killwords=True, end='') }}. Compare against similar providers below before signing any contract.</p>
</div>
{% endif %}
</section>
{% endif %}
{% if lender.services or lender.features or lender.best_for %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Services & Features</h2>
{% if lender.services %}
<h3 class="font-semibold mb-3">Services offered</h3>
<ul class="mb-6 space-y-1">{% for s in lender.services %}<li class="flex items-start gap-2"><span class="text-primary mt-1">✓</span><span>{{ s }}</span></li>{% endfor %}</ul>
{% endif %}
{% if lender.features and lender.features is mapping %}
<h3 class="font-semibold mb-3">Feature Checklist</h3>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6 text-sm">
{% for feat_key, has in lender.features.items() %}
<div class="flex items-center gap-2 glass-card p-3">
{% if has %}<span class="text-positive font-bold">✓</span>{% else %}<span class="text-muted">✗</span>{% endif %}
<span class="{% if not has %}text-muted{% endif %}">{{ feat_key|replace('_',' ')|title }}</span>
</div>
{% endfor %}
</div>
{% elif lender.features %}
<h3 class="font-semibold mb-3">Features</h3>
<ul class="mb-6 space-y-1">{% for f in lender.features %}<li class="flex items-start gap-2"><span class="text-primary mt-1">✓</span><span>{{ f }}</span></li>{% endfor %}</ul>
{% endif %}
{% if lender.best_for %}
<h3 class="font-semibold mb-3">Best For</h3>
<ul class="space-y-1">{% for b in lender.best_for %}<li class="flex items-start gap-2"><span class="text-primary mt-1">•</span><span>{{ b }}</span></li>{% endfor %}</ul>
{% endif %}
</section>
{% endif %}
<section class="mb-8 glass-card p-5">
<h2 class="text-2xl font-semibold mb-3">Before You Contact {{ lender.name }}</h2>
<p class="text-sm text-muted mb-3">Before signing up with any {{ lender.category|title|replace('-',' ') }} provider, review these safeguards:</p>
<ul class="text-sm space-y-1">
<li>Confirm state licensing via your <a href="/tools/state-consumer-credit-regulator-directory/">state regulator directory</a>.</li>
<li>Check <a href="/research/consumer-complaints/">CFPB complaint data</a> for the company name.</li>
<li>Read the contract before paying any upfront fees — most states prohibit upfront credit-repair fees.</li>
<li>Compare against <a href="/best/best-credit-repair-companies/">alternative options</a> before committing.</li>
</ul>
</section>
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Compare Your Needs With {{ lender.name }}</h2>
<p class="text-sm text-muted mb-4">Match these decision factors against {{ lender.name }}'s profile before committing. This rubric mirrors what independent consumer-finance research typically checks for {{ lender.category|title|replace('-',' ') }} providers.</p>
<div class="glass-card p-5 mb-4">
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm mb-4 pb-4 border-b border-border">
<div><strong>Category</strong><p class="text-muted mt-1">{{ lender.category|title|replace('-',' ') }}</p></div>
<div><strong>Service scope</strong><p class="text-muted mt-1">{% if lender.services %}{{ lender.services|length }} services listed{% else %}Contact provider{% endif %}</p></div>
<div><strong>Geographic coverage</strong><p class="text-muted mt-1">{% if lender.states_served %}{{ lender.states_served|length }} states{% elif lender.state %}{{ lender.state }}{% else %}Verify with provider{% endif %}</p></div>
</div>
<h3 class="font-semibold mb-2">Match to your priorities</h3>
<ul class="space-y-3 text-sm">
<li class="flex items-start gap-3"><span class="text-primary mt-1">●</span><div><strong>Budget priority:</strong> {% if lender.pricing %}Pricing published above — factor in setup, monthly, and cancellation fees over the full expected service window.{% else %}Not published — request a written price disclosure before signing any agreement.{% endif %}</div></li>
<li class="flex items-start gap-3"><span class="text-primary mt-1">●</span><div><strong>Complexity priority:</strong> {% if lender.pros %}Consider {{ lender.name }}'s stated strengths ({{ lender.pros[0]|truncate(100, killwords=True) }}) against your specific credit situation.{% else %}Match your specific credit issues against services listed above.{% endif %}</div></li>
<li class="flex items-start gap-3"><span class="text-primary mt-1">●</span><div><strong>Timeline priority:</strong> {{ lender.category|title|replace('-',' ') }} typically takes 3-6 months for meaningful outcomes. Providers guaranteeing overnight results are red flags under federal consumer protection law.</div></li>
<li class="flex items-start gap-3"><span class="text-primary mt-1">●</span><div><strong>Recourse priority:</strong> Confirm state licensing via your <a href="/tools/state-consumer-credit-regulator-directory/" class="text-primary hover:underline">state regulator</a> and check the CFPB complaint database before contracting.</div></li>
<li class="flex items-start gap-3"><span class="text-primary mt-1">●</span><div><strong>Alternatives:</strong> Compare against <a href="/categories/{{ lender.category }}/" class="text-primary hover:underline">all {{ lender.category|title|replace('-',' ') }} providers</a>, DIY options via non-profit counseling agencies, and free CFPB resources.</div></li>
</ul>
</div>
</section>
{% if lender.pricing %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Pricing</h2>
<div>{% if lender.pricing is mapping %}
<ul>{% for k, v in lender.pricing.items() %}<li><strong>{{ k|replace('_',' ')|title }}:</strong> {{ v }}</li>{% endfor %}</ul>
{% else %}{{ lender.pricing }}{% endif %}</div>
</section>
{% endif %}
{% if lender.faqs %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Frequently Asked Questions</h2>
{% for q in lender.faqs %}
<details class="mb-4"><summary class="font-semibold">{{ q.q }}</summary><p class="mt-2">{{ q.a }}</p></details>
{% endfor %}
</section>
{% endif %}
{% if lender.website_url %}
<section class="mb-8">
<a href="/go/{{ lender.slug }}/?source=review_hero" rel="nofollow noopener" class="btn-primary">Visit {{ lender.name }}</a>
</section>
{% endif %}
{% if state_ctx %}
<section class="mb-8 glass-card p-5">
<h2 class="text-2xl font-semibold mb-3">State Consumer Finance Context</h2>
<p class="text-sm text-muted mb-3">
This is state-level context for {{ lender.category|title|replace('-',' ') }} consumers in {{ state_ctx.state_name or state_ctx.name }}.
It does not confirm that {{ lender.name }} or this specific location is licensed.
</p>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4 text-sm">
{% if state_ctx.licensing_board %}
<div><strong>State regulator:</strong> {{ state_ctx.licensing_board }}</div>
{% endif %}
{% if state_ctx.consumer_protection_agency %}
<div><strong>Consumer protection:</strong>
{% if state_ctx.consumer_protection_url %}<a href="{{ state_ctx.consumer_protection_url }}" rel="nofollow noopener">{{ state_ctx.consumer_protection_agency }}</a>
{% else %}{{ state_ctx.consumer_protection_agency }}{% endif %}
</div>
{% endif %}
</div>
{% if state_ctx.credit_repair_laws %}
<h3 class="font-semibold mb-2">Credit and debt help rules in {{ state_ctx.state_name or state_ctx.name }}</h3>
<ul class="text-sm space-y-1 mb-4">
{% if state_ctx.credit_repair_laws.state_statute %}<li><strong>Relevant law:</strong> {{ state_ctx.credit_repair_laws.state_statute }}{% if state_ctx.credit_repair_laws.statute_code %} ({{ state_ctx.credit_repair_laws.statute_code }}){% endif %}</li>{% endif %}
{% if state_ctx.credit_repair_laws.registration_required %}<li><strong>Registration:</strong> Required{% if state_ctx.credit_repair_laws.registration_agency %} with {{ state_ctx.credit_repair_laws.registration_agency }}{% endif %}</li>{% endif %}
{% if state_ctx.credit_repair_laws.upfront_fees_prohibited %}<li><strong>Upfront fees:</strong> Prohibited under state law</li>{% endif %}
{% if state_ctx.credit_repair_laws.cancellation_period_days %}<li><strong>Cancellation window:</strong> {{ state_ctx.credit_repair_laws.cancellation_period_days }}-day right to cancel</li>{% endif %}
{% if state_ctx.credit_repair_laws.bond_required %}<li><strong>Bond required:</strong> {{ state_ctx.credit_repair_laws.bond_amount or 'Yes' }}</li>{% endif %}
</ul>
{% if state_ctx.credit_repair_laws.key_provisions %}
<h3 class="font-semibold mb-2">Key state rules to check</h3>
<ul class="text-sm space-y-1 mb-4">
{% for p in state_ctx.credit_repair_laws.key_provisions[:6] %}<li>{{ p }}</li>{% endfor %}
</ul>
{% endif %}
{% endif %}
{% if state_ctx.payday_loan_status %}
<p class="text-sm mb-3"><strong>Payday lending in {{ state_ctx.state_name or state_ctx.name }}:</strong> {{ state_ctx.payday_loan_status }}{% if state_ctx.max_payday_amount %} (max ${{ state_ctx.max_payday_amount }}){% endif %}</p>
{% endif %}
{% if state_ctx.usury_cap %}
<p class="text-sm mb-3"><strong>Usury cap:</strong> {{ state_ctx.usury_cap }}</p>
{% endif %}
{% if state_ctx.complaint_resources %}
<h3 class="font-semibold mb-2">Complaint resources</h3>
<ul class="text-sm space-y-1 mb-4">
{% for r in state_ctx.complaint_resources[:5] %}
<li>{% if r.url %}<a href="{{ r.url }}" rel="nofollow noopener">{{ r.name }}</a>{% else %}<strong>{{ r.name }}</strong>{% endif %}{% if r.description %} — {{ r.description|truncate(140, killwords=True) }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
{% if state_ctx.statute_links %}
<h3 class="font-semibold mb-2">State references</h3>
<ul class="text-sm space-y-1 mb-4">
{% for s in state_ctx.statute_links[:5] %}
<li>{% if s.url %}<a href="{{ s.url }}" rel="nofollow noopener">{{ s.title or s.name or s.url }}</a>{% else %}{{ s.title or s.name }}{% endif %}</li>
{% endfor %}
</ul>
{% endif %}
{% if state_ctx.consumer_rights_summary %}
<p class="text-sm text-muted">{{ state_ctx.consumer_rights_summary|truncate(400, killwords=True) }}</p>
{% endif %}
</section>
{% endif %}
{% if similar_lenders %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Similar Companies <a href="/about/creditdoc-data/#similar-companies" class="text-sm text-muted hover:text-primary" title="How we find similar companies">&#9432;</a></h2>
<p class="text-sm text-muted mb-4">Comparable {{ lender.category|title|replace('-',' ') }} providers with similar service scope. Ratings reflect stored review context; verify current licensing and pricing directly before contracting.</p>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
{% for s in similar_lenders %}
<article class="glass-card p-5 flex flex-col h-full">
<div class="flex items-start gap-4">
<div class="shrink-0 w-14 h-14 rounded-xl bg-bg-alt border border-border flex items-center justify-center overflow-hidden">
{% if s.logo_url %}<img src="{{ s.logo_url }}" alt="{{ s.name }} logo" class="w-10 h-10 object-contain" loading="lazy">
{% else %}<span class="text-lg font-bold text-primary">{{ s.name[0]|upper }}</span>{% endif %}
</div>
<div class="flex-1 min-w-0">
<h3 class="text-lg font-semibold text-text">{{ s.name }}</h3>
{% if s.description_short %}<p class="text-sm text-muted mt-1">{{ s.description_short|truncate(160, killwords=True) }}</p>{% endif %}
</div>
</div>
<div class="mt-4 pt-4 border-t border-border flex items-center justify-between">
<div>
{% if s.rating %}<p class="text-xs text-muted">Rating <strong>{{ s.rating }}/5</strong></p>{% endif %}
{% if s.state %}<p class="text-xs text-muted">Listed in {{ s.state }}</p>{% endif %}
</div>
<a href="/review/{{ s.slug }}/" class="text-sm text-primary hover:underline">Read review &rarr;</a>
</div>
{% if s.pros and s.pros|length > 0 %}
<p class="text-xs text-muted mt-3"><strong>Notable:</strong> {{ s.pros[0]|truncate(120, killwords=True) }}</p>
{% endif %}
</article>
{% endfor %}
</div>
</section>
{% endif %}
{% if related_answers %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Related Questions</h2>
<ul class="space-y-2">
{% for a in related_answers %}
<li><a href="/answers/{{ a.slug }}/" class="text-primary hover:underline">{{ a.title or a.h1 or a.slug }}</a>
{% if a.meta_description %}<p class="text-sm text-muted">{{ a.meta_description|truncate(160, killwords=True) }}</p>{% endif %}
</li>
{% endfor %}
</ul>
</section>
{% endif %}
{% if wellness_guides %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Financial Wellness Guides</h2>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
{% for g in wellness_guides %}
<a href="/financial-wellness/{{ g.slug }}/" class="glass-card p-4 hover:border-primary transition-colors">
<h3 class="font-semibold mb-2">{{ g.title or g.slug }}</h3>
{% if g.description %}<p class="text-sm text-muted mb-2">{{ g.description|truncate(220, killwords=True) }}</p>{% endif %}
{% if g.category %}<p class="text-xs text-muted">Category: {{ g.category|title|replace('-',' ') }}</p>{% endif %}
<p class="text-sm text-primary mt-2">Read guide &rarr;</p>
</a>
{% endfor %}
</div>
<div class="glass-card p-5 mb-4">
<h3 class="font-semibold mb-2">Free Credit Fundamentals Course</h3>
<p class="text-sm text-muted mb-2">Learn how credit scores work, how to dispute errors, and build credit from scratch. 10 modules, zero cost.</p>
<a href="/courses/credit-fundamentals/" class="text-sm text-primary hover:underline">Start free course &rarr;</a>
</div>
<div class="glass-card p-5 mb-4">
<h3 class="font-semibold mb-2">Borrowing Power Quiz</h3>
<p class="text-sm text-muted mb-2">Find out how much you can borrow and which lenders match your credit situation. 2 minutes.</p>
<a href="/tools/borrowing-power-quiz/" class="text-sm text-primary hover:underline">Take the quiz &rarr;</a>
</div>
<div class="glass-card p-5">
<h3 class="font-semibold mb-2">Credit Score Simulator</h3>
<p class="text-sm text-muted mb-2">See how paying down debt, adding a card, or fixing errors changes your projected score.</p>
<a href="/tools/credit-score-simulator/" class="text-sm text-primary hover:underline">Try the simulator &rarr;</a>
</div>
</section>
{% endif %}
<section class="mb-8 glass-card p-5">
<h2 class="text-2xl font-semibold mb-3">Quick Summary</h2>
<p class="text-sm text-muted mb-2">{{ lender.name }} — {{ lender.category|title|replace('-',' ') }}{% if lender.state %} in {{ lender.state }}{% endif %}.</p>
{% if lender.rating %}<p class="text-sm mb-2">Overall rating: <strong>{{ lender.rating }}/5</strong></p>{% endif %}
{% if lender.description_short %}<p class="text-sm">{{ lender.description_short|truncate(220, killwords=True) }}</p>{% endif %}
{% if lender.website_url %}<div class="mt-3"><a href="/go/{{ lender.slug }}/?source=review_sidebar" rel="nofollow noopener" class="btn-primary">Visit {{ lender.name }}</a></div>{% endif %}
</section>
{% if lender.website_url %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Next Steps</h2>
<ol class="list-decimal list-inside space-y-2 text-sm">
<li>Compare {{ lender.name }} against similar options above.</li>
<li>Run our <a href="/tools/borrowing-power-quiz/">borrowing power quiz</a> to see how {{ lender.name }} matches your situation.</li>
<li>Check state regulator listings for {{ lender.name }}'s licensing before committing.</li>
<li><a href="/go/{{ lender.slug }}/?source=review_quiz" rel="nofollow noopener">Visit {{ lender.name }}</a> once you're ready.</li>
</ol>
</section>
{% endif %}
{% if glossary %}
<section class="mb-8">
<h2 class="text-2xl font-semibold mb-3">Glossary of Terms</h2>
<p class="text-sm text-muted mb-4">Common terms that come up when comparing {{ lender.category|title|replace('-',' ') }} providers. Full glossary at <a href="/glossary/" class="text-primary hover:underline">creditdoc.co/glossary/</a>.</p>
<dl class="space-y-4">
{% for g in glossary %}
<div class="glass-card p-4">
<dt class="font-semibold" id="{{ g.slug }}">{{ g.term }}{% if g.full_form and g.full_form != g.term %} — <span class="text-sm text-muted font-normal">{{ g.full_form }}</span>{% endif %}</dt>
<dd class="text-sm mt-2">{{ g.plain_definition }}</dd>
{% if g.why_it_matters %}
<dd class="text-xs text-muted mt-2"><strong>Why it matters:</strong> {{ g.why_it_matters|truncate(220, killwords=True) }}</dd>
{% endif %}
{% if g.example %}
<dd class="text-xs text-muted mt-1"><strong>Example:</strong> {{ g.example|truncate(240, killwords=True) }}</dd>
{% endif %}
</div>
{% endfor %}
</dl>
</section>
{% endif %}
<footer class="text-xs text-muted mt-16 pt-4 border-t border-border">
<p>Last updated: {{ lender.updated_at }}</p>
</footer>
</main>
{% include '_footer.html' %}
</body>
</html>
