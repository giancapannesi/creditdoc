{#
  /credit-guide/[slug]/[category]/index.html — Jinja2 template.

  Ports src/pages/credit-guide/[slug]/[category].astro (585 LoC).
  Emits noindex+follow (filtered browse — canonical is /credit-guide/<slug>/).
#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ seo_title }}</title>
<meta name="description" content="{{ seo_description|striptags|truncate(160, killwords=True, end='') }}">
<meta name="robots" content="noindex, follow">
<link rel="canonical" href="https://www.creditdoc.co/credit-guide/{{ city_slug }}/">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ seo_description|striptags|truncate(200, killwords=True, end='') }}">
<meta property="og:url" content="https://www.creditdoc.co/credit-guide/{{ city_slug }}/{{ category }}/">
<meta property="og:site_name" content="CreditDoc">
<meta property="og:image" content="https://www.creditdoc.co/og-default.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="stylesheet" href="/styles.css">
<script type="application/ld+json">
{{ breadcrumb_jsonld|safe }}
</script>
<script type="application/ld+json">
{{ collection_jsonld|safe }}
</script>
{% if item_list_jsonld %}
<script type="application/ld+json">
{{ item_list_jsonld|safe }}
</script>
{% endif %}
{% if faq_jsonld %}
<script type="application/ld+json">
{{ faq_jsonld|safe }}
</script>
{% endif %}
</head>
<body class="min-h-screen bg-bg text-text antialiased">
{% include "_header.html" %}
<main>
  <nav class="max-w-6xl mx-auto px-4 pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-muted flex-wrap">
      <li><a href="/" class="hover:text-primary transition-colors">Home</a></li>
      <li class="text-border">/</li>
      {% if state_hub_exists %}
        <li><a href="/state/{{ state_slug }}/" class="hover:text-primary transition-colors">{{ state_name }}</a></li>
        <li class="text-border">/</li>
      {% else %}
        <li class="text-muted">{{ state_name }}</li>
        <li class="text-border">/</li>
      {% endif %}
      <li><a href="/credit-guide/{{ city_slug }}/" class="hover:text-primary transition-colors">{{ city }}</a></li>
      <li class="text-border">/</li>
      <li class="text-text font-medium">{{ cat_name }}</li>
    </ol>
  </nav>

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-text mb-3">{{ cat_name }} in {{ city }}, {{ state_abbr }}</h1>
      <p class="text-lg text-muted max-w-3xl">
        {% if is_atm %}
          Browse selected ATM and cash access profiles for {{ city }}, {{ state_name }}. This is not a complete count of every ATM in the city; confirm current locations and availability with your bank, credit union, or ATM network.
        {% elif n_sorted %}
          Review {{ n_sorted }} listed {{ cat_name|lower }} profiles associated with {{ city }}, {{ state_name }}. Check local offices, stored review context, and state-level rules before contacting a provider.
        {% else %}
          Review {{ cat_name|lower }} provider profiles associated with {{ city }}, {{ state_name }}. Use statewide and category-level context while this local inventory is reviewed.
        {% endif %}
      </p>
    </div>

    {% if not is_atm %}
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-primary">{{ n_sorted }}</p>
        <p class="text-xs text-muted mt-1">{{ cat_name }} Listed Profiles</p>
      </div>
      {% if city_lenders %}
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-text">{{ city_lenders|length }}</p>
        <p class="text-xs text-muted mt-1">In {{ city }} Specifically</p>
      </div>
      {% endif %}
      <div class="glass-card p-4 text-center">
        <p class="text-2xl font-bold text-text">{{ state_only_lenders|length }}</p>
        <p class="text-xs text-muted mt-1">Statewide Profiles</p>
      </div>
    </div>
    {% endif %}

    <div class="glass-card p-6 mb-8">
      <p class="text-sm text-muted leading-relaxed">{{ local_intro }}</p>
      <div class="mt-3 flex flex-wrap gap-3 text-xs">
        {% if state_hub_exists %}
        <a href="/state/{{ state_slug }}/lending-laws/" class="text-primary hover:underline">{{ state_name }} lending laws &rarr;</a>
        {% endif %}
        <a href="/credit-guide/{{ city_slug }}/" class="text-primary hover:underline">{{ city }} full guide &rarr;</a>
        <a href="/tools/borrowing-power-quiz/" class="text-primary hover:underline">Estimate borrowing power &rarr;</a>
        <a href="/research/consumer-complaints/" class="text-primary hover:underline">How complaint data works &rarr;</a>
      </div>
    </div>

    <section class="glass-card p-5 mb-8">
      <h2 class="text-lg font-bold text-text mb-2">How to Use This {{ city }} List</h2>
      <p class="text-sm text-muted leading-relaxed">
        Start with local and statewide provider profiles, then check the related state rules, common borrower questions, and CreditDoc data explainers. A listing here is directory context, not a recommendation, approval prediction, price quote, or licensing determination.
      </p>
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <a href="/credit-guide/{{ city_slug }}/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">{{ city }} guide</a>
        {% if state_hub_exists %}
        <a href="/state/{{ state_slug }}/lending-laws/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">State rules</a>
        {% else %}
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Consumer protection</a>
        {% endif %}
        <a href="/answers/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">Borrower questions</a>
        <a href="/research/consumer-complaints/" class="rounded-lg border border-border bg-bg-alt p-3 text-sm text-primary hover:underline">CFPB data context</a>
      </div>
    </section>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        {% if n_sorted %}
          {% if city_lenders %}
          <section class="glass-card p-6">
            <h2 class="text-xl font-bold text-text mb-2">{{ cat_name }} Located in {{ city }}</h2>
            <p class="text-sm text-muted mb-4">These providers have offices or are specifically located in {{ city }}, {{ state_abbr }}.</p>
            <div class="grid grid-cols-1 gap-3">
              {% for l in city_lenders[:12] %}
              <a href="/review/{{ l.slug }}/" class="block glass-card p-4 hover:border-primary border border-transparent transition-colors">
                <div class="flex items-center gap-3">
                  <div class="shrink-0 w-10 h-10 rounded-lg bg-bg-alt border border-border flex items-center justify-center overflow-hidden">
                    <span class="text-sm font-bold text-primary">{{ l.name[:1] }}</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-text text-sm truncate">{{ l.name }}</p>
                    <p class="text-xs text-muted line-clamp-1">{{ l.description_short_soft }}</p>
                  </div>
                </div>
              </a>
              {% endfor %}
            </div>
            {% if city_lenders|length > 12 %}
            <p class="text-sm text-muted mt-3 text-center">+ {{ city_lenders|length - 12 }} more in {{ city }}</p>
            {% endif %}
          </section>
          {% endif %}

          <section class="glass-card p-6">
            <h2 class="text-xl font-bold text-text mb-2">
              {% if city_lenders %}More {{ cat_name }} Serving {{ city }}, {{ state_abbr }}{% else %}{{ list_name }}{% endif %}
            </h2>
            <p class="text-sm text-muted mb-4">
              {% if is_atm %}
                These are selected {{ state_name }} cash-access profiles in CreditDoc's directory, not a complete inventory of {{ city }} ATMs.
              {% else %}
                Statewide profiles that may be relevant for {{ city }} residents researching this category.
              {% endif %}
            </p>
            <div class="grid grid-cols-1 gap-3">
              {% for l in state_only_lenders[:12] %}
              <a href="/review/{{ l.slug }}/" class="block glass-card p-4 hover:border-primary border border-transparent transition-colors">
                <div class="flex items-center gap-3">
                  <div class="shrink-0 w-10 h-10 rounded-lg bg-bg-alt border border-border flex items-center justify-center overflow-hidden">
                    <span class="text-sm font-bold text-primary">{{ l.name[:1] }}</span>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="font-semibold text-text text-sm truncate">{{ l.name }}</p>
                    <p class="text-xs text-muted line-clamp-1">{{ l.description_short_soft }}</p>
                  </div>
                </div>
              </a>
              {% endfor %}
            </div>
            {% if state_only_lenders|length > 12 %}
            <p class="text-sm text-muted mt-3 text-center">
              Showing 12 of {{ state_only_lenders|length }} statewide providers. <a href="/categories/{{ category }}/" class="text-primary hover:underline">View all {{ cat_name }} nationally &rarr;</a>
            </p>
            {% endif %}
          </section>
        {% else %}
        <div class="glass-card p-8 text-center">
          <p class="text-lg text-muted mb-4">No {{ cat_name|lower }} providers found specifically in {{ city }}, {{ state_abbr }} yet.</p>
          <p class="text-sm text-muted mb-6">CreditDoc is continuing to review profiles. In the meantime, use the broader category directory and state rules.</p>
          <a href="/categories/{{ category }}/" class="inline-block px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors">Browse All {{ cat_name }} &rarr;</a>
        </div>
        {% endif %}

        {% if not is_atm %}
        <div class="glass-card p-6 mt-6 border border-primary bg-gradient-to-r from-primary/5 to-transparent">
          <h3 class="text-lg font-bold text-text mb-1">Not Sure Where to Start in {{ city }}?</h3>
          <p class="text-sm text-muted mb-4">
            Take our free 2-minute quiz to estimate a borrowing range and review {{ cat_name|lower }} research paths based on your inputs and location.
          </p>
          <a href="/tools/borrowing-power-quiz/" class="inline-block px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-primary-dark transition-colors">Take the Borrowing Power Quiz &rarr;</a>
        </div>
        {% endif %}

        {% if not is_atm and faqs %}
        <section class="glass-card p-6 mt-6">
          <h2 class="text-xl font-bold text-text mb-4">{{ cat_name }} Questions in {{ city }}</h2>
          <div class="space-y-3">
            {% for faq in faqs %}
            <details class="group rounded-lg border border-border bg-bg-alt overflow-hidden">
              <summary class="cursor-pointer px-4 py-3 font-semibold text-text text-sm">{{ faq.q }}</summary>
              <div class="px-4 pb-4 text-sm text-muted leading-relaxed">{{ faq.a|safe }}</div>
            </details>
            {% endfor %}
          </div>
          <div class="mt-4 pt-3 border-t border-border">
            <a href="/credit-guide/{{ city_slug }}/" class="text-sm text-primary hover:underline">More local credit questions for {{ city }} &rarr;</a>
          </div>
        </section>
        {% endif %}

        {% if not is_atm and related_answers %}
        <section class="glass-card p-6 mt-6">
          <h2 class="text-xl font-bold text-text mb-4">{{ cat_name }} Questions for {{ city }} Residents</h2>
          <ul class="space-y-3">
            {% for a in related_answers %}
            <li><a href="/answers/{{ a.slug }}/" class="text-sm text-primary hover:underline">{{ a.title }}</a></li>
            {% endfor %}
          </ul>
          <div class="mt-4 pt-3 border-t border-border">
            <a href="/answers/" class="text-sm text-primary hover:underline">More credit &amp; lending answers for {{ city }} &rarr;</a>
          </div>
        </section>
        {% endif %}

        <div class="glass-card p-6 mt-6">
          <h3 class="text-lg font-bold text-text mb-2">Explore More in {{ city }}</h3>
          <p class="text-sm text-muted mb-4">{{ city }} has resources across credit repair, lending, debt relief, and more. See the full local guide.</p>
          <a href="/credit-guide/{{ city_slug }}/" class="text-primary font-semibold hover:underline">&larr; Back to {{ city }}, {{ state_abbr }} Credit Guide</a>
        </div>
      </div>

      <aside class="space-y-6">
        <div class="glass-card p-5">
          <h3 class="text-sm font-bold text-text mb-3 uppercase tracking-wide">More Services in {{ city }}</h3>
          <ul class="space-y-2">
            {% for cat in related_cats %}
            <li><a href="{{ local_related_href(cat.slug) }}" class="text-sm text-muted hover:text-primary transition-colors">{{ cat.name }} in {{ city }}</a></li>
            {% endfor %}
          </ul>
        </div>

        {% if sibling_guides %}
        <div class="glass-card p-5">
          <h3 class="text-sm font-bold text-text mb-3 uppercase tracking-wide">{{ cat_name }} in Other {{ state_name }} Cities</h3>
          <ul class="space-y-2">
            {% for g in sibling_guides %}
            <li><a href="/credit-guide/{{ g.slug }}/" class="text-sm text-muted hover:text-primary transition-colors">{{ cat_name }} in {{ g.city }}</a></li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}

        {% if state_hub_exists %}
        <div class="glass-card p-5">
          <h3 class="text-sm font-bold text-text mb-3 uppercase tracking-wide">{{ state_name }} Overview</h3>
          <p class="text-sm text-muted mb-3">View all lenders and lending laws across {{ state_name }}.</p>
          <a href="/state/{{ state_slug }}/" class="text-sm text-primary hover:underline">{{ state_name }} credit guide &rarr;</a>
        </div>
        {% endif %}

        <div class="glass-card p-5 border-primary border">
          <h3 class="text-sm font-bold text-text mb-3 uppercase tracking-wide">Research Your Options</h3>
          <p class="text-sm text-muted mb-3">Estimate a borrowing range and review research paths for {{ city }}.</p>
          <a href="/tools/borrowing-power-quiz/" class="block w-full text-center py-2 px-4 bg-primary text-white rounded-lg text-sm font-semibold hover:bg-primary-dark transition-colors">Borrowing Power Quiz</a>
        </div>
      </aside>
    </div>
  </div>
</main>
{% include "_footer.html" %}
</body>
</html>
